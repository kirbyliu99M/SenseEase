# .NET / Visual Studio
bin/
obj/
.vs/
*.user
*.suo
artifacts/
publish/
publish_out/
TestResults/

# Pre-Alpha packaging output (Strategy A: trimmed self-contained + bundled GGUF)
# dist/ contains the publish target; zips are the distributable artifacts.
# Both are large (~3 GB zip; ~3.5 GB unpacked) and per-machine ephemeral.
# Pattern `dist/` matches both repo-root dist/v0.11-pre-alpha/ AND
# tools/head-tracker-sidecar/dist/ (PyInstaller output, regenerable).
dist/
*.zip
*.zip.sha256

# Inno Setup output (compiled installer .exe). The .iss source IS committed
# under installer/ — only the compiled binary + its checksum are ignored.
installer/*.exe
installer/*.sha256

# PyInstaller working directory for the head-tracker sidecar build (regenerable).
tools/head-tracker-sidecar/build/

# Local diagnostic / debugging output
app.stderr.log
app.stdout.log
fresh_stderr.log
fresh_stdout.log
verify.log
stack_dump*.txt
app_screenshot.png
after_click.png

# Large model binaries (download per models/mistral-7b/README.md)
models/mistral-7b/gguf/*
!models/mistral-7b/gguf/.gitkeep
models/mistral-7b/onnx/*
!models/mistral-7b/onnx/.gitkeep

# large model artifacts - keep out of git
models/Ministral-3-3B-Instruct-2512-GGUF/
models/gemma-4-E4B-it-GGUF/
# smoke-test screenshots
/chat_*.png
/persistence_smoke.png
/phase3_smoke.png

# Demo video assets (>100 MB, hostile to git — distributed out-of-band)
samples/*.mp4

# llama.cpp b9294 native binaries (Vulkan backend, ~100 MB extracted).
# The csproj auto-stages these into bin\...\runtimes\ on every build.
# Pre-Alpha v0.11.1 swapped from cuda12 (NVIDIA-only, 702 MB) to vulkan
# (cross-vendor, ~100 MB). Restore source: extract
# llama-b9294-bin-win-vulkan-x64.zip from
# https://github.com/ggml-org/llama.cpp/releases/tag/b9294 into
# runtimes\win-x64\native\vulkan\
runtimes/

# Python sidecar (tools/head-tracker-sidecar/) — sprint decision:
# single worktree, .venv gitignored. Keep these out of git repo-wide so
# nobody accidentally commits a virtualenv from anywhere in the tree.
.venv/
__pycache__/
*.pyc

# MediaPipe model binary used by the head-tracker sidecar. Downloaded
# per machine, not committed. See tools/head-tracker-sidecar/README.md.
tools/head-tracker-sidecar/face_landmarker.task

# Test-video binaries for the head-tracker sidecar. Documented but not
# committed (mirrors the existing samples/*.mp4 rule).
tools/head-tracker-sidecar/fixtures/*.mp4
tools/head-tracker-sidecar/fixtures/*.webm
tools/head-tracker-sidecar/fixtures/*.mov
tools/head-tracker-sidecar/fixtures/*.mkv
