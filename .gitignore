# .NET / Visual Studio
bin/
obj/
.vs/
*.user
*.suo
artifacts/
publish/
publish_out/
TestResults/

# Local diagnostic / debugging output
app.stderr.log
app.stdout.log
fresh_stderr.log
fresh_stdout.log
verify.log
stack_dump*.txt
app_screenshot.png
after_click.png

# Large model binaries (download per models/mistral-7b/README.md)
models/mistral-7b/gguf/*
!models/mistral-7b/gguf/.gitkeep
models/mistral-7b/onnx/*
!models/mistral-7b/onnx/.gitkeep

# large model artifacts - keep out of git
models/Ministral-3-3B-Instruct-2512-GGUF/
models/gemma-4-E4B-it-GGUF/
# smoke-test screenshots
/chat_*.png
/persistence_smoke.png
/phase3_smoke.png

# Demo video assets (>100 MB, hostile to git — distributed out-of-band)
samples/*.mp4

# llama.cpp b9294 native binaries (700+ MB, distributed out-of-band).
# The csproj auto-stages these into bin\...\runtimes\ on every build.
# Restore source: %TEMP%\llama-b9294-cuda + %TEMP%\cudart-b9294, or download
# from https://github.com/ggml-org/llama.cpp/releases (tag b9294).
runtimes/

# Python sidecar (tools/head-tracker-sidecar/) — sprint decision:
# single worktree, .venv gitignored. Keep these out of git repo-wide so
# nobody accidentally commits a virtualenv from anywhere in the tree.
.venv/
__pycache__/
*.pyc

# MediaPipe model binary used by the head-tracker sidecar. Downloaded
# per machine, not committed. See tools/head-tracker-sidecar/README.md.
tools/head-tracker-sidecar/face_landmarker.task

# Test-video binaries for the head-tracker sidecar. Documented but not
# committed (mirrors the existing samples/*.mp4 rule).
tools/head-tracker-sidecar/fixtures/*.mp4
tools/head-tracker-sidecar/fixtures/*.webm
tools/head-tracker-sidecar/fixtures/*.mov
tools/head-tracker-sidecar/fixtures/*.mkv
