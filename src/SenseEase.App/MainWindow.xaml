<Window x:Class="SenseEase.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:SenseEase.App.Views"
        xmlns:conv="clr-namespace:SenseEase.App.Converters"
        Title="SenseEase — Visual Comfort Dashboard"
        Icon="pack://application:,,,/SenseEase.App;component/Resources/AppIcon.ico"
        Height="820" Width="1160"
        MinHeight="700" MinWidth="980"
        Background="{DynamicResource Canvas}"
        FontFamily="Segoe UI">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- D0 design tokens, merged VIEW-LOCALLY (never App.Resources) so
                     MainWindowSmokeTests' bare new Application() still resolves
                     {StaticResource} at construction time. -->
                <ResourceDictionary Source="pack://application:,,,/SenseEase.App;component/Theme/SenseEaseTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>

        <!-- Standard bool -> Visibility converter for the first-run welcome
             banner. Lives in Window.Resources (not App.Resources) so the
             MainWindowSmokeTests can construct the window without booting the
             Application object — App.Resources is unset in that path and the
             StaticResource lookup would fail. -->
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- D1 comfort converters (view-local; read-only tier→copy/band). -->
        <conv:TierToHeadlineConverter     x:Key="TierToHeadline"/>
        <conv:TierToSublineConverter      x:Key="TierToSubline"/>
        <conv:TierToComfortLabelConverter x:Key="TierToComfortLabel"/>
        <conv:TierToComfortBandConverter  x:Key="TierToComfortBand"/>

        <!-- ── Card ──
             Clean rounded surface (myHP / HP Smart look): Radius.md corner,
             generous Pad.CardAll padding, soft Elev.2 shadow, plus a hairline
             Separator border so the card keeps definition in BOTH themes
             (critical for dark, where a borderless white-on-white card vanishes). -->
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Surface}"/>
            <Setter Property="CornerRadius" Value="{StaticResource Radius.md}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Separator}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="{StaticResource Pad.CardAll}"/>
            <Setter Property="Effect" Value="{StaticResource Elev.2}"/>
        </Style>

        <!-- ── Button template (rounded) ── -->
        <ControlTemplate x:Key="RoundBtn" TargetType="Button">
            <Border x:Name="Bd" Background="{TemplateBinding Background}"
                    CornerRadius="6" Padding="{TemplateBinding Padding}">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="Bd" Property="Opacity" Value="0.86"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter TargetName="Bd" Property="Opacity" Value="0.72"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter TargetName="Bd" Property="Opacity" Value="0.38"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <Style x:Key="PrimaryBtn" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource Accent}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="22,10"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{DynamicResource FocusVisible}"/>
            <Setter Property="Template" Value="{StaticResource RoundBtn}"/>
        </Style>

        <Style x:Key="AlertBtn" TargetType="Button" BasedOn="{StaticResource PrimaryBtn}">
            <Setter Property="Background" Value="{DynamicResource ComfortHigh}"/>
        </Style>

        <Style x:Key="GhostBtn" TargetType="Button" BasedOn="{StaticResource PrimaryBtn}">
            <Setter Property="Background" Value="{DynamicResource SurfaceMuted}"/>
            <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
        </Style>

        <!-- Profile quick-access pill. The ACTIVE profile lights up via a per-pill
             DataTrigger on {Binding CurrentProfile} (set on each Button below). -->
        <Style x:Key="ProfilePill" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource SurfaceMuted}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="16,7"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{DynamicResource FocusVisible}"/>
            <Setter Property="Template" Value="{StaticResource RoundBtn}"/>
        </Style>

        <!-- ── Text styles ── -->
        <Style x:Key="CardLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextTertiary}"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <Style x:Key="CardValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="32"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="Margin" Value="0,4,0,2"/>
        </Style>

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>

        <!-- ── ListView ── -->
        <Style x:Key="LogListView" TargetType="ListView">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
        </Style>

        <Style TargetType="GridViewColumnHeader">
            <Setter Property="Background" Value="{DynamicResource SurfaceMuted}"/>
            <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>

        <!-- C2 (audit): shared keyboard-focus ring. Implicit styles reach every
             unstyled focusable control; the explicit button styles carry it via
             PrimaryBtn's own FocusVisualStyle setter (Alert/Ghost inherit it via
             BasedOn). Only the FocusVisualStyle property is set, so the default
             control templates and all other styling are untouched. -->
        <Style TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{DynamicResource FocusVisible}"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="FocusVisualStyle" Value="{DynamicResource FocusVisible}"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="FocusVisualStyle" Value="{DynamicResource FocusVisible}"/>
        </Style>

        </ResourceDictionary>
    </Window.Resources>

    <DockPanel>

        <!-- ══════════ HEADER ══════════ -->
        <Border DockPanel.Dock="Top" Background="{DynamicResource HeaderSurface}"
                BorderBrush="{DynamicResource Separator}" BorderThickness="0,0,0,1" Padding="28,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="SenseEase"
                               FontSize="22" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}"/>
                    <TextBlock Text="OS-level Preventive Visual Comfort Prototype"
                               Foreground="{DynamicResource TextTertiary}" FontSize="12"/>
                </StackPanel>

                <Border Grid.Column="1" VerticalAlignment="Center"
                        CornerRadius="20" Padding="14,5">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="{DynamicResource Accent}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SensingModeLabel}" Value="DEMO MODE">
                                    <Setter Property="Background" Value="{DynamicResource ComfortRising}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding SensingModeLabel}" Value="SCREEN CAPTURE">
                                    <Setter Property="Background" Value="{DynamicResource Accent}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Text="{Binding SensingModeLabel, StringFormat='● {0}'}"
                               Foreground="White" FontSize="11" FontWeight="Bold"/>
                </Border>
            </Grid>
        </Border>

        <!-- ══════════ TABS ══════════ -->
        <TabControl x:Name="MainTabs" Background="{DynamicResource Surface}" BorderThickness="0" Padding="0">
            <TabControl.Resources>
                <Style TargetType="TabItem">
                    <Setter Property="FontSize" Value="13"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                    <Setter Property="Foreground" Value="{DynamicResource TextTertiary}"/>
                    <Setter Property="Padding" Value="20,10"/>
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="BorderThickness" Value="0"/>
                    <!-- M5 (a11y): non-colour-only active-tab cue. The template adds a
                         2px bottom underline that the IsSelected trigger paints Accent,
                         so the selected tab is distinguishable without relying on the
                         Foreground colour change alone. Header/Padding flow through the
                         TemplateBinding unchanged — tab sizes/labels are untouched. -->
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="TabItem">
                                <Border x:Name="TabBd" Background="{TemplateBinding Background}"
                                        BorderBrush="Transparent" BorderThickness="0,0,0,2">
                                    <ContentPresenter ContentSource="Header"
                                                      Margin="{TemplateBinding Padding}"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="TabBd" Property="BorderBrush"
                                                Value="{DynamicResource Accent}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                    <Style.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </TabControl.Resources>

            <!-- ── Tab 1: Dashboard ── -->
            <TabItem Header="儀表板 / Dashboard">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="24,20,24,24">

                <!-- ── First-run welcome banner ──
                     Shown only on a fresh install (no first-run-complete.flag in
                     %LocalAppData%\SenseEase\). Either button dismisses it: Run
                     Setup launches the calibration video demo; Skip just marks
                     the flag so we don't pester next launch. -->
                <Border CornerRadius="{StaticResource Radius.md}" Padding="20,14" Margin="0,0,0,16"
                        Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Separator}" BorderThickness="1"
                        Effect="{StaticResource Elev.2}"
                        Visibility="{Binding ShowFirstRunBanner, Converter={StaticResource BoolToVis}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="● 歡迎使用 SenseEase / Welcome to SenseEase"
                                       Foreground="{DynamicResource TextPrimary}" FontSize="12" FontWeight="Bold"/>
                            <TextBlock Text="先跑 60 秒的 setup demo，系統會依您的反應建議個人化預設值 / Run the 60 s setup demo so SenseEase can suggest personalised defaults based on your reaction."
                                       Foreground="{DynamicResource TextSecondary}" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                            <Button Content="Skip"
                                    Command="{Binding SkipSetupCommand}"
                                    Background="{DynamicResource SurfaceMuted}" Foreground="{DynamicResource TextSecondary}"
                                    BorderThickness="0"
                                    Padding="14,6" FontSize="12" Cursor="Hand"
                                    Template="{StaticResource RoundBtn}"
                                    Margin="0,0,8,0"/>
                            <Button Content="Run Setup Demo"
                                    Command="{Binding StartSetupDemoCommand}"
                                    Background="{DynamicResource Accent}" Foreground="White"
                                    BorderThickness="0"
                                    Padding="14,6" FontSize="12" FontWeight="SemiBold" Cursor="Hand"
                                    Template="{StaticResource RoundBtn}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ── D1 Comfort Hero ──
                     Calm, plain-language status — what SenseEase is doing for the
                     user right now (app-action, never felt-state), keyed off the
                     VIMS tier via read-only converters + Comfort* tokens. Replaces
                     the four raw-telemetry cards (now demoted to Advanced below). -->
                <Border Background="{DynamicResource Surface}" CornerRadius="{StaticResource Radius.md}"
                        BorderBrush="{DynamicResource Separator}" BorderThickness="1"
                        Padding="{StaticResource Pad.CardAll}" Effect="{StaticResource Elev.2}"
                        Margin="0,0,0,16"
                        AutomationProperties.Name="{Binding VimsTier, Converter={StaticResource TierToHeadline}, Mode=OneWay}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Type.Title}"
                                   Text="{Binding VimsTier, Converter={StaticResource TierToSubline}, Mode=OneWay}"/>

                        <!-- Comfort + mode chips -->
                        <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                            <Border CornerRadius="{StaticResource Radius.pill}" Padding="12,5" Margin="0,0,8,0"
                                    BorderThickness="1.5">
                                <Border.Style>
                                    <!-- C3 (a11y): full-band-colour 1.5px border so the chip
                                         is distinguishable without the near-invisible Weak
                                         fill alone (colour-not-only). BorderBrush mirrors the
                                         existing Background DataTrigger pattern; Weak fills
                                         stay as the Background. -->
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="{DynamicResource ComfortSteadyWeak}"/>
                                        <Setter Property="BorderBrush" Value="{DynamicResource ComfortSteady}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding VimsTier, Converter={StaticResource TierToComfortBand}}" Value="Rising">
                                                <Setter Property="Background" Value="{DynamicResource ComfortRisingWeak}"/>
                                                <Setter Property="BorderBrush" Value="{DynamicResource ComfortRising}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding VimsTier, Converter={StaticResource TierToComfortBand}}" Value="High">
                                                <Setter Property="Background" Value="{DynamicResource ComfortHighWeak}"/>
                                                <Setter Property="BorderBrush" Value="{DynamicResource ComfortHigh}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="{Binding VimsTier, Converter={StaticResource TierToComfortLabel}, Mode=OneWay}"
                                           FontSize="12" FontWeight="SemiBold"
                                           AutomationProperties.Name="Comfort band">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{DynamicResource ComfortSteadyText}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding VimsTier, Converter={StaticResource TierToComfortBand}}" Value="Rising">
                                                    <Setter Property="Foreground" Value="{DynamicResource ComfortRisingText}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding VimsTier, Converter={StaticResource TierToComfortBand}}" Value="High">
                                                    <Setter Property="Foreground" Value="{DynamicResource ComfortHighText}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Border>
                            <Border CornerRadius="{StaticResource Radius.pill}" Padding="12,5"
                                    Background="{DynamicResource SurfaceMuted}">
                                <TextBlock Text="{Binding Mode}" FontSize="12"
                                           Foreground="{DynamicResource TextSecondary}"/>
                            </Border>
                        </StackPanel>

                        <!-- ComfortMeter: fill ← DisplayStressPercent (0-100, P1
                             personalized = pressure as a % of THIS user's trigger).
                             EMPTY at rest (no "always-on protection" illusion); fills
                             only as real strain rises. Colour keys off the tier band. -->
                        <ProgressBar Value="{Binding DisplayStressPercent, Mode=OneWay}" Maximum="100"
                                     Height="6" Margin="0,16,0,0" BorderThickness="0"
                                     Background="{DynamicResource SurfaceMuted}"
                                     AutomationProperties.Name="Comfort level">
                            <ProgressBar.Style>
                                <Style TargetType="ProgressBar">
                                    <Setter Property="Foreground" Value="{DynamicResource ComfortSteady}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding VimsTier, Converter={StaticResource TierToComfortBand}}" Value="Rising">
                                            <Setter Property="Foreground" Value="{DynamicResource ComfortRising}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding VimsTier, Converter={StaticResource TierToComfortBand}}" Value="High">
                                            <Setter Property="Foreground" Value="{DynamicResource ComfortHigh}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ProgressBar.Style>
                        </ProgressBar>

                        <!-- ComfortMeter legend (a11y): persistent caption + low/high
                             endpoint hints so the meter reads without colour alone.
                             Binding/Max on the ProgressBar above are untouched. -->
                        <Grid Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Style="{StaticResource Type.Caption}"
                                       Foreground="{DynamicResource TextTertiary}"
                                       Text="平穩 / calm"/>
                            <TextBlock Grid.Column="1" Style="{StaticResource Type.Caption}"
                                       Foreground="{DynamicResource TextTertiary}"
                                       HorizontalAlignment="Center" TextAlignment="Center"
                                       Text="相對於你的個人閾值 / Relative to your personal threshold"/>
                            <TextBlock Grid.Column="2" Style="{StaticResource Type.Caption}"
                                       Foreground="{DynamicResource TextTertiary}"
                                       Text="高 / high"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ── Profile quick-access (個人化設定檔) ──
                     Compact light pills under the D1 hero. Bound to the SAME
                     SelectProfileCommand contract used by the in-chat profile
                     picker, passing the canonical profile string as the
                     CommandParameter (the command's RelayCommand already accepts
                     a string: `else if (o is string s) OnProfileSelected(s)`).
                     UNCERTAINTY: SelectProfileCommand lives on the per-message
                     ChatMessageViewModel, not on MainViewModel (the Dashboard's
                     DataContext), so this binding does not resolve here at
                     runtime. Per the brief we wire to the existing command with
                     the string parameter rather than invent a new one; surfacing
                     a MainViewModel-level command (or RelayCommand →
                     OnChatbotProfilePickerSelected) would make it live. -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="個人化設定檔 / Profile"
                                   Style="{StaticResource CardLabel}" Margin="0,0,0,8"/>
                        <WrapPanel Orientation="Horizontal">
                            <Button Content="RESILIENT"
                                    Command="{Binding SelectProfileCommand}"
                                    CommandParameter="RESILIENT"
                                    AutomationProperties.Name="設定檔 RESILIENT / Profile RESILIENT"
                                    Margin="0,0,8,0">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource ProfilePill}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CurrentProfile}" Value="RESILIENT">
                                                <Setter Property="Background" Value="{DynamicResource Accent}"/>
                                                <Setter Property="Foreground" Value="White"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <Button Content="TYPICAL"
                                    Command="{Binding SelectProfileCommand}"
                                    CommandParameter="TYPICAL"
                                    AutomationProperties.Name="設定檔 TYPICAL / Profile TYPICAL"
                                    Margin="0,0,8,0">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource ProfilePill}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CurrentProfile}" Value="TYPICAL">
                                                <Setter Property="Background" Value="{DynamicResource Accent}"/>
                                                <Setter Property="Foreground" Value="White"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <Button Content="SENSITIVE"
                                    Command="{Binding SelectProfileCommand}"
                                    CommandParameter="SENSITIVE"
                                    AutomationProperties.Name="設定檔 SENSITIVE / Profile SENSITIVE"
                                    Margin="0">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource ProfilePill}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CurrentProfile}" Value="SENSITIVE">
                                                <Setter Property="Background" Value="{DynamicResource Accent}"/>
                                                <Setter Property="Foreground" Value="White"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <!-- ── Advanced (demoted raw telemetry — bindings byte-identical) ── -->
                <Expander Header="進階數據 / Advanced" IsExpanded="False" Margin="0,0,0,16"
                          Foreground="{DynamicResource TextSecondary}">
                <StackPanel>
                <TextBlock Style="{StaticResource Type.Caption}" Foreground="{DynamicResource TextTertiary}"
                           TextWrapping="Wrap" Margin="0,8,0,0"
                           Text="開發/診斷用的原始數據,日常使用不需查看 / Raw diagnostic values — not needed for everyday use."/>
                <!-- ── Status Cards ── -->
                <UniformGrid Rows="1" Columns="4" Margin="0,12,0,0">

                    <!-- OFI -->
                    <Border Style="{StaticResource Card}" Margin="0,0,12,0">
                        <StackPanel>
                            <TextBlock Text="Optical Flow Index" Style="{StaticResource CardLabel}"/>
                            <TextBlock Text="{Binding OpticalFlowIndex, StringFormat='{}{0:F1}'}"
                                       Style="{StaticResource CardValue}"/>
                            <ProgressBar Value="{Binding OpticalFlowIndex}" Maximum="150"
                                         Height="4" Background="{DynamicResource SurfaceMuted}" Foreground="{DynamicResource Accent}"
                                         BorderThickness="0" Margin="0,4,0,0"/>
                            <TextBlock Text="/ 150" Style="{StaticResource CardLabel}" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- VIMS Pressure -->
                    <Border Style="{StaticResource Card}" Margin="0,0,12,0">
                        <StackPanel>
                            <TextBlock Text="VIMS Pressure" Style="{StaticResource CardLabel}"/>
                            <TextBlock Text="{Binding Pressure, StringFormat='{}{0:F1}'}"
                                       Style="{StaticResource CardValue}"/>
                            <ProgressBar Value="{Binding Pressure, Mode=OneWay}" Maximum="200"
                                         Height="4" Background="{DynamicResource ComfortHighWeak}" Foreground="{DynamicResource ComfortHigh}"
                                         BorderThickness="0" Margin="0,4,0,0"/>
                            <TextBlock Text="Leaky Integrator" Style="{StaticResource CardLabel}" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- FOV Radius -->
                    <Border Style="{StaticResource Card}" Margin="0,0,12,0">
                        <StackPanel>
                            <TextBlock Text="FOV Radius" Style="{StaticResource CardLabel}"/>
                            <TextBlock Text="{Binding FovRadiusPercent, StringFormat='{}{0}%'}"
                                       Style="{StaticResource CardValue}"/>
                            <ProgressBar Value="{Binding FovRadiusPercent, Mode=OneWay}" Maximum="100"
                                         Height="4" Background="{DynamicResource SurfaceMuted}" Foreground="{DynamicResource Accent}"
                                         BorderThickness="0" Margin="0,4,0,0"/>
                            <TextBlock Text="Clear zone" Style="{StaticResource CardLabel}" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Current Mode -->
                    <Border Style="{StaticResource Card}" Margin="0">
                        <StackPanel>
                            <TextBlock Text="Current Mode" Style="{StaticResource CardLabel}"/>
                            <TextBlock Text="{Binding Mode}" Style="{StaticResource CardValue}"/>
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                <Ellipse Width="8" Height="8" VerticalAlignment="Center" Margin="0,0,6,0">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Fill" Value="{DynamicResource Separator}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding MaskActive}" Value="True">
                                                    <Setter Property="Fill" Value="{DynamicResource ComfortHigh}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                                <TextBlock>
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource CardLabel}">
                                            <Setter Property="Text" Value="Mask inactive"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding MaskActive}" Value="True">
                                                    <Setter Property="Text" Value="Mask ACTIVE"/>
                                                    <Setter Property="Foreground" Value="{DynamicResource ComfortHigh}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                </UniformGrid>

                <!-- Status strip (FMS / Overlay diagnostics) -->
                <Border Background="{DynamicResource SurfaceMuted}" CornerRadius="{StaticResource Radius.sm}" Padding="12,8" Margin="0,8,0,0">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="FMS Score: " Style="{StaticResource CardLabel}"/>
                            <TextBlock Text="{Binding FmsScore}" Foreground="{DynamicResource TextPrimary}"
                                       FontWeight="Bold" FontSize="12"/>
                            <TextBlock Text="   |   Overlay: " Style="{StaticResource CardLabel}"/>
                            <TextBlock Foreground="{DynamicResource TextPrimary}" FontWeight="Bold" FontSize="12">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="Hidden"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding OverlayVisible}" Value="True">
                                                <Setter Property="Text" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                        <!-- Phase-C nit: diagnostic-hint caption so the relocated FMS
                             strip reads as developer/diagnostic info, not a daily metric. -->
                        <TextBlock Style="{StaticResource Type.Caption}"
                                   Foreground="{DynamicResource TextTertiary}" Margin="0,4,0,0"
                                   Text="診斷數值,日常使用可忽略 / Diagnostic values — safe to ignore in everyday use."/>
                    </StackPanel>
                </Border>
                </StackPanel>
                </Expander>

                <!-- ── Controls ──
                     The manual OFI slider was removed when Demo mode shifted
                     from "user moves slider → fake OFI" to "video plays →
                     real WGC pixel-diff drives OFI". All input now arrives
                     via the live sensing provider (Cursor / WGC) or the
                     Setup Demo calibration video. OpticalFlowIndex remains
                     read-only on the dashboard's stat card above. -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="Controls" Style="{StaticResource SectionTitle}"/>

                        <!-- Action buttons -->
                        <TextBlock Text="Demo &amp; Overlay"
                                   Style="{StaticResource CardLabel}" Margin="0,0,0,10"/>
                        <WrapPanel Orientation="Horizontal">
                            <!-- Consolidated demo entry point. Always runs the
                                 calibration variant (video → summary → preset
                                 suggestion). For repeat runs the user's "add on
                                 top" preset mode means new deltas accumulate on
                                 the existing personalization rather than wiping
                                 it. The legacy plain-demo button (StartDemo
                                 without calibration) was removed — it had no
                                 use case once calibration is the default flow. -->
                            <Button Content="Calibration &amp; Demo" Style="{StaticResource PrimaryBtn}"
                                    Command="{Binding StartSetupDemoCommand}"
                                    ToolTip="Plays a 60 s vection clip, then suggests a personalised preset based on your reaction. Re-running adds to existing preferences."
                                    Margin="0,0,8,8"/>
                            <!-- Quest 2 塊 A (UI Consolidation Sprint, 2026-05-30):
                                 Stop Demo hidden via Visibility="Collapsed". Demos
                                 already auto-end (video clip → OnDemoVideoFinished,
                                 synthetic ramp → OFI=150). Mid-discomfort interrupt
                                 path preserved via Reset State (which calls
                                 if (IsRunning) StopDemo() before reset) AND via
                                 closing the demo video window X (also triggers
                                 OnDemoVideoFinished). Wellbeing: user retains
                                 explicit interrupt for "I feel discomfort, stop now". -->
                            <Button Content="Stop Demo" Style="{StaticResource AlertBtn}"
                                    Command="{Binding StopDemoCommand}"
                                    Visibility="Collapsed"
                                    Margin="0,0,8,8"/>
                            <!-- Quest 2 塊 A: Toggle Overlay button removed —
                                 the "保持遮罩開啟 / Keep overlay visible" checkbox
                                 below is the discoverable primary control + has
                                 bilingual explanation. Demo auto-enables overlay
                                 anyway. ToggleOverlayCommand binding still exists
                                 on MainViewModel for any programmatic invocations. -->
                            <Button Content="Reset State" Style="{StaticResource AlertBtn}"
                                    Command="{Binding ResetStateCommand}"
                                    Margin="0,0,8,8"/>
                            <!-- Phase 5 Steps 5-6 (v0.11, 2026-05-31): manual
                                 'Switch Driver / Passenger' button removed.
                                 UserActivityModeDetector (Win32 GetLastInputInfo,
                                 1 Hz, asymmetric hysteresis 2500/5000 ms) is the
                                 sole mode source. Current mode visible in the
                                 status row below via {Binding AutoModeText}. -->
                            <!-- Cycle Sensing Mode button removed (Quest 2 塊 A,
                                 2026-05-30). Was already Visibility="Collapsed"
                                 since Path Z UX iter 2; Cursor mode unused, Demo
                                 mode only entered via Calibration flow. Binding
                                 ToggleDemoModeCommand kept on MainViewModel for
                                 any programmatic test invocations. -->
                        </WrapPanel>

                        <!-- ── Always-on Overlay (issue #4) ──────────────────────────────
                             Forces the FOV mask to stay visible at a user-chosen baseline
                             intensity. Natural pressure-driven tier still wins when higher,
                             so real motion still darkens the periphery further. -->
                        <Separator Background="{DynamicResource Separator}" Margin="0,16"/>
                        <TextBlock Text="保持開啟 / Always-on Overlay"
                                   Style="{StaticResource CardLabel}" Margin="0,0,0,8"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <CheckBox IsChecked="{Binding PersistentOverlayEnabled}"
                                          Content="保持遮罩開啟 / Keep overlay visible"
                                          FontSize="12" Foreground="{DynamicResource TextPrimary}"
                                          VerticalContentAlignment="Center"/>
                                <TextBlock Margin="22,2,0,0" Style="{StaticResource CardLabel}"
                                           Text="顯示器周邊維持暗角；偵測到動態時自動加深 / Periphery stays dim; darkens on detected motion."/>
                            </StackPanel>
                        </Grid>
                        <Grid Margin="0,8,0,0" IsEnabled="{Binding PersistentOverlayEnabled}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="基準強度 / Baseline intensity"
                                       Style="{StaticResource CardLabel}"
                                       VerticalAlignment="Center" Margin="0,0,12,0"/>
                            <Slider Grid.Column="1"
                                    Value="{Binding PersistentOverlayBaselineTier, UpdateSourceTrigger=PropertyChanged}"
                                    Minimum="1" Maximum="10" TickFrequency="1"
                                    IsSnapToTickEnabled="True"
                                    VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="2"
                                       Text="{Binding PersistentOverlayBaselineTier, StringFormat='L{0}'}"
                                       Foreground="{DynamicResource TextPrimary}" FontWeight="Bold"
                                       Width="36" TextAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Grid>

                        <Separator Background="{DynamicResource Separator}" Margin="0,16"/>
                        <TextBlock Text="再適應 Habituation Engine"
                                   Style="{StaticResource CardLabel}" Margin="0,0,0,8"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <ProgressBar Value="{Binding HabituationLevel, Mode=OneWay}" Maximum="100"
                                             Height="6" Background="{DynamicResource SurfaceMuted}" Foreground="{DynamicResource ComfortSteady}"
                                             BorderThickness="0"/>
                                <TextBlock Margin="0,4,0,0" Style="{StaticResource CardLabel}"
                                           Text="{Binding HabituationLevel, StringFormat='再適應進度 Progress: {0}%'}"/>
                            </StackPanel>
                            <Button Grid.Column="1" Style="{StaticResource GhostBtn}"
                                    Margin="12,0,0,0" VerticalAlignment="Center"
                                    Content="{Binding HabituationButtonText}"
                                    Command="{Binding ToggleHabituationCommand}"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Display Comfort (顯示器舒適) UI card removed at v0.11
                     (UI Consolidation Sprint Phase 4) — feature decommissioned.
                     See CHANGELOG.md v0.11 "Removed". -->

                <!-- Event Log relocated to its own TabItem ("事件記錄 / Event Log",
                     after Eye-Protection) per the Crisp Cool refresh. -->

            </StackPanel>
        </ScrollViewer>
            </TabItem>

            <!-- ── Tab 2: Eye-Protection Statistics ── -->
            <TabItem Header="護眼 / Eye Care">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="24,20,24,24">

                        <!-- H4 (audit): D1 comfort hero — leads the Eye-Protection
                             tab with the same calm, plain-language status as the
                             Dashboard instead of a raw-telemetry dump. Same
                             read-only converters + Comfort* tokens. -->
                        <Border Background="{DynamicResource Surface}" CornerRadius="{StaticResource Radius.md}"
                                BorderBrush="{DynamicResource Separator}" BorderThickness="1"
                                Padding="{StaticResource Pad.CardAll}" Effect="{StaticResource Elev.2}"
                                Margin="0,0,0,16"
                                AutomationProperties.Name="{Binding VimsTier, Converter={StaticResource TierToHeadline}, Mode=OneWay}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource Type.Title}"
                                           Text="{Binding VimsTier, Converter={StaticResource TierToSubline}, Mode=OneWay}"/>
                                <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                                    <Border CornerRadius="{StaticResource Radius.pill}" Padding="12,5" Margin="0,0,8,0"
                                            BorderThickness="1.5">
                                        <Border.Style>
                                            <!-- C3 (a11y): full-band-colour 1.5px border so the
                                                 chip is distinguishable without the near-invisible
                                                 Weak fill alone (colour-not-only). BorderBrush
                                                 mirrors the existing Background DataTrigger pattern;
                                                 Weak fills stay as the Background. -->
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="{DynamicResource ComfortSteadyWeak}"/>
                                                <Setter Property="BorderBrush" Value="{DynamicResource ComfortSteady}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding VimsTier, Converter={StaticResource TierToComfortBand}}" Value="Rising">
                                                        <Setter Property="Background" Value="{DynamicResource ComfortRisingWeak}"/>
                                                        <Setter Property="BorderBrush" Value="{DynamicResource ComfortRising}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding VimsTier, Converter={StaticResource TierToComfortBand}}" Value="High">
                                                        <Setter Property="Background" Value="{DynamicResource ComfortHighWeak}"/>
                                                        <Setter Property="BorderBrush" Value="{DynamicResource ComfortHigh}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding VimsTier, Converter={StaticResource TierToComfortLabel}, Mode=OneWay}"
                                                   FontSize="12" FontWeight="SemiBold"
                                                   AutomationProperties.Name="Comfort band">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{DynamicResource ComfortSteadyText}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding VimsTier, Converter={StaticResource TierToComfortBand}}" Value="Rising">
                                                            <Setter Property="Foreground" Value="{DynamicResource ComfortRisingText}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding VimsTier, Converter={StaticResource TierToComfortBand}}" Value="High">
                                                            <Setter Property="Foreground" Value="{DynamicResource ComfortHighText}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                    <Border CornerRadius="{StaticResource Radius.pill}" Padding="12,5"
                                            Background="{DynamicResource SurfaceMuted}">
                                        <TextBlock Text="{Binding Mode}" FontSize="12"
                                                   Foreground="{DynamicResource TextSecondary}"/>
                                    </Border>
                                </StackPanel>
                                <ProgressBar Value="{Binding DisplayStressPercent, Mode=OneWay}" Maximum="100"
                                             Height="6" Margin="0,16,0,0" BorderThickness="0"
                                             Background="{DynamicResource SurfaceMuted}"
                                             AutomationProperties.Name="Comfort level">
                                    <ProgressBar.Style>
                                        <Style TargetType="ProgressBar">
                                            <Setter Property="Foreground" Value="{DynamicResource ComfortSteady}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding VimsTier, Converter={StaticResource TierToComfortBand}}" Value="Rising">
                                                    <Setter Property="Foreground" Value="{DynamicResource ComfortRising}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding VimsTier, Converter={StaticResource TierToComfortBand}}" Value="High">
                                                    <Setter Property="Foreground" Value="{DynamicResource ComfortHigh}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ProgressBar.Style>
                                </ProgressBar>

                                <!-- ComfortMeter legend (a11y): persistent caption +
                                     low/high endpoint hints so the meter reads without
                                     colour alone. Binding/Max above are untouched. -->
                                <Grid Margin="0,4,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Style="{StaticResource Type.Caption}"
                                               Foreground="{DynamicResource TextTertiary}"
                                               Text="平穩 / calm"/>
                                    <TextBlock Grid.Column="1" Style="{StaticResource Type.Caption}"
                                               Foreground="{DynamicResource TextTertiary}"
                                               HorizontalAlignment="Center" TextAlignment="Center"
                                               Text="相對於你的個人閾值 / Relative to your personal threshold"/>
                                    <TextBlock Grid.Column="2" Style="{StaticResource Type.Caption}"
                                               Foreground="{DynamicResource TextTertiary}"
                                               Text="高 / high"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- H4 (audit): the raw 5-column live metrics demoted into a
                             collapsed Advanced expander — the hero above carries the
                             calm at-a-glance status. Bindings byte-identical. -->
                        <Expander Header="進階即時數據 / Advanced — live metrics" IsExpanded="False" Margin="0,0,0,16"
                                  Visibility="Collapsed"><!-- advanced telemetry lives on the Dashboard only -->
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <UniformGrid Rows="1" Columns="5">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="{Binding OpticalFlowIndex, StringFormat='{}{0:F1}'}"
                                                   Foreground="{DynamicResource TextPrimary}" FontWeight="Bold" FontSize="22"
                                                   HorizontalAlignment="Center"/>
                                        <TextBlock Text="Optical Flow" Style="{StaticResource CardLabel}"
                                                   HorizontalAlignment="Center"/>
                                    </StackPanel>
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="{Binding Pressure, StringFormat='{}{0:F1}'}"
                                                   Foreground="{DynamicResource TextPrimary}" FontWeight="Bold" FontSize="22"
                                                   HorizontalAlignment="Center"/>
                                        <TextBlock Text="VIMS Pressure" Style="{StaticResource CardLabel}"
                                                   HorizontalAlignment="Center"/>
                                    </StackPanel>
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Foreground="{DynamicResource TextPrimary}" FontWeight="Bold" FontSize="22"
                                                   HorizontalAlignment="Center">
                                            <Run Text="{Binding VimsTier, Mode=OneWay}"/><Run Text=" / 12"/>
                                        </TextBlock>
                                        <TextBlock Text="VIMS Tier" Style="{StaticResource CardLabel}"
                                                   HorizontalAlignment="Center"/>
                                    </StackPanel>
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="{Binding FovRadiusPercent, StringFormat='{}{0}%'}"
                                                   Foreground="{DynamicResource TextPrimary}" FontWeight="Bold" FontSize="22"
                                                   HorizontalAlignment="Center"/>
                                        <TextBlock Text="FOV Radius" Style="{StaticResource CardLabel}"
                                                   HorizontalAlignment="Center"/>
                                    </StackPanel>
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Foreground="{DynamicResource TextPrimary}" FontWeight="Bold" FontSize="22"
                                                   HorizontalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="OFF"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding MaskActive}" Value="True">
                                                            <Setter Property="Text" Value="ACTIVE"/>
                                                            <Setter Property="Foreground" Value="{DynamicResource ComfortHigh}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Text="Mask State" Style="{StaticResource CardLabel}"
                                                   HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </UniformGrid>
                                <!-- Cross-component status row: OS-chrome suppression + auto Driver/Passenger -->
                                <Separator Background="{DynamicResource Separator}" Margin="0,12,0,10"/>
                                <UniformGrid Rows="1" Columns="2">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <Ellipse Width="9" Height="9" VerticalAlignment="Center" Margin="0,0,6,0">
                                            <Ellipse.Style>
                                                <!-- Green when idle (no suppression), amber when any chrome event
                                                     is currently suppressing OFI. Default is amber; the trigger
                                                     flips to green when ActivityStatus == "Idle" exactly. -->
                                                <Style TargetType="Ellipse">
                                                    <Setter Property="Fill" Value="{DynamicResource ComfortRising}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding ActivityStatus}" Value="Idle">
                                                            <Setter Property="Fill" Value="{DynamicResource ComfortSteady}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Ellipse.Style>
                                        </Ellipse>
                                        <TextBlock Text="{Binding ActivityStatus}" Style="{StaticResource CardLabel}"
                                                   VerticalAlignment="Center"
                                                   AutomationProperties.Name="OS-chrome activity suppression status"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding AutoModeText}" Style="{StaticResource CardLabel}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               AutomationProperties.Name="Auto driver / passenger mode"/>
                                </UniformGrid>
                            </StackPanel>
                        </Border>
                        </Expander>

                        <!-- Protection-activity chart: the calm GRAPHICAL view the Eye-Care
                             tab is meant to show (restored — Wave 2 over-collapsed it). Plain-
                             language labels only; raw OFI/Pressure NUMBERS stay on the Dashboard. -->
                        <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="防護活動 / Protection activity"
                                           Style="{StaticResource SectionTitle}"/>
                                <TextBlock Text="畫面動態與防護強度的即時軌跡 / Live trace of screen motion and protection"
                                           Style="{StaticResource CardLabel}" Margin="0,0,0,10" TextWrapping="Wrap"/>
                                <Border Background="{DynamicResource SurfaceMuted}" CornerRadius="{StaticResource Radius.sm}" Padding="14,10" Height="280">
                                    <Canvas x:Name="PressureChartCanvas" ClipToBounds="True"/>
                                </Border>
                                <!-- Legend -->
                                <StackPanel Orientation="Horizontal" Margin="2,10,0,0">
                                    <Ellipse Width="8" Height="8" Fill="{DynamicResource TextTertiary}" VerticalAlignment="Center"/>
                                    <TextBlock Text="畫面動態 / Motion" Margin="6,0,16,0" Style="{StaticResource CardLabel}"
                                               VerticalAlignment="Center"/>
                                    <Ellipse Width="8" Height="8" Fill="{DynamicResource Accent}" VerticalAlignment="Center"/>
                                    <TextBlock Text="防護強度 / Protection" Margin="6,0,16,0" Style="{StaticResource CardLabel}"
                                               VerticalAlignment="Center"/>
                                    <Rectangle Width="14" Height="2" Fill="{DynamicResource ComfortHigh}" VerticalAlignment="Center"/>
                                    <TextBlock Text="啟動點 / Activation" Margin="6,0,0,0"
                                               Style="{StaticResource CardLabel}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Session Summary — advanced raw metrics, hidden from the
                             Eye-Care tab (advanced info lives on the Dashboard). -->
                        <Border Style="{StaticResource Card}" Visibility="Collapsed">
                            <StackPanel>
                                <TextBlock Text="本次工作階段 / Session Summary" Style="{StaticResource SectionTitle}"/>
                                <UniformGrid Rows="1" Columns="5">
                                    <StackPanel HorizontalAlignment="Center" Margin="6">
                                        <TextBlock Text="{Binding SessionFovIntercepts}"
                                                   Foreground="{DynamicResource TextPrimary}" FontWeight="Bold" FontSize="26"
                                                   HorizontalAlignment="Center"/>
                                        <TextBlock Text="FOV Intercepts" Style="{StaticResource CardLabel}"
                                                   HorizontalAlignment="Center" TextAlignment="Center"/>
                                    </StackPanel>
                                    <StackPanel HorizontalAlignment="Center" Margin="6">
                                        <TextBlock Text="{Binding SessionPeakOfi, StringFormat='{}{0:F1}'}"
                                                   Foreground="{DynamicResource TextPrimary}" FontWeight="Bold" FontSize="26"
                                                   HorizontalAlignment="Center"/>
                                        <TextBlock Text="Peak Optical Flow" Style="{StaticResource CardLabel}"
                                                   HorizontalAlignment="Center" TextAlignment="Center"/>
                                    </StackPanel>
                                    <StackPanel HorizontalAlignment="Center" Margin="6">
                                        <TextBlock Text="{Binding SessionPeakPressure, StringFormat='{}{0:F1}'}"
                                                   Foreground="{DynamicResource TextPrimary}" FontWeight="Bold" FontSize="26"
                                                   HorizontalAlignment="Center"/>
                                        <TextBlock Text="Peak VIMS Pressure" Style="{StaticResource CardLabel}"
                                                   HorizontalAlignment="Center" TextAlignment="Center"/>
                                    </StackPanel>
                                    <StackPanel HorizontalAlignment="Center" Margin="6">
                                        <TextBlock Text="{Binding SessionMaskActiveText}"
                                                   Foreground="{DynamicResource TextPrimary}" FontWeight="Bold" FontSize="26"
                                                   HorizontalAlignment="Center"/>
                                        <TextBlock Text="Mask Active Time" Style="{StaticResource CardLabel}"
                                                   HorizontalAlignment="Center" TextAlignment="Center"/>
                                    </StackPanel>
                                    <StackPanel HorizontalAlignment="Center" Margin="6">
                                        <TextBlock Text="{Binding SessionUptimeText}"
                                                   Foreground="{DynamicResource TextPrimary}" FontWeight="Bold" FontSize="26"
                                                   HorizontalAlignment="Center"/>
                                        <TextBlock Text="Session Uptime" Style="{StaticResource CardLabel}"
                                                   HorizontalAlignment="Center" TextAlignment="Center"/>
                                    </StackPanel>
                                </UniformGrid>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ── Tab 3: Event Log (relocated from Dashboard) ── -->
            <TabItem Header="事件記錄 / Event Log">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="24,20,24,24">
                        <!-- ── Event Log ── -->
                        <Border Style="{StaticResource Card}">
                            <DockPanel>
                                <Grid DockPanel.Dock="Top" Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Event Log"
                                               Style="{StaticResource SectionTitle}" Margin="0"/>
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding EventLog.Count, StringFormat='Latest {0} entries'}"
                                               Style="{StaticResource CardLabel}" VerticalAlignment="Center"/>
                                </Grid>

                                <ListView ItemsSource="{Binding EventLog}"
                                          Style="{StaticResource LogListView}"
                                          MaxHeight="200">
                                    <ListView.View>
                                        <GridView>
                                            <!-- Raw OFI / Pressure / FOV / Mask columns removed: advanced
                                                 telemetry belongs on the Dashboard, not the Event Log, which
                                                 keeps a plain Time + Action record. -->
                                            <GridViewColumn Header="時間 / Time"   Width="80"
                                                            DisplayMemberBinding="{Binding Time}"/>
                                            <GridViewColumn Header="事件 / Action"  Width="440"
                                                            DisplayMemberBinding="{Binding Message}"/>
                                        </GridView>
                                    </ListView.View>
                                </ListView>
                            </DockPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ── Tab 4: AI Assistant ── -->
            <TabItem Header="智能助理 / AI Assistant">
                <Grid DataContext="{Binding ChatbotVm}" Background="{DynamicResource Canvas}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>  <!-- Recalibrate header (Stage 5b) -->
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>  <!-- Invitation banner (Stage 5a) -->
                        <RowDefinition Height="Auto"/>  <!-- Calibration card (Stage 3d) -->
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Stage 5b: small Recalibrate entry. Right-aligned above the
                         chat history so users can re-enter calibration any time
                         without needing a fresh demo run. -->
                    <Grid Grid.Row="0" Margin="24,16,24,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="1"
                                Content="重新校準 / Recalibrate"
                                Command="{Binding RecalibrateCommand}"
                                Style="{StaticResource GhostBtn}"
                                Padding="14,6" FontSize="12" MinHeight="44"
                                ToolTip="Open the LLM calibration dialog without requiring a fresh demo."/>
                    </Grid>

                    <!-- Chat history -->
                    <Border Grid.Row="1" Margin="24,8,24,8"
                            Background="{DynamicResource Surface}" CornerRadius="{StaticResource Radius.md}" Padding="0"
                            BorderBrush="{DynamicResource Separator}" BorderThickness="1"
                            Effect="{StaticResource Elev.2}">
                        <ScrollViewer x:Name="ChatScroll" VerticalScrollBarVisibility="Auto" Padding="16,12">
                            <ItemsControl ItemsSource="{Binding Messages}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <!-- User bubble (right) -->
                                            <Border Grid.Column="1"
                                                    Visibility="{Binding UserVisibility}"
                                                    Background="{DynamicResource Accent}" CornerRadius="12,12,2,12"
                                                    Padding="12,8" Margin="60,0,0,0" HorizontalAlignment="Right">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Content}"
                                                               FontSize="14" Foreground="{DynamicResource TextOnComfort}"
                                                               TextWrapping="Wrap"/>
                                                    <TextBlock Text="{Binding Timestamp}"
                                                               FontSize="12" Foreground="{DynamicResource TextOnComfort}"
                                                               HorizontalAlignment="Right" Margin="0,4,0,0"/>
                                                </StackPanel>
                                            </Border>
                                            <!-- Assistant bubble (left) -->
                                            <Border Grid.Column="0"
                                                    Grid.ColumnSpan="2"
                                                    Visibility="{Binding AssistantVisibility}"
                                                    Background="{DynamicResource SurfaceMuted}" CornerRadius="12,12,12,2"
                                                    Padding="12,8" Margin="0,0,60,0" HorizontalAlignment="Left">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Author}"
                                                               FontSize="12" Foreground="{DynamicResource Accent}"
                                                               FontWeight="SemiBold" Margin="0,0,0,4"/>

                                                    <!-- Animated typing-dots indicator (visible only when IsTyping=true).
                                                         A 1.0 s storyboard cycles each dot's opacity 0.2 → 1.0 with
                                                         offsets so they pulse left-to-right like the typing UI in
                                                         most chat apps. -->
                                                    <StackPanel Orientation="Horizontal"
                                                                Visibility="{Binding TypingVisibility}"
                                                                Margin="0,2,0,2">
                                                        <StackPanel.Resources>
                                                            <Storyboard x:Key="DotsStoryboard" RepeatBehavior="Forever">
                                                                <DoubleAnimation Storyboard.TargetName="Dot1"
                                                                                 Storyboard.TargetProperty="Opacity"
                                                                                 From="0.2" To="1.0" Duration="0:0:0.25"
                                                                                 AutoReverse="True"/>
                                                                <DoubleAnimation Storyboard.TargetName="Dot2"
                                                                                 Storyboard.TargetProperty="Opacity"
                                                                                 From="0.2" To="1.0" Duration="0:0:0.25"
                                                                                 BeginTime="0:0:0.1" AutoReverse="True"/>
                                                                <DoubleAnimation Storyboard.TargetName="Dot3"
                                                                                 Storyboard.TargetProperty="Opacity"
                                                                                 From="0.2" To="1.0" Duration="0:0:0.25"
                                                                                 BeginTime="0:0:0.2" AutoReverse="True"/>
                                                            </Storyboard>
                                                        </StackPanel.Resources>
                                                        <StackPanel.Triggers>
                                                            <EventTrigger RoutedEvent="StackPanel.Loaded">
                                                                <BeginStoryboard Storyboard="{StaticResource DotsStoryboard}"/>
                                                            </EventTrigger>
                                                        </StackPanel.Triggers>
                                                        <Ellipse x:Name="Dot1" Width="6" Height="6"
                                                                 Fill="{DynamicResource TextPrimary}" Opacity="0.35" Margin="0,0,3,0"/>
                                                        <Ellipse x:Name="Dot2" Width="6" Height="6"
                                                                 Fill="{DynamicResource TextPrimary}" Opacity="0.35" Margin="0,0,3,0"/>
                                                        <Ellipse x:Name="Dot3" Width="6" Height="6"
                                                                 Fill="{DynamicResource TextPrimary}" Opacity="0.35"/>
                                                    </StackPanel>

                                                    <!-- Real reply text: rendered as inline runs by MarkdownInlines
                                                         so the bot can use **bold**, *italic*, `code`, and bullets
                                                         (•) in its replies. Hidden when the typing indicator is up. -->
                                                    <TextBlock Visibility="{Binding ContentVisibility}"
                                                               views:MarkdownInlines.Source="{Binding Content}"
                                                               FontSize="14" Foreground="{DynamicResource TextPrimary}"
                                                               TextWrapping="Wrap"/>

                                                    <!-- Followup option cards. Only visible when the message carries
                                                         FollowupOptions (i.e. the bot wants a structured quick reply).
                                                         The free-text TextBox below still works in parallel, so the
                                                         user is never trapped on the options. -->
                                                    <ItemsControl ItemsSource="{Binding FollowupOptions}"
                                                                  Visibility="{Binding FollowupVisibility}"
                                                                  Margin="0,8,0,0">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate>
                                                                <WrapPanel/>
                                                            </ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Button Content="{Binding}"
                                                                        Command="{Binding DataContext.SelectFollowupCommand,
                                                                                          RelativeSource={RelativeSource AncestorType=ItemsControl, AncestorLevel=1}}"
                                                                        CommandParameter="{Binding}"
                                                                        Style="{StaticResource GhostBtn}"
                                                                        Margin="0,0,8,8"
                                                                        Padding="14,8"
                                                                        FontSize="12" MinHeight="44"/>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>

                                                    <!-- M3 7e+ Profile picker. Each card shows the canonical name
                                                         (bold) and a short description. Click → ProfilePickerSelected
                                                         event → MainViewModel applies via HabituationOverrideApplicator
                                                         (safety intercept + action-log audit). -->
                                                    <ItemsControl ItemsSource="{Binding ProfileOptions}"
                                                                  Visibility="{Binding ProfileOptionsVisibility}"
                                                                  Margin="0,8,0,0">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Button Command="{Binding DataContext.SelectProfileCommand,
                                                                                          RelativeSource={RelativeSource AncestorType=ItemsControl, AncestorLevel=1}}"
                                                                        CommandParameter="{Binding}"
                                                                        Background="{DynamicResource Surface}"
                                                                        BorderBrush="{DynamicResource Separator}"
                                                                        BorderThickness="1"
                                                                        Padding="12,10"
                                                                        Margin="0,0,0,8"
                                                                        MinHeight="44"
                                                                        HorizontalContentAlignment="Stretch"
                                                                        Cursor="Hand">
                                                                    <StackPanel Orientation="Vertical">
                                                                        <TextBlock Text="{Binding Name}"
                                                                                   FontSize="14"
                                                                                   FontWeight="SemiBold"
                                                                                   Foreground="{DynamicResource Accent}"/>
                                                                        <TextBlock Text="{Binding Description}"
                                                                                   FontSize="12"
                                                                                   Foreground="{DynamicResource TextSecondary}"
                                                                                   TextWrapping="Wrap"
                                                                                   Margin="0,4,0,0"/>
                                                                    </StackPanel>
                                                                </Button>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>

                                                    <TextBlock Text="{Binding Timestamp}"
                                                               FontSize="12" Foreground="{DynamicResource TextTertiary}"
                                                               Margin="0,4,0,0"/>
                                                </StackPanel>
                                            </Border>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>

                    <!-- Stage 5a: subsequent-calibration invitation banner.
                         Shown after a demo finishes when the user already has
                         at least one prior calibration. Auto-dismisses after
                         30 s or on either button click. Two actions: Start
                         (opens the LLM dialog) or Skip (silent dismiss). -->
                    <Border Grid.Row="2" Margin="24,0,24,8"
                            CornerRadius="{StaticResource Radius.md}" Padding="20,14"
                            Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Separator}" BorderThickness="1"
                            Effect="{StaticResource Elev.2}"
                            Visibility="{Binding ShowCalibrationInvitationBanner, Converter={StaticResource BoolToVis}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="想更新你的設定嗎？跟系統聊聊剛才的感覺。"
                                           Foreground="{DynamicResource TextPrimary}" FontSize="14" FontWeight="SemiBold"
                                           TextWrapping="Wrap"/>
                                <TextBlock Text="Want to refresh your settings? Chat about what you just felt."
                                           Foreground="{DynamicResource TextSecondary}" FontSize="12"
                                           TextWrapping="Wrap" Margin="0,4,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal"
                                        VerticalAlignment="Center" Margin="16,0,0,0">
                                <Button Content="跳過 / Skip"
                                        Command="{Binding SkipCalibrationInvitationCommand}"
                                        Background="{DynamicResource SurfaceMuted}" Foreground="{DynamicResource TextSecondary}"
                                        BorderThickness="0"
                                        Padding="14,6" FontSize="12" Cursor="Hand"
                                        Template="{StaticResource RoundBtn}"
                                        Margin="0,0,8,0"/>
                                <Button Content="開始 calibration / Start calibration"
                                        Command="{Binding StartInvitedCalibrationCommand}"
                                        Background="{DynamicResource Accent}" Foreground="White"
                                        BorderThickness="0"
                                        Padding="14,6" FontSize="12" FontWeight="SemiBold" Cursor="Hand"
                                        Template="{StaticResource RoundBtn}"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Calibration card host (Stage 3d).
                         Visible only when IsCalibrationCardActive == true.
                         DataContext flows to the inner ContentPresenter via
                         ActiveCalibrationCard binding so the card sees its
                         own CalibrationCardViewModel rather than ChatbotVm. -->
                    <Border Grid.Row="3" Margin="24,0,24,8"
                            Visibility="{Binding IsCalibrationCardActive, Converter={StaticResource BoolToVis}}">
                        <views:CalibrationCardView DataContext="{Binding ActiveCalibrationCard}"/>
                    </Border>

                    <!-- Status bar -->
                    <Border Grid.Row="4" Margin="24,0,24,8"
                            Background="{DynamicResource Surface}" CornerRadius="{StaticResource Radius.sm}" Padding="14,7"
                            BorderBrush="{DynamicResource Separator}" BorderThickness="1"
                            Effect="{StaticResource Elev.2}">
                        <TextBlock Text="{Binding StatusText}"
                                   FontSize="12" Foreground="{DynamicResource TextTertiary}" TextWrapping="Wrap"
                                   AutomationProperties.Name="AI assistant status"/>
                    </Border>

                    <!-- Input row -->
                    <Grid Grid.Row="5" Margin="24,0,24,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Background="{DynamicResource Surface}" CornerRadius="{StaticResource Radius.sm}"
                                Padding="2" Margin="0,0,8,0"
                                BorderBrush="{DynamicResource Separator}" BorderThickness="1"
                                Effect="{StaticResource Elev.2}">
                            <TextBox Text="{Binding InputText, UpdateSourceTrigger=PropertyChanged}"
                                     Padding="10,8" BorderThickness="0" Background="Transparent"
                                     FontSize="14" Foreground="{DynamicResource TextPrimary}"
                                     AcceptsReturn="False" VerticalContentAlignment="Center">
                                <TextBox.InputBindings>
                                    <KeyBinding Key="Return" Command="{Binding SendCommand}"/>
                                </TextBox.InputBindings>
                            </TextBox>
                        </Border>
                        <Button Grid.Column="1"
                                Content="Send" Style="{StaticResource PrimaryBtn}"
                                Command="{Binding SendCommand}" Margin="0,0,8,0" MinHeight="44"/>
                        <Button Grid.Column="2"
                                Content="Clear" Style="{StaticResource GhostBtn}"
                                Command="{Binding ClearCommand}" MinHeight="44"/>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- ── Tab 4: Settings (UI Consolidation Sprint M-Phase-1, 2026-05-30) ──
                 Hosts the shared SettingsContent UserControl. State is
                 shared with SettingsWindow (tray menu / Pop-up Card gear)
                 via static UserPreferences.Current + AppConfig.* singletons
                 + the UserPreferences.Changed event for visual sync.
                 Phase 1.5 user feedback: tab background follows the main
                 console light palette (the Canvas token), not the dark
                 Pop-up sprint theme. -->
            <TabItem Header="設定 / Settings">
                <Grid Background="{DynamicResource Canvas}">
                    <views:SettingsContent x:Name="SettingsTabContent"/>
                </Grid>
            </TabItem>

        </TabControl>

    </DockPanel>
</Window>
