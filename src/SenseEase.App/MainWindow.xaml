<Window x:Class="SenseEase.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:SenseEase.App.Views"
        xmlns:conv="clr-namespace:SenseEase.App.Converters"
        xmlns:loc="clr-namespace:SenseEase.App.Localization"
        Title="{loc:T Zh='SenseEase — 視覺舒適儀表板', En='SenseEase — Visual Comfort Dashboard'}"
        Icon="pack://application:,,,/SenseEase.App;component/Resources/AppIcon.ico"
        Height="820" Width="1160"
        MinHeight="700" MinWidth="980"
        Background="{DynamicResource Canvas}"
        FontFamily="Segoe UI">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- D0 design tokens, merged VIEW-LOCALLY (never App.Resources) so
                     MainWindowSmokeTests' bare new Application() still resolves
                     {StaticResource} at construction time. -->
                <ResourceDictionary Source="pack://application:,,,/SenseEase.App;component/Theme/SenseEaseTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>

        <!-- Standard bool -> Visibility converter for the first-run welcome
             banner. Lives in Window.Resources (not App.Resources) so the
             MainWindowSmokeTests can construct the window without booting the
             Application object — App.Resources is unset in that path and the
             StaticResource lookup would fail. -->
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- D1 comfort converters (view-local; read-only tier→copy/band).
             DEAD-08: TierToSubline/TierToComfortLabel resource keys removed —
             their backing converters were deleted (zero consumers; never bound). -->
        <conv:TierToHeadlineConverter     x:Key="TierToHeadline"/>
        <conv:TierToComfortBandConverter  x:Key="TierToComfortBand"/>
        <conv:TierToFeelLabelConverter    x:Key="TierToFeelLabel"/>
        <conv:TierToFillPercentConverter  x:Key="TierToFillPercent"/>

        <!-- UX-06: auto Driver/Passenger mode token → calm plain protection label,
             live on language. Replaces the bare {Binding Mode} on the hero pill. -->
        <conv:ModeToProtectionLabelConverter   x:Key="ModeToProtectionLabel"/>
        <!-- UX-06: localized mask-state / overlay-visibility labels for the Advanced
             expander (a Setter.Value can't hold a {loc:T} Binding, so these build the
             localized text from the bound bool + language). -->
        <conv:MaskStateLabelConverter          x:Key="MaskStateLabel"/>
        <conv:OverlayVisibilityLabelConverter  x:Key="OverlayVisibilityLabel"/>
        <!-- Honest FOV-card hint: the 清晰區 caption gains （含個人化 −N） when the user's
             persisted chatbot FOV personalization (UserFovOffsetPp < 0) is why the resting
             clear-zone reads below the natural baseline. Offset + Language inputs ⇒ live-flips
             on language toggle, same MultiBinding pattern as the labels above. -->
        <conv:FovClearZoneCaptionConverter     x:Key="FovClearZoneCaption"/>

        <!-- ── Card ──
             Clean rounded surface (myHP / HP Smart look): Radius.md corner,
             generous Pad.CardAll padding, soft Elev.2 shadow, plus a hairline
             Separator border so the card keeps definition in BOTH themes
             (critical for dark, where a borderless white-on-white card vanishes). -->
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Surface}"/>
            <Setter Property="CornerRadius" Value="{StaticResource Radius.md}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Separator}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="{StaticResource Pad.CardAll}"/>
            <Setter Property="Effect" Value="{StaticResource Elev.2}"/>
        </Style>

        <!-- ── Button template (rounded) ── -->
        <ControlTemplate x:Key="RoundBtn" TargetType="Button">
            <Border x:Name="Bd" Background="{TemplateBinding Background}"
                    CornerRadius="6" Padding="{TemplateBinding Padding}">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="Bd" Property="Opacity" Value="0.86"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter TargetName="Bd" Property="Opacity" Value="0.72"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter TargetName="Bd" Property="Opacity" Value="0.38"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <Style x:Key="PrimaryBtn" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource Accent}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="22,10"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{DynamicResource FocusVisible}"/>
            <Setter Property="Template" Value="{StaticResource RoundBtn}"/>
        </Style>

        <!-- UX-21/B2 (2026-06-11): the orphaned AlertBtn style was deleted here (zero
             usages — grep over *.cs/*.xaml found only its own declaration; B1b removed
             its last consumer). The DesignLint ratchet counts inline hex only, not named
             styles, so no ratchet change is needed. -->

        <Style x:Key="GhostBtn" TargetType="Button" BasedOn="{StaticResource PrimaryBtn}">
            <Setter Property="Background" Value="{DynamicResource SurfaceMuted}"/>
            <!-- UX-11: AccentHover (#3552D9) on SurfaceMuted clears WCAG AA 4.5:1;
                 plain Accent (#4B6EF5) measured 3.76:1 — see TokenContrastTests. -->
            <Setter Property="Foreground" Value="{DynamicResource AccentHover}"/>
        </Style>

        <!-- UX-18 / D-3 (2026-06-11): the orphaned ProfilePill style was deleted here
             (zero usages — the dashboard profile-pill card was removed 2026-06-09 and
             profiles are now auto-managed). SelectProfileCommand / CurrentProfile stay
             on the VM for tests; this presentation-only style had no consumer. -->

        <!-- ── Text styles ── -->
        <Style x:Key="CardLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextTertiary}"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <Style x:Key="CardValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="32"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="Margin" Value="0,4,0,2"/>
        </Style>

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>

        <!-- ── ListView ──
             UX-21/B2 (2026-06-11): the orphaned LogListView style was deleted here (zero
             usages — the Event Log moved to its own EventLogWindow, which styles its list
             inline; grep found only this declaration + a stale comment reference in
             EventLogWindow.xaml). The DesignLint ratchet counts inline hex only, so no
             ratchet change is needed. -->

        <!-- C cleanup (2026-06-15): the orphaned implicit GridViewColumnHeader style was deleted
             here — MainWindow has no GridView/ListView (the Event Log moved to EventLogWindow,
             which carries its own copy of this style inline). It styled nothing. -->

        <!-- C2 (audit): shared keyboard-focus ring. Implicit styles reach every
             unstyled focusable control; the explicit button styles carry it via
             PrimaryBtn's own FocusVisualStyle setter (Alert/Ghost inherit it via
             BasedOn). Only the FocusVisualStyle property is set, so the default
             control templates and all other styling are untouched. -->
        <Style TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{DynamicResource FocusVisible}"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="FocusVisualStyle" Value="{DynamicResource FocusVisible}"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="FocusVisualStyle" Value="{DynamicResource FocusVisible}"/>
        </Style>

        <!-- Phase-1 rev: formal 5-point survey button for the in-console check-in overlay (and the
             2-option consent card). Instantiated in code-behind; theme-consistent (SurfaceMuted +
             Separator hairline, hover → Separator fill, themed focus ring). Labels only, no emoji. -->
        <Style x:Key="CheckInOptionButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource SurfaceMuted}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Separator}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="6,8"/>
            <Setter Property="Margin" Value="3,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{DynamicResource FocusVisible}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{StaticResource Radius.sm}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Separator}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        </ResourceDictionary>
    </Window.Resources>

    <!-- Phase-1 rev: root wrapped in a Grid so the in-console check-in overlay (CheckInOverlayHost,
         at the end of this Grid) can render ON TOP of the dashboard content without a separate window. -->
    <Grid>
    <DockPanel>

        <!-- ══════════ UX-13: FIRST-RUN WELCOME STRIP ══════════
             One-time, dismissible, plain-language card answering "Am I protected?".
             Keyed off the EXISTING AppConfig.IsFirstRun flag (its designed use) via the
             VM's FirstRunStripVisibility; Dismiss calls MarkFirstRunComplete so it never
             shows again. Sequenced BEFORE the vestibular prompt bar: while this strip is
             visible the vestibular bar is held back (VestibularPromptVisibility ANDs in
             "first-run dismissed"), so a fresh user sees framing first, not a bare
             medical-adjacent question. Reduce-Motion-safe (no entrance animation). Theme
             tokens only; ≥12px (body 14, caption 12). -->
        <Border DockPanel.Dock="Top"
                Visibility="{Binding FirstRunStripVisibility}"
                Background="{DynamicResource SurfaceMuted}"
                BorderBrush="{DynamicResource Separator}" BorderThickness="0,0,0,1"
                Padding="28,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock FontSize="14" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimary}"
                               Text="{loc:T Zh='歡迎使用 SenseEase — 您已受到保護', En='Welcome to SenseEase — you are protected'}"/>
                    <TextBlock FontSize="14" TextWrapping="Wrap" Margin="0,6,0,0"
                               Foreground="{DynamicResource TextSecondary}"
                               Text="{loc:T Zh='SenseEase 會在背景偵測畫面動態，並自動將周邊輕微調暗，幫助減緩視覺不適。', En='SenseEase watches screen motion in the background and gently dims the edges to ease visual discomfort.'}"/>
                    <TextBlock FontSize="12" TextWrapping="Wrap" Margin="0,6,0,0"
                               Foreground="{DynamicResource TextTertiary}"
                               Text="{loc:T Zh='關閉視窗會縮到系統匣繼續運作（不會結束程式）；所有選項都在「設定」分頁。', En='Closing the window minimizes it to the tray and keeps running (close is not quit). All options live in the Settings tab.'}"/>
                </StackPanel>
                <Button Grid.Column="1" VerticalAlignment="Center" Margin="20,0,0,0"
                        Content="{loc:T Zh='開始使用', En='Get started'}"
                        Command="{Binding DismissFirstRunCommand}"
                        Background="{DynamicResource Accent}" Foreground="White" BorderThickness="0"
                        Padding="20,9" FontSize="13" FontWeight="SemiBold" Cursor="Hand"
                        Template="{StaticResource RoundBtn}"
                        AutomationProperties.Name="{loc:T Zh='開始使用 SenseEase', En='Get started with SenseEase'}"/>
            </Grid>
        </Border>

        <!-- Alpha-2 addendum: one-time vestibular first-use prompt (auto-profiling world).
             Non-blocking bottom bar; hidden unless AutoProfilingEnabled AND not-yet-answered.
             "Asked once" — answering (Yes / No) marks it answered; closing the app without
             interacting reshows it next launch. §6 non-medical wording (asks about a
             diagnosis, makes no clinical claim). Permanently changeable later in Settings. -->
        <Border DockPanel.Dock="Bottom"
                Visibility="{Binding VestibularPromptVisibility}"
                Background="{DynamicResource SurfaceMuted}"
                BorderBrush="{DynamicResource Separator}" BorderThickness="0,1,0,0"
                Padding="24,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" VerticalAlignment="Center" TextWrapping="Wrap"
                           Foreground="{DynamicResource TextSecondary}" FontSize="12"
                           Text="{loc:T Zh='是否有前庭/眩暈相關診斷？（可略過，日後可於設定調整）', En='Do you have a vestibular / dizziness-related diagnosis? (Optional — you can change this later in Settings.)'}"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                    <Button Content="{loc:T Zh='是', En='Yes'}"
                            Command="{Binding VestibularPromptYesCommand}"
                            Background="{DynamicResource Accent}" Foreground="White" BorderThickness="0"
                            Padding="16,6" FontSize="12" FontWeight="SemiBold" Cursor="Hand"
                            Template="{StaticResource RoundBtn}" Margin="0,0,8,0"/>
                    <Button Content="{loc:T Zh='否 / 略過', En='No / Skip'}"
                            Command="{Binding VestibularPromptNoCommand}"
                            Background="{DynamicResource SurfaceMuted}" Foreground="{DynamicResource TextSecondary}"
                            BorderThickness="0" Padding="16,6" FontSize="12" Cursor="Hand"
                            Template="{StaticResource RoundBtn}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ══════════ HEADER ══════════ -->
        <Border DockPanel.Dock="Top" Background="{DynamicResource HeaderSurface}"
                BorderBrush="{DynamicResource Separator}" BorderThickness="0,0,0,1" Padding="28,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <!-- Subtitle removed entirely (zh+en) per Kirby ruling 2026-06-11. -->
                    <TextBlock Text="SenseEase"
                               FontSize="22" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Sensing-mode badge ("● SCREEN CAPTURE" / "DEMO MODE") removed per UI
                         audit (2026-06-09): it surfaced an internal capture-mode detail with no
                         user value, and was English-only in both languages. The VM's
                         SensingModeLabel property is left intact (harmless; no longer shown). -->

                    <!-- HP co-brand mark. Dark-mode fix (2026-06-09): the asset is the blue
                         HP roundel on a WHITE background, and the old white chip rendered as
                         an "absurd" bright square in Dark mode. The roundel is self-contained
                         (its white "hp" cut-outs read fine on the blue circle in any theme), so
                         we drop the chip entirely and CLIP the image to a circle — only the blue
                         roundel shows, clean on light OR dark. The ImageBrush Viewbox crops the
                         JPG's thin white margin so no white ring survives at the circle edge. -->
                    <Ellipse Width="28" Height="28" VerticalAlignment="Center" Margin="12,0,0,0"
                             ToolTip="{loc:T Zh='專為 HP 筆電設計', En='Designed for HP laptops'}">
                        <Ellipse.Fill>
                            <ImageBrush ImageSource="pack://application:,,,/SenseEase.App;component/Resources/hp-logo.jpg"
                                        Stretch="UniformToFill"
                                        Viewbox="0.05,0.05,0.90,0.90"/>
                        </Ellipse.Fill>
                    </Ellipse>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ══════════ TABS ══════════ -->
        <TabControl x:Name="MainTabs" Background="{DynamicResource Surface}" BorderThickness="0" Padding="0"
                    SelectionChanged="MainTabs_SelectionChanged">
            <TabControl.Resources>
                <Style TargetType="TabItem">
                    <Setter Property="FontSize" Value="13"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                    <Setter Property="Foreground" Value="{DynamicResource TextTertiary}"/>
                    <Setter Property="Padding" Value="20,10"/>
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="BorderThickness" Value="0"/>
                    <!-- M5 (a11y): non-colour-only active-tab cue. The template adds a
                         2px bottom underline that the IsSelected trigger paints Accent,
                         so the selected tab is distinguishable without relying on the
                         Foreground colour change alone. Header/Padding flow through the
                         TemplateBinding unchanged — tab sizes/labels are untouched. -->
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="TabItem">
                                <Border x:Name="TabBd" Background="{TemplateBinding Background}"
                                        BorderBrush="Transparent" BorderThickness="0,0,0,2">
                                    <ContentPresenter ContentSource="Header"
                                                      Margin="{TemplateBinding Padding}"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="TabBd" Property="BorderBrush"
                                                Value="{DynamicResource Accent}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                    <Style.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </TabControl.Resources>

            <!-- Tab 1 (儀表板 / Dashboard) REMOVED in the dashboard dismantle (Stage 1, 2026-06-21):
                 the comfort hero + ComfortMeter + Advanced raw telemetry + overlay-settings card. The
                 overlay Keep-visible / baseline controls are re-homed to the quick-settings flyout +
                 popup bar slider (PersistentOverlayEnabled / PersistentOverlayBaselineTier, same engine
                 path); the raw-telemetry / ActivityStatus diagnostics are dev-only and dropped. The VM
                 properties (VimsTier, OpticalFlowIndex, Pressure, Mode, ActivityStatus, …) are unchanged
                 and still drive the popup bar / overlay / tray. -->

            <!-- ── Tab: Eye-Protection Statistics (護眼 / Eye Care) — KEPT (Stage 2, gated on the health report) ── -->
            <TabItem x:Name="EyeCareTab" Header="{loc:T Zh='護眼', En='Eye Care'}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Style="{DynamicResource AutoHideScroll}">
                    <StackPanel Margin="24,20,24,24">

                        <!-- Phase-2 (2026-06-16): the comfort-hero card was REMOVED here — it
                             duplicated the Dashboard tab's hero (Kirby). The Eye-Care tab now leads
                             with the check-in card below. -->

                        <!-- Phase-2 (2026-06-16): "my check-ins" — the in-app review home for the
                             event-driven FMS feedback, organized into the Eye Care tab (the "選單").
                             Trend + recent check-ins + a manual check-in. NOT a floating window and
                             NOT an always-on dashboard solicitation — you navigate here to review. -->
                        <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="{loc:T Zh='我的感受紀錄', En='My check-ins'}"
                                           Style="{StaticResource SectionTitle}"/>
                                <TextBlock x:Name="EyeCareTrendText" Style="{StaticResource CardLabel}"
                                           TextWrapping="Wrap" Margin="0,0,0,14"/>

                                <!-- DYNAMIC self-report: the question + 5-point options show ONLY when a
                                     check-in is warranted (first time / 30-min cooldown elapsed / the
                                     motion tier changed since the last log = "update needed"). After a
                                     tap the card RESTS (options hidden) to prevent surge/duplicate input
                                     + confusion — paced EMA-style. Toggled in RefreshEyeCareCheckIns. -->
                                <StackPanel x:Name="EyeCareInlinePrompt">
                                    <TextBlock Text="{loc:T Zh='你現在的感受如何？', En='How are you feeling right now?'}"
                                               Style="{StaticResource CardLabel}" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                    <UniformGrid Rows="1">
                                        <Button Style="{StaticResource CheckInOptionButton}" Tag="0"  Click="OnEyeCareInlineBandClicked"
                                                Content="{loc:T Zh='沒有', En='None'}"        AutomationProperties.Name="{loc:T Zh='沒有不適', En='No discomfort'}"/>
                                        <Button Style="{StaticResource CheckInOptionButton}" Tag="5"  Click="OnEyeCareInlineBandClicked"
                                                Content="{loc:T Zh='輕微', En='Slight'}"      AutomationProperties.Name="{loc:T Zh='輕微不適', En='Slight discomfort'}"/>
                                        <Button Style="{StaticResource CheckInOptionButton}" Tag="10" Click="OnEyeCareInlineBandClicked"
                                                Content="{loc:T Zh='中等', En='Moderate'}"    AutomationProperties.Name="{loc:T Zh='中等不適', En='Moderate discomfort'}"/>
                                        <Button Style="{StaticResource CheckInOptionButton}" Tag="15" Click="OnEyeCareInlineBandClicked"
                                                Content="{loc:T Zh='嚴重', En='Severe'}"      AutomationProperties.Name="{loc:T Zh='嚴重不適', En='Severe discomfort'}"/>
                                        <Button Style="{StaticResource CheckInOptionButton}" Tag="20" Click="OnEyeCareInlineBandClicked"
                                                Content="{loc:T Zh='非常嚴重', En='Very severe'}" AutomationProperties.Name="{loc:T Zh='非常嚴重不適', En='Very severe discomfort'}"/>
                                    </UniformGrid>
                                </StackPanel>
                                <!-- Resting state (text set in code-behind): shown while a fresh check-in
                                     isn't warranted, so the user can't surge-tap. -->
                                <TextBlock x:Name="EyeCareInlineResting" Visibility="Collapsed"
                                           Style="{StaticResource CardLabel}" Foreground="{DynamicResource TextTertiary}"
                                           TextWrapping="Wrap"/>
                                <TextBlock Text="{loc:T Zh='健康自我紀錄 — 並非醫療診斷。', En='A wellness check-in — not a medical assessment.'}"
                                           Style="{StaticResource Type.Caption}" Foreground="{DynamicResource TextTertiary}"
                                           Margin="0,8,0,0" TextWrapping="Wrap"/>

                                <Border Background="{DynamicResource Separator}" Height="1" Margin="0,16,0,12"/>
                                <TextBlock Text="{loc:T Zh='最近的紀錄', En='Recent'}"
                                           Style="{StaticResource CardLabel}" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                <StackPanel x:Name="EyeCareCheckInList"/>
                                <TextBlock x:Name="EyeCareCheckInEmpty" Visibility="Collapsed"
                                           Style="{StaticResource CardLabel}" Foreground="{DynamicResource TextTertiary}"
                                           TextWrapping="Wrap"
                                           Text="{loc:T Zh='還沒有任何紀錄。出現「動態提醒」時，或在上方選一個程度即可記錄。', En='No check-ins yet. Log one when a motion check-in appears, or pick a level above.'}"/>
                                <TextBlock Style="{StaticResource Type.Caption}" Foreground="{DynamicResource TextTertiary}"
                                           Margin="0,12,0,0" TextWrapping="Wrap"
                                           Text="{loc:T Zh='想做長期分析？可在「設定」把原始紀錄匯出成 CSV。', En='For long-term analysis, export your raw data as CSV in Settings.'}"/>
                            </StackPanel>
                        </Border>

                        <!-- UX-18 (2026-06-11): the hardcoded-Collapsed Eye-Care "Advanced —
                             live metrics" expander was DELETED here. Its only live consumer (the
                             ActivityStatus "why isn't sensing reacting?" row) moved to the
                             Dashboard Advanced expander, which is the single home for advanced
                             telemetry; the rest (raw OFI/Pressure/Tier/FOV/Mask grid + the
                             AutoModeText row) duplicated the Dashboard cards and was never shown
                             (Visibility=Collapsed). Bindings used here live on the Dashboard. -->

                        <!-- Protection-activity chart: the calm GRAPHICAL view the Eye-Care
                             tab is meant to show (restored — Wave 2 over-collapsed it). Plain-
                             language labels only; raw OFI/Pressure NUMBERS stay on the Dashboard. -->
                        <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="{loc:T Zh='保護紀錄', En='Protection record'}"
                                           Style="{StaticResource SectionTitle}"/>
                                <TextBlock Text="{loc:T Zh='畫面動態與防護強度的即時軌跡', En='Live trace of screen motion and protection'}"
                                           Style="{StaticResource CardLabel}" Margin="0,0,0,10" TextWrapping="Wrap"/>
                                <Border Background="{DynamicResource SurfaceMuted}" CornerRadius="{StaticResource Radius.sm}" Padding="14,10" Height="280">
                                    <Canvas x:Name="PressureChartCanvas" ClipToBounds="True"/>
                                </Border>
                                <!-- Legend -->
                                <StackPanel Orientation="Horizontal" Margin="2,10,0,0">
                                    <Ellipse Width="8" Height="8" Fill="{DynamicResource TextTertiary}" VerticalAlignment="Center"/>
                                    <TextBlock Text="{loc:T Zh='畫面動態', En='Motion'}" Margin="6,0,16,0" Style="{StaticResource CardLabel}"
                                               VerticalAlignment="Center"/>
                                    <Ellipse Width="8" Height="8" Fill="{DynamicResource Accent}" VerticalAlignment="Center"/>
                                    <TextBlock Text="{loc:T Zh='防護強度', En='Protection'}" Margin="6,0,16,0" Style="{StaticResource CardLabel}"
                                               VerticalAlignment="Center"/>
                                    <Rectangle Width="14" Height="2" Fill="{DynamicResource ComfortHigh}" VerticalAlignment="Center"/>
                                    <TextBlock Text="{loc:T Zh='啟動點', En='Activation'}" Margin="6,0,0,0"
                                               Style="{StaticResource CardLabel}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

