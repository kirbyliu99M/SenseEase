<Window x:Class="SenseEase.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:SenseEase.App.Views"
        xmlns:conv="clr-namespace:SenseEase.App.Converters"
        xmlns:loc="clr-namespace:SenseEase.App.Localization"
        Title="{loc:T Zh='SenseEase — 視覺舒適儀表板', En='SenseEase — Visual Comfort Dashboard'}"
        Icon="pack://application:,,,/SenseEase.App;component/Resources/AppIcon.ico"
        Height="820" Width="1160"
        MinHeight="700" MinWidth="980"
        Background="{DynamicResource Canvas}"
        FontFamily="Segoe UI">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- D0 design tokens, merged VIEW-LOCALLY (never App.Resources) so
                     MainWindowSmokeTests' bare new Application() still resolves
                     {StaticResource} at construction time. -->
                <ResourceDictionary Source="pack://application:,,,/SenseEase.App;component/Theme/SenseEaseTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>

        <!-- Standard bool -> Visibility converter for the first-run welcome
             banner. Lives in Window.Resources (not App.Resources) so the
             MainWindowSmokeTests can construct the window without booting the
             Application object — App.Resources is unset in that path and the
             StaticResource lookup would fail. -->
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- D1 comfort converters (view-local; read-only tier→copy/band).
             DEAD-08: TierToSubline/TierToComfortLabel resource keys removed —
             their backing converters were deleted (zero consumers; never bound). -->
        <conv:TierToHeadlineConverter     x:Key="TierToHeadline"/>
        <conv:TierToComfortBandConverter  x:Key="TierToComfortBand"/>
        <conv:TierToFeelLabelConverter    x:Key="TierToFeelLabel"/>
        <conv:TierToFillPercentConverter  x:Key="TierToFillPercent"/>

        <!-- UX-06: auto Driver/Passenger mode token → calm plain protection label,
             live on language. Replaces the bare {Binding Mode} on the hero pill. -->
        <conv:ModeToProtectionLabelConverter   x:Key="ModeToProtectionLabel"/>
        <!-- UX-06: localized mask-state / overlay-visibility labels for the Advanced
             expander (a Setter.Value can't hold a {loc:T} Binding, so these build the
             localized text from the bound bool + language). -->
        <conv:MaskStateLabelConverter          x:Key="MaskStateLabel"/>
        <conv:OverlayVisibilityLabelConverter  x:Key="OverlayVisibilityLabel"/>
        <!-- Honest FOV-card hint: the 清晰區 caption gains （含個人化 −N） when the user's
             persisted chatbot FOV personalization (UserFovOffsetPp < 0) is why the resting
             clear-zone reads below the natural baseline. Offset + Language inputs ⇒ live-flips
             on language toggle, same MultiBinding pattern as the labels above. -->
        <conv:FovClearZoneCaptionConverter     x:Key="FovClearZoneCaption"/>

        <!-- ── Card ──
             Clean rounded surface (myHP / HP Smart look): Radius.md corner,
             generous Pad.CardAll padding, soft Elev.2 shadow, plus a hairline
             Separator border so the card keeps definition in BOTH themes
             (critical for dark, where a borderless white-on-white card vanishes). -->
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Surface}"/>
            <Setter Property="CornerRadius" Value="{StaticResource Radius.md}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Separator}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="{StaticResource Pad.CardAll}"/>
            <!-- Effect=Elev.2 removed (audit 2026-06-22): legacy dashboard-card shadow on the now-hidden host; cleared so the shared Elev resources can retire. -->
        </Style>

        <!-- ── Button template (rounded) ── -->
        <ControlTemplate x:Key="RoundBtn" TargetType="Button">
            <Border x:Name="Bd" Background="{TemplateBinding Background}"
                    CornerRadius="6" Padding="{TemplateBinding Padding}">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="Bd" Property="Opacity" Value="0.86"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter TargetName="Bd" Property="Opacity" Value="0.72"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter TargetName="Bd" Property="Opacity" Value="0.38"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <Style x:Key="PrimaryBtn" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource Accent}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="22,10"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{DynamicResource FocusVisible}"/>
            <Setter Property="Template" Value="{StaticResource RoundBtn}"/>
        </Style>

        <!-- UX-21/B2 (2026-06-11): the orphaned AlertBtn style was deleted here (zero
             usages — grep over *.cs/*.xaml found only its own declaration; B1b removed
             its last consumer). The DesignLint ratchet counts inline hex only, not named
             styles, so no ratchet change is needed. -->

        <Style x:Key="GhostBtn" TargetType="Button" BasedOn="{StaticResource PrimaryBtn}">
            <Setter Property="Background" Value="{DynamicResource SurfaceMuted}"/>
            <!-- UX-11: AccentHover (#3552D9) on SurfaceMuted clears WCAG AA 4.5:1;
                 plain Accent (#4B6EF5) measured 3.76:1 — see TokenContrastTests. -->
            <Setter Property="Foreground" Value="{DynamicResource AccentHover}"/>
        </Style>

        <!-- UX-18 / D-3 (2026-06-11): the orphaned ProfilePill style was deleted here
             (zero usages — the dashboard profile-pill card was removed 2026-06-09 and
             profiles are now auto-managed). SelectProfileCommand / CurrentProfile stay
             on the VM for tests; this presentation-only style had no consumer. -->

        <!-- ── Text styles ── -->
        <Style x:Key="CardLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextTertiary}"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <Style x:Key="CardValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="32"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="Margin" Value="0,4,0,2"/>
        </Style>

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>

        <!-- ── ListView ──
             UX-21/B2 (2026-06-11): the orphaned LogListView style was deleted here (zero
             usages — the Event Log moved to its own EventLogWindow, which styles its list
             inline; grep found only this declaration + a stale comment reference in
             EventLogWindow.xaml). The DesignLint ratchet counts inline hex only, so no
             ratchet change is needed. -->

        <!-- C cleanup (2026-06-15): the orphaned implicit GridViewColumnHeader style was deleted
             here — MainWindow has no GridView/ListView (the Event Log moved to EventLogWindow,
             which carries its own copy of this style inline). It styled nothing. -->

        <!-- C2 (audit): shared keyboard-focus ring. Implicit styles reach every
             unstyled focusable control; the explicit button styles carry it via
             PrimaryBtn's own FocusVisualStyle setter (Alert/Ghost inherit it via
             BasedOn). Only the FocusVisualStyle property is set, so the default
             control templates and all other styling are untouched. -->
        <Style TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{DynamicResource FocusVisible}"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="FocusVisualStyle" Value="{DynamicResource FocusVisible}"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="FocusVisualStyle" Value="{DynamicResource FocusVisible}"/>
        </Style>

        </ResourceDictionary>
    </Window.Resources>

    <!-- Headless host (dashboard dismantle Stage 2, 2026-06-21): the console is no longer surfaced to
         the user — all tabs are removed. The window stays instantiated as the engine/overlay/tray host;
         the only visible remnant is the first-run welcome strip + header. -->
    <Grid>
    <DockPanel>

        <!-- ══════════ UX-13: FIRST-RUN WELCOME STRIP ══════════
             One-time, dismissible, plain-language card answering "Am I protected?".
             Keyed off the EXISTING AppConfig.IsFirstRun flag (its designed use) via the
             VM's FirstRunStripVisibility; Dismiss calls MarkFirstRunComplete so it never
             shows again. (Vestibular-removal: the medical-adjacent vestibular prompt bar that
             used to be sequenced after this strip was removed; the strip now carries a brief
             non-clinical scope disclaimer as its last caption line.) Reduce-Motion-safe (no
             entrance animation). Theme tokens only; ≥12px (body 14, caption 12). -->
        <Border DockPanel.Dock="Top"
                Visibility="{Binding FirstRunStripVisibility}"
                Background="{DynamicResource SurfaceMuted}"
                BorderBrush="{DynamicResource Separator}" BorderThickness="0,0,0,1"
                Padding="28,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock FontSize="14" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimary}"
                               Text="{loc:T Zh='歡迎使用 SenseEase — 您已受到保護', En='Welcome to SenseEase — you are protected'}"/>
                    <TextBlock FontSize="14" TextWrapping="Wrap" Margin="0,6,0,0"
                               Foreground="{DynamicResource TextSecondary}"
                               Text="{loc:T Zh='SenseEase 會在背景偵測畫面動態，並自動將周邊輕微調暗，幫助減緩視覺不適。', En='SenseEase watches screen motion in the background and gently dims the edges to ease visual discomfort.'}"/>
                    <TextBlock FontSize="12" TextWrapping="Wrap" Margin="0,6,0,0"
                               Foreground="{DynamicResource TextTertiary}"
                               Text="{loc:T Zh='關閉視窗會縮到系統匣繼續運作（不會結束程式）；所有選項都在「設定」分頁。', En='Closing the window minimizes it to the tray and keeps running (close is not quit). All options live in the Settings tab.'}"/>
                    <!-- Non-clinical scope disclaimer (vestibular-removal): general comfort only,
                         not a medical device. Placed LAST in the strip (don't lead with a negative). -->
                    <TextBlock FontSize="12" TextWrapping="Wrap" Margin="0,6,0,0"
                               Foreground="{DynamicResource TextTertiary}"
                               Text="{loc:T Zh='SenseEase 幫助減緩日常視覺不適，並非臨床前庭疾病的醫療裝置。', En='SenseEase helps with everyday visual comfort — it is not a medical device for clinical vestibular conditions.'}"/>
                </StackPanel>
                <Button Grid.Column="1" VerticalAlignment="Center" Margin="20,0,0,0"
                        Content="{loc:T Zh='開始使用', En='Get started'}"
                        Command="{Binding DismissFirstRunCommand}"
                        Background="{DynamicResource Accent}" Foreground="White" BorderThickness="0"
                        Padding="20,9" FontSize="13" FontWeight="SemiBold" Cursor="Hand"
                        Template="{StaticResource RoundBtn}"
                        AutomationProperties.Name="{loc:T Zh='開始使用 SenseEase', En='Get started with SenseEase'}"/>
            </Grid>
        </Border>

        <!-- ══════════ HEADER ══════════ -->
        <Border DockPanel.Dock="Top" Background="{DynamicResource HeaderSurface}"
                BorderBrush="{DynamicResource Separator}" BorderThickness="0,0,0,1" Padding="28,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <!-- Subtitle removed entirely (zh+en) per Kirby ruling 2026-06-11. -->
                    <TextBlock Text="SenseEase"
                               FontSize="22" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Sensing-mode badge ("● SCREEN CAPTURE" / "DEMO MODE") removed per UI
                         audit (2026-06-09): it surfaced an internal capture-mode detail with no
                         user value, and was English-only in both languages. The VM's
                         SensingModeLabel property is left intact (harmless; no longer shown). -->

                    <!-- HP co-brand mark. Dark-mode fix (2026-06-09): the asset is the blue
                         HP roundel on a WHITE background, and the old white chip rendered as
                         an "absurd" bright square in Dark mode. The roundel is self-contained
                         (its white "hp" cut-outs read fine on the blue circle in any theme), so
                         we drop the chip entirely and CLIP the image to a circle — only the blue
                         roundel shows, clean on light OR dark. The ImageBrush Viewbox crops the
                         JPG's thin white margin so no white ring survives at the circle edge. -->
                    <Ellipse Width="28" Height="28" VerticalAlignment="Center" Margin="12,0,0,0"
                             ToolTip="{loc:T Zh='專為 HP 筆電設計', En='Designed for HP laptops'}">
                        <Ellipse.Fill>
                            <ImageBrush ImageSource="pack://application:,,,/SenseEase.App;component/Resources/hp-logo.jpg"
                                        Stretch="UniformToFill"
                                        Viewbox="0.05,0.05,0.90,0.90"/>
                        </Ellipse.Fill>
                    </Ellipse>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ══════════ TABS REMOVED — dashboard dismantle complete (2026-06-21) ══════════
             Stage 1 removed Dashboard + AI Assistant + Settings; Stage 2 removed the last tab, Eye Care
             (its check-in card + manual self-report + live protection chart). The chatbot lives in the
             popup ChatPanel, Settings in the standalone SettingsWindow, and the longer-term comfort
             trend in the de-identified health report (Settings → Export health report). This window is
             now a headless engine/overlay/tray host and is no longer surfaced to the user. -->


    </DockPanel>

        <!-- CHECK-IN OVERLAY (CheckInOverlayHost) retired 2026-06-21: the in-window proactive-check-in
             consent overlay rendered only inside the now-hidden console (unreachable on the shell boot).
             Proactive check-ins are opt-in via the Settings toggle; see MainWindow.MaybeShowSpikeCheckIn. -->
    </Grid>
</Window>
