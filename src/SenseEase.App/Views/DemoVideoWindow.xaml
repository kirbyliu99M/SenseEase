<Window x:Class="SenseEase.App.Views.DemoVideoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SenseEase Demo — Vection Stress Test"
        WindowStyle="None"
        WindowState="Maximized"
        ResizeMode="NoResize"
        Background="Black"
        ShowInTaskbar="True"
        Topmost="False"
        Icon="pack://application:,,,/SenseEase.App;component/Resources/AppIcon.ico">
    <Grid>
        <!-- Video surface. LoadedBehavior=Manual so we control Play/Stop from code. -->
        <MediaElement x:Name="Player"
                      LoadedBehavior="Manual"
                      UnloadedBehavior="Stop"
                      ScrubbingEnabled="False"
                      Stretch="Uniform"/>

        <!-- HUD: explains the demo + how to stop -->
        <Border VerticalAlignment="Top" HorizontalAlignment="Right"
                Background="#90000000" CornerRadius="6"
                Padding="12,8" Margin="14">
            <StackPanel>
                <TextBlock Text="● SENSEEASE DEMO"
                           Foreground="#FFB347" FontSize="11" FontWeight="Bold"/>
                <TextBlock Text="Screen-capture sensing is live."
                           Foreground="White" FontSize="11" Margin="0,4,0,0"/>
                <TextBlock Text="Mask + chatbot will react to motion."
                           Foreground="White" FontSize="11"/>
                <TextBlock Text="Press ESC or close window to stop"
                           Foreground="#9AB6E0" FontSize="10" Margin="0,6,0,0"/>
            </StackPanel>
        </Border>

        <!-- Failure / fallback message -->
        <TextBlock x:Name="ErrorText"
                   Text="" Foreground="#FF6B6B"
                   FontSize="14" FontWeight="SemiBold"
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   TextWrapping="Wrap" MaxWidth="600"
                   Visibility="Collapsed"/>
    </Grid>
</Window>
