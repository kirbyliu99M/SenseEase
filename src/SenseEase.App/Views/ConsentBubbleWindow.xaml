<Window x:Class="SenseEase.App.Views.ConsentBubbleWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:SenseEase.App.Localization"
        Title="SenseEase"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        ResizeMode="NoResize"
        SizeToContent="Manual" Width="320" Height="240"
        WindowStartupLocation="Manual"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType"
        AutomationProperties.Name="{loc:T Zh='要開啟舒適防護嗎？', En='Start comfort overlay?'}">
    <!-- Item 1 — the consent bubble, REFIT 2026-06-19 (Kirby): a subtle, OS-incorporated rounded MESSAGE
         bubble. At rest it is a small circular avatar (the SenseEase mark centred) carrying a red NOTICE
         dot — no question text, so it is not abrupt. Tapping it EXPANDS the message bubble (the question +
         Start / Not now) using the popup's flash-free logic: the WINDOW is a FIXED 320x240 (SizeToContent
         =Manual) that NEVER resizes; the message section grows Height 0->natural + slides/fades INSIDE it
         (no layered-window resize = no flash; no DropShadowEffect for the same reason). The mask stays OFF
         (clamped to L1) until the user taps Start — fail-safe: a missed/ignored bubble means no overlay.
         No-activate (never steals the user's app focus). Popup.* tokens, view-local merge. -->
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/SenseEase.App;component/Theme/SenseEaseTheme.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/SenseEase.App;component/Theme/PopupGlassTokens.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="ConsentStartBtn" TargetType="Button">
                <Setter Property="Background" Value="{DynamicResource Popup.Blue}"/>
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Padding" Value="16,7"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="MinHeight" Value="34"/>
                <Setter Property="FocusVisualStyle" Value="{DynamicResource FocusVisible}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="9"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="{DynamicResource Popup.BlueHover}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <!-- Secondary "Not now" — a quiet text button (transparent at rest, token wash on hover);
                 no inline hex so the design-lint ratchet stays clean. -->
            <Style x:Key="ConsentGhostBtn" TargetType="Button">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Foreground" Value="{DynamicResource Popup.Ink2}"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Padding" Value="14,7"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="MinHeight" Value="34"/>
                <Setter Property="FocusVisualStyle" Value="{DynamicResource FocusVisible}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="9"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="{DynamicResource Popup.BtnHover}"/>
                                    <Setter Property="Foreground" Value="{DynamicResource Popup.Ink1}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <!-- RootGrid hugs the right edge + is vertically centred INSIDE the fixed window, so ShellController.
         PositionConsentBubble (docks the window right, centres it on the bar centre) lands the content
         flush near the bar — exactly the popup's content-rect arrangement. -->
    <Grid x:Name="RootGrid" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="10">
        <!-- The content block: message bubble (above) + avatar (below). Centred so the expand reads as a
             gentle centred bloom (the house "calm breath" stretch). -->
        <StackPanel x:Name="ContentRoot" HorizontalAlignment="Right" VerticalAlignment="Center">

            <!-- EXPANDED message bubble — collapsed at rest; Height-grows + slides/fades in on tap. -->
            <Border x:Name="MessageBubble" HorizontalAlignment="Right" Width="284"
                    Background="{DynamicResource Popup.PanelBg}"
                    BorderBrush="{DynamicResource Popup.Bdr}" BorderThickness="1"
                    CornerRadius="16" Padding="14,12,14,12" Margin="0,0,0,8"
                    Visibility="Collapsed" Opacity="0" ClipToBounds="True">
                <Border.RenderTransform><TranslateTransform x:Name="MsgShift"/></Border.RenderTransform>
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,7">
                        <Image Source="pack://application:,,,/SenseEase.App;component/Resources/AppIcon.ico"
                               Width="16" Height="16" Margin="0,0,7,0" VerticalAlignment="Center"
                               RenderOptions.BitmapScalingMode="HighQuality"/>
                        <TextBlock Text="SenseEase" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{DynamicResource Popup.Ink1}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock TextWrapping="Wrap" FontSize="13" LineHeight="19" Foreground="{DynamicResource Popup.Ink1}"
                               Text="{loc:T Zh='偵測到畫面晃動。要為你開啟舒適防護來緩和嗎？', En='SenseEase noticed some on-screen motion. Start the comfort overlay to ease it?'}"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                        <Button x:Name="NotNowBtn" Style="{StaticResource ConsentGhostBtn}" Click="OnNotNowClicked"
                                Content="{loc:T Zh='暫時不要', En='Not now'}"
                                AutomationProperties.Name="{loc:T Zh='暫時不要', En='Not now'}"/>
                        <Button x:Name="StartBtn" Style="{StaticResource ConsentStartBtn}" Click="OnStartClicked" IsDefault="True" Margin="8,0,0,0"
                                Content="{loc:T Zh='開啟', En='Start'}"
                                AutomationProperties.Name="{loc:T Zh='開啟舒適防護', En='Start comfort overlay'}"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- COLLAPSED avatar — the round message bubble with the SenseEase mark centred + the red
                 notice dot. This is the only thing shown at rest, and the tap target that expands.
                 The notice dot is a SIBLING overlay (not inside the template) so the code-behind can
                 toggle it; IsHitTestVisible=False so taps still reach the button. -->
            <Grid HorizontalAlignment="Right" Width="52" Height="52">
                <Button x:Name="AvatarBtn" Width="52" Height="52"
                        Background="Transparent" BorderThickness="0" Cursor="Hand" Click="OnAvatarClicked"
                        FocusVisualStyle="{DynamicResource FocusVisible}"
                        AutomationProperties.Name="{loc:T Zh='SenseEase 通知，點按展開', En='SenseEase notice — tap to expand'}">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Grid>
                                <Border x:Name="circle" Width="52" Height="52" CornerRadius="26"
                                        Background="{DynamicResource Popup.PanelBg}"
                                        BorderBrush="{DynamicResource Popup.Bdr}" BorderThickness="1"/>
                                <Image Source="pack://application:,,,/SenseEase.App;component/Resources/AppIcon.ico"
                                       Width="24" Height="24" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       RenderOptions.BitmapScalingMode="HighQuality"/>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="circle" Property="Background" Value="{DynamicResource Popup.ChipHover}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
                <Ellipse x:Name="NoticeDot" Width="11" Height="11" IsHitTestVisible="False"
                         Fill="{DynamicResource Popup.Notice}"
                         Stroke="{DynamicResource Popup.PanelBg}" StrokeThickness="1.5"
                         HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,2,2,0"/>
            </Grid>

        </StackPanel>
    </Grid>
</Window>
