<UserControl x:Class="SenseEase.App.Views.CalibrationConfirmCardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Segoe UI">

    <!-- ============================================================
         H11 — Calibration confirmation card

         Shown in the AI Assistant tab AFTER the 5-card calibration completes
         but BEFORE the result is applied to the engine. DataContext is set
         externally to a CalibrationConfirmCardViewModel. Accept → host applies
         the already-computed result; Decline → host keeps current settings.

         Styling mirrors CalibrationCardView (D0 theme tokens) so the surface,
         text, and accent track light/dark.
         ============================================================ -->

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/SenseEase.App;component/Theme/SenseEaseTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <ControlTemplate x:Key="ConfirmRoundBtn" TargetType="Button">
                <Border x:Name="Bd" Background="{TemplateBinding Background}"
                        CornerRadius="6" Padding="{TemplateBinding Padding}">
                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter TargetName="Bd" Property="Opacity" Value="0.86"/>
                    </Trigger>
                    <Trigger Property="IsPressed" Value="True">
                        <Setter TargetName="Bd" Property="Opacity" Value="0.72"/>
                    </Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate>

            <Style x:Key="ConfirmPrimaryBtn" TargetType="Button">
                <Setter Property="Background" Value="{DynamicResource Accent}"/>
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Padding" Value="18,8"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template" Value="{StaticResource ConfirmRoundBtn}"/>
            </Style>

            <Style x:Key="ConfirmGhostBtn" TargetType="Button" BasedOn="{StaticResource ConfirmPrimaryBtn}">
                <Setter Property="Background" Value="{DynamicResource SurfaceMuted}"/>
                <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Border Background="{DynamicResource Surface}" CornerRadius="10" Padding="18,16"
            BorderBrush="{DynamicResource Separator}" BorderThickness="1">
        <StackPanel>
            <TextBlock Text="{Binding HeaderText}" FontSize="15" FontWeight="Bold"
                       Foreground="{DynamicResource TextPrimary}"/>
            <TextBlock Text="{Binding IntroText}" FontSize="12" TextWrapping="Wrap"
                       Foreground="{DynamicResource TextSecondary}" Margin="0,6,0,10"/>

            <!-- Q1–Q5 plain-language recap -->
            <ItemsControl ItemsSource="{Binding RecapLines}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" FontSize="12" TextWrapping="Wrap" Margin="0,2"
                                   Foreground="{DynamicResource TextPrimary}"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- What will change -->
            <Border Background="{DynamicResource SurfaceMuted}" CornerRadius="6" Padding="12,8" Margin="0,12,0,0">
                <TextBlock Text="{Binding OutcomeText}" FontSize="12" FontWeight="SemiBold"
                           TextWrapping="Wrap" Foreground="{DynamicResource TextPrimary}"/>
            </Border>

            <!-- Accept / Decline -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                <Button Content="{Binding DeclineText}" Command="{Binding DeclineCommand}"
                        Style="{StaticResource ConfirmGhostBtn}" Margin="0,0,10,0"/>
                <Button Content="{Binding AcceptText}" Command="{Binding AcceptCommand}"
                        Style="{StaticResource ConfirmPrimaryBtn}"/>
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
