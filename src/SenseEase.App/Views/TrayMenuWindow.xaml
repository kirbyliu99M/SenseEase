<Window x:Class="SenseEase.App.Views.TrayMenuWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        Topmost="True"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="Manual"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">
    <!--
      Tray-menu 閃退 permanent fix (2026-06-22): the notification-area icon's right-click menu, rebuilt as a
      REAL top-level Window instead of a WPF ContextMenu. A ContextMenu is a Popup that auto-dismisses when it
      loses activation — fatal for a windowless tray app (KB135788). A Window never auto-vanishes: only the
      code-behind closes it (item click / Escape / Deactivated-after-grace), so it can no longer flash away.
      Skinned to match the former SenseEaseContextMenu look (Surface card + rounded border + per-item hover wash).
    -->
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/SenseEase.App;component/Theme/SenseEaseTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- One menu row: mirrors SenseEaseMenuItem (transparent, calm SurfaceMuted highlight). Compact
                 sizing (2026-06-22): tighter padding + 12px font (the legibility floor) so the card stays small
                 and covers less of the screen. -->
            <Style x:Key="TrayMenuItemButton" TargetType="Button">
                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Padding" Value="9,4"/>
                <Setter Property="FontFamily" Value="{DynamicResource Font.UI}"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="HorizontalContentAlignment" Value="Left"/>
                <Setter Property="HorizontalAlignment" Value="Stretch"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="SnapsToDevicePixels" Value="True"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                    CornerRadius="5" Padding="{TemplateBinding Padding}"
                                    SnapsToDevicePixels="True">
                                <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Left"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SurfaceMuted}"/>
                                </Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SurfaceMuted}"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Foreground" Value="{DynamicResource TextTertiary}"/>
                                    <Setter Property="Cursor" Value="Arrow"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <!-- The rounded Surface card. The window itself is transparent so the corners read clean. -->
    <Border x:Name="MenuCard"
            Background="{DynamicResource Surface}"
            BorderBrush="{DynamicResource CardBorder}"
            BorderThickness="1"
            CornerRadius="8"
            Padding="3"
            MinWidth="150"
            SnapsToDevicePixels="True">
        <StackPanel x:Name="ItemsPanel"/>
    </Border>
</Window>
