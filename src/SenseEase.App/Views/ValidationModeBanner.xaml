<Window x:Class="SenseEase.App.Views.ValidationModeBanner"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SenseEase validation warning"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="Manual"
        Focusable="False"
        IsHitTestVisible="False">
    <!-- Pop-up sprint Task 7 patch: validation-mode warning banner.
         Bottom-right of primary monitor. Click-through (IsHitTestVisible=false)
         so it never interferes with whatever the user is doing during a
         validation run. Auto-fades after 4 s. Content set imperatively from
         ValidationModeBanner.xaml.cs so the diagnostic text is sourced from
         ValidationModeDiagnostics (one place owns the message). -->
    <Border Background="#E6201418"
            CornerRadius="6"
            Padding="14"
            BorderBrush="#FFFF9B6B"
            BorderThickness="1"
            MaxWidth="460">
        <!-- Audit 2026-06-22: removed DropShadowEffect (AllowsTransparency software-render flash). -->
        <TextBlock x:Name="DiagnosticText"
                   FontFamily="Consolas, Courier New, monospace"
                   FontSize="12"
                   Foreground="#F0F4FA"
                   TextWrapping="Wrap"
                   Text=""/>
    </Border>
</Window>
