<Window x:Class="SenseEase.App.Views.NotificationCardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SenseEase notification"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        SizeToContent="Height"
        Width="480"
        MinHeight="220"
        WindowStartupLocation="Manual"
        ShowActivated="False">
    <Window.Resources>
        <!-- overlay-bar-redesign D4: light-theme primary action button.
             Replaces the dark-theme PrimaryHpBlueButtonStyle. Deep blue fill
             with a darker hover/pressed state matches the new white card
             surface. Vertical stacked label (zh + en) lives inside the
             button content, not the style — see OpenDashboardBtn below. -->
        <!-- Path Z bug-fix 6: explicit ControlTemplate. The default Aero
             Button template paints its own hover/pressed background via
             VisualStateManager and ignores outer Style.Triggers on the
             Background property — meaning the Style triggers we used to
             have here were silently no-op'd at runtime. The Border-based
             template below ensures the Trigger Background swaps actually
             render. CornerRadius=3 matches the card's overall radius
             vocabulary; the ContentPresenter uses TemplateBinding so the
             vertical-stacked label inside OpenDashboardBtn keeps centering. -->
        <Style x:Key="PrimaryDeepBlueButtonStyle" TargetType="Button">
            <Setter Property="Background"      Value="#1E5BB0"/>
            <Setter Property="Foreground"      Value="White"/>
            <Setter Property="FontSize"        Value="12"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="Padding"         Value="14,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"
                                              RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#174A92"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#103770"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <!-- overlay-bar-redesign D1: light card theme.
         White surface, light grey border, soft drop shadow. The previous
         dark-on-dark scheme blended into the bar — switching to a near-pure
         white card with the same WGC mask seam (Topmost + AllowsTransparency)
         gives strong contrast against any background. MouseMove anywhere in
         the Border resets the 60 s idle-collapse timer. -->
    <Border x:Name="CardBorder"
            Background="#FFFFFF"
            CornerRadius="10"
            Padding="16"
            BorderBrush="#E0E4EA"
            BorderThickness="1"
            MouseMove="OnCardMouseMove">
        <Border.Effect>
            <DropShadowEffect Color="Black" BlurRadius="14"
                              ShadowDepth="3" Opacity="0.18"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- title row -->
                <RowDefinition Height="Auto"/> <!-- M3 7e: chatbot proposal (Flow A) -->
                <RowDefinition Height="Auto"/> <!-- body -->
                <RowDefinition Height="Auto"/> <!-- v0.9.1 round-4: discomfort quick-response -->
                <RowDefinition Height="Auto"/> <!-- buttons -->
                <RowDefinition Height="Auto"/> <!-- v0.9.1 round-3: chatbot input -->
            </Grid.RowDefinitions>

            <!-- Title + settings (gear) + close (X). DockPanel docks right-side
                 buttons first so the title TextBlock takes the remaining space. -->
            <DockPanel Grid.Row="0" LastChildFill="True" Margin="0,0,0,10">
                <Button DockPanel.Dock="Right"
                        x:Name="CloseBtn"
                        Content="×"
                        Width="22" Height="22"
                        Padding="0" BorderThickness="0"
                        Background="Transparent"
                        Foreground="#7A8499"
                        FontSize="16" FontWeight="Bold"
                        Cursor="Hand"
                        Click="OnCloseClicked"/>
                <Button DockPanel.Dock="Right"
                        x:Name="SettingsBtn"
                        Content="&#x2699;"
                        Width="22" Height="22"
                        Padding="0" BorderThickness="0"
                        Background="Transparent"
                        Foreground="#7A8499"
                        FontSize="18"
                        Cursor="Hand"
                        Margin="0,0,4,0"
                        Click="OnSettingsClicked"
                        ToolTip="設定 / Settings"/>
                <TextBlock x:Name="TitleText"
                           Text=""
                           FontSize="14" FontWeight="Bold"
                           Foreground="#1A1F2E"
                           VerticalAlignment="Center"
                           TextWrapping="Wrap"/>
            </DockPanel>

            <!-- M3 7e: chatbot proposal section (Flow A, spec §4.3.5).
                 Visible only when ProposalPanel.Visibility = Visible (set by
                 code-behind when ActiveProposal is non-null). Sits ABOVE the
                 tier-band body text so user sees the recommendation first
                 when the card auto-pops on a proposal. -->
            <Border Grid.Row="1"
                    x:Name="ProposalPanel"
                    Visibility="Collapsed"
                    Background="#F2F6FE"
                    BorderBrush="#C3D2EE"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="12,10"
                    Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock x:Name="ProposalHeaderText"
                               Text="&#x1F4A1; SenseEase 建議"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="#1E5BB0"
                               Margin="0,0,0,6"/>
                    <TextBlock x:Name="ProposalSummaryText"
                               Text=""
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="#1A1F2E"
                               TextWrapping="Wrap"
                               Margin="0,0,0,4"/>
                    <!-- H7: distinct treatment for model-controlled rationale —
                         italic + muted colour + the always-present "AI suggests"
                         attribution (set in code) so it can't read as app chrome. -->
                    <TextBlock x:Name="ProposalRationaleText"
                               Text=""
                               FontSize="11"
                               FontStyle="Italic"
                               Foreground="#5A6478"
                               TextWrapping="Wrap"
                               Margin="0,0,0,8"/>
                    <TextBlock x:Name="ProposalSafetyNoteText"
                               Text=""
                               Visibility="Collapsed"
                               FontSize="11"
                               Foreground="#8C2F23"
                               TextWrapping="Wrap"
                               Margin="0,0,0,8"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal">
                            <Button x:Name="ProposalAcceptBtn"
                                    Content="接受"
                                    Click="OnProposalAcceptClicked"
                                    Background="#1E5BB0"
                                    Foreground="White"
                                    BorderThickness="0"
                                    Padding="14,6"
                                    Margin="0,0,6,0"
                                    FontSize="12"
                                    FontWeight="SemiBold"
                                    Cursor="Hand"/>
                            <Button x:Name="ProposalDeclineBtn"
                                    Content="拒絕"
                                    Click="OnProposalDeclineClicked"
                                    Background="#EEF1F5"
                                    Foreground="#3A4252"
                                    BorderThickness="0"
                                    Padding="14,6"
                                    Margin="0,0,6,0"
                                    FontSize="12"
                                    Cursor="Hand"/>
                            <Button x:Name="ProposalLaterBtn"
                                    Content="稍後"
                                    Click="OnProposalLaterClicked"
                                    Background="Transparent"
                                    Foreground="#7A8499"
                                    BorderBrush="#D6DBE3"
                                    BorderThickness="1"
                                    Padding="14,6"
                                    FontSize="12"
                                    Cursor="Hand"/>
                        </StackPanel>
                        <TextBlock Grid.Column="2"
                                   x:Name="ProposalExpiryText"
                                   Text=""
                                   FontSize="10"
                                   Foreground="#7A8499"
                                   VerticalAlignment="Center"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Body text -->
            <TextBlock Grid.Row="2"
                       x:Name="BodyText"
                       Text=""
                       FontSize="13"
                       Foreground="#3A4252"
                       TextWrapping="Wrap"
                       VerticalAlignment="Top"
                       Margin="0,0,0,10"/>

            <!-- v0.9.1 round-4: discomfort quick-response. Four buttons
                 along a single "程度漸強" axis: 輕微 → 中等 → 明顯 → 嚴重.
                 Each sends a localised phrase the chatbot interprets as a
                 ReportDiscomfort with the matching severity, applying
                 the same FOV/mask/grid deltas as a typed message. Severity
                 mapping is by button Tag (1-4) → index into
                 QuickDiscomfortPhrases; labels are purely cosmetic. -->
            <StackPanel Grid.Row="3" Margin="0,0,0,10">
                <TextBlock Text="視覺不適程度"
                           FontSize="11"
                           FontWeight="SemiBold"
                           Foreground="#5A6478"
                           Margin="0,0,0,6"/>
                <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0"
                        x:Name="QuickDiscomfort1Btn"
                        Tag="1"
                        Click="OnQuickDiscomfortClicked"
                        Background="#E5F0F8"
                        Foreground="#1E5BB0"
                        BorderBrush="#B7CFE3"
                        BorderThickness="1"
                        Padding="4,8"
                        FontSize="12"
                        FontWeight="SemiBold"
                        Content="輕微"
                        Margin="0,0,4,0"
                        Cursor="Hand"/>
                <Button Grid.Column="1"
                        x:Name="QuickDiscomfort2Btn"
                        Tag="2"
                        Click="OnQuickDiscomfortClicked"
                        Background="#FFF1D6"
                        Foreground="#7A5310"
                        BorderBrush="#E5C98E"
                        BorderThickness="1"
                        Padding="4,8"
                        FontSize="12"
                        FontWeight="SemiBold"
                        Content="中等"
                        Margin="2,0,2,0"
                        Cursor="Hand"/>
                <Button Grid.Column="2"
                        x:Name="QuickDiscomfort3Btn"
                        Tag="3"
                        Click="OnQuickDiscomfortClicked"
                        Background="#FFE0CC"
                        Foreground="#9B4F1A"
                        BorderBrush="#E5B388"
                        BorderThickness="1"
                        Padding="4,8"
                        FontSize="12"
                        FontWeight="SemiBold"
                        Content="明顯"
                        Margin="2,0,2,0"
                        Cursor="Hand"/>
                <Button Grid.Column="3"
                        x:Name="QuickDiscomfort4Btn"
                        Tag="4"
                        Click="OnQuickDiscomfortClicked"
                        Background="#FBD0CB"
                        Foreground="#8C2F23"
                        BorderBrush="#E5928B"
                        BorderThickness="1"
                        Padding="4,8"
                        FontSize="12"
                        FontWeight="SemiBold"
                        Content="嚴重"
                        Margin="4,0,0,0"
                        Cursor="Hand"/>
                </Grid>
            </StackPanel>

            <!-- Button row: Grid with two columns so PowerSaveToggle sits
                 hard-left and the action buttons sit hard-right at 480 dip.
                 Layout: [PowerSaveToggle] | [Dashboard][Engage][Mute] -->
            <Grid Grid.Row="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>  <!-- left: toggle -->
                    <ColumnDefinition Width="*"/>     <!-- stretch -->
                    <ColumnDefinition Width="Auto"/>  <!-- right: actions -->
                </Grid.ColumnDefinitions>

                <!-- Path Z UX iter 2: replaced text label "省電模式 / Power Save"
                     with a universal power glyph (U+23FB). Old label was both
                     getting clipped at 480 dip AND mis-framed the action as
                     "energy saving" when it's actually a sensing on/off
                     toggle. ToolTip makes the actual semantic clear. -->
                <CheckBox x:Name="PowerSaveToggle"
                          Grid.Column="0"
                          VerticalAlignment="Center"
                          Foreground="#3A4252"
                          Cursor="Hand"
                          ToolTip="暫停 / 恢復 SenseEase 感測（不會關閉應用程式）"
                          Checked="OnPowerSaveToggled"
                          Unchecked="OnPowerSaveToggled">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="&#x23FB;" FontSize="18" FontWeight="SemiBold"/>
                        <TextBlock Text="省電" FontSize="12" Margin="6,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </CheckBox>

                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right">
                    <Button x:Name="OpenDashboardBtn"
                            Style="{StaticResource PrimaryDeepBlueButtonStyle}"
                            Click="OnOpenDashboardClicked"
                            Content="開啟主視窗"
                            Margin="0,0,8,0"/>
                    <Button x:Name="EngageBtn"
                            Content="啟動保護"
                            Click="OnEngageClicked"
                            Background="#FF9B6B"
                            Foreground="#101418"
                            BorderThickness="0"
                            Padding="12,6"
                            Margin="0,0,8,0"
                            FontSize="12"
                            FontWeight="Bold"
                            Cursor="Hand"/>
                    <Button x:Name="MuteBtn"
                            Content="6 小時內不再提示"
                            Click="OnMuteClicked"
                            Background="#EEF1F5"
                            Foreground="#3A4252"
                            BorderThickness="0"
                            Padding="12,6"
                            FontSize="12"
                            Cursor="Hand"/>
                </StackPanel>
            </Grid>

            <!-- v0.9.1 round-3: inline chatbot input. Lets the user adjust
                 comfort settings via natural-language ("worse", "tighten",
                 "more open") without opening the dashboard. The reply
                 (and any deltas applied) flow into the dashboard's chat
                 tab via the host's ChatbotViewModel pipeline; the card
                 itself only shows a one-line acknowledgement so the
                 card stays compact. Enter key sends; Send button sends. -->
            <Grid Grid.Row="5" Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBox Grid.Row="0" Grid.Column="0"
                         x:Name="ChatInputBox"
                         Background="#F7F8FA"
                         Foreground="#1A1F2E"
                         BorderBrush="#D6DBE3"
                         BorderThickness="1"
                         Padding="8,6"
                         FontSize="12"
                         MaxLength="240"
                         VerticalContentAlignment="Center"
                         KeyDown="OnChatInputKeyDown"
                         Margin="0,0,8,0">
                    <TextBox.Resources>
                        <VisualBrush x:Key="PlaceholderBrush" Stretch="None" AlignmentX="Left">
                            <VisualBrush.Visual>
                                <TextBlock Text="跟 SenseEase 說話" Foreground="#9AA3B0" FontSize="12" Margin="2,0,0,0"/>
                            </VisualBrush.Visual>
                        </VisualBrush>
                    </TextBox.Resources>
                    <TextBox.Style>
                        <Style TargetType="TextBox">
                            <Style.Triggers>
                                <Trigger Property="Text" Value="">
                                    <Setter Property="Background" Value="{StaticResource PlaceholderBrush}"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </TextBox.Style>
                </TextBox>

                <Button Grid.Row="0" Grid.Column="1"
                        x:Name="ChatSendBtn"
                        Content="送出"
                        Click="OnChatSendClicked"
                        Style="{StaticResource PrimaryDeepBlueButtonStyle}"
                        Padding="12,6"/>

                <TextBlock Grid.Row="1" Grid.ColumnSpan="2"
                           x:Name="ChatStatusText"
                           Text=""
                           FontSize="10"
                           Foreground="#7A8499"
                           Margin="2,4,0,0"
                           TextWrapping="Wrap"
                           MaxHeight="32"/>
            </Grid>
        </Grid>
    </Border>
</Window>
