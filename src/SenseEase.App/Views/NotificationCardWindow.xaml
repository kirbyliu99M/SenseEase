<Window x:Class="SenseEase.App.Views.NotificationCardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:SenseEase.App.Localization"
        Title="SenseEase notification"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        MinWidth="360"
        MaxWidth="560"
        WindowStartupLocation="Manual"
        ShowActivated="False"
        FontFamily="{DynamicResource Font.UI}">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- D0 design tokens, merged view-locally (never App.Resources). -->
                <ResourceDictionary Source="pack://application:,,,/SenseEase.App;component/Theme/SenseEaseTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>

        <!-- bar-redesign: deep-blue primary action button (Accent fill).
             Used by the chat-face "send" button. Border-based ControlTemplate so
             the Trigger Background swaps render (the default Aero template paints
             its own hover/pressed background and ignores Style.Triggers). -->
        <Style x:Key="PrimaryDeepBlueButtonStyle" TargetType="Button">
            <Setter Property="Background"      Value="{DynamicResource Accent}"/>
            <Setter Property="Foreground"      Value="White"/>
            <Setter Property="FontSize"        Value="12"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="Padding"         Value="14,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{DynamicResource FocusVisible}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{StaticResource Radius.pill}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"
                                              RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentHover}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentHover}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- bar-redesign: white/SurfaceMuted PILL button with Accent text. Used by
             介入 +/-, 停用 (restyled checkbox), 設定. Calm, no alarm-red; the rounded
             SurfaceMuted fill + 1px Separator hairline reads as a soft chip.
             Border-based template so per-instance Background actually paints. -->
        <Style x:Key="PillButtonStyle" TargetType="Button">
            <Setter Property="Background"      Value="{DynamicResource SurfaceMuted}"/>
            <Setter Property="Foreground"      Value="{DynamicResource Accent}"/>
            <Setter Property="FontSize"        Value="12"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="Padding"         Value="14,6"/>
            <Setter Property="MinHeight"       Value="30"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush"     Value="{DynamicResource Separator}"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{DynamicResource FocusVisible}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{StaticResource Radius.pill}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"
                                              RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.8"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- bar-redesign: round +/- intervention-depth pill. The VISIBLE chip stays a
             30x30 circle (Accent glyph on a Surface fill with a Separator hairline —
             unchanged visuals), but UX-14 widens the clickable HIT AREA to 44x44 for
             touch/switch users: the Button is 44x44 with a Transparent fill (hit-
             testable) and the 30x30 visible Border is centred inside it. The button's
             OWN bounds carry the hit test, so the glyph + chip read identically while
             the tappable target meets the 44px floor. Negative margins on the call
             sites pull the 44x44 box back so the surrounding bar layout doesn't shift. -->
        <Style x:Key="RoundPillButtonStyle" TargetType="Button" BasedOn="{StaticResource PillButtonStyle}">
            <Setter Property="Width"    Value="44"/>
            <Setter Property="Height"   Value="44"/>
            <Setter Property="MinHeight" Value="44"/>
            <Setter Property="Padding"  Value="0"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <!-- 44x44 transparent hit region; the visible 30x30 chip is centred. -->
                        <Border Background="{TemplateBinding Background}">
                            <Border x:Name="Bd"
                                    Width="30" Height="30"
                                    Background="{DynamicResource Surface}"
                                    BorderBrush="{DynamicResource Separator}"
                                    BorderThickness="1"
                                    CornerRadius="{StaticResource Radius.pill}"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    SnapsToDevicePixels="True">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  RecognizesAccessKey="True"/>
                            </Border>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.8"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- C2 (audit): shared keyboard-focus ring for any focusable control that
             doesn't carry an explicit style. -->
        <Style TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{DynamicResource FocusVisible}"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="FocusVisualStyle" Value="{DynamicResource FocusVisible}"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="FocusVisualStyle" Value="{DynamicResource FocusVisible}"/>
        </Style>
        </ResourceDictionary>
    </Window.Resources>

    <!-- HUD-card rework: rounded horizontal BAR, THEME-AWARE surface. The
         Background is now {DynamicResource Surface} (white in light, deep slate
         in dark) instead of a hardcoded translucent white — so the card reads
         correctly in BOTH themes (the dark-mode "white card" bug). The acrylic
         tint behind it is re-picked per theme in code-behind. The card grows
         ABOVE the bar when ActiveProposal != null (ProposalPanel row). MouseMove
         anywhere resets the idle-collapse timer; MouseLeftButtonDown on this
         surface (NOT on a child button) drags the whole window (Game-Bar style),
         and its new position is persisted to UserPreferences. -->
    <Border x:Name="CardBorder"
            Background="{DynamicResource Surface}"
            CornerRadius="{StaticResource Radius.md}"
            Padding="14,7"
            BorderBrush="{DynamicResource CardBorder}"
            BorderThickness="1"
            MouseMove="OnCardMouseMove"
            MouseLeftButtonDown="OnCardDragStart"
            KeyboardNavigation.TabNavigation="Cycle"
            RenderTransformOrigin="0.5,0.5">
        <Border.RenderTransform>
            <TransformGroup>
                <ScaleTransform x:Name="PopScale" ScaleX="1" ScaleY="1"/>
                <TranslateTransform x:Name="SlideTransform"/>
            </TransformGroup>
        </Border.RenderTransform>
        <Border.Effect>
            <DropShadowEffect Color="Black" BlurRadius="18"
                              ShadowDepth="2" Opacity="0.10"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- chatbot proposal (grows the card above the bar) -->
                <RowDefinition Height="Auto"/> <!-- P5 AdaptiveFit set-move proposal -->
                <RowDefinition Height="Auto"/> <!-- the bar (main face / chat face) -->
            </Grid.RowDefinitions>

            <!-- M3 7e: chatbot proposal section (Flow A, spec §4.3.5).
                 Unchanged behaviour — sits ABOVE the bar when ActiveProposal is
                 non-null. Restyled margins only so it sits above the new bar. -->
            <Border Grid.Row="0"
                    x:Name="ProposalPanel"
                    Visibility="Collapsed"
                    Background="{DynamicResource SurfaceMuted}"
                    BorderBrush="{DynamicResource Separator}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="12,10"
                    Margin="0,0,0,10">
                <StackPanel>
                    <TextBlock x:Name="ProposalHeaderText"
                               Text="{loc:T Zh='SenseEase 建議', En='SenseEase suggests'}"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource Accent}"
                               Margin="0,0,0,6"/>
                    <TextBlock x:Name="ProposalSummaryText"
                               Text=""
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimary}"
                               TextWrapping="Wrap"
                               Margin="0,0,0,4"/>
                    <!-- H7: distinct treatment for model-controlled rationale —
                         italic + muted colour + the always-present "AI suggests"
                         attribution (set in code) so it can't read as app chrome. -->
                    <TextBlock x:Name="ProposalRationaleText"
                               Text=""
                               FontSize="12"
                               FontStyle="Italic"
                               Foreground="{DynamicResource TextSecondary}"
                               TextWrapping="Wrap"
                               Margin="0,0,0,8"/>
                    <!-- M8: safety-note callout. Calm clay ComfortHighWeak card with
                         a ComfortHigh hairline + ⚠ glyph so a system-intervention
                         note reads as an advisory, not an alarm-red banner. The
                         Border's Visibility tracks the inner TextBlock's so the
                         existing code-behind (which toggles ProposalSafetyNoteText
                         .Visibility) shows/hides the whole callout. -->
                    <Border Background="{DynamicResource ComfortHighWeak}"
                            BorderBrush="{DynamicResource ComfortHigh}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="8,6"
                            Margin="0,0,0,8"
                            AutomationProperties.Name="{loc:T Zh='安全提醒', En='Safety note'}"
                            Visibility="{Binding Visibility, ElementName=ProposalSafetyNoteText}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#x26A0;"
                                       FontSize="13"
                                       Foreground="{DynamicResource ComfortHighText}"
                                       VerticalAlignment="Top"
                                       Margin="0,0,6,0"/>
                            <TextBlock x:Name="ProposalSafetyNoteText"
                                       Text=""
                                       Visibility="Collapsed"
                                       FontSize="12"
                                       Foreground="{DynamicResource ComfortHighText}"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal">
                            <Button x:Name="ProposalAcceptBtn"
                                    Content="{loc:T Zh='接受', En='Accept'}"
                                    Click="OnProposalAcceptClicked"
                                    Background="{DynamicResource Accent}"
                                    Foreground="White"
                                    BorderThickness="0"
                                    Padding="14,6"
                                    Margin="0,0,6,0"
                                    FontSize="12"
                                    FontWeight="SemiBold"
                                    Cursor="Hand"/>
                            <Button x:Name="ProposalDeclineBtn"
                                    Content="{loc:T Zh='拒絕', En='Decline'}"
                                    Click="OnProposalDeclineClicked"
                                    Background="{DynamicResource SurfaceMuted}"
                                    Foreground="{DynamicResource TextPrimary}"
                                    BorderThickness="0"
                                    Padding="14,6"
                                    Margin="0,0,6,0"
                                    FontSize="12"
                                    Cursor="Hand"/>
                            <Button x:Name="ProposalLaterBtn"
                                    Content="{loc:T Zh='稍後', En='Later'}"
                                    Click="OnProposalLaterClicked"
                                    Background="Transparent"
                                    Foreground="{DynamicResource TextSecondary}"
                                    BorderBrush="{DynamicResource Separator}"
                                    BorderThickness="1"
                                    Padding="14,6"
                                    FontSize="12"
                                    Cursor="Hand"/>
                        </StackPanel>
                        <TextBlock Grid.Column="2"
                                   x:Name="ProposalExpiryText"
                                   Text=""
                                   FontSize="12"
                                   Foreground="{DynamicResource TextSecondary}"
                                   VerticalAlignment="Center"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- P5 (propose-confirm): the AdaptiveFit set-move proposal section.
                 A SIBLING of the chatbot ProposalPanel (Row 0) above, MIRRORING its
                 structure but with CANNED non-medical copy describing the SCREEN
                 setting only (never the user's state). Surfaced ONLY behind a
                 userInitiated card-open (the engine never opens a window). Driven by
                 the ActiveSetMove code-behind property. -->
            <Border Grid.Row="1"
                    x:Name="SetMoveProposalPanel"
                    Visibility="Collapsed"
                    Background="{DynamicResource SurfaceMuted}"
                    BorderBrush="{DynamicResource Separator}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="12,10"
                    Margin="0,0,0,10">
                <StackPanel>
                    <TextBlock x:Name="SetMoveHeaderText"
                               Text="{loc:T Zh='SenseEase 建議', En='SenseEase suggests'}"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource Accent}"
                               Margin="0,0,0,6"/>
                    <TextBlock x:Name="SetMoveSummaryText"
                               Text=""
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimary}"
                               TextWrapping="Wrap"
                               Margin="0,0,0,8"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal">
                            <Button x:Name="SetMoveAcceptBtn"
                                    Content="{loc:T Zh='套用', En='Apply'}"
                                    Click="OnSetMoveAcceptClicked"
                                    Background="{DynamicResource Accent}"
                                    Foreground="White"
                                    BorderThickness="0"
                                    Padding="14,6"
                                    Margin="0,0,6,0"
                                    FontSize="12"
                                    FontWeight="SemiBold"
                                    Cursor="Hand"/>
                            <Button x:Name="SetMoveDeclineBtn"
                                    Content="{loc:T Zh='不要', En='No thanks'}"
                                    Click="OnSetMoveDeclineClicked"
                                    Background="{DynamicResource SurfaceMuted}"
                                    Foreground="{DynamicResource TextPrimary}"
                                    BorderThickness="0"
                                    Padding="14,6"
                                    Margin="0,0,6,0"
                                    FontSize="12"
                                    Cursor="Hand"/>
                            <Button x:Name="SetMoveLaterBtn"
                                    Content="{loc:T Zh='稍後', En='Later'}"
                                    Click="OnSetMoveLaterClicked"
                                    Background="Transparent"
                                    Foreground="{DynamicResource TextSecondary}"
                                    BorderBrush="{DynamicResource Separator}"
                                    BorderThickness="1"
                                    Padding="14,6"
                                    FontSize="12"
                                    Cursor="Hand"/>
                        </StackPanel>
                        <TextBlock Grid.Column="2"
                                   x:Name="SetMoveExpiryText"
                                   Text=""
                                   FontSize="12"
                                   Foreground="{DynamicResource TextSecondary}"
                                   VerticalAlignment="Center"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ═══ THE BAR ════════════════════════════════════════════════════
                 Two faces stacked in the same cell; only one is visible at a
                 time. FlipBtn toggles MainFace ⇄ ChatFace. -->
            <Grid Grid.Row="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>   <!-- SHARED close (×) — visible on BOTH faces -->
                    <RowDefinition Height="*"/>      <!-- the two stacked faces -->
                </Grid.RowDefinitions>

                <!-- SHARED close (×): lives in the bar container, NOT inside a single face,
                     so it stays visible after the flip to the chat face. Bug-fix: the × used
                     to be a child of MainFace only, so flipping to ChatFace hid it. Both faces
                     now sit in row 1 BELOW this ×, sharing one vertical band — so the flip no
                     longer shifts the visible content up/down inside the card. -->
                <!-- UX-14: the VISIBLE × glyph is unchanged (16px, transparent chrome), but
                     the clickable HIT AREA is widened to 44x44 for touch/switch users. The
                     Transparent fill is hit-testable across the full 44 box; the -11 margins
                     reclaim the +22 so the glyph stays pinned at the top-right corner and the
                     Auto row height doesn't grow. -->
                <Button Grid.Row="0"
                        x:Name="CloseBtn"
                        Content="×"
                        HorizontalAlignment="Right"
                        Width="44" Height="44"
                        Margin="0,-11,-11,-11"
                        Padding="0" BorderThickness="0"
                        Background="Transparent"
                        Foreground="{DynamicResource TextTertiary}"
                        FontSize="16" FontWeight="Bold"
                        Cursor="Hand"
                        Panel.ZIndex="10"
                        AutomationProperties.Name="{loc:T Zh='關閉通知', En='Close'}"
                        Click="OnCloseClicked"/>

                <!-- ── MAIN FACE (default) ──────────────────────────────────── -->
                <!-- Top-aligned (UI/UX fine-tune 2026-06-08): both faces hug the top of the
                     band with a caption row on top, so the primary row (value/controls) lands
                     at the SAME Y as the chat face's input row. When the chat reply grows the
                     band, this face stays put instead of drifting to the band centre. -->
                <Grid x:Name="MainFace" Grid.Row="1" VerticalAlignment="Top">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>      <!-- status text -->
                        <ColumnDefinition Width="Auto"/>   <!-- controls -->
                    </Grid.ColumnDefinitions>

                    <!-- LEFT: status text, vertically centred to align with the
                         controls cluster on the right. -->
                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="2,0,8,0">
                        <!-- UI/UX fine-tune (2026-06-08): a subtle caption frames the status;
                             the BAND WORD below ("極低" / "Very Calm") is the prominent value
                             (set in code via ComfortBands.FeelBandLocalized). The bar/tray/hero
                             keep the full "畫面動態 · 極低" label — only this card drops the prefix
                             because the caption already says "screen status". -->
                        <TextBlock Text="{loc:T Zh='目前螢幕狀態', En='Current screen status'}"
                                   FontSize="12"
                                   Foreground="{DynamicResource TextTertiary}"
                                   Margin="0,0,0,1"/>

                        <!-- HUD-card rework item 1: the LEFT primary label is the
                             PLAIN-LANGUAGE SCREEN STATUS (the band feel — what the
                             screen is doing right now), set by the host via
                             SetContent. It is the prominent headline of the card and
                             must NOT truncate to "守護…": the strings are short, so
                             we drop CharacterEllipsis and allow a single clean line
                             with a sensible MinWidth so the controls cluster can't
                             starve it. The engineering telemetry (第 N 級 / 壓力) and
                             the band-description body stay present (test contract reads
                             their .Text) but HIDDEN on the calm bar — telemetry lives
                             in the dashboard's Advanced view, never on this surface. -->
                        <TextBlock x:Name="TitleText"
                                   Text=""
                                   MinWidth="96"
                                   FontSize="20" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimary}"
                                   VerticalAlignment="Center"
                                   TextTrimming="None"
                                   AutomationProperties.HelpText="{loc:T Zh='畫面狀態', En='Screen status'}"/>
                        <TextBlock x:Name="TelemetryText" Text="" Visibility="Collapsed"
                                   FontFamily="Consolas, 'Cascadia Mono', monospace" FontSize="12"
                                   Foreground="{DynamicResource TextSecondary}"
                                   AutomationProperties.HelpText="{loc:T Zh='感測讀數', En='Sensing readout'}"/>
                        <TextBlock x:Name="BodyText" Text="" Visibility="Collapsed"
                                   FontSize="12" Foreground="{DynamicResource TextSecondary}"
                                   TextWrapping="Wrap"
                                   AutomationProperties.HelpText="{loc:T Zh='通知內容', En='Notification details'}"/>
                    </StackPanel>

                    <!-- RIGHT: controls — +/- depth pills, separator, 暫停 / 設定 /
                         flip — vertically centred so they align with the status label. -->
                    <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <!-- UI/UX fine-tune (2026-06-08): a subtle caption sits above the
                             12-level intensity adjuster (−/level/+). It is left-aligned so it
                             frames the adjuster; 暫停 / 設定 / flip continue to its right. -->
                        <TextBlock Text="{loc:T Zh='調整強度', En='Intensity'}"
                                   FontSize="12"
                                   Foreground="{DynamicResource TextTertiary}"
                                   HorizontalAlignment="Left"
                                   Margin="2,0,0,3"/>
                        <StackPanel Orientation="Horizontal">
                            <!-- HUD-card rework: intervention-depth cluster, now
                                 ordered [ − ] [ level ] [ + ] (minus LEFT, plus
                                 RIGHT) with the current level read out BETWEEN
                                 them. The level is set by the host via SetLevel()
                                 from the current VimsTier before Show(). -->
                            <!-- UX-14: -7 margins reclaim the +14 the 44x44 hit area added
                                 (right keeps the original 6dip gap → 6-7=-1) so the visible
                                 30 chip + the bar's vertical rhythm don't shift. -->
                            <Button x:Name="InterventionDownBtn"
                                    Style="{StaticResource RoundPillButtonStyle}"
                                    Content="&#x2212;"
                                    Margin="-7,-7,-1,-7"
                                    Click="OnInterventionDownClicked"
                                    AutomationProperties.Name="{loc:T Zh='減弱介入', En='Adjust down'}"
                                    ToolTip="{loc:T Zh='減弱介入', En='Ease less'}"/>
                            <TextBlock x:Name="LevelText"
                                       Text="Lv.1"
                                       MinWidth="40"
                                       FontSize="13" FontWeight="SemiBold"
                                       Foreground="{DynamicResource Accent}"
                                       TextAlignment="Center"
                                       VerticalAlignment="Center"
                                       Margin="0,0,6,0"
                                       AutomationProperties.Name="{loc:T Zh='目前介入級別', En='Current level'}"
                                       ToolTip="{loc:T Zh='目前介入級別', En='Current intervention level'}"/>
                            <Button x:Name="InterventionUpBtn"
                                    Style="{StaticResource RoundPillButtonStyle}"
                                    Content="+"
                                    Margin="-7,-7,1,-7"
                                    Click="OnInterventionUpClicked"
                                    AutomationProperties.Name="{loc:T Zh='加強介入', En='Adjust up'}"
                                    ToolTip="{loc:T Zh='加強介入', En='Ease more'}"/>

                            <!-- thin separator -->
                            <Border Width="1" Height="22"
                                    Background="{DynamicResource Separator}"
                                    Margin="0,0,8,0" VerticalAlignment="Center"/>

                            <!-- 暫停 / 恢復 — a CheckBox restyled as a pill that
                                 drives PowerSaveToggle (keeps x:Name + event).
                                 P2 mode-shift: label reads 暫停 when running
                                 (unchecked) and 恢復 when paused (checked), swapped
                                 by the IsChecked trigger below. -->
                            <CheckBox x:Name="PowerSaveToggle"
                                      VerticalAlignment="Center"
                                      MinHeight="30"
                                      Margin="0,0,8,0"
                                      Cursor="Hand"
                                      Foreground="{DynamicResource Accent}"
                                      ToolTip="{loc:T Zh='暫停或恢復所有防護（不會關閉應用程式）', En='Pause or resume all protection (does not quit the app)'}"
                                      AutomationProperties.Name="{loc:T Zh='暫停或恢復防護', En='Pause or resume protection'}"
                                      AutomationProperties.HelpText="{loc:T Zh='暫停或恢復所有防護（不會關閉應用程式）', En='Pause or resume all protection (does not quit the app)'}"
                                      Checked="OnPowerSaveToggled"
                                      Unchecked="OnPowerSaveToggled">
                                <CheckBox.Template>
                                    <ControlTemplate TargetType="CheckBox">
                                        <Border x:Name="Bd"
                                                Background="{DynamicResource SurfaceMuted}"
                                                BorderBrush="{DynamicResource Separator}"
                                                BorderThickness="1"
                                                CornerRadius="{StaticResource Radius.pill}"
                                                Padding="14,6"
                                                VerticalAlignment="Center"
                                                SnapsToDevicePixels="True">
                                            <!-- Two localized labels swapped by Visibility (a Trigger
                                                 Setter can't hold a loc binding). Pause shows when
                                                 running; Resume when paused (IsChecked trigger below). -->
                                            <Grid>
                                                <TextBlock x:Name="PowerSaveLabelPause"
                                                           Text="{loc:T Zh='暫停', En='Pause'}"
                                                           FontSize="12" FontWeight="SemiBold"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"/>
                                                <TextBlock x:Name="PowerSaveLabelResume"
                                                           Text="{loc:T Zh='恢復', En='Resume'}"
                                                           Visibility="Collapsed"
                                                           FontSize="12" FontWeight="SemiBold"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Accent}"/>
                                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                                                <Setter TargetName="PowerSaveLabelPause" Property="Visibility" Value="Collapsed"/>
                                                <Setter TargetName="PowerSaveLabelResume" Property="Visibility" Value="Visible"/>
                                                <!-- Bug fix (2026-06-09): the active "恢復/Resume" label was invisible —
                                                     same colour as the Accent fill. The labels inherit the CheckBox's
                                                     LOCAL Foreground={Accent} (set for the unchecked "Pause" label on
                                                     SurfaceMuted), and a local value out-precedences this template
                                                     trigger — so the old `<Setter Property="Foreground" Value="White"/>`
                                                     never applied. Target the visible label directly so it contrasts on
                                                     the Accent fill (matches the white-on-Accent −/+ buttons). -->
                                                <Setter TargetName="PowerSaveLabelResume" Property="Foreground" Value="{DynamicResource TextOnComfort}"/>
                                            </Trigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </CheckBox.Template>
                            </CheckBox>

                            <!-- 設定 / Settings -->
                            <Button x:Name="SettingsBtn"
                                    Style="{StaticResource PillButtonStyle}"
                                    Content="{loc:T Zh='設定', En='Settings'}"
                                    Margin="0,0,8,0"
                                    Click="OnSettingsClicked"
                                    AutomationProperties.Name="{loc:T Zh='設定', En='Settings'}"
                                    ToolTip="{loc:T Zh='設定', En='Settings'}"/>

                            <!-- Flip to chat face. UI/UX fine-tune (2026-06-08): subtle chrome
                                 glyph matching the × close (22×22, TextTertiary — was 28×28 Accent).
                                 The chat face carries an IDENTICAL glyph at the SAME right-edge,
                                 band-centred position so flipping feels seamless (the affordance
                                 stays put). -->
                            <!-- UX-14: 44x44 hit area, 13px glyph unchanged. -11 margins
                                 reclaim the +22 so the cluster height + right edge stay put. -->
                            <Button x:Name="FlipBtn"
                                    Content="&#x21A9;"
                                    Width="44" Height="44"
                                    Margin="-11"
                                    Padding="0" BorderThickness="0"
                                    Background="Transparent"
                                    Foreground="{DynamicResource TextTertiary}"
                                    FontSize="13"
                                    Cursor="Hand"
                                    VerticalAlignment="Center"
                                    Click="OnFlipClicked"
                                    AutomationProperties.Name="{loc:T Zh='開啟對話', En='Open chat'}"
                                    ToolTip="{loc:T Zh='跟 SenseEase 說話', En='Talk to SenseEase'}"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Hidden legacy action buttons. Kept ONLY so the host's
                         EngageClicked / MuteClicked / OpenDashboard wiring still
                         compiles; never surfaced in the redesigned card (Collapsed +
                         IsHitTestVisible=False ⇒ unreachable by the user). NOTE: the +
                         pill raises ONLY InterventionAdjustRequested (see
                         OnInterventionUpClicked) — it does NOT raise EngageClicked. -->
                    <StackPanel Visibility="Collapsed" IsHitTestVisible="False">
                        <Button x:Name="OpenDashboardBtn" Click="OnOpenDashboardClicked" Content="開啟主視窗"/>
                        <Button x:Name="EngageBtn" Click="OnEngageClicked" Content="緩和畫面"/>
                        <Button x:Name="MuteBtn" Click="OnMuteClicked" Content="6 小時內不再提示"/>
                    </StackPanel>
                </Grid>

                <!-- ── CHAT FACE (shown after flip) ─────────────────────────── -->
                <!-- Shares row 1 with MainFace (below the persistent × in row 0). Hidden (not
                     Collapsed) so it is still MEASURED while the main face shows: the card sizes
                     to the MAX of both faces and keeps a constant footprint across a flip (no
                     resize / re-centre jump). VerticalAlignment=Center centres the chat row in
                     that band — the SAME band MainFace's content is centred in, so the visible
                     content no longer jumps to a different position when the user flips. -->
                <!-- Top-aligned + caption-on-top so the input row lands at the SAME Y as the
                     main face's content row (kills the flip jump). The status/reply row grows
                     DOWNWARD only, so it never shifts the two aligned rows. -->
                <Grid x:Name="ChatFace" Grid.Row="1" Visibility="Hidden" VerticalAlignment="Top">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>     <!-- input -->
                        <ColumnDefinition Width="Auto"/>  <!-- send -->
                        <ColumnDefinition Width="Auto"/>  <!-- flip (same right-edge spot as the main face) -->
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>  <!-- caption (matches the main face caption row) -->
                        <RowDefinition Height="Auto"/>  <!-- input / send / flip (primary row) -->
                        <RowDefinition Height="Auto"/>  <!-- status / reply (grows downward) -->
                        <RowDefinition Height="Auto"/>  <!-- CW-5: crisis panel (full-width, non-truncating) -->
                    </Grid.RowDefinitions>

                    <!-- Caption matching the main face's caption rhythm — its presence is what
                         drops the input row to the same Y as the main content row. -->
                    <TextBlock Grid.Row="0" Grid.Column="0"
                               Text="{loc:T Zh='對話', En='Chat'}"
                               FontSize="12"
                               Foreground="{DynamicResource TextTertiary}"
                               Margin="2,0,0,1"/>

                    <TextBox Grid.Row="1" Grid.Column="0"
                             x:Name="ChatInputBox"
                             Background="{DynamicResource SurfaceMuted}"
                             Foreground="{DynamicResource TextPrimary}"
                             BorderBrush="{DynamicResource Separator}"
                             BorderThickness="1"
                             Padding="8,6"
                             FontSize="12"
                             MaxLength="240"
                             VerticalContentAlignment="Center"
                             KeyDown="OnChatInputKeyDown"
                             Margin="0,0,8,0">
                        <TextBox.Resources>
                            <VisualBrush x:Key="PlaceholderBrush" Stretch="None" AlignmentX="Left">
                                <VisualBrush.Visual>
                                    <TextBlock Text="{loc:T Zh='跟 SenseEase 說話', En='Talk to SenseEase'}" Foreground="{DynamicResource TextTertiary}" FontSize="12" Margin="2,0,0,0"/>
                                </VisualBrush.Visual>
                            </VisualBrush>
                        </TextBox.Resources>
                        <TextBox.Style>
                            <Style TargetType="TextBox">
                                <Style.Triggers>
                                    <Trigger Property="Text" Value="">
                                        <Setter Property="Background" Value="{StaticResource PlaceholderBrush}"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </TextBox.Style>
                    </TextBox>

                    <Button Grid.Row="1" Grid.Column="1"
                            x:Name="ChatSendBtn"
                            Content="{loc:T Zh='傳送', En='Send'}"
                            Click="OnChatSendClicked"
                            Style="{StaticResource PrimaryDeepBlueButtonStyle}"
                            Padding="14,6"
                            Margin="0,0,8,0"/>

                    <!-- Flip BACK to the status face. Identical glyph (↩) + right-edge position to
                         the main face's FlipBtn so the affordance stays in place across the flip
                         (seamless). In the input row (Row 1), centred → same Y as the main flip. -->
                    <!-- UX-14: 44x44 hit area, 13px glyph unchanged. -11 margins reclaim the
                         +22 so the chat-face input row keeps the same height + right edge
                         (stays aligned with the main-face flip glyph across a flip). -->
                    <Button Grid.Row="1" Grid.Column="2"
                            x:Name="FlipBackBtn"
                            Content="&#x21A9;"
                            Width="44" Height="44"
                            Margin="-11"
                            Padding="0" BorderThickness="0"
                            Background="Transparent"
                            Foreground="{DynamicResource TextTertiary}"
                            FontSize="13"
                            Cursor="Hand"
                            VerticalAlignment="Center"
                            Click="OnFlipClicked"
                            AutomationProperties.Name="{loc:T Zh='返回', En='Back'}"
                            ToolTip="{loc:T Zh='返回畫面狀態', En='Back to status'}"/>

                    <!-- CW-5 (UX-02): a GENERAL assistant reply. Raised to 12px (a11y
                         floor) and no longer hard-clipped at 32px — the card itself
                         SizeToContent-grows downward so a normal reply reads in full.
                         A long reply is capped by the ScrollViewer's MaxHeight (~7 lines
                         at 12px ≈ 130dip) so it scrolls in place instead of turning the
                         card into a wall; the 對話 input above stays reachable. The CRISIS
                         response NEVER renders here — it is routed to CrisisPanel below,
                         which has no cap, no scroll, and no truncation (locked invariant A1). -->
                    <ScrollViewer Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
                                  x:Name="ChatStatusScroll"
                                  MaxHeight="130"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  Margin="0,4,0,0">
                        <TextBlock x:Name="ChatStatusText"
                                   Text=""
                                   FontSize="12"
                                   Foreground="{DynamicResource TextSecondary}"
                                   Margin="2,0,0,0"
                                   TextWrapping="Wrap"/>
                    </ScrollViewer>

                    <!-- CW-5 (UX-02, locked invariant A1): the SafetyFloor crisis response.
                         FULL-WIDTH (spans all three columns), >=12px, NEVER truncated,
                         scrolled, paraphrased, localized-away, or animated. The text is the
                         fixed SafetyFloor.CrisisResponse{Zh,En} constant, set verbatim in
                         code-behind. While this panel is visible the card suppresses its
                         idle auto-fade, foreground-change dismiss, and click-outside dismiss
                         (see _crisisActive in code-behind) so the hotline numbers can't
                         vanish out from under the user. Only the explicit close button
                         (or ×/Escape) dismisses it. Calm ComfortHigh advisory styling —
                         a soft clay card, never an alarm-red banner. -->
                    <Border Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="3"
                            x:Name="CrisisPanel"
                            Visibility="Collapsed"
                            Background="{DynamicResource ComfortHighWeak}"
                            BorderBrush="{DynamicResource ComfortHigh}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="12,10"
                            Margin="0,8,0,0"
                            AutomationProperties.Name="{loc:T Zh='求助資訊', En='Crisis support'}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <!-- Plain close button (no countdown, no auto-dismiss). -->
                            <Button Grid.Row="0" Grid.Column="1"
                                    x:Name="CrisisCloseBtn"
                                    Content="×"
                                    Width="22" Height="22"
                                    Padding="0" BorderThickness="0"
                                    Background="Transparent"
                                    Foreground="{DynamicResource ComfortHighText}"
                                    FontSize="16" FontWeight="Bold"
                                    Cursor="Hand"
                                    VerticalAlignment="Top"
                                    HorizontalAlignment="Right"
                                    Click="OnCrisisCloseClicked"
                                    AutomationProperties.Name="{loc:T Zh='關閉', En='Close'}"/>
                            <!-- The crisis text itself. >=12px, full wrap, NO MaxHeight, NO
                                 scroll, NO trimming — every character (988 / 1925 安心專線 /
                                 findahelpline.com) is always present. Set verbatim from
                                 SafetyFloor.CrisisResponse{Zh,En} in code-behind. -->
                            <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                                       x:Name="CrisisResponseText"
                                       Text=""
                                       FontSize="13"
                                       LineHeight="19"
                                       Foreground="{DynamicResource ComfortHighText}"
                                       TextWrapping="Wrap"
                                       TextTrimming="None"
                                       Margin="0,2,0,0"
                                       AutomationProperties.HelpText="{loc:T Zh='求助專線資訊', En='Crisis line information'}"/>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
