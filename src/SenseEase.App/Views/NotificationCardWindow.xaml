<Window x:Class="SenseEase.App.Views.NotificationCardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SenseEase notification"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        SizeToContent="Height"
        Width="380"
        WindowStartupLocation="Manual"
        ShowActivated="False"
        FontFamily="{DynamicResource Font.UI}">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- D0 design tokens, merged view-locally (never App.Resources). -->
                <ResourceDictionary Source="pack://application:,,,/SenseEase.App;component/Theme/SenseEaseTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>

        <!-- bar-redesign: deep-blue primary action button (Accent fill).
             Used by the chat-face "send" button. Border-based ControlTemplate so
             the Trigger Background swaps render (the default Aero template paints
             its own hover/pressed background and ignores Style.Triggers). -->
        <Style x:Key="PrimaryDeepBlueButtonStyle" TargetType="Button">
            <Setter Property="Background"      Value="{DynamicResource Accent}"/>
            <Setter Property="Foreground"      Value="White"/>
            <Setter Property="FontSize"        Value="12"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="Padding"         Value="14,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{DynamicResource FocusVisible}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"
                                              RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentHover}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentHover}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- bar-redesign: white/SurfaceMuted PILL button with Accent text. Used by
             介入 +/-, 停用 (restyled checkbox), 設定. Calm, no alarm-red; the rounded
             SurfaceMuted fill + 1px Separator hairline reads as a soft chip.
             Border-based template so per-instance Background actually paints. -->
        <Style x:Key="PillButtonStyle" TargetType="Button">
            <Setter Property="Background"      Value="{DynamicResource SurfaceMuted}"/>
            <Setter Property="Foreground"      Value="{DynamicResource Accent}"/>
            <Setter Property="FontSize"        Value="12"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="Padding"         Value="14,6"/>
            <Setter Property="MinHeight"       Value="30"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush"     Value="{DynamicResource Separator}"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{DynamicResource FocusVisible}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{StaticResource Radius.pill}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"
                                              RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.8"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- bar-redesign: round +/- intervention-depth pill. Fixed 30x30 circle,
             Accent glyph on a white surface with a Separator hairline. -->
        <Style x:Key="RoundPillButtonStyle" TargetType="Button" BasedOn="{StaticResource PillButtonStyle}">
            <Setter Property="Width"    Value="30"/>
            <Setter Property="Height"   Value="30"/>
            <Setter Property="MinHeight" Value="30"/>
            <Setter Property="Padding"  Value="0"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="Background" Value="{DynamicResource Surface}"/>
        </Style>

        <!-- C2 (audit): shared keyboard-focus ring for any focusable control that
             doesn't carry an explicit style. -->
        <Style TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{DynamicResource FocusVisible}"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="FocusVisualStyle" Value="{DynamicResource FocusVisible}"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="FocusVisualStyle" Value="{DynamicResource FocusVisible}"/>
        </Style>
        </ResourceDictionary>
    </Window.Resources>

    <!-- bar-redesign: light, rounded horizontal BAR. White surface, soft border,
         soft drop shadow. The card grows ABOVE the bar when ActiveProposal != null
         (ProposalPanel row). MouseMove anywhere resets the idle-collapse timer. -->
    <Border x:Name="CardBorder"
            Background="#F2FFFFFF"
            CornerRadius="11"
            Padding="14,10"
            BorderBrush="{DynamicResource Separator}"
            BorderThickness="1"
            MouseMove="OnCardMouseMove">
        <Border.RenderTransform>
            <TranslateTransform x:Name="SlideTransform"/>
        </Border.RenderTransform>
        <Border.Effect>
            <DropShadowEffect Color="Black" BlurRadius="18"
                              ShadowDepth="2" Opacity="0.10"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- proposal (grows the card above the bar) -->
                <RowDefinition Height="Auto"/> <!-- the bar (main face / chat face) -->
            </Grid.RowDefinitions>

            <!-- M3 7e: chatbot proposal section (Flow A, spec §4.3.5).
                 Unchanged behaviour — sits ABOVE the bar when ActiveProposal is
                 non-null. Restyled margins only so it sits above the new bar. -->
            <Border Grid.Row="0"
                    x:Name="ProposalPanel"
                    Visibility="Collapsed"
                    Background="{DynamicResource SurfaceMuted}"
                    BorderBrush="{DynamicResource Separator}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="12,10"
                    Margin="0,0,0,10">
                <StackPanel>
                    <TextBlock x:Name="ProposalHeaderText"
                               Text="SenseEase 建議"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource Accent}"
                               Margin="0,0,0,6"/>
                    <TextBlock x:Name="ProposalSummaryText"
                               Text=""
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimary}"
                               TextWrapping="Wrap"
                               Margin="0,0,0,4"/>
                    <!-- H7: distinct treatment for model-controlled rationale —
                         italic + muted colour + the always-present "AI suggests"
                         attribution (set in code) so it can't read as app chrome. -->
                    <TextBlock x:Name="ProposalRationaleText"
                               Text=""
                               FontSize="11"
                               FontStyle="Italic"
                               Foreground="{DynamicResource TextSecondary}"
                               TextWrapping="Wrap"
                               Margin="0,0,0,8"/>
                    <!-- M8: safety-note callout. Calm clay ComfortHighWeak card with
                         a ComfortHigh hairline + ⚠ glyph so a system-intervention
                         note reads as an advisory, not an alarm-red banner. The
                         Border's Visibility tracks the inner TextBlock's so the
                         existing code-behind (which toggles ProposalSafetyNoteText
                         .Visibility) shows/hides the whole callout. -->
                    <Border Background="{DynamicResource ComfortHighWeak}"
                            BorderBrush="{DynamicResource ComfortHigh}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="8,6"
                            Margin="0,0,0,8"
                            AutomationProperties.Name="安全提醒 / Safety note"
                            Visibility="{Binding Visibility, ElementName=ProposalSafetyNoteText}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#x26A0;"
                                       FontSize="13"
                                       Foreground="{DynamicResource ComfortHighText}"
                                       VerticalAlignment="Top"
                                       Margin="0,0,6,0"/>
                            <TextBlock x:Name="ProposalSafetyNoteText"
                                       Text=""
                                       Visibility="Collapsed"
                                       FontSize="11"
                                       Foreground="{DynamicResource ComfortHighText}"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal">
                            <Button x:Name="ProposalAcceptBtn"
                                    Content="接受"
                                    Click="OnProposalAcceptClicked"
                                    Background="{DynamicResource Accent}"
                                    Foreground="White"
                                    BorderThickness="0"
                                    Padding="14,6"
                                    Margin="0,0,6,0"
                                    FontSize="12"
                                    FontWeight="SemiBold"
                                    Cursor="Hand"/>
                            <Button x:Name="ProposalDeclineBtn"
                                    Content="拒絕"
                                    Click="OnProposalDeclineClicked"
                                    Background="{DynamicResource SurfaceMuted}"
                                    Foreground="{DynamicResource TextPrimary}"
                                    BorderThickness="0"
                                    Padding="14,6"
                                    Margin="0,0,6,0"
                                    FontSize="12"
                                    Cursor="Hand"/>
                            <Button x:Name="ProposalLaterBtn"
                                    Content="稍後"
                                    Click="OnProposalLaterClicked"
                                    Background="Transparent"
                                    Foreground="{DynamicResource TextSecondary}"
                                    BorderBrush="{DynamicResource Separator}"
                                    BorderThickness="1"
                                    Padding="14,6"
                                    FontSize="12"
                                    Cursor="Hand"/>
                        </StackPanel>
                        <TextBlock Grid.Column="2"
                                   x:Name="ProposalExpiryText"
                                   Text=""
                                   FontSize="10"
                                   Foreground="{DynamicResource TextSecondary}"
                                   VerticalAlignment="Center"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ═══ THE BAR ════════════════════════════════════════════════════
                 Two faces stacked in the same cell; only one is visible at a
                 time. FlipBtn toggles MainFace ⇄ ChatFace. -->
            <Grid Grid.Row="1">

                <!-- ── MAIN FACE (default) ──────────────────────────────────── -->
                <Grid x:Name="MainFace">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>      <!-- status text -->
                        <ColumnDefinition Width="Auto"/>   <!-- controls -->
                    </Grid.ColumnDefinitions>

                    <!-- LEFT: status text. TitleText (placeholder copy from
                         SetContent) + static separator + 介入調節/Adjust label,
                         with TelemetryText as a small sub-line. -->
                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="2,0,8,0">
                        <!-- ui-ux-pro-max principles applied (content-priority,
                             visual-hierarchy, whitespace-balance, progressive-disclosure,
                             truncation-strategy): ONE plain-language status line. The
                             engineering telemetry (第 N 級 / 壓力) and the band-description
                             body are kept ONLY so the test contract (SetContent /
                             power-save) can read their .Text — they are HIDDEN on the calm
                             bar (telemetry lives in the dashboard's Advanced view, never on
                             this primary surface). The +/- pills are self-labelled by their
                             tooltip + AutomationProperties, so no separate "介入調節" label
                             clutters the left. -->
                        <TextBlock x:Name="TitleText"
                                   Text=""
                                   FontSize="15" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimary}"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"
                                   AutomationProperties.HelpText="通知標題 / Notification title"/>
                        <TextBlock x:Name="TelemetryText" Text="" Visibility="Collapsed"
                                   FontFamily="Consolas, 'Cascadia Mono', monospace" FontSize="11"
                                   Foreground="{DynamicResource TextSecondary}"
                                   AutomationProperties.HelpText="感測讀數 / Sensing readout"/>
                        <TextBlock x:Name="BodyText" Text="" Visibility="Collapsed"
                                   FontSize="11" Foreground="{DynamicResource TextSecondary}"
                                   TextWrapping="Wrap"
                                   AutomationProperties.HelpText="通知內容 / Notification details"/>
                    </StackPanel>

                    <!-- RIGHT: controls. Top row = close (X) + flip. Bottom row =
                         the +/- depth pills, a separator, then 停用 / 設定. -->
                    <Grid Grid.Column="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>  <!-- close + flip -->
                            <RowDefinition Height="Auto"/>  <!-- control pills -->
                        </Grid.RowDefinitions>

                        <!-- TOP-RIGHT: close (×). -->
                        <Button Grid.Row="0"
                                x:Name="CloseBtn"
                                Content="×"
                                HorizontalAlignment="Right"
                                Width="22" Height="22"
                                Padding="0" BorderThickness="0"
                                Background="Transparent"
                                Foreground="{DynamicResource TextTertiary}"
                                FontSize="16" FontWeight="Bold"
                                Cursor="Hand"
                                AutomationProperties.Name="關閉通知 / Close"
                                Click="OnCloseClicked"/>

                        <!-- CENTER controls + bottom-right flip. -->
                        <StackPanel Grid.Row="1" Orientation="Horizontal"
                                    HorizontalAlignment="Right" VerticalAlignment="Center"
                                    Margin="0,6,0,0">
                            <!-- intervention-depth +/- (replaces the 4 quick buttons) -->
                            <Button x:Name="InterventionUpBtn"
                                    Style="{StaticResource RoundPillButtonStyle}"
                                    Content="+"
                                    Margin="0,0,6,0"
                                    Click="OnInterventionUpClicked"
                                    AutomationProperties.Name="加強介入 / Adjust up"
                                    ToolTip="加強介入 / Ease more"/>
                            <Button x:Name="InterventionDownBtn"
                                    Style="{StaticResource RoundPillButtonStyle}"
                                    Content="&#x2212;"
                                    Margin="0,0,8,0"
                                    Click="OnInterventionDownClicked"
                                    AutomationProperties.Name="減弱介入 / Adjust down"
                                    ToolTip="減弱介入 / Ease less"/>

                            <!-- thin separator -->
                            <Border Width="1" Height="22"
                                    Background="{DynamicResource Separator}"
                                    Margin="0,0,8,0" VerticalAlignment="Center"/>

                            <!-- 暫停 / 恢復 — a CheckBox restyled as a pill that
                                 drives PowerSaveToggle (keeps x:Name + event).
                                 P2 mode-shift: label reads 暫停 when running
                                 (unchecked) and 恢復 when paused (checked), swapped
                                 by the IsChecked trigger below. -->
                            <CheckBox x:Name="PowerSaveToggle"
                                      VerticalAlignment="Center"
                                      Margin="0,0,6,0"
                                      Cursor="Hand"
                                      Foreground="{DynamicResource Accent}"
                                      ToolTip="暫停或恢復所有防護（不會關閉應用程式）"
                                      AutomationProperties.Name="暫停或恢復防護 / Pause or resume protection"
                                      AutomationProperties.HelpText="暫停或恢復所有防護（不會關閉應用程式）"
                                      Checked="OnPowerSaveToggled"
                                      Unchecked="OnPowerSaveToggled">
                                <CheckBox.Template>
                                    <ControlTemplate TargetType="CheckBox">
                                        <Border x:Name="Bd"
                                                Background="{DynamicResource SurfaceMuted}"
                                                BorderBrush="{DynamicResource Separator}"
                                                BorderThickness="1"
                                                CornerRadius="{StaticResource Radius.pill}"
                                                Padding="12,6"
                                                SnapsToDevicePixels="True">
                                            <TextBlock x:Name="PowerSaveLabel"
                                                       Text="暫停"
                                                       FontSize="12" FontWeight="SemiBold"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Accent}"/>
                                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                                                <Setter TargetName="PowerSaveLabel" Property="Text" Value="恢復"/>
                                                <Setter Property="Foreground" Value="White"/>
                                            </Trigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </CheckBox.Template>
                            </CheckBox>

                            <!-- 設定 / Settings -->
                            <Button x:Name="SettingsBtn"
                                    Style="{StaticResource PillButtonStyle}"
                                    Content="設定 / Settings"
                                    Margin="0,0,8,0"
                                    Click="OnSettingsClicked"
                                    AutomationProperties.Name="設定 / Settings"
                                    ToolTip="設定 / Settings"/>

                            <!-- BOTTOM-RIGHT: flip to chat face (↩). -->
                            <Button x:Name="FlipBtn"
                                    Content="&#x21A9;"
                                    Width="28" Height="28"
                                    Padding="0" BorderThickness="0"
                                    Background="Transparent"
                                    Foreground="{DynamicResource Accent}"
                                    FontSize="16"
                                    Cursor="Hand"
                                    VerticalAlignment="Center"
                                    Click="OnFlipClicked"
                                    AutomationProperties.Name="開啟對話 / Open chat"
                                    ToolTip="跟 SenseEase 說話 / Talk to SenseEase"/>
                        </StackPanel>
                    </Grid>

                    <!-- Hidden legacy action buttons. Kept so the host's
                         EngageClicked / MuteClicked / dashboard wiring still
                         compiles; no longer surfaced in the new bar. The +
                         pill ALSO raises EngageClicked (see code-behind). -->
                    <StackPanel Visibility="Collapsed" IsHitTestVisible="False">
                        <Button x:Name="OpenDashboardBtn" Click="OnOpenDashboardClicked" Content="開啟主視窗"/>
                        <Button x:Name="EngageBtn" Click="OnEngageClicked" Content="緩和畫面"/>
                        <Button x:Name="MuteBtn" Click="OnMuteClicked" Content="6 小時內不再提示"/>
                    </StackPanel>
                </Grid>

                <!-- ── CHAT FACE (shown after flip) ─────────────────────────── -->
                <Grid x:Name="ChatFace" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>  <!-- back arrow -->
                        <ColumnDefinition Width="*"/>     <!-- input -->
                        <ColumnDefinition Width="Auto"/>  <!-- send -->
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- flip-back affordance (back arrow). -->
                    <Button Grid.Row="0" Grid.Column="0"
                            x:Name="FlipBackBtn"
                            Content="&#x2190;"
                            Width="28" Height="28"
                            Padding="0" BorderThickness="0"
                            Background="Transparent"
                            Foreground="{DynamicResource Accent}"
                            FontSize="16"
                            Cursor="Hand"
                            VerticalAlignment="Center"
                            Margin="0,0,8,0"
                            Click="OnFlipClicked"
                            AutomationProperties.Name="返回 / Back"
                            ToolTip="返回 / Back"/>

                    <TextBox Grid.Row="0" Grid.Column="1"
                             x:Name="ChatInputBox"
                             Background="{DynamicResource SurfaceMuted}"
                             Foreground="{DynamicResource TextPrimary}"
                             BorderBrush="{DynamicResource Separator}"
                             BorderThickness="1"
                             Padding="8,6"
                             FontSize="12"
                             MaxLength="240"
                             VerticalContentAlignment="Center"
                             KeyDown="OnChatInputKeyDown"
                             Margin="0,0,8,0">
                        <TextBox.Resources>
                            <VisualBrush x:Key="PlaceholderBrush" Stretch="None" AlignmentX="Left">
                                <VisualBrush.Visual>
                                    <TextBlock Text="跟 SenseEase 說話" Foreground="{DynamicResource TextTertiary}" FontSize="12" Margin="2,0,0,0"/>
                                </VisualBrush.Visual>
                            </VisualBrush>
                        </TextBox.Resources>
                        <TextBox.Style>
                            <Style TargetType="TextBox">
                                <Style.Triggers>
                                    <Trigger Property="Text" Value="">
                                        <Setter Property="Background" Value="{StaticResource PlaceholderBrush}"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </TextBox.Style>
                    </TextBox>

                    <Button Grid.Row="0" Grid.Column="2"
                            x:Name="ChatSendBtn"
                            Content="send"
                            Click="OnChatSendClicked"
                            Style="{StaticResource PrimaryDeepBlueButtonStyle}"
                            Padding="14,6"/>

                    <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2"
                               x:Name="ChatStatusText"
                               Text=""
                               FontSize="10"
                               Foreground="{DynamicResource TextSecondary}"
                               Margin="2,4,0,0"
                               TextWrapping="Wrap"
                               MaxHeight="32"/>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
