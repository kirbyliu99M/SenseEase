<Window x:Class="SenseEase.App.Views.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SenseEase Overlay"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        WindowState="Maximized"
        IsHitTestVisible="False">
    <Grid>
        <!-- Static anchor grid. NE30: Opacity starts at 0 so a DrawGrid fired by
             a SizeChanged / DPI-monitor change before the first ApplyState can
             never flash full-strength grid lines across the whole screen; the
             intensity is ramped up only when the mask actually engages. -->
        <Canvas x:Name="GridCanvas" Opacity="0" />
        <!-- Chang-Hain three-zone radial FOV mask -->
        <Rectangle x:Name="FovMask" IsHitTestVisible="False" />
    </Grid>
</Window>
