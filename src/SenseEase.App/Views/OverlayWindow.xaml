<Window x:Class="SenseEase.App.Views.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SenseEase Overlay"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ResizeMode="NoResize"
        WindowState="Maximized"
        IsHitTestVisible="False">
    <!-- E fix (2026-06-15): ShowInTaskbar="False" was REMOVED. With it set, WPF creates a hidden
         owner HWND that does NOT receive WS_EX_TOPMOST — a documented cause of intermittent z-order
         loss (the overlay dropping behind a fullscreen/borderless app). Taskbar + Alt-Tab absence
         is instead guaranteed by WS_EX_TOOLWINDOW (with WS_EX_APPWINDOW cleared), applied in
         OnSourceInitialized via ClickThrough.EnableSystemUiClickThrough BEFORE the window is shown,
         so dropping the attribute does NOT reintroduce a taskbar button. UVHS-visible (z-order). -->
    <!-- Beta A2 HYBRID (UVHS round 2, 2026-06-11): content split by spatial frequency.
         A 1.2 px world-locked hairline grid CANNOT survive rasterization into the
         quarter-res field bitmap (each line becomes a fat bilinear-blurred band that
         pops in 4 px-quantized steps — the "grid FORM wrong / grid JUMPS" verdict), so
         only LOW-frequency content lives in the reduced-res field; the grid stays full-
         res vector geometry.

         z-order (bottom → top), both click-through:
           1. FieldImage  — the reduced-res FOV-mask dim + folded cell-fill tint, bilinear-
                            upscaled (Stretch=Fill). One per-pixel field, one alpha.
           2. GridCanvas  — full-resolution white Chang-Hain anchor Line shapes, windowed by
                            an inverse-feather RadialGradientBrush OpacityMask on the one-clock
                            pose. Drawn OVER the dim so the faint lines read in the dimmed
                            periphery; the clear-centre window keeps the centre grid-free.
                            Opacity starts at 0 (NE30 anti-flash) — ApplyGridIntensity ramps it. -->
    <Grid>
        <!-- BitmapScalingMode=LowQuality is WPF's BILINEAR (linear) interpolation — the
             correct, cheap upscale for the low-frequency field (Kirby round-3 item 4.4):
             a smooth gradient, no Fant/HighQuality cost, no nearest-neighbour stepping. -->
        <Image x:Name="FieldImage"
               IsHitTestVisible="False"
               Stretch="Fill"
               RenderOptions.BitmapScalingMode="LowQuality" />
        <Canvas x:Name="GridCanvas"
                IsHitTestVisible="False"
                Opacity="0" />
    </Grid>
</Window>
