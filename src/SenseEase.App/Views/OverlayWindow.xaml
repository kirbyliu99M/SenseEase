<Window x:Class="SenseEase.App.Views.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SenseEase Overlay"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        WindowState="Maximized"
        IsHitTestVisible="False">
    <Grid>
        <!-- Static anchor grid -->
        <Canvas x:Name="GridCanvas" />
        <!-- Chang-Hain three-zone radial FOV mask -->
        <Rectangle x:Name="FovMask" IsHitTestVisible="False" />
    </Grid>
</Window>
