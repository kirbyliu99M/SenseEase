<Window x:Class="SenseEase.App.Views.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SenseEase Overlay"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        WindowState="Maximized"
        IsHitTestVisible="False">
    <!-- Beta A2 (single-pass field): the mask, cell-fill and anchor grid were three
         independently-shaped translucent strata (a Gestalt common-fate / scission
         "multilayer halo"). They are now ONE per-pixel field computed into a single
         premultiplied-BGRA WriteableBitmap and presented through this one Image with
         smooth (bilinear) upscale from reduced resolution. One alpha per pixel → no
         stacked layers, no separate cell-fill rect, no scalar-radius "breathing".
         Stretch=Fill so the reduced-res field covers the maximized window; the
         RenderOptions hint keeps the low-frequency gradient smooth rather than blocky. -->
    <Grid>
        <Image x:Name="FieldImage"
               IsHitTestVisible="False"
               Stretch="Fill"
               RenderOptions.BitmapScalingMode="LowQuality" />
    </Grid>
</Window>
