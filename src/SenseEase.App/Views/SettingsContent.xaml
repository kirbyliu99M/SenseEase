<UserControl x:Class="SenseEase.App.Views.SettingsContent"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:SenseEase.App.Localization"
             FontFamily="{DynamicResource Font.UI}"
             Background="Transparent">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/SenseEase.App;component/Theme/SenseEaseTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- SettingSwitch (calm iOS-style toggle) moved to SenseEaseTheme.xaml
                 (UI/UX fine-tune 2026-06-07) so the dashboard's Overlay Adjustment
                 toggle shares ONE source with the Settings page. Resolved here via
                 the merged theme dictionary above; consumers below are unchanged. -->

            <!-- Appearance setting (2026-06-07): segmented-control segment.
                 Three of these RadioButtons (GroupName="ThemeMode") form a
                 single pill-grouped selector: 自動 / 淺色 / 深色. Each segment is
                 a ≥44px-tall touch target with a clear selected fill (Accent),
                 hover lift, and keyboard-focus ring — all via DynamicResource
                 tokens so it tracks both themes. Selection is NOT colour-only:
                 the picked segment also goes SemiBold + TextOnComfort so it
                 reads without relying on hue. 160ms colour transitions keep the
                 state change calm, not snappy. -->
            <Style x:Key="ThemeSegment" TargetType="RadioButton">
                <Setter Property="FocusVisualStyle" Value="{DynamicResource FocusVisible}"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="MinHeight" Value="44"/>
                <Setter Property="MinWidth" Value="84"/>
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="FontWeight" Value="Medium"/>
                <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RadioButton">
                            <!-- Fill is token-driven (DynamicResource via the
                                 triggers below) so it tracks BOTH themes — the
                                 selected segment picks up the light indigo or the
                                 brighter dark-mode indigo automatically. This
                                 matches the established SettingSwitch pattern in
                                 this same file (token swap, not a hardcoded
                                 ColorAnimation that would freeze one theme's hue). -->
                            <Border x:Name="SegBorder"
                                    Background="Transparent"
                                    CornerRadius="{StaticResource Radius.sm}"
                                    SnapsToDevicePixels="True">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  Margin="14,0"
                                                  RecognizesAccessKey="True"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <!-- Hover (unselected): gentle muted fill -->
                                <MultiTrigger>
                                    <MultiTrigger.Conditions>
                                        <Condition Property="IsMouseOver" Value="True"/>
                                        <Condition Property="IsChecked" Value="False"/>
                                    </MultiTrigger.Conditions>
                                    <Setter TargetName="SegBorder" Property="Background"
                                            Value="{DynamicResource Surface}"/>
                                    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                                </MultiTrigger>
                                <!-- Selected: Accent fill, on-accent text, SemiBold
                                     so selection survives without relying on hue. -->
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="SegBorder" Property="Background"
                                            Value="{DynamicResource Accent}"/>
                                    <Setter Property="Foreground" Value="{DynamicResource TextOnComfort}"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                </Trigger>
                                <!-- Disabled: dim -->
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.4"/>
                                    <Setter Property="Cursor" Value="Arrow"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Tighter variant of ThemeSegment for the Appearance capsule only
                 (UI/UX fine-tune 2026-06-07): short labels (自動/淺色/深色) looked
                 loose in the 44×84 segments. MinHeight 44→36, MinWidth 84→60 hugs
                 the labels. Inherits the ThemeSegment template (incl. the 14,0
                 content margin, which MinWidth=60 now governs). Language selector
                 keeps the full ThemeSegment. -->
            <Style x:Key="ThemeSegmentTight" TargetType="RadioButton"
                   BasedOn="{StaticResource ThemeSegment}">
                <Setter Property="MinHeight" Value="36"/>
                <Setter Property="MinWidth" Value="60"/>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>
    <!-- UI Consolidation Sprint M-Phase-1 (2026-05-30): shared settings UI
         hosted by BOTH the main console's "設定" tab and the topmost
         SettingsWindow opened from the tray menu / Pop-up Card gear. State
         sharing is automatic — every toggle writes through to the static
         UserPreferences.Current + AppConfig.* singletons, and the
         UserPreferences.Changed event re-hydrates peer instances.

         Phase 1.5 polish (post-smoke-test, user feedback):
           • Fully token-driven palette — every card surface, text, border,
             separator, toggle track and accent resolves via {DynamicResource}
             from the merged theme tokens (Surface / CardBorder / Separator /
             TextPrimary / TextSecondary / TextTertiary / Accent …), so the
             whole panel tracks BOTH light and dark. Dark-mode correctness
             relies on ThemeManager.TrackElement(this) (see code-behind):
             this UserControl merges the light theme into its OWN Resources for
             the non-colour StaticResource tokens, which would otherwise shadow
             the Window-level dark palette, so the dark override is merged into
             this control's own resources too.
           • "需重新啟動" badge replaced with an actual "立即重啟" Button
             that restarts the app via a delayed cmd handoff (releases
             single-instance mutex before relaunching).
           • Close button (in SettingsWindow.xaml) restyled to light.

         The Close button intentionally stays in SettingsWindow.xaml because
         it's window-chrome; the Settings tab has no Close affordance. -->
    <Border Background="{DynamicResource Canvas}"
            CornerRadius="{StaticResource Radius.md}"
            Effect="{StaticResource Elev.3}"
            Padding="24" Margin="6">
        <ScrollViewer VerticalScrollBarVisibility="Auto" Style="{DynamicResource AutoHideScroll}">
            <!-- M3 regroup (2026-06-06): the formerly flat single scroll is now
                 organised into three visually-grouped {StaticResource Surface}
                 section cards (Radius.md + Elev.2), each opened by a
                 {StaticResource Type.Heading} title and using {StaticResource
                 Separator} hairlines to divide its rows. The long bilingual
                 helper paragraphs keep one concise line inline and tuck the
                 remainder behind a small collapsed "了解更多 / Learn more"
                 Expander. RESTYLE/REGROUP only — every x:Name, handler and
                 binding is byte-identical to the previous flat layout. -->
            <StackPanel>
                <!-- ═══ Section 0 · 外觀 / Appearance ═══════════════════════════
                     Appearance setting (2026-06-07): user theme choice.
                     A 3-segment selector (自動 / 淺色 / 深色) wired to
                     ThemeManager.SetMode via OnThemeModeChanged. The whole
                     selector sits in a SurfaceMuted "track" so the three pills
                     read as one grouped control; the selected pill fills Accent.
                     Hydrated from UserPreferences.ThemeMode in
                     RefreshFromPreferences (guarded by _wiring like the rest). -->
                <Border Background="{DynamicResource Surface}"
                        BorderBrush="{DynamicResource CardBorder}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource Radius.md}"
                        Effect="{StaticResource Elev.2}"
                        Padding="20,18"
                        Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Type.Heading}"
                                   Text="{loc:T Zh='外觀', En='Appearance'}"
                                   Margin="0,0,0,12"/>

                        <!-- Segmented control: one SurfaceMuted track wrapping
                             three equal-width RadioButton segments. The track is
                             Radius.md (12) so the inner segments' Radius.sm (8)
                             nest cleanly inside the 3px padding. -->
                        <Border Background="{DynamicResource SurfaceMuted}"
                                BorderBrush="{DynamicResource CardBorder}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource Radius.md}"
                                Padding="3"
                                HorizontalAlignment="Left">
                            <UniformGrid Rows="1" Columns="3">
                                <RadioButton x:Name="ThemeAuto"
                                             Style="{StaticResource ThemeSegmentTight}"
                                             GroupName="ThemeMode"
                                             Content="{loc:T Zh='自動', En='Auto'}"
                                             ToolTip="{loc:T Zh='跟隨 Windows 系統的淺色 / 深色設定', En='Follow the Windows system light / dark setting'}"
                                             Checked="OnThemeModeChanged"/>
                                <RadioButton x:Name="ThemeLight"
                                             Style="{StaticResource ThemeSegmentTight}"
                                             GroupName="ThemeMode"
                                             Content="{loc:T Zh='淺色', En='Light'}"
                                             ToolTip="{loc:T Zh='永遠使用淺色主題', En='Always use the light theme'}"
                                             Checked="OnThemeModeChanged"/>
                                <RadioButton x:Name="ThemeDark"
                                             Style="{StaticResource ThemeSegmentTight}"
                                             GroupName="ThemeMode"
                                             Content="{loc:T Zh='深色', En='Dark'}"
                                             ToolTip="{loc:T Zh='永遠使用深色主題', En='Always use the dark theme'}"
                                             Checked="OnThemeModeChanged"/>
                            </UniformGrid>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- ═══ Section 0.5 · 語言 / Language ═══════════════════════════
                     Language setting (2026-06-07): live UI-language toggle,
                     modelled byte-for-byte on the Appearance segmented control
                     above (same Border/UniformGrid/ThemeSegment chrome). Two
                     segments (繁體中文 / English) wired to OnLanguageModeChanged,
                     which sets LocalizationManager.Current.Language AND persists
                     UserPreferences.LanguageModeRaw. Hydrated from the persisted
                     language in RefreshFromPreferences (guarded by _wiring like
                     the rest), so re-checking a segment during hydration doesn't
                     loop back. The whole UI re-picks its {loc:T} text live on
                     toggle — no restart needed for the language switch itself. -->
                <Border Background="{DynamicResource Surface}"
                        BorderBrush="{DynamicResource CardBorder}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource Radius.md}"
                        Effect="{StaticResource Elev.2}"
                        Padding="20,18"
                        Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Type.Heading}"
                                   Text="{loc:T Zh='語言', En='Language'}"
                                   Margin="0,0,0,12"/>

                        <!-- Segmented control: one SurfaceMuted track wrapping
                             two equal-width RadioButton segments, mirroring the
                             Appearance selector exactly. -->
                        <Border Background="{DynamicResource SurfaceMuted}"
                                BorderBrush="{DynamicResource CardBorder}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource Radius.md}"
                                Padding="3"
                                HorizontalAlignment="Left">
                            <UniformGrid Rows="1" Columns="2">
                                <RadioButton x:Name="LanguageChinese"
                                             Style="{StaticResource ThemeSegment}"
                                             GroupName="LanguageMode"
                                             Content="繁體中文"
                                             ToolTip="{loc:T Zh='以繁體中文顯示介面', En='Show the interface in Traditional Chinese'}"
                                             Checked="OnLanguageModeChanged"/>
                                <RadioButton x:Name="LanguageEnglish"
                                             Style="{StaticResource ThemeSegment}"
                                             GroupName="LanguageMode"
                                             Content="English"
                                             ToolTip="{loc:T Zh='以英文顯示介面', En='Show the interface in English'}"
                                             Checked="OnLanguageModeChanged"/>
                            </UniformGrid>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- ═══ Section 1 · 通知與顯示 / Notifications & display ═══ -->
                <Border Background="{DynamicResource Surface}"
                        BorderBrush="{DynamicResource CardBorder}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource Radius.md}"
                        Effect="{StaticResource Elev.2}"
                        Padding="20,18"
                        Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Type.Heading}"
                                   Text="{loc:T Zh='通知與顯示', En='Notifications &amp; display'}"
                                   Margin="0,0,0,14"/>

                        <!-- Toggle A: auto-expand notifications -->
                        <StackPanel Orientation="Vertical">
                            <CheckBox x:Name="ToggleAuto"
                                      Style="{StaticResource SettingSwitch}"
                                      Content="{loc:T Zh='讓 SenseEase 主動提醒', En='Let SenseEase remind me proactively'}"
                                      Foreground="{DynamicResource TextPrimary}"
                                      FontSize="13"
                                      Checked="OnToggleAutoChanged"
                                      Unchecked="OnToggleAutoChanged"/>
                            <TextBlock Text="{loc:T Zh='偵測到中度以上不適時自動通知', En='Notifies automatically on moderate-or-higher discomfort.'}"
                                       FontSize="12"
                                       Foreground="{DynamicResource TextTertiary}"
                                       TextWrapping="Wrap"
                                       Margin="22,4,0,0"/>
                        </StackPanel>

                        <!-- Bar/Tray colour toggle removed (2026-06-09, user request).
                             D-10 (2026-06-11): UserPreferences.BarTrayColorEnabled
                             (Toggle B) was deleted along with its tray/bar colour
                             consumers — the band signal is now always the calm
                             non-colour treatment. -->
                    </StackPanel>
                </Border>

                <!-- ═══ Section 2 · 背景常駐 / Background & startup ═══ -->
                <Border Background="{DynamicResource Surface}"
                        BorderBrush="{DynamicResource CardBorder}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource Radius.md}"
                        Effect="{StaticResource Elev.2}"
                        Padding="20,18"
                        Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Type.Heading}"
                                   Text="{loc:T Zh='背景模式', En='Background mode'}"
                                   Margin="0,0,0,14"/>

                        <StackPanel Orientation="Vertical">
                            <CheckBox x:Name="ToggleMinimizeToTray"
                                      Style="{StaticResource SettingSwitch}"
                                      Content="{loc:T Zh='關閉視窗時最小化到系統匣 (不結束程式)', En='Minimise to the tray when the window closes (keep running)'}"
                                      Foreground="{DynamicResource TextPrimary}"
                                      FontSize="13"
                                      Checked="OnToggleMinimizeToTrayChanged"
                                      Unchecked="OnToggleMinimizeToTrayChanged"/>
                            <TextBlock Text="{loc:T Zh='按下主視窗的 X 只會收到系統匣，背景持續偵測。', En='Pressing X on the main window just sends it to the tray; detection keeps running in the background.'}"
                                       FontSize="12"
                                       Foreground="{DynamicResource TextTertiary}"
                                       TextWrapping="Wrap"
                                       Margin="22,4,0,0"/>
                            <Expander Header="{loc:T Zh='了解更多', En='Learn more'}"
                                      FontSize="12"
                                      Foreground="{DynamicResource TextTertiary}"
                                      IsExpanded="False"
                                      Margin="22,2,0,0">
                                <TextBlock Text="{loc:T Zh='開啟時，按下主視窗的 X 只會把視窗收到右下角的系統匣，SenseEase 持續在背景偵測。要完全結束請用系統匣選單的「退出 SenseEase」。', En='When on, pressing X on the main window sends it to the system tray (bottom-right) and SenseEase keeps detecting in the background. To quit completely, use Quit SenseEase in the tray menu.'}"
                                           FontSize="12"
                                           Foreground="{DynamicResource TextTertiary}"
                                           TextWrapping="Wrap"
                                           Margin="0,4,0,0"/>
                            </Expander>
                        </StackPanel>

                        <Border Height="1" Background="{DynamicResource Separator}" Margin="0,14"/>

                        <StackPanel Orientation="Vertical">
                            <CheckBox x:Name="ToggleRunAtStartup"
                                      Style="{StaticResource SettingSwitch}"
                                      Content="{loc:T Zh='開機時自動啟動 SenseEase', En='Start SenseEase automatically at startup'}"
                                      Foreground="{DynamicResource TextPrimary}"
                                      FontSize="13"
                                      Checked="OnToggleRunAtStartupChanged"
                                      Unchecked="OnToggleRunAtStartupChanged"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- ═══ Section 3 · 頭部追蹤與隱私 / Head tracking & privacy ═══ -->
                <Border Background="{DynamicResource Surface}"
                        BorderBrush="{DynamicResource CardBorder}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource Radius.md}"
                        Effect="{StaticResource Elev.2}"
                        Padding="20,18"
                        Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Type.Heading}"
                                   Text="{loc:T Zh='頭部追蹤與隱私', En='Head tracking &amp; privacy'}"
                                   Margin="0,0,0,14"/>

                        <StackPanel Orientation="Vertical">
                            <StackPanel Orientation="Horizontal">
                                <CheckBox x:Name="ToggleHeadTrackingEnabled"
                                          Style="{StaticResource SettingSwitch}"
                                          Content="{loc:T Zh='啟用頭部追蹤', En='Enable Head Tracking'}"
                                          Foreground="{DynamicResource TextPrimary}"
                                          FontSize="13"
                                          VerticalAlignment="Center"
                                          Checked="OnToggleHeadTrackingEnabledChanged"
                                          Unchecked="OnToggleHeadTrackingEnabledChanged"/>
                                <!-- Phase 1.5 user feedback: badge replaced with a
                                     real Button that restarts the app. Click prompts
                                     confirmation, then spawns a delayed cmd handoff
                                     (timeout 2 → start) so the current process can
                                     release the single-instance mutex before the new
                                     instance launches. -->
                                <!-- UX-08 (B1b): the chip is now SHOWN ONLY when the
                                     toggle differs from the app-start value (pending
                                     restart). Default Collapsed; code-behind
                                     (UpdateRestartChip) flips it. It no longer lies on
                                     every Settings open. -->
                                <Button x:Name="RestartButton"
                                        Visibility="Collapsed"
                                        Content="{loc:T Zh='需重新啟動', En='Restart needed'}"
                                        Margin="10,0,0,0"
                                        Padding="10,5"
                                        FontSize="12"
                                        FontWeight="SemiBold"
                                        Foreground="{DynamicResource ComfortRisingText}"
                                        Background="{DynamicResource ComfortRisingWeak}"
                                        BorderBrush="{DynamicResource ComfortRising}"
                                        BorderThickness="1"
                                        Cursor="Hand"
                                        Click="OnRestartClicked"
                                        ToolTip="{loc:T Zh='點擊立即重啟 SenseEase 以套用頭部追蹤變更', En='Click to restart SenseEase now and apply head-tracking changes'}"/>
                            </StackPanel>

                            <!-- UX-08 (B1b) B1 consent copy at the point of decision:
                                 the webcam / local-only line the 頭部追蹤與隱私 group was
                                 missing. ≥12px caption; wording is the locked B1
                                 invariant. -->
                            <TextBlock Text="{loc:T Zh='開啟後會使用視訊鏡頭，影像僅在本機處理，不會儲存或上傳。', En='Uses your webcam; processed locally — never stored or uploaded.'}"
                                       FontSize="12"
                                       Foreground="{DynamicResource TextTertiary}"
                                       TextWrapping="Wrap"
                                       Margin="22,4,0,0"/>

                            <!-- FEAT-08 (CW-10, B1b UI half): one-line head-tracking
                                 health status from the B1a SidecarHeadPoseReader health
                                 API (Healthy / NoFrames / Dead). Status is NOT colour-
                                 only — a leading glyph + a plain-language word carry the
                                 meaning ("never colour alone"). Hidden until the host
                                 wires GetHeadTrackingHealth (the no-MainViewModel popup
                                 path has no reader); code-behind sets text + glyph +
                                 token in RefreshHeadTrackingHealth. -->
                            <StackPanel x:Name="HeadTrackingHealthRow"
                                        Orientation="Horizontal"
                                        Visibility="Collapsed"
                                        Margin="22,6,0,0">
                                <TextBlock x:Name="HeadTrackingHealthGlyph"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center"
                                           Margin="0,0,6,0"/>
                                <TextBlock x:Name="HeadTrackingHealthText"
                                           FontSize="12"
                                           VerticalAlignment="Center"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                        </StackPanel>

                        <Border Height="1" Background="{DynamicResource Separator}" Margin="0,14"/>

                        <!-- UX-08 (B1b): the follow-mode radios are now IsEnabled-bound
                             to the head-tracking toggle, so they don't look live while
                             tracking is off (an honesty fix — inert-looking-but-live
                             controls misrepresent state). The 追蹤模式 label dims with
                             them for a coherent disabled group. -->
                        <StackPanel Orientation="Vertical"
                                    IsEnabled="{Binding IsChecked, ElementName=ToggleHeadTrackingEnabled}">
                            <TextBlock Text="{loc:T Zh='追蹤模式', En='Tracking mode'}"
                                       FontSize="12" FontWeight="Bold"
                                       Foreground="{DynamicResource TextPrimary}"
                                       Margin="22,0,0,4"/>
                            <RadioButton x:Name="FollowModeBalanced"
                                         GroupName="HeadTrackingFollowMode"
                                         Content="{loc:T Zh='平衡 (建議)', En='Balanced (recommended)'}"
                                         Foreground="{DynamicResource TextPrimary}"
                                         FontSize="13"
                                         Margin="22,2,0,0"
                                         Checked="OnFollowModeChanged"/>
                            <RadioButton x:Name="FollowModeFull"
                                         GroupName="HeadTrackingFollowMode"
                                         Content="{loc:T Zh='完整追蹤（邊緣較完整）', En='Full tracking (more complete edges)'}"
                                         Foreground="{DynamicResource TextPrimary}"
                                         FontSize="13"
                                         Margin="22,8,0,0"
                                         Checked="OnFollowModeChanged"/>
                        </StackPanel>

                        <!-- 「啟用暫時透明」 escape-hatch section (toggle + description +
                             vestibular note) removed entirely (2026-06-09, user request). -->
                    </StackPanel>
                </Border>

                <!-- ═══ Section 3.4 · 漸進適應 / Graded exposure (D-1) ═══════════
                     D-1 (CW-1 step 3, 2026-06-11): the graded-exposure (habituation)
                     opt-in reinstated as a Settings toggle. Graded exposure defaults
                     PAUSED; the old dashboard toggle was removed 2026-06-09, so this
                     is the only user-intent path that resumes/pauses the program.
                     Mirrors the head-tracking group's chrome + SettingSwitch toggle
                     + ≥12px caption exactly. Hydrated from the host's live engine
                     state (or the persisted pref on the no-MainViewModel popup) in
                     RefreshFromPreferences, guarded by _wiring. Copy is §6-compliant:
                     describes the APP relaxing protection while the user is
                     comfortable — no 耐受/tolerance/therapy/recovery claims. -->
                <Border Background="{DynamicResource Surface}"
                        BorderBrush="{DynamicResource CardBorder}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource Radius.md}"
                        Effect="{StaticResource Elev.2}"
                        Padding="20,18"
                        Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Type.Heading}"
                                   Text="{loc:T Zh='漸進適應', En='Graded exposure'}"
                                   Margin="0,0,0,14"/>

                        <StackPanel Orientation="Vertical">
                            <CheckBox x:Name="ToggleGradedExposure"
                                      Style="{StaticResource SettingSwitch}"
                                      Content="{loc:T Zh='啟用漸進適應（緩慢提高舒適度）', En='Enable graded exposure (slowly builds comfort)'}"
                                      Foreground="{DynamicResource TextPrimary}"
                                      FontSize="13"
                                      Checked="OnToggleGradedExposureChanged"
                                      Unchecked="OnToggleGradedExposureChanged"/>
                            <TextBlock Text="{loc:T Zh='開啟後，SenseEase 會在您舒適時逐步、緩慢地放寬防護，幫助您按自己的步調適應。隨時可暫停。', En='When on, SenseEase gradually relaxes protection while you are comfortable, helping you adjust at your own pace. Pause anytime.'}"
                                       FontSize="12"
                                       Foreground="{DynamicResource TextTertiary}"
                                       TextWrapping="Wrap"
                                       Margin="22,4,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- ═══ Section 3.5 · 事件記錄 / Event Log ═══════════════════════
                     UI/UX fine-tune (2026-06-07): the former top-level 事件記錄 tab
                     became a button here that opens the dedicated EventLogWindow —
                     declutters the primary nav and keeps the log full-page in its own
                     window. Grouped near 資料與隱私 (both are records/diagnostics).
                     Hidden unless the host wired OpenEventLog (code-behind OnLoaded). -->
                <Border x:Name="EventLogCard"
                        Background="{DynamicResource Surface}"
                        BorderBrush="{DynamicResource CardBorder}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource Radius.md}"
                        Effect="{StaticResource Elev.2}"
                        Padding="20,18"
                        Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Type.Heading}"
                                   Text="{loc:T Zh='事件記錄', En='Event Log'}"
                                   Margin="0,0,0,12"/>
                        <Button x:Name="OpenEventLogButton"
                                Content="{loc:T Zh='開啟事件記錄', En='Open event log'}"
                                HorizontalAlignment="Left"
                                Padding="14,7"
                                FontSize="12"
                                FontWeight="SemiBold"
                                Foreground="{DynamicResource TextOnComfort}"
                                Background="{DynamicResource Accent}"
                                BorderThickness="0"
                                Cursor="Hand"
                                Click="OnOpenEventLogClicked"
                                ToolTip="{loc:T Zh='在獨立視窗開啟事件／診斷紀錄', En='Open the event / diagnostic log in its own window'}"/>
                    </StackPanel>
                </Border>

                <!-- ═══ Section 3.6 · 偏好設定 / Preferences (D-15) ═══════════════
                     D-15 (2026-06-11): "重設偏好設定 / Reset preferences" — wires the
                     existing UserPreferences.ResetToDefaults() to a Settings action
                     behind a ThemedDialog confirm that plainly enumerates what resets
                     (theme, language, the notification / background toggles, and the
                     saved HUD-card position). Deliberately kept in its OWN card,
                     APART from the 資料與隱私 "Clear all my data" button below and
                     with a distinct caption, so the two never read as the same action:
                     this resets PREFERENCES; that clears DATA. Q4.5-safe — it touches
                     only the preferences file, never the earned habituation offset.
                     After reset the visible controls re-hydrate and the theme / language
                     re-apply immediately (see OnResetPreferencesClicked). -->
                <Border Background="{DynamicResource Surface}"
                        BorderBrush="{DynamicResource CardBorder}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource Radius.md}"
                        Effect="{StaticResource Elev.2}"
                        Padding="20,18"
                        Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Type.Heading}"
                                   Text="{loc:T Zh='偏好設定', En='Preferences'}"
                                   Margin="0,0,0,14"/>
                        <TextBlock Text="{loc:T Zh='把外觀、語言、通知與背景開關，以及通知卡片的位置還原成預設值。不會刪除你的資料或漸進適應進度。', En='Restore appearance, language, the notification &amp; background toggles, and the notification-card position to their defaults. This does not delete your data or graded-exposure progress.'}"
                                   FontSize="12"
                                   Foreground="{DynamicResource TextTertiary}"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,10"/>
                        <Button x:Name="ResetPreferencesButton"
                                Content="{loc:T Zh='重設偏好設定', En='Reset preferences'}"
                                HorizontalAlignment="Left"
                                Padding="14,7"
                                FontSize="12"
                                FontWeight="SemiBold"
                                Foreground="{DynamicResource TextPrimary}"
                                Background="{DynamicResource SurfaceMuted}"
                                BorderBrush="{DynamicResource CardBorder}"
                                BorderThickness="1"
                                Cursor="Hand"
                                Click="OnResetPreferencesClicked"
                                ToolTip="{loc:T Zh='把外觀、語言、通知與背景開關及通知卡片位置還原成預設值；不影響你的資料或漸進適應進度。', En='Restore appearance, language, notification &amp; background toggles, and the notification-card position to defaults; your data and graded-exposure progress are unaffected.'}"/>
                    </StackPanel>
                </Border>

                <!-- ═══ Section 4 · 資料與隱私 / Data & privacy (H24) ═══ -->
                <Border Background="{DynamicResource Surface}"
                        BorderBrush="{DynamicResource CardBorder}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource Radius.md}"
                        Effect="{StaticResource Elev.2}"
                        Padding="20,18"
                        Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Type.Heading}"
                                   Text="{loc:T Zh='資料與隱私', En='Data &amp; privacy'}"
                                   Margin="0,0,0,14"/>
                        <!-- UX-09 + FEAT-13 (B1b): the label said "all my data" but the
                             clear path used to skip the two content-bearing PII files
                             (chat transcript + legacy calibration history). The clear
                             path now includes both; this caption + the confirm dialog
                             plainly enumerate everything deleted and everything kept, so
                             the label no longer overstates its scope. ≥12px caption. -->
                        <TextBlock Text="{loc:T Zh='清除 SenseEase 為你建立的長期行為紀錄、分析索引、長期觀察、模型診斷追蹤、對話紀錄與舊版校正紀錄。你的漸進適應進度與偏好設定會保留，此動作無法復原。', En='Clear the behaviour log, analysis index, longitudinal observations, model diagnostic trace, chat transcript, and legacy calibration history SenseEase has built about you. Your graded-exposure progress and preferences are kept. This cannot be undone.'}"
                                   FontSize="12"
                                   Foreground="{DynamicResource TextTertiary}"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,10"/>
                        <Button x:Name="ClearAllDataButton"
                                Content="{loc:T Zh='清除所有資料並重設', En='Clear all my data and reset'}"
                                HorizontalAlignment="Left"
                                Padding="14,7"
                                FontSize="12"
                                FontWeight="SemiBold"
                                Foreground="{DynamicResource ComfortHighText}"
                                Background="{DynamicResource ComfortHighWeak}"
                                BorderBrush="{DynamicResource ComfortHigh}"
                                BorderThickness="1"
                                Cursor="Hand"
                                Click="OnClearAllDataClicked"
                                ToolTip="{loc:T Zh='刪除行為紀錄、分析索引、長期觀察、模型追蹤、對話紀錄與舊版校正紀錄；保留漸進適應進度與偏好設定。', En='Deletes the behaviour log, analysis index, longitudinal observations, model trace, chat transcript, and legacy calibration history; keeps your graded-exposure progress and preferences.'}"/>

                        <!-- Beta-1 D-16 (2026-06-14): per-app attribution consent.
                             OFF by default; flipping ON lets SenseEase record which
                             foreground app + coarse category was active when a comfort
                             event fires, so personalisation can learn per-app triggers.
                             STRICTLY on-device (D-16) — the app name never leaves the
                             machine. Runtime-changeable: WindowsActivityFilter reads the
                             live flag each foreground change (no restart needed). -->
                        <Border Background="{DynamicResource Separator}" Height="1" Margin="0,18,0,14"/>
                        <CheckBox x:Name="TogglePerAppAttribution"
                                  Content="{loc:T Zh='記錄使用中的應用程式（協助個人化）', En='Record which app I am using (helps personalisation)'}"
                                  Foreground="{DynamicResource TextPrimary}" FontSize="12"
                                  Checked="OnTogglePerAppAttributionChanged"
                                  Unchecked="OnTogglePerAppAttributionChanged"/>
                        <TextBlock Text="{loc:T Zh='開啟後，SenseEase 會在不適發生時記錄你正在使用哪個應用程式及其類別，用來學習個別的觸發來源。所有資料僅在本機處理，應用程式名稱永遠不會上傳。', En='When on, SenseEase records which app (and its category) was active when discomfort occurs, to learn your individual triggers. All data stays on this device — the app name is never uploaded.'}"
                                   FontSize="12" Foreground="{DynamicResource TextTertiary}"
                                   TextWrapping="Wrap" Margin="0,6,0,0"/>

                        <!-- Phase-1 (2026-06-16): opt-in for the event-driven contextual check-in. -->
                        <CheckBox x:Name="ToggleProactiveCheckIns"
                                  Content="{loc:T Zh='動態較多時順手問我的感受（事件提醒）', En='Check in on how I feel after intense motion (event prompts)'}"
                                  Foreground="{DynamicResource TextPrimary}" FontSize="12"
                                  Margin="0,14,0,0"
                                  Checked="OnToggleProactiveCheckInsChanged"
                                  Unchecked="OnToggleProactiveCheckInsChanged"/>
                        <TextBlock Text="{loc:T Zh='開啟後，偵測到大量畫面動態時會出現一個可一鍵回應的小提醒，詢問你的不適程度。完全選用、可隨時關閉，並有頻率限制以避免打擾；資料僅存於本機。', En='When on, a one-tap prompt appears after a burst of on-screen motion, asking how you feel. Fully optional, dismissible, rate-limited so it never nags, and stored on this device only.'}"
                                   FontSize="12" Foreground="{DynamicResource TextTertiary}"
                                   TextWrapping="Wrap" Margin="0,6,0,0"/>

                        <!-- B5 (2026-06-17): opt-in for the deterministic auto-adaptation tuner. -->
                        <CheckBox x:Name="ToggleAdaptiveAutoTune"
                                  Content="{loc:T Zh='讓 SenseEase 依我的回報自動微調防護強度', En='Let SenseEase auto-tune protection strength from my reports'}"
                                  Foreground="{DynamicResource TextPrimary}" FontSize="12"
                                  Margin="0,14,0,0"
                                  Checked="OnToggleAdaptiveAutoTuneChanged"
                                  Unchecked="OnToggleAdaptiveAutoTuneChanged"/>
                        <TextBlock Text="{loc:T Zh='開啟後，SenseEase 會依你最近的感受回報與使用情況，自動且小幅地調整防護強度（每次幅度有上限、可隨時在設定中重置）。每次調整都會在對話中告知你。完全選用、預設關閉；所有判斷皆在本機進行。', En='When on, SenseEase makes small automatic adjustments to protection strength based on your recent check-ins and usage (each step is capped and can be reset anytime). Every change is announced in the chat. Fully optional, off by default; all decisions happen on this device.'}"
                                   FontSize="12" Foreground="{DynamicResource TextTertiary}"
                                   TextWrapping="Wrap" Margin="0,6,0,0"/>

                        <!-- Beta-1 D-17 (2026-06-14): de-identified clinical export. Builds a
                             numbers-and-categories-only aggregate (measured vs estimated kept
                             separate) to share with a clinician — never a raw app name, an
                             utterance, or a finer-than-date timestamp. OnExportClinicalClicked
                             → ClinicalExportService.WriteJson. -->
                        <Border Background="{DynamicResource Separator}" Height="1" Margin="0,18,0,14"/>
                        <TextBlock Text="{loc:T Zh='健康報告匯出', En='Health report export'}"
                                   Foreground="{DynamicResource TextPrimary}" FontSize="13" FontWeight="SemiBold"
                                   Margin="0,0,0,6"/>
                        <TextBlock Text="{loc:T Zh='匯出一份去識別化的數據摘要（僅數字與類別，不含應用程式名稱或對話內容），可提供給醫療人員參考。測量值與估計值會分開呈現。', En='Export a de-identified numeric summary (numbers and categories only — no app names or conversation text) to share with a clinician. Measured and estimated values are shown separately.'}"
                                   FontSize="12" Foreground="{DynamicResource TextTertiary}"
                                   TextWrapping="Wrap" Margin="0,0,0,10"/>
                        <Button x:Name="ExportClinicalButton"
                                Content="{loc:T Zh='匯出健康報告…', En='Export health report…'}"
                                HorizontalAlignment="Left" Padding="14,7" FontSize="12" FontWeight="SemiBold"
                                Cursor="Hand" Click="OnExportClinicalClicked"
                                ToolTip="{loc:T Zh='把去識別化的數值摘要存成 JSON 檔。', En='Save a de-identified numeric summary as a JSON file.'}"/>
                        <!-- D-redesign: not-a-medical-device disclaimer on the health export.
                             Wording is checked against the §6 BannedPhraseLint medical-claim
                             vocabulary (describes the tool, not the user's clinical state). -->
                        <TextBlock Text="{loc:T Zh='SenseEase 為健康輔助工具，並非醫療器材。這些自評數值僅供您與醫療人員參考，並非臨床評估。', En='SenseEase is a wellness tool, not a medical device. These self-reported values are for reference by you and your clinician only — not a clinical assessment.'}"
                                   FontSize="11" Foreground="{DynamicResource TextTertiary}" FontStyle="Italic"
                                   TextWrapping="Wrap" Margin="0,8,0,0"/>

                        <!-- Raw per-check-in CSV export for the user's own long-term analysis
                             (distinct from the de-identified clinician report above). -->
                        <Border Background="{DynamicResource Separator}" Height="1" Margin="0,18,0,14"/>
                        <TextBlock Text="{loc:T Zh='匯出原始紀錄（CSV）', En='Export raw data (CSV)'}"
                                   Foreground="{DynamicResource TextPrimary}" FontSize="13" FontWeight="SemiBold"
                                   Margin="0,0,0,6"/>
                        <TextBlock Text="{loc:T Zh='把你的每一筆感受紀錄（含時間與當時情境）匯出成 CSV，方便長期用試算表或統計工具分析。這是你自己的資料，僅在你主動匯出時才離開本機。', En='Export every one of your check-ins (with its timestamp and context) as a CSV for long-term analysis in a spreadsheet or stats tool. This is your own data; it only leaves this device when you choose to export it.'}"
                                   FontSize="12" Foreground="{DynamicResource TextTertiary}"
                                   TextWrapping="Wrap" Margin="0,0,0,10"/>
                        <Button x:Name="ExportSymptomCsvButton"
                                Content="{loc:T Zh='匯出原始紀錄…', En='Export raw data…'}"
                                HorizontalAlignment="Left" Padding="14,7" FontSize="12" FontWeight="SemiBold"
                                Cursor="Hand" Click="OnExportSymptomCsvClicked"
                                ToolTip="{loc:T Zh='把每一筆感受紀錄存成 CSV 檔。', En='Save every check-in as a CSV file.'}"/>

                        <!-- Alpha-2 addendum (auto-profiling world only): the vestibular
                             "regret" toggle + the Reset that moved here from the console.
                             Hidden unless AppConfig.AutoProfilingEnabled (set in OnLoaded). -->
                        <StackPanel x:Name="AutoProfilingDataGroup" Visibility="Collapsed" Margin="0,18,0,0">
                            <Border Background="{DynamicResource Separator}" Height="1" Margin="0,0,0,14"/>
                            <CheckBox x:Name="VestibularProtectionToggle"
                                      Content="{loc:T Zh='暈眩防護（敏感模式）', En='Dizziness protection (sensitive mode)'}"
                                      Foreground="{DynamicResource TextPrimary}" FontSize="12"
                                      Checked="OnVestibularProtectionChanged"
                                      Unchecked="OnVestibularProtectionChanged"/>
                            <TextBlock Text="{loc:T Zh='若您感到暈眩或不適，可開啟此防護。', En='If you feel dizzy or uncomfortable, you can enable this protection.'}"
                                       FontSize="12" Foreground="{DynamicResource TextTertiary}"
                                       TextWrapping="Wrap" Margin="0,6,0,14"/>
                            <Button x:Name="ResetStateButton"
                                    Content="{loc:T Zh='重設個人化狀態', En='Reset personalisation state'}"
                                    HorizontalAlignment="Left" Padding="14,7" FontSize="12" FontWeight="SemiBold"
                                    Foreground="{DynamicResource ComfortHighText}"
                                    Background="{DynamicResource ComfortHighWeak}"
                                    BorderBrush="{DynamicResource ComfortHigh}" BorderThickness="1" Cursor="Hand"
                                    Click="OnResetStateClicked"
                                    ToolTip="{loc:T Zh='清除暫時的個人化（遮罩微調），保留你已養成的習慣化進度。', En='Clears transient personalisation (shader tweaks); keeps your earned habituation progress.'}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Phase 5 follow-up (v0.11, 2026-05-31): developer / QA test
                     hotkey reference table. Per user request, labeled as "dev
                     test usage" — this is not a normal-user feature. Lists the
                     window-scoped hotkey the app currently registers so future
                     testing has a single discoverable reference. TEMP UVHS
                     scaffolds (F11 from Step 7, F12 from Step 3) are
                     intentionally NOT listed — they were reverted before
                     their respective commits.

                     D-10 (2026-06-11): the double-tap-Ctrl overlay escape-hatch
                     row was removed because the feature was retired entirely
                     (OverlayWindow.TriggerEscapeHatch deleted,
                     AppConfig.HeadTrackingEscapeHatchEnabled retired) — the row
                     documented a hotkey that no longer exists.

                     Hidden 2026-05-31: user reported the remaining listed hotkey
                     (Ctrl+Shift+H mock head-pose sweep) is non-functional in
                     current builds. Showing this table would mislead testers
                     about a feature that doesn't actually work. Beta follow-up:
                     diagnose why the Key.H branch of MainWindow.PreviewKeyDown
                     doesn't fire end-to-end — the F11 UVHS-P5-7 scaffold worked
                     from the same lambda, so PreviewKeyDown wiring itself is
                     fine; the issue is downstream (key detection state machine,
                     ViewModel command invocation, or the target method
                     StartMockHeadPoseSweep itself). Once fixed, flip
                     Visibility="Collapsed" back to Visible to re-expose the
                     reference table. -->
                <StackPanel Margin="0,8,0,0" Visibility="Collapsed">
                    <TextBlock Text="{loc:T Zh='開發者測試快捷鍵', En='Developer Test Hotkeys'}"
                               FontSize="14" FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimary}"
                               Margin="0,0,0,6"/>
                    <TextBlock Text="{loc:T Zh='以下快捷鍵為開發 / QA 測試用途，非一般使用流程的一部分。', En='These are for development / QA testing only, not part of the normal user flow.'}"
                               FontSize="12"
                               Foreground="{DynamicResource TextTertiary}"
                               TextWrapping="Wrap"
                               Margin="0,0,0,10"/>
                    <Border Background="{DynamicResource SurfaceMuted}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" CornerRadius="{StaticResource Radius.sm}" Padding="14,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="170"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/> <!-- header -->
                                <RowDefinition Height="Auto"/> <!-- row 1: Ctrl+Shift+H -->
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="{loc:T Zh='快捷鍵', En='Hotkey'}"
                                       FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource Accent}" Margin="0,0,0,6"/>
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{loc:T Zh='作用', En='Effect'}"
                                       FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource Accent}" Margin="0,0,0,6"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Ctrl + Shift + H"
                                       FontFamily="Consolas" FontSize="12" Foreground="{DynamicResource TextPrimary}" Margin="0,2,0,2"/>
                            <TextBlock Grid.Row="1" Grid.Column="1"
                                       Text="{loc:T Zh='觸發 20 秒模擬頭部姿勢掃描 (橫向→縱向→圓形→中心持住)。用於無 webcam 機器驗證 wiring 端到端，與 AppConfig.HeadTrackingEnabled 無關。', En='Triggers a 20-second mock head-pose sweep (horizontal→vertical→circular→hold centre). Used to verify wiring end-to-end on webcam-less machines. Independent of AppConfig.HeadTrackingEnabled.'}"
                                       FontSize="12" Foreground="{DynamicResource TextPrimary}" TextWrapping="Wrap" Margin="0,2,0,2"/>
                        </Grid>
                    </Border>
                    <TextBlock Text="{loc:T Zh='提示：所有快捷鍵僅在主控台視窗有焦點時觸發 (PreviewKeyDown 範圍)。', En='Note: all hotkeys fire only when the main console window has focus.'}"
                               FontSize="12" Foreground="{DynamicResource TextTertiary}" FontStyle="Italic"
                               TextWrapping="Wrap" Margin="0,8,0,0"/>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Border>
</UserControl>
