<UserControl x:Class="SenseEase.App.Views.SettingsContent"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:SenseEase.App.Localization"
             FontFamily="{DynamicResource Font.UI}"
             Background="Transparent">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/SenseEase.App;component/Theme/SenseEaseTheme.xaml"/>
                <!-- GLASS BRIDGE: redefines the SenseEaseTheme colour keys with the popup's glass
                     values so Settings matches the brand panel (slate by default; the Game-Bar dark
                     variant flips in via SettingsGlassTheme.Track). Merged ABOVE SenseEaseTheme so
                     glass wins; structural tokens (radius/elevation/type) still resolve underneath. -->
                <ResourceDictionary Source="pack://application:,,,/SenseEase.App;component/Theme/SettingsGlassPalette.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- SettingSwitch (calm iOS-style toggle) moved to SenseEaseTheme.xaml
                 (UI/UX fine-tune 2026-06-07) so the dashboard's Overlay Adjustment
                 toggle shares ONE source with the Settings page. Resolved here via
                 the merged theme dictionary above; consumers below are unchanged. -->

            <!-- Appearance setting (2026-06-07): segmented-control segment.
                 Three of these RadioButtons (GroupName="ThemeMode") form a
                 single pill-grouped selector: 自動 / 淺色 / 深色. Each segment is
                 a ≥44px-tall touch target with a clear selected fill (Accent),
                 hover lift, and keyboard-focus ring — all via DynamicResource
                 tokens so it tracks both themes. Selection is NOT colour-only:
                 the picked segment also goes SemiBold + TextOnComfort so it
                 reads without relying on hue. 160ms colour transitions keep the
                 state change calm, not snappy. -->
            <Style x:Key="ThemeSegment" TargetType="RadioButton">
                <Setter Property="FocusVisualStyle" Value="{DynamicResource FocusVisible}"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="MinHeight" Value="44"/>
                <Setter Property="MinWidth" Value="84"/>
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="FontWeight" Value="Medium"/>
                <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RadioButton">
                            <!-- Fill is token-driven (DynamicResource via the
                                 triggers below) so it tracks BOTH themes — the
                                 selected segment picks up the light indigo or the
                                 brighter dark-mode indigo automatically. This
                                 matches the established SettingSwitch pattern in
                                 this same file (token swap, not a hardcoded
                                 ColorAnimation that would freeze one theme's hue). -->
                            <Border x:Name="SegBorder"
                                    Background="Transparent"
                                    CornerRadius="{StaticResource Radius.sm}"
                                    SnapsToDevicePixels="True">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  Margin="14,0"
                                                  RecognizesAccessKey="True"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <!-- Hover (unselected): gentle muted fill -->
                                <MultiTrigger>
                                    <MultiTrigger.Conditions>
                                        <Condition Property="IsMouseOver" Value="True"/>
                                        <Condition Property="IsChecked" Value="False"/>
                                    </MultiTrigger.Conditions>
                                    <Setter TargetName="SegBorder" Property="Background"
                                            Value="{DynamicResource Surface}"/>
                                    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                                </MultiTrigger>
                                <!-- Selected: Accent fill, on-accent text, SemiBold
                                     so selection survives without relying on hue. -->
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="SegBorder" Property="Background"
                                            Value="{DynamicResource Accent}"/>
                                    <Setter Property="Foreground" Value="{DynamicResource TextOnComfort}"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                </Trigger>
                                <!-- Disabled: dim -->
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.4"/>
                                    <Setter Property="Cursor" Value="Arrow"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Tighter variant of ThemeSegment for the Appearance capsule only
                 (UI/UX fine-tune 2026-06-07): short labels (自動/淺色/深色) looked
                 loose in the 44×84 segments. MinHeight 44→36, MinWidth 84→60 hugs
                 the labels. Inherits the ThemeSegment template (incl. the 14,0
                 content margin, which MinWidth=60 now governs). Language selector
                 keeps the full ThemeSegment. -->
            <Style x:Key="ThemeSegmentTight" TargetType="RadioButton"
                   BasedOn="{StaticResource ThemeSegment}">
                <Setter Property="MinHeight" Value="36"/>
                <Setter Property="MinWidth" Value="60"/>
            </Style>

            <!-- ONE-PIECE GLASS REDESIGN (2026-06-18): the small-caps-weight group header.
                 Replaces the per-section 16px Type.Heading — a 12px SemiBold tertiary label is
                 the macOS/iOS grouped-list section header, the single biggest "tighter/less
                 blank" lever (drops a 16px+22px-line title per group to 12px+inline). The
                 window's "Settings" title (16px) carries the one top-level heading. -->
            <Style x:Key="GroupHeader" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{DynamicResource Font.UI}"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Foreground" Value="{DynamicResource TextTertiary}"/>
                <Setter Property="TextWrapping" Value="Wrap"/>
                <Setter Property="Margin" Value="2,0,0,8"/>
            </Style>

            <!-- ONE-PIECE GLASS REDESIGN: the calm inter-group seam. A faint GroupDivider
                 hairline so the scroll reads as one continuous frosted list (not stacked
                 tiles). Groups that can collapse (EventLogCard) carry their OWN leading
                 divider INSIDE the group so no orphan hairline is left behind. -->
            <Style x:Key="GroupSeam" TargetType="Border">
                <Setter Property="Height" Value="1"/>
                <Setter Property="Background" Value="{DynamicResource GroupDivider}"/>
                <Setter Property="Margin" Value="0,18"/>
            </Style>

            <!-- Calm glass ComboBox (2026-06-21) — retires the native Aero combo (item #2) so the range
                 picker matches the panel: a flat RecessField box, a hairline that warms to the indigo
                 Accent on hover/open, a thin vector chevron, and a flat themed dropdown with an Accent
                 selected-row. NO drop-shadow/blur — the software-render contract + the effect-free calm
                 the popup bar already uses. GlassComboItem must precede GlassComboBox (StaticResource ref). -->
            <Style x:Key="GlassComboItem" TargetType="ComboBoxItem">
                <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="Padding" Value="9,6"/>
                <Setter Property="SnapsToDevicePixels" Value="True"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ComboBoxItem">
                            <Border x:Name="row" Background="Transparent" CornerRadius="5"
                                    Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                                <ContentPresenter VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="row" Property="Background" Value="{DynamicResource SurfaceMuted}"/>
                                    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="row" Property="Background" Value="{DynamicResource SurfaceMuted}"/>
                                    <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="GlassComboBox" TargetType="ComboBox">
                <Setter Property="Height" Value="30"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="SnapsToDevicePixels" Value="True"/>
                <Setter Property="TextOptions.TextRenderingMode" Value="ClearType"/>
                <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
                <Setter Property="ItemContainerStyle" Value="{StaticResource GlassComboItem}"/>
                <Setter Property="FocusVisualStyle" Value="{DynamicResource FocusVisible}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ComboBox">
                            <Grid>
                                <ToggleButton x:Name="Toggle" Focusable="False" ClickMode="Press"
                                              IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Border x:Name="box" Background="{DynamicResource RecessField}"
                                                    BorderBrush="{DynamicResource CardBorder}" BorderThickness="1"
                                                    CornerRadius="6" SnapsToDevicePixels="True">
                                                <Path x:Name="chev" HorizontalAlignment="Right" VerticalAlignment="Center"
                                                      Margin="0,0,11,0" Data="M0,0 L4,4 L8,0"
                                                      Stroke="{DynamicResource TextSecondary}" StrokeThickness="1.4"
                                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                      StrokeLineJoin="Round"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="box" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                                                    <Setter TargetName="chev" Property="Stroke" Value="{DynamicResource TextPrimary}"/>
                                                </Trigger>
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Setter TargetName="box" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                                                    <Setter TargetName="chev" Property="Stroke" Value="{DynamicResource Accent}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                </ToggleButton>
                                <ContentPresenter x:Name="sel" IsHitTestVisible="False"
                                                  Content="{TemplateBinding SelectionBoxItem}"
                                                  ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                  Margin="11,0,30,0" VerticalAlignment="Center" HorizontalAlignment="Left"
                                                  TextElement.Foreground="{DynamicResource TextPrimary}"/>
                                <Popup x:Name="PART_Popup" Placement="Bottom" VerticalOffset="4"
                                       IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True"
                                       Focusable="False" PopupAnimation="Fade">
                                    <Border MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                            Background="{DynamicResource Surface}" BorderBrush="{DynamicResource CardBorder}"
                                            BorderThickness="1" CornerRadius="6" Padding="3" SnapsToDevicePixels="True">
                                        <ScrollViewer MaxHeight="220">
                                            <ItemsPresenter/>
                                        </ScrollViewer>
                                    </Border>
                                </Popup>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.5"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <!-- UI Consolidation Sprint M-Phase-1 (2026-05-30): shared settings UI hosted by the
         topmost SettingsWindow (tray menu / popup-bar gear). State sharing is automatic —
         every toggle writes through to the static UserPreferences.Current + AppConfig.*
         singletons, and the UserPreferences.Changed event re-hydrates peer instances.

         ONE-PIECE GLASS REDESIGN (2026-06-18): the former "card of cards" — a transparent
         Elev.3 outer Border wrapping ~9 raised Surface+Elev.2 section tiles with 16px gaps —
         collapses to a SINGLE flat list. The host window's rounded Surface slab over the Win11
         acrylic (SettingsWindow.xaml) is now the ONE glass piece; this control is chrome-light
         content inside it. Sections are flat groups with a 12px GroupHeader, divided by faint
         GroupSeam hairlines — the popup's "one frosted panel, internal facets" idiom
         (PopupBarWindow ChatPanel), not stacked Material cards. Controls keep their own glass
         facets: the segmented tracks (SurfaceMuted), the recessed hotkey field (RecessField =
         the popup ChatInput), the Comfort* destructive buttons. This is a container / material /
         spacing reshape ONLY — every x:Name, Checked/Unchecked/Click handler, binding, loc:T
         string and FontSize is byte-identical to the previous tiled layout. -->
    <ScrollViewer VerticalScrollBarVisibility="Auto" Style="{DynamicResource AutoHideScroll}"
                  Padding="0,0,8,0">
        <StackPanel>

            <!-- ═══ 1 · 一般 / General ════════════════════════════════════════════
                 #7 five-section reorg (2026-06-21): Appearance + Language merged under one
                 "General" header (each picker keeps a small sub-label). The 2026-06-20 dead
                 "通知與顯示 / 主動提醒" toggle (#5) is removed — the card it drove is being retired
                 (see docs/NOTIFICATIONCARD_RETIREMENT_PLAN.md); the AutoExpandNotifications flag
                 defaults off, so removing the row leaves auto-show inert. All x:Names / handlers
                 are byte-identical to the prior layout — this is a regroup only. -->
            <StackPanel>
                <TextBlock Style="{StaticResource GroupHeader}"
                           Text="{loc:T Zh='一般', En='General'}"/>
                <!-- Appearance: 3-segment selector (自動 / 淺色 / 深色) → ThemeManager.SetMode. -->
                <TextBlock Text="{loc:T Zh='外觀', En='Appearance'}"
                           FontSize="12" Foreground="{DynamicResource TextSecondary}" Margin="2,0,0,6"/>
                <Border Background="{DynamicResource SurfaceMuted}"
                        BorderBrush="{DynamicResource CardBorder}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource Radius.md}"
                        Padding="3"
                        HorizontalAlignment="Left">
                    <UniformGrid Rows="1" Columns="3">
                        <RadioButton x:Name="ThemeAuto"
                                     Style="{StaticResource ThemeSegmentTight}"
                                     GroupName="ThemeMode"
                                     Content="{loc:T Zh='自動', En='Auto'}"
                                     ToolTip="{loc:T Zh='跟隨 Windows 系統的淺色 / 深色設定', En='Follow the Windows system light / dark setting'}"
                                     Checked="OnThemeModeChanged"/>
                        <RadioButton x:Name="ThemeLight"
                                     Style="{StaticResource ThemeSegmentTight}"
                                     GroupName="ThemeMode"
                                     Content="{loc:T Zh='淺色', En='Light'}"
                                     ToolTip="{loc:T Zh='永遠使用淺色主題', En='Always use the light theme'}"
                                     Checked="OnThemeModeChanged"/>
                        <RadioButton x:Name="ThemeDark"
                                     Style="{StaticResource ThemeSegmentTight}"
                                     GroupName="ThemeMode"
                                     Content="{loc:T Zh='深色', En='Dark'}"
                                     ToolTip="{loc:T Zh='永遠使用深色主題', En='Always use the dark theme'}"
                                     Checked="OnThemeModeChanged"/>
                    </UniformGrid>
                </Border>
                <!-- Language: 繁體中文 / English → OnLanguageModeChanged (live re-pick, no restart). -->
                <TextBlock Text="{loc:T Zh='語言', En='Language'}"
                           FontSize="12" Foreground="{DynamicResource TextSecondary}" Margin="2,14,0,6"/>
                <Border Background="{DynamicResource SurfaceMuted}"
                        BorderBrush="{DynamicResource CardBorder}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource Radius.md}"
                        Padding="3"
                        HorizontalAlignment="Left">
                    <UniformGrid Rows="1" Columns="2">
                        <RadioButton x:Name="LanguageChinese"
                                     Style="{StaticResource ThemeSegment}"
                                     GroupName="LanguageMode"
                                     Content="繁體中文"
                                     ToolTip="{loc:T Zh='以繁體中文顯示介面', En='Show the interface in Traditional Chinese'}"
                                     Checked="OnLanguageModeChanged"/>
                        <RadioButton x:Name="LanguageEnglish"
                                     Style="{StaticResource ThemeSegment}"
                                     GroupName="LanguageMode"
                                     Content="English"
                                     ToolTip="{loc:T Zh='以英文顯示介面', En='Show the interface in English'}"
                                     Checked="OnLanguageModeChanged"/>
                    </UniformGrid>
                </Border>
            </StackPanel>

            <!-- ═══ 2 · 舒適與防護 / Comfort & protection ═════════════════════════
                 #7 reorg: promoted to 2nd (most-consequential engine controls first). Graded
                 exposure (the sole pause/resume of habituation) + Head tracking. Blocks moved
                 verbatim from the old 漸進適應 + 頭部追蹤與隱私 groups. -->
            <Border Style="{StaticResource GroupSeam}"/>
            <StackPanel>
                <TextBlock Style="{StaticResource GroupHeader}"
                           Text="{loc:T Zh='舒適與防護', En='Comfort &amp; protection'}"/>
                <StackPanel Orientation="Vertical">
                    <CheckBox x:Name="ToggleGradedExposure"
                              Style="{StaticResource SettingSwitch}"
                              Content="{loc:T Zh='啟用漸進適應（緩慢提高舒適度）', En='Enable Adaptive Training (slowly builds comfort)'}"
                              Foreground="{DynamicResource TextPrimary}"
                              FontSize="13"
                              Checked="OnToggleGradedExposureChanged"
                              Unchecked="OnToggleGradedExposureChanged"/>
                    <TextBlock Text="{loc:T Zh='開啟後，SenseEase 會在您舒適時逐步、緩慢地放寬防護，幫助您按自己的步調適應。隨時可暫停。', En='When on, SenseEase gradually relaxes protection while you are comfortable, helping you adjust at your own pace. Pause anytime.'}"
                               FontSize="12"
                               Foreground="{DynamicResource TextTertiary}"
                               TextWrapping="Wrap"
                               Margin="22,4,0,0"/>
                </StackPanel>

                <Border Height="1" Background="{DynamicResource Separator}" Margin="0,12"/>

                <StackPanel Orientation="Vertical">
                    <StackPanel Orientation="Horizontal">
                        <CheckBox x:Name="ToggleHeadTrackingEnabled"
                                  Style="{StaticResource SettingSwitch}"
                                  Content="{loc:T Zh='啟用頭部追蹤', En='Enable Head Tracking'}"
                                  Foreground="{DynamicResource TextPrimary}"
                                  FontSize="13"
                                  VerticalAlignment="Center"
                                  Checked="OnToggleHeadTrackingEnabledChanged"
                                  Unchecked="OnToggleHeadTrackingEnabledChanged"/>
                        <!-- UX-08 (B1b): the chip is SHOWN ONLY when the toggle differs
                             from the app-start value (pending restart). Default Collapsed;
                             code-behind (UpdateRestartChip) flips it. -->
                        <Button x:Name="RestartButton"
                                Visibility="Collapsed"
                                Content="{loc:T Zh='需重新啟動', En='Restart needed'}"
                                Margin="10,0,0,0"
                                Padding="10,5"
                                FontSize="12"
                                FontWeight="SemiBold"
                                Foreground="{DynamicResource ComfortRisingText}"
                                Background="{DynamicResource ComfortRisingWeak}"
                                BorderBrush="{DynamicResource ComfortRising}"
                                BorderThickness="1"
                                Cursor="Hand"
                                Click="OnRestartClicked"
                                ToolTip="{loc:T Zh='點擊立即重啟 SenseEase 以套用頭部追蹤變更', En='Click to restart SenseEase now and apply head-tracking changes'}"/>
                    </StackPanel>

                    <!-- UX-08 (B1b) B1 consent copy at the point of decision: the webcam /
                         local-only line. ≥12px caption; wording is the locked B1 invariant. -->
                    <TextBlock Text="{loc:T Zh='開啟後會使用視訊鏡頭，影像僅在本機處理，不會儲存或上傳。', En='Uses your webcam; processed locally — never stored or uploaded.'}"
                               FontSize="12"
                               Foreground="{DynamicResource TextTertiary}"
                               TextWrapping="Wrap"
                               Margin="22,4,0,0"/>

                    <!-- FEAT-08 (CW-10, B1b UI half): one-line head-tracking health from the
                         B1a SidecarHeadPoseReader health API. Status is NOT colour-only — a
                         leading glyph + a plain-language word carry the meaning. Hidden until
                         the host wires GetHeadTrackingHealth; code-behind sets text + glyph +
                         token in RefreshHeadTrackingHealth. -->
                    <StackPanel x:Name="HeadTrackingHealthRow"
                                Orientation="Horizontal"
                                Visibility="Collapsed"
                                Margin="22,6,0,0">
                        <TextBlock x:Name="HeadTrackingHealthGlyph"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   Margin="0,0,6,0"/>
                        <TextBlock x:Name="HeadTrackingHealthText"
                                   FontSize="12"
                                   VerticalAlignment="Center"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </StackPanel>

                <!-- Head-tracking follow mode is fixed to FULL-FOLLOW (the Balanced option +
                     its radios were removed 2026-06-18, user request — no user choice). The
                     mode is forced in App.OnStartup; OverlayWindow reads AppConfig.HeadTrackingFollowMode. -->
            </StackPanel>

            <!-- ═══ 3 · 應用程式 / App behaviour ═══════════════════════════════════
                 #7 reorg: minimise-to-tray + run-at-startup + the Sidebar shortcut (the reveal
                 hotkey, pulled out of the old "背景模式" group where it was mis-filed). Blocks
                 verbatim from the old 背景模式 group. -->
            <Border Style="{StaticResource GroupSeam}"/>
            <StackPanel>
                <TextBlock Style="{StaticResource GroupHeader}"
                           Text="{loc:T Zh='應用程式', En='App behaviour'}"/>

                <StackPanel Orientation="Vertical">
                    <CheckBox x:Name="ToggleMinimizeToTray"
                              Style="{StaticResource SettingSwitch}"
                              Content="{loc:T Zh='關閉視窗時最小化到系統匣 (不結束程式)', En='Minimise to the tray when the window closes (keep running)'}"
                              Foreground="{DynamicResource TextPrimary}"
                              FontSize="13"
                              Checked="OnToggleMinimizeToTrayChanged"
                              Unchecked="OnToggleMinimizeToTrayChanged"/>
                    <TextBlock Text="{loc:T Zh='按下主視窗的 X 只會收到系統匣，背景持續偵測。', En='Pressing X on the main window just sends it to the tray; detection keeps running in the background.'}"
                               FontSize="12"
                               Foreground="{DynamicResource TextTertiary}"
                               TextWrapping="Wrap"
                               Margin="22,4,0,0"/>
                    <Expander Header="{loc:T Zh='了解更多', En='Learn more'}"
                              FontSize="12"
                              Foreground="{DynamicResource TextTertiary}"
                              IsExpanded="False"
                              Margin="22,2,0,0">
                        <TextBlock Text="{loc:T Zh='開啟時，按下主視窗的 X 只會把視窗收到右下角的系統匣，SenseEase 持續在背景偵測。要完全結束請用系統匣選單的「退出 SenseEase」。', En='When on, pressing X on the main window sends it to the system tray (bottom-right) and SenseEase keeps detecting in the background. To quit completely, use Quit SenseEase in the tray menu.'}"
                                   FontSize="12"
                                   Foreground="{DynamicResource TextTertiary}"
                                   TextWrapping="Wrap"
                                   Margin="0,4,0,0"/>
                    </Expander>
                </StackPanel>

                <Border Height="1" Background="{DynamicResource Separator}" Margin="0,12"/>

                <StackPanel Orientation="Vertical">
                    <CheckBox x:Name="ToggleRunAtStartup"
                              Style="{StaticResource SettingSwitch}"
                              Content="{loc:T Zh='開機時自動啟動 SenseEase', En='Start SenseEase automatically at startup'}"
                              Foreground="{DynamicResource TextPrimary}"
                              FontSize="13"
                              Checked="OnToggleRunAtStartupChanged"
                              Unchecked="OnToggleRunAtStartupChanged"/>
                </StackPanel>

                <Border Height="1" Background="{DynamicResource Separator}" Margin="0,12"/>

                <!-- ═══ TASK #7 · 喚出熱鍵 / Reveal hotkey ═══════════════════
                     A system-wide hotkey (default Win+Alt+S, customisable) that
                     reveals / toggles the glass popup bar even when SenseEase has no
                     foreground window. The current gesture is shown read-only; 錄製 /
                     Record arms a capture box (focused TextBox, PreviewKeyDown) that
                     records the next modifier+key chord, persists it
                     (UserPreferences.RevealHotkey) and asks the host to re-register the
                     live Win32 hotkey (SetRevealHotkey). Modifier-only presses are
                     ignored; Escape cancels. Fail-soft: an unregisterable chord just
                     leaves no global hotkey — the edge-sidebar click still reveals.
                     The chip + Record button use the RecessField dark inset so they
                     read as the popup's recessed ChatInput, not a foreign card. -->
                <StackPanel Orientation="Vertical">
                    <!-- #9: label renamed to 側欄快捷鍵 / Sidebar shortcut; description line removed. -->
                    <TextBlock Text="{loc:T Zh='側欄快捷鍵', En='Sidebar shortcut'}"
                               FontSize="13" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimary}"
                               Margin="0,0,0,10"/>
                    <StackPanel Orientation="Horizontal">
                        <!-- Current gesture, shown read-only. While recording, the
                             code-behind swaps this to a "press a combination…" prompt. -->
                        <Border Background="{DynamicResource RecessField}"
                                BorderBrush="{DynamicResource CardBorder}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource Radius.sm}"
                                Padding="12,7"
                                MinWidth="150"
                                VerticalAlignment="Center">
                            <TextBlock x:Name="RevealHotkeyDisplay"
                                       Text="Win+Alt+S"
                                       FontFamily="Consolas"
                                       FontSize="13"
                                       Foreground="{DynamicResource TextPrimary}"
                                       VerticalAlignment="Center"/>
                        </Border>
                        <!-- Invisible focus target that owns the key capture. A read-only
                             0-size TextBox is the simplest focusable element whose
                             PreviewKeyDown fires for chords; it never shows a caret or
                             accepts typed text. -->
                        <TextBox x:Name="HotkeyCaptureBox"
                                 Width="0" Height="0" Opacity="0"
                                 IsReadOnly="True"
                                 IsTabStop="False"
                                 PreviewKeyDown="OnHotkeyCaptureKeyDown"
                                 LostKeyboardFocus="OnHotkeyCaptureLostFocus"/>
                        <Button x:Name="RecordHotkeyButton"
                                Content="{loc:T Zh='自訂', En='Record'}"
                                Margin="10,0,0,0"
                                Padding="14,7"
                                FontSize="12"
                                FontWeight="SemiBold"
                                Foreground="{DynamicResource TextPrimary}"
                                Background="{DynamicResource SurfaceMuted}"
                                BorderBrush="{DynamicResource CardBorder}"
                                BorderThickness="1"
                                Cursor="Hand"
                                VerticalAlignment="Center"
                                Click="OnRecordHotkeyClicked"
                                ToolTip="{loc:T Zh='點擊後按下新的組合鍵（需含 Ctrl / Alt / Shift / Win）；Esc 取消。', En='Click, then press a new combination (must include Ctrl / Alt / Shift / Win); Esc cancels.'}"/>
                    </StackPanel>
                </StackPanel>
            </StackPanel>

            <!-- ═══ 4 · 隱私與資料 / Privacy & data ════════════════════════════════
                 #7 reorg: the consent toggles + health export + Event Log. The destructive
                 "Clear all my data" moved OUT to §5 (Reset & clear) so a wipe is not at the top
                 of a long group. Head-tracking's webcam consent moved to §2, so this group no
                 longer double-claims "privacy". All x:Names / handlers unchanged. -->
            <Border Style="{StaticResource GroupSeam}"/>
            <StackPanel>
                <TextBlock Style="{StaticResource GroupHeader}"
                           Text="{loc:T Zh='隱私與資料', En='Privacy &amp; data'}"/>

                <!-- Beta-1 D-16 (2026-06-14): per-app attribution consent. OFF by default;
                     flipping ON lets SenseEase record which foreground app + coarse category
                     was active when a comfort event fires. STRICTLY on-device — the app name
                     never leaves the machine. Runtime-changeable (no restart). -->
                <CheckBox x:Name="TogglePerAppAttribution"
                          Style="{StaticResource SettingSwitch}"
                          Content="{loc:T Zh='記錄使用中的應用程式（協助個人化）', En='Record which app I am using (helps personalisation)'}"
                          Foreground="{DynamicResource TextPrimary}" FontSize="12"
                          Checked="OnTogglePerAppAttributionChanged"
                          Unchecked="OnTogglePerAppAttributionChanged"/>
                <TextBlock Text="{loc:T Zh='開啟後，SenseEase 會在不適發生時記錄你正在使用哪個應用程式及其類別，用來學習個別的觸發來源。所有資料僅在本機處理，應用程式名稱永遠不會上傳。', En='When on, SenseEase records which app (and its category) was active when discomfort occurs, to learn your individual triggers. All data stays on this device — the app name is never uploaded.'}"
                           FontSize="12" Foreground="{DynamicResource TextTertiary}"
                           TextWrapping="Wrap" Margin="22,6,0,0"/>

                <!-- Phase-1 (2026-06-16): opt-in for the event-driven contextual check-in. -->
                <CheckBox x:Name="ToggleProactiveCheckIns"
                          Style="{StaticResource SettingSwitch}"
                          Content="{loc:T Zh='動態較多時順手問我的感受（事件提醒）', En='Check in on how I feel after intense motion (event prompts)'}"
                          Foreground="{DynamicResource TextPrimary}" FontSize="12"
                          Margin="0,14,0,0"
                          Checked="OnToggleProactiveCheckInsChanged"
                          Unchecked="OnToggleProactiveCheckInsChanged"/>
                <TextBlock Text="{loc:T Zh='開啟後，偵測到大量畫面動態時會出現一個可一鍵回應的小提醒，詢問你的不適程度。完全選用、可隨時關閉，並有頻率限制以避免打擾；資料僅存於本機。', En='When on, a one-tap prompt appears after a burst of on-screen motion, asking how you feel. Fully optional, dismissible, rate-limited so it never nags, and stored on this device only.'}"
                           FontSize="12" Foreground="{DynamicResource TextTertiary}"
                           TextWrapping="Wrap" Margin="22,6,0,0"/>

                <!-- B5 (2026-06-17): opt-in for the deterministic auto-adaptation tuner. -->
                <CheckBox x:Name="ToggleAdaptiveAutoTune"
                          Style="{StaticResource SettingSwitch}"
                          Content="{loc:T Zh='讓 SenseEase 依我的回報自動微調防護強度', En='Let SenseEase auto-tune protection strength from my reports'}"
                          Foreground="{DynamicResource TextPrimary}" FontSize="12"
                          Margin="0,14,0,0"
                          Checked="OnToggleAdaptiveAutoTuneChanged"
                          Unchecked="OnToggleAdaptiveAutoTuneChanged"/>
                <TextBlock Text="{loc:T Zh='開啟後，SenseEase 會依你最近的感受回報與使用情況，在背景自動且小幅地調整防護強度（每次幅度有上限，可隨時在設定中重置）。完全選用、預設關閉；所有判斷皆在本機進行。', En='When on, SenseEase quietly makes small automatic adjustments to protection strength based on your recent check-ins and usage (each step is capped, and you can reset it anytime in Settings). Fully optional, off by default; all decisions happen on this device.'}"
                           FontSize="12" Foreground="{DynamicResource TextTertiary}"
                           TextWrapping="Wrap" Margin="22,6,0,0"/>

                <!-- Beta-1 D-17 (2026-06-14): de-identified clinical export. Numbers-and-
                     categories-only aggregate (measured vs estimated kept separate) — never a
                     raw app name, an utterance, or a finer-than-date timestamp. -->
                <Border Background="{DynamicResource Separator}" Height="1" Margin="0,14,0,12"/>
                <TextBlock Text="{loc:T Zh='健康報告匯出', En='Health report export'}"
                           Foreground="{DynamicResource TextPrimary}" FontSize="13" FontWeight="SemiBold"
                           Margin="0,0,0,6"/>
                <TextBlock Text="{loc:T Zh='匯出一份去識別化的健康報告：可在瀏覽器開啟或列印的 HTML 報告（重點數字、圖表與簡短摘要），並在旁附上 JSON 數據紀錄。僅含數字與類別，不含應用程式名稱或對話內容；測量值與估計值分開呈現。', En='Export a de-identified health report — an HTML page (key numbers, charts, a short summary) you can open in a browser or print, with the JSON data record beside it. Numbers and categories only — no app names or conversation text; measured and estimated values are shown separately.'}"
                           FontSize="12" Foreground="{DynamicResource TextTertiary}"
                           TextWrapping="Wrap" Margin="0,0,0,10"/>
                <!-- #21: optional window scope for the export (defaults to all history). -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,10">
                    <TextBlock Text="{loc:T Zh='範圍', En='Range'}" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextSecondary}" FontSize="12" Margin="0,0,8,0"/>
                    <ComboBox x:Name="ExportRangeCombo" SelectedIndex="0" Width="170" FontSize="12"
                              Style="{StaticResource GlassComboBox}">
                        <ComboBoxItem Content="{loc:T Zh='全部時間', En='All time'}"/>
                        <ComboBoxItem Content="{loc:T Zh='最近 90 天', En='Last 90 days'}"/>
                        <ComboBoxItem Content="{loc:T Zh='最近 30 天', En='Last 30 days'}"/>
                    </ComboBox>
                </StackPanel>
                <Button x:Name="ExportClinicalButton"
                        Content="{loc:T Zh='匯出健康報告…', En='Export health report…'}"
                        HorizontalAlignment="Left" Padding="14,7" FontSize="12" FontWeight="SemiBold"
                        Foreground="{DynamicResource TextPrimary}"
                        Background="{DynamicResource SurfaceMuted}"
                        BorderBrush="{DynamicResource CardBorder}"
                        BorderThickness="1"
                        Cursor="Hand" Click="OnExportClinicalClicked"
                        ToolTip="{loc:T Zh='存成可在瀏覽器開啟或列印的 HTML 健康報告，並在旁附上 JSON 數據紀錄檔（皆為去識別化）。', En='Save an HTML health report you can open in a browser or print, with the JSON data record beside it (both de-identified).'}"/>
                <!-- D-redesign: not-a-medical-device disclaimer. Wording is §6 BannedPhraseLint
                     compliant (describes the tool, not the user's clinical state). -->
                <TextBlock Text="{loc:T Zh='SenseEase 為健康輔助工具，並非醫療器材。這些自評數值僅供您與醫療人員參考，並非臨床評估。本程式為一般視覺舒適輔助，不適用於臨床前庭／平衡疾病。', En='SenseEase is a wellness tool, not a medical device. These self-reported values are for reference by you and your clinician only — not a clinical assessment. SenseEase is for general visual comfort and is not for clinical vestibular or balance disorders.'}"
                           FontSize="11" Foreground="{DynamicResource TextTertiary}" FontStyle="Italic"
                           TextWrapping="Wrap" Margin="0,8,0,0"/>

                <!-- Raw per-check-in CSV export REMOVED 2026-06-18 (user): raw data is
                     LLM-access-only now — the user-facing export is the de-identified health
                     report above. The symptom store stays on-device for the engine/LLM. -->

                <!-- Event Log — opens the diagnostic log in its own window. Keeps x:Name="EventLogCard"
                     so code-behind collapses it (incl. its leading separator) as ONE unit when
                     OpenEventLog is unwired — no orphan hairline. -->
                <StackPanel x:Name="EventLogCard">
                    <Border Background="{DynamicResource Separator}" Height="1" Margin="0,14,0,12"/>
                    <Button x:Name="OpenEventLogButton"
                            Content="{loc:T Zh='開啟事件記錄', En='Open event log'}"
                            HorizontalAlignment="Left"
                            Padding="14,7"
                            FontSize="12"
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource TextOnComfort}"
                            Background="{DynamicResource Accent}"
                            BorderThickness="0"
                            Cursor="Hand"
                            Click="OnOpenEventLogClicked"
                            ToolTip="{loc:T Zh='在獨立視窗開啟事件／診斷紀錄', En='Open the event / diagnostic log in its own window'}"/>
                </StackPanel>

                <!-- Auto-profiling world only: the Reset that moved here from the console.
                     Hidden unless AppConfig.AutoProfilingEnabled (set in RefreshFromPreferences).
                     (Vestibular-removal: the dizziness-protection "regret" toggle was removed —
                     the app is now scoped to general comfort, not clinical vestibular disorders.) -->
                <StackPanel x:Name="AutoProfilingDataGroup" Visibility="Collapsed" Margin="0,14,0,0">
                    <Border Background="{DynamicResource Separator}" Height="1" Margin="0,0,0,12"/>
                    <Button x:Name="ResetStateButton"
                            Content="{loc:T Zh='重設個人化狀態', En='Reset personalisation state'}"
                            HorizontalAlignment="Left" Padding="14,7" FontSize="12" FontWeight="SemiBold"
                            Foreground="{DynamicResource ComfortHighText}"
                            Background="{DynamicResource ComfortHighWeak}"
                            BorderBrush="{DynamicResource ComfortHigh}" BorderThickness="1" Cursor="Hand"
                            Click="OnResetStateClicked"
                            ToolTip="{loc:T Zh='清除暫時的個人化（遮罩微調），保留你已養成的習慣化進度。', En='Clears transient personalisation (shader tweaks); keeps your earned habituation progress.'}"/>
                </StackPanel>
            </StackPanel>

            <!-- ═══ 5 · 重設與清除 / Reset & clear ═════════════════════════════════
                 #7 reorg: the data-control actions consolidated (were split across the old
                 "偏好設定" + "資料與隱私" groups) — Reset preferences (safe) first, then the
                 destructive "Clear all my data" LAST (top-down scan safety). x:Names unchanged. -->
            <Border Style="{StaticResource GroupSeam}"/>
            <StackPanel>
                <TextBlock Style="{StaticResource GroupHeader}"
                           Text="{loc:T Zh='重設與清除', En='Reset &amp; clear'}"/>
                <TextBlock Text="{loc:T Zh='把外觀、語言、通知與背景開關，以及通知卡片的位置還原成預設值。不會刪除你的資料或漸進適應進度。', En='Restore appearance, language, the notification &amp; background toggles, and the notification-card position to their defaults. This does not delete your data or Adaptive Training progress.'}"
                           FontSize="12"
                           Foreground="{DynamicResource TextTertiary}"
                           TextWrapping="Wrap"
                           Margin="0,0,0,10"/>
                <Button x:Name="ResetPreferencesButton"
                        Content="{loc:T Zh='重設偏好設定', En='Reset preferences'}"
                        HorizontalAlignment="Left"
                        Padding="14,7"
                        FontSize="12"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource TextPrimary}"
                        Background="{DynamicResource SurfaceMuted}"
                        BorderBrush="{DynamicResource CardBorder}"
                        BorderThickness="1"
                        Cursor="Hand"
                        Click="OnResetPreferencesClicked"
                        ToolTip="{loc:T Zh='把外觀、語言、通知與背景開關及通知卡片位置還原成預設值；不影響你的資料或漸進適應進度。', En='Restore appearance, language, notification &amp; background toggles, and the notification-card position to defaults; your data and Adaptive Training progress are unaffected.'}"/>

                <Border Background="{DynamicResource Separator}" Height="1" Margin="0,14,0,12"/>

                <!-- UX-09 + FEAT-13 (B1b): the caption + confirm dialog plainly enumerate
                     everything deleted and everything kept, so the label never overstates.
                     Destructive — placed LAST in the group (low-vision top-down scan safety). -->
                <TextBlock Text="{loc:T Zh='清除 SenseEase 為你建立的長期行為紀錄、分析索引、長期觀察、模型診斷追蹤、對話紀錄、感受紀錄與舊版校正紀錄。你的漸進適應進度與偏好設定會保留，此動作無法復原。', En='Clear the behaviour log, analysis index, longitudinal observations, model diagnostic trace, chat transcript, check-in history, and legacy calibration history SenseEase has built about you. Your Adaptive Training progress and preferences are kept. This cannot be undone.'}"
                           FontSize="12"
                           Foreground="{DynamicResource TextTertiary}"
                           TextWrapping="Wrap"
                           Margin="0,0,0,10"/>
                <Button x:Name="ClearAllDataButton"
                        Content="{loc:T Zh='清除所有資料並重設', En='Clear all my data and reset'}"
                        HorizontalAlignment="Left"
                        Padding="14,7"
                        FontSize="12"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource ComfortHighText}"
                        Background="{DynamicResource ComfortHighWeak}"
                        BorderBrush="{DynamicResource ComfortHigh}"
                        BorderThickness="1"
                        Cursor="Hand"
                        Click="OnClearAllDataClicked"
                        ToolTip="{loc:T Zh='刪除行為紀錄、分析索引、長期觀察、模型追蹤、對話紀錄與舊版校正紀錄；保留漸進適應進度與偏好設定。', En='Deletes the behaviour log, analysis index, longitudinal observations, model trace, chat transcript, and legacy calibration history; keeps your Adaptive Training progress and preferences.'}"/>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</UserControl>
