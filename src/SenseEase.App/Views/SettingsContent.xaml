<UserControl x:Class="SenseEase.App.Views.SettingsContent"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/SenseEase.App;component/Theme/SenseEaseTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <!-- UI Consolidation Sprint M-Phase-1 (2026-05-30): shared settings UI
         hosted by BOTH the main console's "設定" tab and the topmost
         SettingsWindow opened from the tray menu / Pop-up Card gear. State
         sharing is automatic — every toggle writes through to the static
         UserPreferences.Current + AppConfig.* singletons, and the
         UserPreferences.Changed event re-hydrates peer instances.

         Phase 1.5 polish (post-smoke-test, user feedback):
           • Light theme matching main console palette (#E2ECFF / White
             cards / #0A1F5C dark navy text / #024AD8 accent).
           • "需重新啟動" badge replaced with an actual "立即重啟" Button
             that restarts the app via a delayed cmd handoff (releases
             single-instance mutex before relaunching).
           • Close button (in SettingsWindow.xaml) restyled to light.

         The Close button intentionally stays in SettingsWindow.xaml because
         it's window-chrome; the Settings tab has no Close affordance. -->
    <Border Background="White" CornerRadius="14" Padding="24" Margin="6">
        <Border.Effect>
            <DropShadowEffect Color="#5B82C6" BlurRadius="14"
                              ShadowDepth="2" Opacity="0.08"/>
        </Border.Effect>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- 0: section title (notifications) -->
                    <RowDefinition Height="Auto"/> <!-- 1: toggle A row -->
                    <RowDefinition Height="Auto"/> <!-- 2: toggle B row -->
                    <RowDefinition Height="Auto"/> <!-- 3: background-section header -->
                    <RowDefinition Height="Auto"/> <!-- 4: toggle C: minimize to tray -->
                    <RowDefinition Height="Auto"/> <!-- 5: toggle D: run at startup -->
                    <RowDefinition Height="Auto"/> <!-- 6: head-tracking section header -->
                    <RowDefinition Height="Auto"/> <!-- 7: head-tracking enable -->
                    <RowDefinition Height="Auto"/> <!-- 8: follow mode group -->
                    <RowDefinition Height="Auto"/> <!-- 9: escape hatch -->
                    <RowDefinition Height="Auto"/> <!-- 10: dev test hotkeys reference table -->
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Text="通知與顯示"
                           FontSize="16" FontWeight="Bold"
                           Foreground="#0A1F5C"
                           Margin="0,0,0,16"/>

                <!-- Toggle A: auto-expand notifications -->
                <StackPanel Grid.Row="1" Orientation="Vertical" Margin="0,0,0,16">
                    <CheckBox x:Name="ToggleAuto"
                              Content="讓 SenseEase 主動展開通知卡"
                              Foreground="#0A1F5C"
                              FontSize="13"
                              Checked="OnToggleAutoChanged"
                              Unchecked="OnToggleAutoChanged"/>
                    <TextBlock Text="開啟時，系統偵測到中度以上不適會自動展開通知卡。預設關閉以避免非預期視覺干擾。"
                               FontSize="11"
                               Foreground="#7B8DB0"
                               TextWrapping="Wrap"
                               Margin="22,4,0,0"/>
                </StackPanel>

                <!-- Toggle B: bar/tray colour -->
                <StackPanel Grid.Row="2" Orientation="Vertical">
                    <CheckBox x:Name="ToggleColor"
                              Content="Bar 與 Tray 顏色隨 tier 變化"
                              Foreground="#0A1F5C"
                              FontSize="13"
                              Checked="OnToggleColorChanged"
                              Unchecked="OnToggleColorChanged"/>
                    <TextBlock Text="開啟時，bar 與 tray icon 顏色會依視覺壓力 tier 變化（灰 / 琥珀 / 紅）；關閉時永遠維持灰色透明。"
                               FontSize="11"
                               Foreground="#7B8DB0"
                               TextWrapping="Wrap"
                               Margin="22,4,0,0"/>
                </StackPanel>

                <TextBlock Grid.Row="3"
                           Text="背景常駐 / Background"
                           FontSize="14" FontWeight="Bold"
                           Foreground="#0A1F5C"
                           Margin="0,20,0,8"/>

                <StackPanel Grid.Row="4" Orientation="Vertical" Margin="0,0,0,12">
                    <CheckBox x:Name="ToggleMinimizeToTray"
                              Content="關閉視窗時最小化到工作匣 (不結束程式)"
                              Foreground="#0A1F5C"
                              FontSize="13"
                              Checked="OnToggleMinimizeToTrayChanged"
                              Unchecked="OnToggleMinimizeToTrayChanged"/>
                    <TextBlock Text="開啟時，按下主視窗的 X 只會把視窗收到右下角的工作匣，SenseEase 持續在背景偵測。要完全結束請用工作匣選單的「退出 SenseEase」。"
                               FontSize="11"
                               Foreground="#7B8DB0"
                               TextWrapping="Wrap"
                               Margin="22,4,0,0"/>
                </StackPanel>

                <StackPanel Grid.Row="5" Orientation="Vertical" Margin="0,0,0,8">
                    <CheckBox x:Name="ToggleRunAtStartup"
                              Content="登入 Windows 時自動啟動 SenseEase"
                              Foreground="#0A1F5C"
                              FontSize="13"
                              Checked="OnToggleRunAtStartupChanged"
                              Unchecked="OnToggleRunAtStartupChanged"/>
                    <TextBlock Text="開啟時，SenseEase 會跟著 Windows 登入自動啟動並直接最小化到工作匣，不會彈出主視窗。透過 HKCU 註冊表項目實作（不需系統管理員權限）。"
                               FontSize="11"
                               Foreground="#7B8DB0"
                               TextWrapping="Wrap"
                               Margin="22,4,0,0"/>
                </StackPanel>

                <TextBlock Grid.Row="6"
                           Text="頭部追蹤 / Head Tracking"
                           FontSize="14" FontWeight="Bold"
                           Foreground="#0A1F5C"
                           Margin="0,20,0,8"/>

                <StackPanel Grid.Row="7" Orientation="Vertical" Margin="0,0,0,12">
                    <StackPanel Orientation="Horizontal">
                        <CheckBox x:Name="ToggleHeadTrackingEnabled"
                                  Content="啟用頭部追蹤 / Enable Head Tracking"
                                  Foreground="#0A1F5C"
                                  FontSize="13"
                                  VerticalAlignment="Center"
                                  Checked="OnToggleHeadTrackingEnabledChanged"
                                  Unchecked="OnToggleHeadTrackingEnabledChanged"/>
                        <!-- Phase 1.5 user feedback: badge replaced with a
                             real Button that restarts the app. Click prompts
                             confirmation, then spawns a delayed cmd handoff
                             (timeout 2 → start) so the current process can
                             release the single-instance mutex before the new
                             instance launches. -->
                        <Button x:Name="RestartButton"
                                Content="需重新啟動 / 立即重啟"
                                Margin="10,0,0,0"
                                Padding="10,4"
                                FontSize="11"
                                FontWeight="Bold"
                                Foreground="#8B5A00"
                                Background="#FFF4D6"
                                BorderBrush="#E5A841"
                                BorderThickness="1"
                                Cursor="Hand"
                                Click="OnRestartClicked"
                                ToolTip="點擊立即重啟 SenseEase 以套用頭部追蹤變更&#x0a;Click to restart SenseEase now and apply head-tracking changes"/>
                    </StackPanel>
                    <TextBlock Text="開啟時，啟動會啟動 Python sidecar 並讀取 webcam（MediaPipe 推論臉部姿態）讓 FOV 遮罩跟著你的視線移動。預設關閉以保護隱私。"
                               FontSize="11"
                               Foreground="#7B8DB0"
                               TextWrapping="Wrap"
                               Margin="22,4,0,0"/>
                    <TextBlock Text="When on, app launch spawns a Python sidecar and reads the webcam (MediaPipe face-landmark inference) so the FOV mask follows your gaze. Default off for privacy. See docs/HEAD-TRACKING-PRIVACY.md."
                               FontSize="11"
                               Foreground="#9AB6E0"
                               TextWrapping="Wrap"
                               Margin="22,2,0,0"/>
                </StackPanel>

                <StackPanel Grid.Row="8" Orientation="Vertical" Margin="0,0,0,12">
                    <TextBlock Text="跟隨模式 / Follow Mode"
                               FontSize="12" FontWeight="Bold"
                               Foreground="#0A1F5C"
                               Margin="22,0,0,4"/>
                    <RadioButton x:Name="FollowModeBalanced"
                                 GroupName="HeadTrackingFollowMode"
                                 Content="平衡 Balanced (建議 / recommended)"
                                 Foreground="#0A1F5C"
                                 FontSize="13"
                                 Margin="22,2,0,0"
                                 Checked="OnFollowModeChanged"/>
                    <TextBlock Text="遮罩中心限制在螢幕中央 80% 區域，周邊永遠維持部分遮蔽（臨床預設、減輕視覺動暈）。"
                               FontSize="11"
                               Foreground="#7B8DB0"
                               TextWrapping="Wrap"
                               Margin="42,2,0,0"/>
                    <RadioButton x:Name="FollowModeFull"
                                 GroupName="HeadTrackingFollowMode"
                                 Content="完整跟隨 Full follow (邊緣較完整，可能感覺較不穩定)"
                                 Foreground="#0A1F5C"
                                 FontSize="13"
                                 Margin="22,8,0,0"
                                 Checked="OnFollowModeChanged"/>
                    <TextBlock Text="遮罩中心可走到螢幕角落，可以完整看到邊緣內容；周邊變化較大、可能感覺較不穩定。"
                               FontSize="11"
                               Foreground="#7B8DB0"
                               TextWrapping="Wrap"
                               Margin="42,2,0,0"/>
                </StackPanel>

                <StackPanel Grid.Row="9" Orientation="Vertical">
                    <CheckBox x:Name="ToggleEscapeHatch"
                              Content="啟用暫時透明 / Enable temporary transparency"
                              Foreground="#0A1F5C"
                              FontSize="13"
                              Checked="OnToggleEscapeHatchChanged"
                              Unchecked="OnToggleEscapeHatchChanged"/>
                    <TextBlock Text="連點兩下 Ctrl / Double-tap Ctrl — 短暫降低 FOV 遮罩到 30% 透明度 3 秒，方便偷瞄螢幕角落。"
                               FontSize="11"
                               Foreground="#7B8DB0"
                               TextWrapping="Wrap"
                               Margin="22,4,0,0"/>
                    <TextBlock x:Name="EscapeHatchVestibularNote"
                               Visibility="Collapsed"
                               Text="（你的 calibration 紀錄顯示前庭敏感，此功能已停用以維持視覺保護。Disabled because vestibular sensitivity detected; temporary transparency would compromise visual protection.）"
                               FontSize="11"
                               Foreground="#C2410C"
                               TextWrapping="Wrap"
                               Margin="22,4,0,0"/>
                </StackPanel>

                <!-- Phase 5 follow-up (v0.11, 2026-05-31): developer / QA test
                     hotkey reference table. Per user request, labeled as "dev
                     test usage" — this is not a normal-user feature. Lists the
                     two window-scoped hotkeys the app currently registers so
                     future testing has a single discoverable reference. TEMP
                     UVHS scaffolds (F11 from Step 7, F12 from Step 3) are
                     intentionally NOT listed — they were reverted before
                     their respective commits.

                     Hidden 2026-05-31 (same day): user reported that BOTH
                     listed hotkeys (Ctrl+Shift+H mock head-pose sweep AND
                     double-tap Ctrl overlay escape hatch) are non-functional
                     in current builds. Showing this table would mislead
                     testers about features that don't actually work. Beta
                     follow-up: diagnose why the Key.H / double-Ctrl branches
                     of MainWindow.PreviewKeyDown (around line 349) don't
                     fire end-to-end — the F11 UVHS-P5-7 scaffold worked
                     from the same lambda, so PreviewKeyDown wiring itself
                     is fine; the issue is downstream (key detection state
                     machine, ViewModel command invocation, or the target
                     methods StartMockHeadPoseSweep / TriggerEscapeHatch
                     themselves). Once fixed, flip Visibility="Collapsed"
                     back to Visible to re-expose the reference table. -->
                <StackPanel Grid.Row="10" Margin="0,24,0,0" Visibility="Collapsed">
                    <TextBlock Text="開發者測試快捷鍵 / Developer Test Hotkeys"
                               FontSize="14" FontWeight="Bold"
                               Foreground="#0A1F5C"
                               Margin="0,0,0,6"/>
                    <TextBlock Text="以下快捷鍵為開發 / QA 測試用途，非一般使用流程的一部分。These are for development / QA testing only, not part of the normal user flow."
                               FontSize="11"
                               Foreground="#7B8DB0"
                               TextWrapping="Wrap"
                               Margin="0,0,0,10"/>
                    <Border Background="#F8FAFF" BorderBrush="#E8EEFF" BorderThickness="1" CornerRadius="6" Padding="14,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="170"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/> <!-- header -->
                                <RowDefinition Height="Auto"/> <!-- row 1: Ctrl+Shift+H -->
                                <RowDefinition Height="Auto"/> <!-- row 2: double-tap Ctrl -->
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Hotkey / 快捷鍵"
                                       FontWeight="SemiBold" FontSize="11" Foreground="{StaticResource Accent}" Margin="0,0,0,6"/>
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="Effect / 作用"
                                       FontWeight="SemiBold" FontSize="11" Foreground="{StaticResource Accent}" Margin="0,0,0,6"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Ctrl + Shift + H"
                                       FontFamily="Consolas" FontSize="12" Foreground="#0A1F5C" Margin="0,2,0,2"/>
                            <TextBlock Grid.Row="1" Grid.Column="1"
                                       Text="觸發 20 秒模擬頭部姿勢掃描 (橫向→縱向→圓形→中心持住)。G4 head-tracking UVHS 用於無 webcam 機器驗證 wiring 端到端。Independent of AppConfig.HeadTrackingEnabled."
                                       FontSize="11" Foreground="#0A1F5C" TextWrapping="Wrap" Margin="0,2,0,2"/>

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="連點兩下 Ctrl"
                                       FontFamily="Consolas" FontSize="12" Foreground="#0A1F5C" Margin="0,2,0,2"/>
                            <TextBlock Grid.Row="2" Grid.Column="1"
                                       Text="(400 ms 內) 觸發 FOV 遮罩 3 秒透明度 30% 的「偷瞄」逃生口。受上方「開啟臨時透明度」開關控制；前庭敏感者強制停用。Same as the toggle above; listed here for hotkey discoverability."
                                       FontSize="11" Foreground="#0A1F5C" TextWrapping="Wrap" Margin="0,2,0,2"/>
                        </Grid>
                    </Border>
                    <TextBlock Text="提示：所有快捷鍵僅在主控台視窗有焦點時觸發 (PreviewKeyDown 範圍)。Note: all hotkeys fire only when the main console window has focus."
                               FontSize="10" Foreground="#9AB6E0" FontStyle="Italic"
                               TextWrapping="Wrap" Margin="0,8,0,0"/>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Border>
</UserControl>
