<UserControl x:Class="SenseEase.App.Views.SettingsContent"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:SenseEase.App.Localization"
             FontFamily="{DynamicResource Font.UI}"
             Background="Transparent">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/SenseEase.App;component/Theme/SenseEaseTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- SettingSwitch (calm iOS-style toggle) moved to SenseEaseTheme.xaml
                 (UI/UX fine-tune 2026-06-07) so the dashboard's Overlay Adjustment
                 toggle shares ONE source with the Settings page. Resolved here via
                 the merged theme dictionary above; consumers below are unchanged. -->

            <!-- Appearance setting (2026-06-07): segmented-control segment.
                 Three of these RadioButtons (GroupName="ThemeMode") form a
                 single pill-grouped selector: 自動 / 淺色 / 深色. Each segment is
                 a ≥44px-tall touch target with a clear selected fill (Accent),
                 hover lift, and keyboard-focus ring — all via DynamicResource
                 tokens so it tracks both themes. Selection is NOT colour-only:
                 the picked segment also goes SemiBold + TextOnComfort so it
                 reads without relying on hue. 160ms colour transitions keep the
                 state change calm, not snappy. -->
            <Style x:Key="ThemeSegment" TargetType="RadioButton">
                <Setter Property="FocusVisualStyle" Value="{DynamicResource FocusVisible}"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="MinHeight" Value="44"/>
                <Setter Property="MinWidth" Value="84"/>
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="FontWeight" Value="Medium"/>
                <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RadioButton">
                            <!-- Fill is token-driven (DynamicResource via the
                                 triggers below) so it tracks BOTH themes — the
                                 selected segment picks up the light indigo or the
                                 brighter dark-mode indigo automatically. This
                                 matches the established SettingSwitch pattern in
                                 this same file (token swap, not a hardcoded
                                 ColorAnimation that would freeze one theme's hue). -->
                            <Border x:Name="SegBorder"
                                    Background="Transparent"
                                    CornerRadius="{StaticResource Radius.sm}"
                                    SnapsToDevicePixels="True">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  Margin="14,0"
                                                  RecognizesAccessKey="True"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <!-- Hover (unselected): gentle muted fill -->
                                <MultiTrigger>
                                    <MultiTrigger.Conditions>
                                        <Condition Property="IsMouseOver" Value="True"/>
                                        <Condition Property="IsChecked" Value="False"/>
                                    </MultiTrigger.Conditions>
                                    <Setter TargetName="SegBorder" Property="Background"
                                            Value="{DynamicResource Surface}"/>
                                    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                                </MultiTrigger>
                                <!-- Selected: Accent fill, on-accent text, SemiBold
                                     so selection survives without relying on hue. -->
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="SegBorder" Property="Background"
                                            Value="{DynamicResource Accent}"/>
                                    <Setter Property="Foreground" Value="{DynamicResource TextOnComfort}"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                </Trigger>
                                <!-- Disabled: dim -->
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.4"/>
                                    <Setter Property="Cursor" Value="Arrow"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Tighter variant of ThemeSegment for the Appearance capsule only
                 (UI/UX fine-tune 2026-06-07): short labels (自動/淺色/深色) looked
                 loose in the 44×84 segments. MinHeight 44→36, MinWidth 84→60 hugs
                 the labels. Inherits the ThemeSegment template (incl. the 14,0
                 content margin, which MinWidth=60 now governs). Language selector
                 keeps the full ThemeSegment. -->
            <Style x:Key="ThemeSegmentTight" TargetType="RadioButton"
                   BasedOn="{StaticResource ThemeSegment}">
                <Setter Property="MinHeight" Value="36"/>
                <Setter Property="MinWidth" Value="60"/>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>
    <!-- UI Consolidation Sprint M-Phase-1 (2026-05-30): shared settings UI
         hosted by BOTH the main console's "設定" tab and the topmost
         SettingsWindow opened from the tray menu / Pop-up Card gear. State
         sharing is automatic — every toggle writes through to the static
         UserPreferences.Current + AppConfig.* singletons, and the
         UserPreferences.Changed event re-hydrates peer instances.

         Phase 1.5 polish (post-smoke-test, user feedback):
           • Fully token-driven palette — every card surface, text, border,
             separator, toggle track and accent resolves via {DynamicResource}
             from the merged theme tokens (Surface / CardBorder / Separator /
             TextPrimary / TextSecondary / TextTertiary / Accent …), so the
             whole panel tracks BOTH light and dark. Dark-mode correctness
             relies on ThemeManager.TrackElement(this) (see code-behind):
             this UserControl merges the light theme into its OWN Resources for
             the non-colour StaticResource tokens, which would otherwise shadow
             the Window-level dark palette, so the dark override is merged into
             this control's own resources too.
           • "需重新啟動" badge replaced with an actual "立即重啟" Button
             that restarts the app via a delayed cmd handoff (releases
             single-instance mutex before relaunching).
           • Close button (in SettingsWindow.xaml) restyled to light.

         The Close button intentionally stays in SettingsWindow.xaml because
         it's window-chrome; the Settings tab has no Close affordance. -->
    <Border Background="{DynamicResource Canvas}"
            CornerRadius="{StaticResource Radius.md}"
            Effect="{StaticResource Elev.3}"
            Padding="24" Margin="6">
        <ScrollViewer VerticalScrollBarVisibility="Auto" Style="{DynamicResource AutoHideScroll}">
            <!-- M3 regroup (2026-06-06): the formerly flat single scroll is now
                 organised into three visually-grouped {StaticResource Surface}
                 section cards (Radius.md + Elev.2), each opened by a
                 {StaticResource Type.Heading} title and using {StaticResource
                 Separator} hairlines to divide its rows. The long bilingual
                 helper paragraphs keep one concise line inline and tuck the
                 remainder behind a small collapsed "了解更多 / Learn more"
                 Expander. RESTYLE/REGROUP only — every x:Name, handler and
                 binding is byte-identical to the previous flat layout. -->
            <StackPanel>
                <!-- ═══ Section 0 · 外觀 / Appearance ═══════════════════════════
                     Appearance setting (2026-06-07): user theme choice.
                     A 3-segment selector (自動 / 淺色 / 深色) wired to
                     ThemeManager.SetMode via OnThemeModeChanged. The whole
                     selector sits in a SurfaceMuted "track" so the three pills
                     read as one grouped control; the selected pill fills Accent.
                     Hydrated from UserPreferences.ThemeMode in
                     RefreshFromPreferences (guarded by _wiring like the rest). -->
                <Border Background="{DynamicResource Surface}"
                        BorderBrush="{DynamicResource CardBorder}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource Radius.md}"
                        Effect="{StaticResource Elev.2}"
                        Padding="20,18"
                        Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Type.Heading}"
                                   Text="{loc:T Zh='外觀', En='Appearance'}"
                                   Margin="0,0,0,12"/>

                        <!-- Segmented control: one SurfaceMuted track wrapping
                             three equal-width RadioButton segments. The track is
                             Radius.md (12) so the inner segments' Radius.sm (8)
                             nest cleanly inside the 3px padding. -->
                        <Border Background="{DynamicResource SurfaceMuted}"
                                BorderBrush="{DynamicResource CardBorder}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource Radius.md}"
                                Padding="3"
                                HorizontalAlignment="Left">
                            <UniformGrid Rows="1" Columns="3">
                                <RadioButton x:Name="ThemeAuto"
                                             Style="{StaticResource ThemeSegmentTight}"
                                             GroupName="ThemeMode"
                                             Content="{loc:T Zh='自動', En='Auto'}"
                                             ToolTip="{loc:T Zh='跟隨 Windows 系統的淺色 / 深色設定', En='Follow the Windows system light / dark setting'}"
                                             Checked="OnThemeModeChanged"/>
                                <RadioButton x:Name="ThemeLight"
                                             Style="{StaticResource ThemeSegmentTight}"
                                             GroupName="ThemeMode"
                                             Content="{loc:T Zh='淺色', En='Light'}"
                                             ToolTip="{loc:T Zh='永遠使用淺色主題', En='Always use the light theme'}"
                                             Checked="OnThemeModeChanged"/>
                                <RadioButton x:Name="ThemeDark"
                                             Style="{StaticResource ThemeSegmentTight}"
                                             GroupName="ThemeMode"
                                             Content="{loc:T Zh='深色', En='Dark'}"
                                             ToolTip="{loc:T Zh='永遠使用深色主題', En='Always use the dark theme'}"
                                             Checked="OnThemeModeChanged"/>
                            </UniformGrid>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- ═══ Section 0.5 · 語言 / Language ═══════════════════════════
                     Language setting (2026-06-07): live UI-language toggle,
                     modelled byte-for-byte on the Appearance segmented control
                     above (same Border/UniformGrid/ThemeSegment chrome). Two
                     segments (繁體中文 / English) wired to OnLanguageModeChanged,
                     which sets LocalizationManager.Current.Language AND persists
                     UserPreferences.LanguageModeRaw. Hydrated from the persisted
                     language in RefreshFromPreferences (guarded by _wiring like
                     the rest), so re-checking a segment during hydration doesn't
                     loop back. The whole UI re-picks its {loc:T} text live on
                     toggle — no restart needed for the language switch itself. -->
                <Border Background="{DynamicResource Surface}"
                        BorderBrush="{DynamicResource CardBorder}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource Radius.md}"
                        Effect="{StaticResource Elev.2}"
                        Padding="20,18"
                        Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Type.Heading}"
                                   Text="{loc:T Zh='語言', En='Language'}"
                                   Margin="0,0,0,12"/>

                        <!-- Segmented control: one SurfaceMuted track wrapping
                             two equal-width RadioButton segments, mirroring the
                             Appearance selector exactly. -->
                        <Border Background="{DynamicResource SurfaceMuted}"
                                BorderBrush="{DynamicResource CardBorder}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource Radius.md}"
                                Padding="3"
                                HorizontalAlignment="Left">
                            <UniformGrid Rows="1" Columns="2">
                                <RadioButton x:Name="LanguageChinese"
                                             Style="{StaticResource ThemeSegment}"
                                             GroupName="LanguageMode"
                                             Content="繁體中文"
                                             ToolTip="{loc:T Zh='以繁體中文顯示介面', En='Show the interface in Traditional Chinese'}"
                                             Checked="OnLanguageModeChanged"/>
                                <RadioButton x:Name="LanguageEnglish"
                                             Style="{StaticResource ThemeSegment}"
                                             GroupName="LanguageMode"
                                             Content="English"
                                             ToolTip="{loc:T Zh='以英文顯示介面', En='Show the interface in English'}"
                                             Checked="OnLanguageModeChanged"/>
                            </UniformGrid>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- ═══ Section 1 · 通知與顯示 / Notifications & display ═══ -->
                <Border Background="{DynamicResource Surface}"
                        BorderBrush="{DynamicResource CardBorder}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource Radius.md}"
                        Effect="{StaticResource Elev.2}"
                        Padding="20,18"
                        Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Type.Heading}"
                                   Text="{loc:T Zh='通知與顯示', En='Notifications &amp; display'}"
                                   Margin="0,0,0,14"/>

                        <!-- Toggle A: auto-expand notifications -->
                        <StackPanel Orientation="Vertical">
                            <CheckBox x:Name="ToggleAuto"
                                      Style="{StaticResource SettingSwitch}"
                                      Content="{loc:T Zh='讓 SenseEase 主動提醒', En='Let SenseEase remind me proactively'}"
                                      Foreground="{DynamicResource TextPrimary}"
                                      FontSize="13"
                                      Checked="OnToggleAutoChanged"
                                      Unchecked="OnToggleAutoChanged"/>
                            <TextBlock Text="{loc:T Zh='偵測到中度以上不適時自動通知', En='Notifies automatically on moderate-or-higher discomfort.'}"
                                       FontSize="11"
                                       Foreground="{DynamicResource TextTertiary}"
                                       TextWrapping="Wrap"
                                       Margin="22,4,0,0"/>
                        </StackPanel>

                        <!-- Bar/Tray colour toggle removed (2026-06-09, user request).
                             UserPreferences.BarTrayColorEnabled stays for the tray icon. -->
                    </StackPanel>
                </Border>

                <!-- ═══ Section 2 · 背景常駐 / Background & startup ═══ -->
                <Border Background="{DynamicResource Surface}"
                        BorderBrush="{DynamicResource CardBorder}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource Radius.md}"
                        Effect="{StaticResource Elev.2}"
                        Padding="20,18"
                        Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Type.Heading}"
                                   Text="{loc:T Zh='背景模式', En='Background mode'}"
                                   Margin="0,0,0,14"/>

                        <StackPanel Orientation="Vertical">
                            <CheckBox x:Name="ToggleMinimizeToTray"
                                      Style="{StaticResource SettingSwitch}"
                                      Content="{loc:T Zh='關閉視窗時最小化到系統匣 (不結束程式)', En='Minimise to the tray when the window closes (keep running)'}"
                                      Foreground="{DynamicResource TextPrimary}"
                                      FontSize="13"
                                      Checked="OnToggleMinimizeToTrayChanged"
                                      Unchecked="OnToggleMinimizeToTrayChanged"/>
                            <TextBlock Text="{loc:T Zh='按下主視窗的 X 只會收到系統匣，背景持續偵測。', En='Pressing X on the main window just sends it to the tray; detection keeps running in the background.'}"
                                       FontSize="11"
                                       Foreground="{DynamicResource TextTertiary}"
                                       TextWrapping="Wrap"
                                       Margin="22,4,0,0"/>
                            <Expander Header="{loc:T Zh='了解更多', En='Learn more'}"
                                      FontSize="11"
                                      Foreground="{DynamicResource TextTertiary}"
                                      IsExpanded="False"
                                      Margin="22,2,0,0">
                                <TextBlock Text="{loc:T Zh='開啟時，按下主視窗的 X 只會把視窗收到右下角的系統匣，SenseEase 持續在背景偵測。要完全結束請用系統匣選單的「退出 SenseEase」。', En='When on, pressing X on the main window sends it to the system tray (bottom-right) and SenseEase keeps detecting in the background. To quit completely, use Quit SenseEase in the tray menu.'}"
                                           FontSize="11"
                                           Foreground="{DynamicResource TextTertiary}"
                                           TextWrapping="Wrap"
                                           Margin="0,4,0,0"/>
                            </Expander>
                        </StackPanel>

                        <Border Height="1" Background="{DynamicResource Separator}" Margin="0,14"/>

                        <StackPanel Orientation="Vertical">
                            <CheckBox x:Name="ToggleRunAtStartup"
                                      Style="{StaticResource SettingSwitch}"
                                      Content="{loc:T Zh='開機時自動啟動 SenseEase', En='Start SenseEase automatically at startup'}"
                                      Foreground="{DynamicResource TextPrimary}"
                                      FontSize="13"
                                      Checked="OnToggleRunAtStartupChanged"
                                      Unchecked="OnToggleRunAtStartupChanged"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- ═══ Section 3 · 頭部追蹤與隱私 / Head tracking & privacy ═══ -->
                <Border Background="{DynamicResource Surface}"
                        BorderBrush="{DynamicResource CardBorder}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource Radius.md}"
                        Effect="{StaticResource Elev.2}"
                        Padding="20,18"
                        Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Type.Heading}"
                                   Text="{loc:T Zh='頭部追蹤與隱私', En='Head tracking &amp; privacy'}"
                                   Margin="0,0,0,14"/>

                        <StackPanel Orientation="Vertical">
                            <StackPanel Orientation="Horizontal">
                                <CheckBox x:Name="ToggleHeadTrackingEnabled"
                                          Style="{StaticResource SettingSwitch}"
                                          Content="{loc:T Zh='啟用頭部追蹤', En='Enable Head Tracking'}"
                                          Foreground="{DynamicResource TextPrimary}"
                                          FontSize="13"
                                          VerticalAlignment="Center"
                                          Checked="OnToggleHeadTrackingEnabledChanged"
                                          Unchecked="OnToggleHeadTrackingEnabledChanged"/>
                                <!-- Phase 1.5 user feedback: badge replaced with a
                                     real Button that restarts the app. Click prompts
                                     confirmation, then spawns a delayed cmd handoff
                                     (timeout 2 → start) so the current process can
                                     release the single-instance mutex before the new
                                     instance launches. -->
                                <Button x:Name="RestartButton"
                                        Content="{loc:T Zh='需重新啟動', En='Restart needed'}"
                                        Margin="10,0,0,0"
                                        Padding="10,5"
                                        FontSize="12"
                                        FontWeight="SemiBold"
                                        Foreground="{DynamicResource ComfortRisingText}"
                                        Background="{DynamicResource ComfortRisingWeak}"
                                        BorderBrush="{DynamicResource ComfortRising}"
                                        BorderThickness="1"
                                        Cursor="Hand"
                                        Click="OnRestartClicked"
                                        ToolTip="{loc:T Zh='點擊立即重啟 SenseEase 以套用頭部追蹤變更', En='Click to restart SenseEase now and apply head-tracking changes'}"/>
                            </StackPanel>
                        </StackPanel>

                        <Border Height="1" Background="{DynamicResource Separator}" Margin="0,14"/>

                        <StackPanel Orientation="Vertical">
                            <TextBlock Text="{loc:T Zh='追蹤模式', En='Tracking mode'}"
                                       FontSize="12" FontWeight="Bold"
                                       Foreground="{DynamicResource TextPrimary}"
                                       Margin="22,0,0,4"/>
                            <RadioButton x:Name="FollowModeBalanced"
                                         GroupName="HeadTrackingFollowMode"
                                         Content="{loc:T Zh='平衡 (建議)', En='Balanced (recommended)'}"
                                         Foreground="{DynamicResource TextPrimary}"
                                         FontSize="13"
                                         Margin="22,2,0,0"
                                         Checked="OnFollowModeChanged"/>
                            <RadioButton x:Name="FollowModeFull"
                                         GroupName="HeadTrackingFollowMode"
                                         Content="{loc:T Zh='完整追蹤（邊緣較完整）', En='Full tracking (more complete edges)'}"
                                         Foreground="{DynamicResource TextPrimary}"
                                         FontSize="13"
                                         Margin="22,8,0,0"
                                         Checked="OnFollowModeChanged"/>
                        </StackPanel>

                        <!-- 「啟用暫時透明」 escape-hatch section (toggle + description +
                             vestibular note) removed entirely (2026-06-09, user request). -->
                    </StackPanel>
                </Border>

                <!-- ═══ Section 3.5 · 事件記錄 / Event Log ═══════════════════════
                     UI/UX fine-tune (2026-06-07): the former top-level 事件記錄 tab
                     became a button here that opens the dedicated EventLogWindow —
                     declutters the primary nav and keeps the log full-page in its own
                     window. Grouped near 資料與隱私 (both are records/diagnostics).
                     Hidden unless the host wired OpenEventLog (code-behind OnLoaded). -->
                <Border x:Name="EventLogCard"
                        Background="{DynamicResource Surface}"
                        BorderBrush="{DynamicResource CardBorder}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource Radius.md}"
                        Effect="{StaticResource Elev.2}"
                        Padding="20,18"
                        Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Type.Heading}"
                                   Text="{loc:T Zh='事件記錄', En='Event Log'}"
                                   Margin="0,0,0,12"/>
                        <Button x:Name="OpenEventLogButton"
                                Content="{loc:T Zh='開啟事件記錄', En='Open event log'}"
                                HorizontalAlignment="Left"
                                Padding="14,7"
                                FontSize="12"
                                FontWeight="SemiBold"
                                Foreground="{DynamicResource TextOnComfort}"
                                Background="{DynamicResource Accent}"
                                BorderThickness="0"
                                Cursor="Hand"
                                Click="OnOpenEventLogClicked"
                                ToolTip="{loc:T Zh='在獨立視窗開啟事件／診斷紀錄', En='Open the event / diagnostic log in its own window'}"/>
                    </StackPanel>
                </Border>

                <!-- ═══ Section 4 · 資料與隱私 / Data & privacy (H24) ═══ -->
                <Border Background="{DynamicResource Surface}"
                        BorderBrush="{DynamicResource CardBorder}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource Radius.md}"
                        Effect="{StaticResource Elev.2}"
                        Padding="20,18"
                        Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Type.Heading}"
                                   Text="{loc:T Zh='資料與隱私', En='Data &amp; privacy'}"
                                   Margin="0,0,0,14"/>
                        <TextBlock Text="{loc:T Zh='清除 SenseEase 為你建立的長期行為紀錄、分析，並刪除模型診斷追蹤。你的校正設定檔會保留，此動作無法復原。', En='Clear the long-term behaviour log and analysis SenseEase has built about you, and delete the model diagnostic trace. Your calibration profile is kept. This cannot be undone.'}"
                                   FontSize="11"
                                   Foreground="{DynamicResource TextTertiary}"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,10"/>
                        <Button x:Name="ClearAllDataButton"
                                Content="{loc:T Zh='清除所有資料並重設', En='Clear all my data and reset'}"
                                HorizontalAlignment="Left"
                                Padding="14,7"
                                FontSize="12"
                                FontWeight="SemiBold"
                                Foreground="{DynamicResource ComfortHighText}"
                                Background="{DynamicResource ComfortHighWeak}"
                                BorderBrush="{DynamicResource ComfortHigh}"
                                BorderThickness="1"
                                Cursor="Hand"
                                Click="OnClearAllDataClicked"
                                ToolTip="{loc:T Zh='刪除行為紀錄、分析索引、長期觀察與模型追蹤；保留校正設定檔。', En='Deletes the behaviour log, analysis index, longitudinal observations, and model trace; keeps your calibration profile.'}"/>

                        <!-- Alpha-2 addendum (auto-profiling world only): the vestibular
                             "regret" toggle + the Reset that moved here from the console.
                             Hidden unless AppConfig.AutoProfilingEnabled (set in OnLoaded). -->
                        <StackPanel x:Name="AutoProfilingDataGroup" Visibility="Collapsed" Margin="0,18,0,0">
                            <Border Background="{DynamicResource Separator}" Height="1" Margin="0,0,0,14"/>
                            <CheckBox x:Name="VestibularProtectionToggle"
                                      Content="{loc:T Zh='暈眩防護（敏感模式）', En='Dizziness protection (sensitive mode)'}"
                                      Foreground="{DynamicResource TextPrimary}" FontSize="12"
                                      Checked="OnVestibularProtectionChanged"
                                      Unchecked="OnVestibularProtectionChanged"/>
                            <TextBlock Text="{loc:T Zh='若您感到暈眩或不適，可開啟此防護。', En='If you feel dizzy or uncomfortable, you can enable this protection.'}"
                                       FontSize="11" Foreground="{DynamicResource TextTertiary}"
                                       TextWrapping="Wrap" Margin="0,6,0,14"/>
                            <Button x:Name="ResetStateButton"
                                    Content="{loc:T Zh='重設個人化狀態', En='Reset personalisation state'}"
                                    HorizontalAlignment="Left" Padding="14,7" FontSize="12" FontWeight="SemiBold"
                                    Foreground="{DynamicResource ComfortHighText}"
                                    Background="{DynamicResource ComfortHighWeak}"
                                    BorderBrush="{DynamicResource ComfortHigh}" BorderThickness="1" Cursor="Hand"
                                    Click="OnResetStateClicked"
                                    ToolTip="{loc:T Zh='清除暫時的個人化（遮罩微調），保留你已養成的習慣化進度。', En='Clears transient personalisation (shader tweaks); keeps your earned habituation progress.'}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Phase 5 follow-up (v0.11, 2026-05-31): developer / QA test
                     hotkey reference table. Per user request, labeled as "dev
                     test usage" — this is not a normal-user feature. Lists the
                     two window-scoped hotkeys the app currently registers so
                     future testing has a single discoverable reference. TEMP
                     UVHS scaffolds (F11 from Step 7, F12 from Step 3) are
                     intentionally NOT listed — they were reverted before
                     their respective commits.

                     Hidden 2026-05-31 (same day): user reported that BOTH
                     listed hotkeys (Ctrl+Shift+H mock head-pose sweep AND
                     double-tap Ctrl overlay escape hatch) are non-functional
                     in current builds. Showing this table would mislead
                     testers about features that don't actually work. Beta
                     follow-up: diagnose why the Key.H / double-Ctrl branches
                     of MainWindow.PreviewKeyDown (around line 349) don't
                     fire end-to-end — the F11 UVHS-P5-7 scaffold worked
                     from the same lambda, so PreviewKeyDown wiring itself
                     is fine; the issue is downstream (key detection state
                     machine, ViewModel command invocation, or the target
                     methods StartMockHeadPoseSweep / TriggerEscapeHatch
                     themselves). Once fixed, flip Visibility="Collapsed"
                     back to Visible to re-expose the reference table. -->
                <StackPanel Margin="0,8,0,0" Visibility="Collapsed">
                    <TextBlock Text="{loc:T Zh='開發者測試快捷鍵', En='Developer Test Hotkeys'}"
                               FontSize="14" FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimary}"
                               Margin="0,0,0,6"/>
                    <TextBlock Text="{loc:T Zh='以下快捷鍵為開發 / QA 測試用途，非一般使用流程的一部分。', En='These are for development / QA testing only, not part of the normal user flow.'}"
                               FontSize="11"
                               Foreground="{DynamicResource TextTertiary}"
                               TextWrapping="Wrap"
                               Margin="0,0,0,10"/>
                    <Border Background="{DynamicResource SurfaceMuted}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" CornerRadius="{StaticResource Radius.sm}" Padding="14,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="170"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/> <!-- header -->
                                <RowDefinition Height="Auto"/> <!-- row 1: Ctrl+Shift+H -->
                                <RowDefinition Height="Auto"/> <!-- row 2: double-tap Ctrl -->
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="{loc:T Zh='快捷鍵', En='Hotkey'}"
                                       FontWeight="SemiBold" FontSize="11" Foreground="{DynamicResource Accent}" Margin="0,0,0,6"/>
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{loc:T Zh='作用', En='Effect'}"
                                       FontWeight="SemiBold" FontSize="11" Foreground="{DynamicResource Accent}" Margin="0,0,0,6"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Ctrl + Shift + H"
                                       FontFamily="Consolas" FontSize="12" Foreground="{DynamicResource TextPrimary}" Margin="0,2,0,2"/>
                            <TextBlock Grid.Row="1" Grid.Column="1"
                                       Text="{loc:T Zh='觸發 20 秒模擬頭部姿勢掃描 (橫向→縱向→圓形→中心持住)。用於無 webcam 機器驗證 wiring 端到端，與 AppConfig.HeadTrackingEnabled 無關。', En='Triggers a 20-second mock head-pose sweep (horizontal→vertical→circular→hold centre). Used to verify wiring end-to-end on webcam-less machines. Independent of AppConfig.HeadTrackingEnabled.'}"
                                       FontSize="11" Foreground="{DynamicResource TextPrimary}" TextWrapping="Wrap" Margin="0,2,0,2"/>

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="{loc:T Zh='連點兩下 Ctrl', En='Double-tap Ctrl'}"
                                       FontFamily="Consolas" FontSize="12" Foreground="{DynamicResource TextPrimary}" Margin="0,2,0,2"/>
                            <TextBlock Grid.Row="2" Grid.Column="1"
                                       Text="{loc:T Zh='(400 ms 內) 觸發 FOV 遮罩 3 秒透明度 30% 的「偷瞄」逃生口。受上方「啟用暫時透明」開關控制；前庭敏感者強制停用。', En='(within 400 ms) triggers the FOV-mask peek escape hatch — 30% opacity for 3 seconds. Governed by the temporary-transparency toggle above; force-disabled for vestibular-sensitive users. Listed here for hotkey discoverability.'}"
                                       FontSize="11" Foreground="{DynamicResource TextPrimary}" TextWrapping="Wrap" Margin="0,2,0,2"/>
                        </Grid>
                    </Border>
                    <TextBlock Text="{loc:T Zh='提示：所有快捷鍵僅在主控台視窗有焦點時觸發 (PreviewKeyDown 範圍)。', En='Note: all hotkeys fire only when the main console window has focus.'}"
                               FontSize="10" Foreground="{DynamicResource TextTertiary}" FontStyle="Italic"
                               TextWrapping="Wrap" Margin="0,8,0,0"/>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Border>
</UserControl>
