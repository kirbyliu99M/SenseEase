<Window x:Class="SenseEase.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:SenseEase.App.Views"
        xmlns:loc="clr-namespace:SenseEase.App.Localization"
        Title="SenseEase 設定"
        Width="520" Height="700"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="False"
        Topmost="True"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType"
        RenderOptions.BitmapScalingMode="HighQuality">
    <!-- UI-reshape Task 9 (2026-06-17): frameless GLASS re-skin so opening Settings from the
         popup bar no longer jumps to an old square console. The window is now WindowStyle=None +
         AllowsTransparency + a Win11 acrylic blur-behind (theme-aware tint applied in
         SourceInitialized, mirroring NotificationCardWindow), wrapping the EXISTING
         SettingsContent UserControl in a rounded Surface card with a slim custom title row
         (drag handle + round X close). RootGrid is clipped to a rounded rect on SizeChanged so
         the acrylic reads as one clean rounded slab (same idea as PopupBarWindow.OnRootSizeChanged).

         All toggle UI + handlers still live in SettingsContent so this Window and the main
         console's "設定" TabItem share state automatically through UserPreferences.Current +
         AppConfig.* singletons + the UserPreferences.Changed event. The constructor signature
         (Func<bool> hasVestibularDiagnosis) and all pass-through delegates are preserved verbatim.

         Theme: the Window background is Transparent (the acrylic + Surface card supply the fill).
         SenseEaseTheme.xaml + SettingsGlassPalette.xaml (the SLATE glass bridge) are merged
         view-locally; SettingsGlassTheme.Track (code-behind) flips in SettingsGlassPalette.Dark.xaml
         (the Game-Bar variant) for Dark, incl. live OS flips. The Settings stays slate glass in BOTH
         OS themes by design — it does NOT follow the popup's light-blue light variant. -->
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/SenseEase.App;component/Theme/SenseEaseTheme.xaml"/>
                <!-- GLASS BRIDGE for the window chrome (title row + close + Close button), matching
                     the hosted SettingsContent. SettingsGlassTheme.Track flips the dark variant. -->
                <ResourceDictionary Source="pack://application:,,,/SenseEase.App;component/Theme/SettingsGlassPalette.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- Round translucent X close button — sits at the right of the title row. 32x32 hit
                 area, 28x28 visible chip; reddens softly on hover. Glyph is a 12px-floor caption. -->
            <Style x:Key="GlassCloseBtn" TargetType="Button">
                <Setter Property="Width" Value="32"/>
                <Setter Property="Height" Value="32"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="FocusVisualStyle" Value="{DynamicResource FocusVisible}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border Background="Transparent">
                                <Border x:Name="bd" Width="28" Height="28" CornerRadius="14"
                                        Background="{TemplateBinding Background}"
                                        HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Text="&#x2715;" FontSize="13" FontWeight="SemiBold"
                                               Foreground="{TemplateBinding Foreground}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="{DynamicResource CloseHoverWash}"/>
                                    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="{DynamicResource ClosePressWash}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid x:Name="RootGrid" SizeChanged="OnRootSizeChanged">
        <!-- Rounded Surface slab — the glass card the acrylic frosts behind. -->
        <Border x:Name="SlabBorder"
                Background="{DynamicResource Surface}"
                BorderBrush="{DynamicResource CardBorder}"
                BorderThickness="1"
                CornerRadius="16"
                Effect="{StaticResource Elev.3}"
                RenderTransformOrigin="0.5,0.4">
            <Border.RenderTransform>
                <ScaleTransform x:Name="SlabScale" ScaleX="1" ScaleY="1"/>
            </Border.RenderTransform>
            <!-- Single-cell wrapper: the content grid + ONE top-edge specular sheen layered
                 over it. Both sit INSIDE this slab Border so RootGrid.Clip (set in
                 OnRootSizeChanged) rounds them and the sheen never peeks past the acrylic edge. -->
            <Grid>
            <Grid Margin="16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Brand banner (2026-06-18) — the window's top identity now that the main
                     console (which carried the SenseEase / HP brand) is being dismantled. Logo +
                     SenseEase wordmark on the left; the "by ATCCxHP A02" credit shifted to the
                     very right next to the round X close. The whole banner row stays the drag
                     handle (the X owns its own click); a faint seam divides it from the list
                     below so it reads as a banner, not just a title. -->
                <StackPanel Grid.Row="0" Margin="0,0,0,14">
                    <Grid Background="Transparent"
                          MouseLeftButtonDown="OnTitleBarMouseDown"
                          TouchDown="OnTitleBarTouchDown" TouchMove="OnTitleBarTouchMove" TouchUp="OnTitleBarTouchUp">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Brand lockup: the app logo (AppIcon.ico) + wordmark. -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <Image Width="24" Height="24" VerticalAlignment="Center"
                                   Source="pack://application:,,,/SenseEase.App;component/Resources/AppIcon.ico"
                                   RenderOptions.BitmapScalingMode="HighQuality"
                                   AutomationProperties.Name="SenseEase"/>
                            <TextBlock Text="SenseEase" Margin="10,0,0,0" VerticalAlignment="Center"
                                       FontSize="17" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimary}"/>
                        </StackPanel>

                        <!-- Credit + close, shifted to the very right. -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="by ATCCxHP A02" VerticalAlignment="Center" Margin="0,0,10,0"
                                       FontSize="12" Foreground="{DynamicResource TextTertiary}"/>
                            <Button Style="{StaticResource GlassCloseBtn}"
                                    Click="OnCloseClicked"
                                    ToolTip="{loc:T Zh='關閉', En='Close'}"
                                    AutomationProperties.Name="{loc:T Zh='關閉', En='Close'}"/>
                        </StackPanel>
                    </Grid>
                    <Border Height="1" Background="{DynamicResource GroupDivider}" Margin="0,12,0,0"/>
                </StackPanel>

                <views:SettingsContent x:Name="ContentHost" Grid.Row="1"/>
            </Grid>
            <!-- ONE top-edge specular sheen = the liquid-glass light catch (a short
                 white→transparent vertical gradient, the SettingsSlabSheen token).
                 IsHitTestVisible=False so it never
                 blocks the title drag handle or any control. The round X in the title row +
                 Escape (OnKeyDown) are the sole close affordances — the redundant bottom
                 Accent "Close" button was removed in the one-piece redesign (2026-06-18). -->
            <Border CornerRadius="16" IsHitTestVisible="False"
                    Background="{DynamicResource SettingsSlabSheen}"/>
            </Grid>
        </Border>
    </Grid>
</Window>
