<Window x:Class="SenseEase.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:SenseEase.App.Views"
        xmlns:loc="clr-namespace:SenseEase.App.Localization"
        Title="SenseEase 設定"
        Width="520" Height="700"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        Background="{DynamicResource Canvas}">
    <!-- UI Consolidation Sprint M-Phase-1 (2026-05-30): thin Window chrome
         hosting the shared SettingsContent UserControl. All toggle UI +
         handlers live in SettingsContent so this Window and the main
         console's "設定" TabItem share state automatically through
         UserPreferences.Current + AppConfig.* singletons + the
         UserPreferences.Changed event.

         Close button stays here (window-specific affordance — the tab
         version has no Close because tabs don't close).

         Theme (2026-06-09 dark-mode fix): the Window background + Close button
         are theme TOKENS (Canvas / Accent / TextOnComfort), NOT hardcoded
         colours. The old #E2ECFF / #024AD8 literals (a 2026-05-30 light-only
         restyle) stayed light in Dark mode, leaving a periwinkle frame around
         the already-dark SettingsContent cards — "not true dark". SenseEaseTheme.xaml
         is merged view-locally below so the tokens resolve in Light mode;
         ThemeManager merges Palette.Dark.xaml over it for Dark (Window.Loaded class
         handler + TrackElement in the code-behind for live OS flips). Mirrors EventLogWindow. -->
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/SenseEase.App;component/Theme/SenseEaseTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <views:SettingsContent x:Name="ContentHost" Grid.Row="0"/>
        <Button Grid.Row="1"
                Content="{loc:T Zh='關閉', En='Close'}"
                HorizontalAlignment="Right"
                Padding="18,8"
                Margin="0,12,6,0"
                Background="{DynamicResource Accent}"
                Foreground="{DynamicResource TextOnComfort}"
                BorderThickness="0"
                FontSize="12"
                FontWeight="SemiBold"
                Cursor="Hand"
                Click="OnCloseClicked"/>
    </Grid>
</Window>
