<Window x:Class="SenseEase.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:SenseEase.App.Views"
        xmlns:loc="clr-namespace:SenseEase.App.Localization"
        Title="SenseEase 設定"
        Width="520" Height="700"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        Background="#E2ECFF">
    <!-- UI Consolidation Sprint M-Phase-1 (2026-05-30): thin Window chrome
         hosting the shared SettingsContent UserControl. All toggle UI +
         handlers live in SettingsContent so this Window and the main
         console's "設定" TabItem share state automatically through
         UserPreferences.Current + AppConfig.* singletons + the
         UserPreferences.Changed event.

         Close button stays here (window-specific affordance — the tab
         version has no Close because tabs don't close).

         Phase 1.5 user feedback (2026-05-30): Window background + Close
         button restyled from dark Pop-up sprint theme (#101418) to the
         light main console palette (#E2ECFF / White cards / #024AD8). -->
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <views:SettingsContent x:Name="ContentHost" Grid.Row="0"/>
        <Button Grid.Row="1"
                Content="{loc:T Zh='關閉', En='Close'}"
                HorizontalAlignment="Right"
                Padding="18,8"
                Margin="0,12,6,0"
                Background="#024AD8"
                Foreground="White"
                BorderThickness="0"
                FontSize="12"
                FontWeight="SemiBold"
                Cursor="Hand"
                Click="OnCloseClicked"/>
    </Grid>
</Window>
