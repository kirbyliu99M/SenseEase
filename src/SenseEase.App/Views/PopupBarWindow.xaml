<Window x:Class="SenseEase.App.Views.PopupBarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:SenseEase.App.Localization"
        xmlns:conv="clr-namespace:SenseEase.App.Converters"
        xmlns:views="clr-namespace:SenseEase.App.Views"
        Title="SenseEase"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="Manual"
        AutomationProperties.Name="{loc:T Zh='SenseEase 控制列', En='SenseEase control bar'}"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType"
        RenderOptions.BitmapScalingMode="HighQuality">
    <!-- UI-RESHAPE: a dense vertical function bar (col 1) + the chat / quick-settings as
         separate floating rounded cards (col 0). NO window-wide acrylic — empty window area is
         transparent so only the cards show (iter-4: acrylic frosted the whole rect, painting a
         "massive" blank). Popup.* colour brushes are DynamicResource so Light↔Dark re-themes
         live. DataContext = PopupBarViewModel. -->
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/SenseEase.App;component/Theme/SenseEaseTheme.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/SenseEase.App;component/Theme/PopupGlassTokens.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/SenseEase.App;component/Theme/Icons.PopupBar.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <conv:TierToPopupStatusBrushConverter x:Key="StatusBrush"/>
            <conv:TierToPopupStatusWordConverter  x:Key="StatusWord"/>
            <conv:TierToPopupStatusWordMultiConverter x:Key="StatusWordML"/>
            <conv:TierToPopupStatusGlyphConverter x:Key="StatusGlyph"/>
            <conv:SegmentFillConverter            x:Key="SegFill"/>
            <BooleanToVisibilityConverter         x:Key="BoolToVis"/>

            <!-- Round transparent glyph button: 44 HIT area / 28 visible chip. The hit area is the
                 44pt touch-target floor (the tester uses a touch laptop); the small chip keeps the
                 dense look the user asked for — visual stays minimal, tap target stays accessible. -->
            <Style x:Key="BarIconBtn" TargetType="Button">
                <Setter Property="Width" Value="44"/>
                <Setter Property="Height" Value="44"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="FocusVisualStyle" Value="{DynamicResource FocusVisible}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <!-- 44×44 hit area; 28×28 visible chip centred. -->
                            <Border Background="Transparent">
                                <Border x:Name="bd" Width="28" Height="28" CornerRadius="14"
                                        Background="{TemplateBinding Background}"
                                        HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="{DynamicResource Popup.BtnHover}"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="{DynamicResource Popup.BtnPress}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Filled blue primary (play/pause): 44 HIT / 32 visible circle (see BarIconBtn note) -->
            <Style x:Key="BarPrimaryBtn" TargetType="Button">
                <Setter Property="Width" Value="44"/>
                <Setter Property="Height" Value="44"/>
                <Setter Property="Background" Value="{DynamicResource Popup.Blue}"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="FocusVisualStyle" Value="{DynamicResource FocusVisible}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <!-- 44×44 hit area; 32×32 visible filled circle centred. -->
                            <Border Background="Transparent">
                                <Border x:Name="bd" Width="32" Height="32" CornerRadius="16"
                                        Background="{TemplateBinding Background}"
                                        HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="{DynamicResource Popup.BlueHover}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Calm pill button used on the cards (chat options, undo, full-settings, send) -->
            <Style x:Key="PanelBtn" TargetType="Button">
                <Setter Property="Background" Value="{DynamicResource Popup.Blue}"/>
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Padding" Value="12,6"/>
                <Setter Property="MinHeight" Value="30"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="FocusVisualStyle" Value="{DynamicResource FocusVisible}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="14"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="{DynamicResource Popup.BlueHover}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Ghost pill for secondary card actions (undo / followup options) -->
            <Style x:Key="GhostPanelBtn" TargetType="Button" BasedOn="{StaticResource PanelBtn}">
                <Setter Property="Background" Value="#1A024AD8"/>
                <Setter Property="Foreground" Value="{DynamicResource Popup.Ink1}"/>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid x:Name="RootGrid">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <!-- ═══ Col 0 — AI chat card (toggled, floats left of the bar, hugs its content) ═══ -->
        <Border x:Name="ChatPanel" Grid.Column="0" Width="300" Margin="0,0,8,0"
                VerticalAlignment="Center"
                Visibility="Collapsed" Opacity="0" RenderTransformOrigin="1,0.5"
                Background="{DynamicResource Popup.PanelBg}"
                BorderBrush="{DynamicResource Popup.Bdr}" BorderThickness="1"
                CornerRadius="{StaticResource Radius.md}"
                Effect="{StaticResource Elev.3}">
            <Border.RenderTransform><ScaleTransform x:Name="ChatScale" ScaleX="1" ScaleY="1"/></Border.RenderTransform>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- header -->
                <TextBlock Text="SenseEase AI" Margin="16,13,16,8"
                           FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource Popup.Ink1}"/>

                <!-- messages — sizes to content up to a cap (no fixed-height blank) -->
                <ScrollViewer Grid.Row="1" Margin="10,0" MaxHeight="340" VerticalScrollBarVisibility="Auto"
                              PanningMode="VerticalOnly"
                              Style="{DynamicResource AutoHideScroll}">
                    <ItemsControl ItemsSource="{Binding Chat.Messages}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="6,4">
                                    <Border CornerRadius="12" Padding="10,8" MaxWidth="246">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="HorizontalAlignment" Value="Left"/>
                                                <Setter Property="Background" Value="#33FFFFFF"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsUser}" Value="True">
                                                        <Setter Property="HorizontalAlignment" Value="Right"/>
                                                        <Setter Property="Background" Value="{DynamicResource Popup.Blue}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Grid>
                                            <!-- Selectable, marker-stripped content (reuses the proven
                                                 MarkdownInlines source the console chat uses). Hidden while typing. -->
                                            <TextBox Visibility="{Binding ContentVisibility}"
                                                     views:MarkdownInlines.Source="{Binding Content}"
                                                     IsReadOnly="True" IsReadOnlyCaretVisible="False" IsTabStop="False"
                                                     BorderThickness="0" Background="Transparent" Padding="0"
                                                     TextWrapping="Wrap" FontSize="13">
                                                <TextBox.Style>
                                                    <Style TargetType="TextBox">
                                                        <Setter Property="Foreground" Value="{DynamicResource Popup.Ink1}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsUser}" Value="True">
                                                                <Setter Property="Foreground" Value="White"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBox.Style>
                                            </TextBox>
                                            <!-- Static "thinking" indicator while generating — no animation
                                                 (reduced-motion-safe by default for a motion-sickness app). -->
                                            <TextBlock Visibility="{Binding TypingVisibility}"
                                                       Text="• • •" FontSize="15" Foreground="{DynamicResource Popup.Ink2}"/>
                                        </Grid>
                                    </Border>

                                    <!-- Gated followup options: the FMS check-in / habituation-proposal
                                         answers + B5 adaptation notices flow through the real
                                         ChatbotViewModel into Messages, so they surface here automatically. -->
                                    <ItemsControl ItemsSource="{Binding FollowupOptions}" Margin="2,6,0,0"
                                                  Visibility="{Binding FollowupVisibility}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Content="{Binding}"
                                                        Command="{Binding DataContext.SelectFollowupCommand,
                                                                          RelativeSource={RelativeSource AncestorType=ItemsControl, AncestorLevel=1}}"
                                                        CommandParameter="{Binding}"
                                                        Style="{StaticResource GhostPanelBtn}" Margin="0,0,6,6" MinHeight="34"/>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- input row -->
                <Grid Grid.Row="2" Margin="12,10,12,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <!-- #1: dark, themed, auto-expanding input (was a default WHITE box → invisible
                         white-on-white text in dark). Recessed dark field + light caret/ink; one line
                         at rest, wraps + grows to ~3 lines then scrolls. -->
                    <Border Grid.Column="0" Background="#33000000" BorderBrush="{DynamicResource Popup.Bdr}"
                            BorderThickness="1" CornerRadius="9" VerticalAlignment="Bottom">
                        <TextBox x:Name="ChatInput" Background="Transparent" BorderThickness="0"
                                 Padding="9,6" FontSize="13" MinHeight="20" MaxHeight="84"
                                 TextWrapping="Wrap" AcceptsReturn="False" VerticalContentAlignment="Center"
                                 VerticalScrollBarVisibility="Auto"
                                 Foreground="{DynamicResource Popup.Ink1}" CaretBrush="{DynamicResource Popup.Ink1}"
                                 Text="{Binding Chat.InputText, UpdateSourceTrigger=PropertyChanged}"
                                 IsVisibleChanged="OnChatInputVisibleChanged" KeyDown="OnChatInputKeyDown"
                                 AutomationProperties.Name="{loc:T Zh='輸入訊息給 SenseEase AI', En='Message SenseEase AI'}"/>
                    </Border>
                    <Button Grid.Column="1" Margin="6,0,0,0" VerticalAlignment="Bottom"
                            AutomationProperties.Name="{loc:T Zh='傳送或停止', En='Send or stop'}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource BarPrimaryBtn}">
                                <Setter Property="Command" Value="{Binding Chat.SendCommand}"/>
                                <Setter Property="ToolTip" Value="{loc:T Zh='傳送', En='Send'}"/>
                                <Style.Triggers>
                                    <!-- While generating, the same button STOPS the reply. -->
                                    <DataTrigger Binding="{Binding Chat.IsGenerating}" Value="True">
                                        <Setter Property="Command" Value="{Binding Chat.CancelGenerationCommand}"/>
                                        <Setter Property="ToolTip" Value="{loc:T Zh='停止生成', En='Stop'}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <Path Width="13" Height="13" Stretch="Uniform" Fill="White">
                            <Path.Style>
                                <Style TargetType="Path">
                                    <Setter Property="Data" Value="{StaticResource Icon.Send}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Chat.IsGenerating}" Value="True">
                                            <Setter Property="Data" Value="{StaticResource Icon.Stop}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Path.Style>
                        </Path>
                    </Button>
                </Grid>
            </Grid>
        </Border>

        <!-- quick-settings card — a small individual card (NOT the chat's template), floats at the
             lower-left near the gear. In-window overlay, NOT a WPF Popup (a Popup hooks
             Application.Exit + mis-places over a topmost no-activate transparent window). -->
        <!-- Distinct from the chat card: uses the BAR's glass (not the chat's PanelBg), is
             narrower, a smaller pill radius, and a compact toggle list — a different "template". -->
        <Border x:Name="SettingsFlyout" Grid.Column="0" Width="190" Margin="0,0,8,12"
                VerticalAlignment="Bottom" HorizontalAlignment="Right" Panel.ZIndex="10"
                Visibility="Collapsed" Opacity="0" RenderTransformOrigin="1,1"
                Background="{DynamicResource Popup.BarBg}" BorderBrush="{DynamicResource Popup.Bdr}"
                BorderThickness="1" CornerRadius="{StaticResource Radius.sm}" Padding="11,11,11,11"
                Effect="{StaticResource Elev.3}">
            <Border.RenderTransform><ScaleTransform x:Name="SettingsScale" ScaleX="1" ScaleY="1"/></Border.RenderTransform>
            <StackPanel>
                <CheckBox Style="{StaticResource SettingSwitch}" IsChecked="{Binding AnchorGridOn}"
                          Foreground="{DynamicResource Popup.Ink1}" Margin="0,2"
                          Content="{loc:T Zh='錨點格線', En='Anchor grid'}"/>
                <CheckBox Style="{StaticResource SettingSwitch}" IsChecked="{Binding GradedExposureOn}"
                          Foreground="{DynamicResource Popup.Ink1}" Margin="0,2"
                          Content="{loc:T Zh='漸進適應', En='Graded exposure'}"/>
                <CheckBox Style="{StaticResource SettingSwitch}" IsChecked="{Binding PersistentMaskOn}"
                          Foreground="{DynamicResource Popup.Ink1}" Margin="0,2"
                          Content="{loc:T Zh='常駐遮罩', En='Persistent mask'}"/>
                <Border Height="1" Background="{DynamicResource Popup.Ink3}" Margin="0,9,0,7" Opacity="0.4"/>
                <Button Content="{loc:T Zh='完整設定頁面', En='Full settings'}" Style="{StaticResource PanelBtn}"
                        HorizontalAlignment="Stretch" Command="{Binding OpenFullSettingsCommand}"
                        AutomationProperties.Name="{loc:T Zh='開啟完整設定頁面', En='Open full settings'}"/>
            </StackPanel>
        </Border>

        <!-- ═══ Col 1 — the bar ═══ -->
        <!-- Two-stage reveal: the bar reveals CONDENSED — status · power · chat · expand-chevron.
             The chevron grows it to FULL, adding the ±strength meter, the quick-settings gear, and
             the pin. IsExpanded-bound blocks carry their OWN leading divider so no orphan dividers
             appear when collapsed. -->
        <Border x:Name="BarRoot" Grid.Column="1" Width="48" Padding="0,8"
                VerticalAlignment="Center" Cursor="SizeNS"
                Background="{DynamicResource Popup.BarBg}"
                BorderBrush="{DynamicResource Popup.Bdr}" BorderThickness="1"
                CornerRadius="{StaticResource Radius.md}"
                Effect="{StaticResource Elev.3}"
                RenderTransformOrigin="1,0.5"
                MouseLeftButtonDown="OnBarMouseDown">
            <!-- SizeNS cursor over the bar background hints the vertical-only drag (buttons override
                 to Hand). BarScale drives the unified fade+scale reveal (code-behind, deferred to settle). -->
            <Border.RenderTransform><ScaleTransform x:Name="BarScale" ScaleX="1" ScaleY="1"/></Border.RenderTransform>
            <StackPanel HorizontalAlignment="Center">

                <!-- pulse status (colour + dot + word) — CONDENSED + FULL -->
                <StackPanel HorizontalAlignment="Center">
                    <AutomationProperties.Name>
                        <MultiBinding Converter="{StaticResource StatusWordML}">
                            <Binding Path="VimsTier"/>
                            <Binding Path="Language" Source="{x:Static loc:LocalizationManager.Current}"/>
                        </MultiBinding>
                    </AutomationProperties.Name>
                    <!-- Screen-motion status — a clean solid dot (no glyph, no halo).
                         The 低/中/高 word below keeps it dual-coded for accessibility. -->
                    <Grid Width="20" Height="20" HorizontalAlignment="Center">
                        <Ellipse Width="13" Height="13"
                                 Fill="{Binding VimsTier, Converter={StaticResource StatusBrush}}"/>
                    </Grid>
                    <!-- The word re-picks on a language flip via the MultiBinding's Language value
                         (a plain VimsTier binding stayed stale — "低" in English). -->
                    <TextBlock Margin="0,2,0,0" HorizontalAlignment="Center" FontSize="12" FontWeight="SemiBold"
                               Foreground="{DynamicResource Popup.OnBar}">
                        <TextBlock.Text>
                            <MultiBinding Converter="{StaticResource StatusWordML}">
                                <Binding Path="VimsTier"/>
                                <Binding Path="Language" Source="{x:Static loc:LocalizationManager.Current}"/>
                            </MultiBinding>
                        </TextBlock.Text>
                    </TextBlock>
                </StackPanel>

                <Border Height="1" Width="22" Margin="0,5" Background="{DynamicResource Popup.OnBarDim}" Opacity="0.30"/>

                <!-- on/off switch — a power symbol; BRIGHT blue when running, muted GREY "off" when
                     paused (reads as a switch position, not a disabled/dimmed control). CONDENSED + FULL -->
                <Button Command="{Binding PlayPauseCommand}"
                        ToolTip="{loc:T Zh='開啟／暫停保護', En='Toggle protection on / off'}"
                        AutomationProperties.Name="{loc:T Zh='開啟或暫停保護', En='Toggle protection on/off'}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource BarPrimaryBtn}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsPaused}" Value="True">
                                    <Setter Property="Background" Value="#995A6475"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <Path Data="{StaticResource Icon.Power}" Width="15" Height="15" Stretch="Uniform"
                          Stroke="White" StrokeThickness="2"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                </Button>

                <!-- FULL only: read-only 12-seg strength meter + nudge buttons (with its own
                     leading divider so nothing is orphaned when condensed). -->
                <!-- Cursor="Arrow" so the read-only meter does NOT inherit the bar's SizeNS drag-hint
                     cursor — it was implying the level/segments are drag-adjustable, which they aren't.
                     The +/- buttons keep their Hand cursor (BarIconBtn). -->
                <StackPanel x:Name="MeterSection" HorizontalAlignment="Center" Cursor="Arrow"
                            Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVis}}">
                    <Border Height="1" Width="22" Margin="0,5" Background="{DynamicResource Popup.OnBarDim}" Opacity="0.30"/>
                    <Button Style="{StaticResource BarIconBtn}" Command="{Binding StrongerCommand}"
                            ToolTip="{loc:T Zh='加強保護（提高遮罩強度）', En='Stronger protection'}"
                            AutomationProperties.Name="{loc:T Zh='加強保護', En='Stronger protection'}">
                        <Path Data="{StaticResource Icon.Plus}" Fill="{DynamicResource Popup.OnBar}" Width="13" Height="13" Stretch="Uniform"/>
                    </Button>
                    <ItemsControl ItemsSource="{Binding Segments}" Margin="0,4" HorizontalAlignment="Center"
                                  AutomationProperties.Name="{Binding LevelText}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <!-- Themed via DynamicResource (not the frozen-literal SegFill converter)
                                     so the lit run uses the THEME accent and flips with Light↔Dark. -->
                                <Border Width="20" Height="4" Margin="0,1" CornerRadius="2">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="{DynamicResource Popup.SegOff}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding}" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource Popup.SegOn}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="{Binding LevelText}" HorizontalAlignment="Center" FontSize="12" FontWeight="SemiBold"
                               Foreground="{DynamicResource Popup.OnBar}"/>
                    <Button Style="{StaticResource BarIconBtn}" Command="{Binding GentlerCommand}"
                            ToolTip="{loc:T Zh='減弱保護（降低遮罩強度）', En='Gentler protection'}"
                            AutomationProperties.Name="{loc:T Zh='減弱保護', En='Gentler protection'}">
                        <Path Data="{StaticResource Icon.Minus}" Fill="{DynamicResource Popup.OnBar}" Width="13" Height="13" Stretch="Uniform"/>
                    </Button>
                </StackPanel>

                <Border Height="1" Width="22" Margin="0,5" Background="{DynamicResource Popup.OnBarDim}" Opacity="0.30"/>

                <!-- chat — CONDENSED + FULL -->
                <Button Style="{StaticResource BarIconBtn}" Command="{Binding ToggleChatCommand}"
                        ToolTip="{loc:T Zh='與 SenseEase AI 對話', En='Chat with SenseEase AI'}"
                        AutomationProperties.Name="{loc:T Zh='開啟對話', En='Open chat'}">
                    <Path Data="{StaticResource Icon.Chat}" Fill="{DynamicResource Popup.OnBar}" Width="15" Height="15" Stretch="Uniform"/>
                </Button>

                <!-- FULL only: quick-settings gear + pin. The gear's dropdown is the in-window
                     SettingsFlyout card. Pin lights up blue while active. -->
                <StackPanel x:Name="ToolsSection" HorizontalAlignment="Center"
                            Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVis}}">
                    <Button x:Name="SettingsBtn" Style="{StaticResource BarIconBtn}" Command="{Binding ToggleSettingsCommand}"
                            ToolTip="{loc:T Zh='快速設定', En='Quick settings'}"
                            AutomationProperties.Name="{loc:T Zh='設定', En='Settings'}">
                        <Path Data="{StaticResource Icon.Settings}" Fill="{DynamicResource Popup.OnBar}" Width="15" Height="15" Stretch="Uniform"/>
                    </Button>
                    <Button Command="{Binding TogglePinCommand}"
                            ToolTip="{loc:T Zh='釘選工具列（保持顯示）', En='Pin the bar (keep open)'}"
                            AutomationProperties.Name="{loc:T Zh='釘選工具列', En='Pin the bar'}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource BarIconBtn}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsPinned}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource Popup.Blue}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <Path Data="{StaticResource Icon.Pin}" Fill="{DynamicResource Popup.OnBar}" Width="14" Height="14" Stretch="Uniform"/>
                    </Button>
                </StackPanel>

                <Border Height="1" Width="22" Margin="0,5" Background="{DynamicResource Popup.OnBarDim}" Opacity="0.30"/>

                <!-- expand / collapse chevron — hidden while pinned (a pinned bar can't be
                     collapsed; the pin toggle in the FULL set is then always reachable to un-pin) -->
                <Button Command="{Binding ToggleExpandCommand}"
                        ToolTip="{loc:T Zh='展開／收合工具列', En='Expand / collapse'}"
                        AutomationProperties.Name="{loc:T Zh='展開或收合工具列', En='Expand or collapse the bar'}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource BarIconBtn}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsPinned}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <Path Width="14" Height="14" Stretch="Uniform" Stroke="{DynamicResource Popup.OnBar}" StrokeThickness="2"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round">
                        <Path.Style>
                            <Style TargetType="Path">
                                <Setter Property="Data" Value="{StaticResource Icon.ChevronDown}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                        <Setter Property="Data" Value="{StaticResource Icon.ChevronUp}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Path.Style>
                    </Path>
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</Window>
