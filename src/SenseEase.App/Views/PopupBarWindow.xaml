<Window x:Class="SenseEase.App.Views.PopupBarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:SenseEase.App.Localization"
        xmlns:conv="clr-namespace:SenseEase.App.Converters"
        xmlns:views="clr-namespace:SenseEase.App.Views"
        Title="SenseEase"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        ResizeMode="NoResize"
        SizeToContent="Manual" Width="360" Height="496"
        WindowStartupLocation="Manual"
        AutomationProperties.Name="{loc:T Zh='SenseEase 控制列', En='SenseEase control bar'}"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType"
        RenderOptions.BitmapScalingMode="HighQuality">
    <!-- UI-RESHAPE: a dense vertical function bar (col 1) + the chat / quick-settings as
         separate floating rounded cards (col 0). NO window-wide acrylic — empty window area is
         transparent so only the cards show (iter-4: acrylic frosted the whole rect, painting a
         "massive" blank). Popup.* colour brushes are DynamicResource so Light↔Dark re-themes
         live. DataContext = PopupBarViewModel. -->
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/SenseEase.App;component/Theme/SenseEaseTheme.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/SenseEase.App;component/Theme/PopupGlassTokens.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/SenseEase.App;component/Theme/Icons.PopupBar.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- Status converters removed with the bar's status dot+word (item 2). The C# converter
                 classes remain (PopupStatusConverterTests references them). -->
            <BooleanToVisibilityConverter         x:Key="BoolToVis"/>

            <!-- Round transparent glyph button: 44 HIT area / 28 visible chip. The hit area is the
                 44pt touch-target floor (the tester uses a touch laptop); the small chip keeps the
                 dense look the user asked for — visual stays minimal, tap target stays accessible. -->
            <Style x:Key="BarIconBtn" TargetType="Button">
                <Setter Property="Width" Value="44"/>
                <Setter Property="Height" Value="44"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="FocusVisualStyle" Value="{DynamicResource FocusVisible}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <!-- 44×44 hit area; 28×28 visible chip centred. Hover/press = a soft glass
                                 fill wash (no accent RING — the crisp ring read as a selection box). -->
                            <Border Background="Transparent">
                                <Border x:Name="bd" Width="28" Height="28" CornerRadius="14"
                                        Background="{TemplateBinding Background}"
                                        HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="{DynamicResource Popup.BtnHover}"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="{DynamicResource Popup.BtnPress}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Filled blue primary (play/pause): 44 HIT / 32 visible circle (see BarIconBtn note) -->
            <Style x:Key="BarPrimaryBtn" TargetType="Button">
                <Setter Property="Width" Value="44"/>
                <Setter Property="Height" Value="44"/>
                <Setter Property="Background" Value="{DynamicResource Popup.Blue}"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="FocusVisualStyle" Value="{DynamicResource FocusVisible}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <!-- 44×44 hit area; 32×32 visible filled circle centred. -->
                            <Border Background="Transparent">
                                <Border x:Name="bd" Width="32" Height="32" CornerRadius="{StaticResource Radius.md}"
                                        Background="{TemplateBinding Background}"
                                        HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="{DynamicResource Popup.BlueHover}"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter Property="Opacity" Value="0.6"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.5"/>
                                    <Setter Property="Cursor" Value="Arrow"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Calm pill button used on the cards (chat options, undo, full-settings, send) -->
            <Style x:Key="PanelBtn" TargetType="Button">
                <Setter Property="Background" Value="{DynamicResource Popup.Blue}"/>
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Padding" Value="12,6"/>
                <Setter Property="MinHeight" Value="30"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="FocusVisualStyle" Value="{DynamicResource FocusVisible}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="14"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="{DynamicResource Popup.BlueHover}"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter Property="Opacity" Value="0.6"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.5"/>
                                    <Setter Property="Cursor" Value="Arrow"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Ghost pill for secondary card actions (undo / followup options). Fill is the per-theme
                 glass chip (was a fixed #1A024AD8 that neither flipped with the theme nor was caught by
                 the banned-#024AD8 lint due to its alpha prefix). -->
            <Style x:Key="GhostPanelBtn" TargetType="Button" BasedOn="{StaticResource PanelBtn}">
                <Setter Property="Background" Value="{DynamicResource Popup.ChipRest}"/>
                <Setter Property="Foreground" Value="{DynamicResource Popup.Ink1}"/>
            </Style>

            <!-- W-F2 (2026-06-21): ‹ › window-navigation arrows for the FMS rating row (replaces the single
                 "更嚴重 →" chip). Small square "blocks" that echo the rating squares — flat brushes only, no
                 effects/cache (software-render safe). The pair reads as pagination: the IsEnabled=False state
                 greys an arrow when there is no window in that direction (‹ at the start, › at the top). -->
            <Style x:Key="FmsNavArrowBtn" TargetType="Button">
                <Setter Property="Width" Value="22"/>
                <Setter Property="Height" Value="22"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Foreground" Value="{DynamicResource Popup.Ink1}"/>
                <!-- Audit 2026-06-22 (WCAG 2.4.7): show the shared keyboard focus ring (was {x:Null}). -->
                <Setter Property="FocusVisualStyle" Value="{DynamicResource FocusVisible}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="ab" CornerRadius="6" BorderThickness="1"
                                    Background="{DynamicResource Popup.ChipRest}"
                                    BorderBrush="{DynamicResource Popup.Bdr}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="ab" Property="BorderBrush" Value="{DynamicResource Popup.Ink2}"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="ab" Property="Opacity" Value="0.6"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.35"/>
                                    <Setter Property="Cursor" Value="Arrow"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- ── Intensity vertical slider (R3 #6) — a THICK, SEAMLESS fill bar (like the user's
                 reference progress bar, vertical, our accent). Restyled from the standard 3-part Track
                 (decrease repeat / thumb / increase repeat) so dragging + snapping work natively.
                 Top = stronger (Maximum at top). The DECREASE run is the bottom→thumb fill (painted
                 accent), the increase run is transparent so the grey rail shows above — NO per-level
                 segments/rungs (they read cheap); the continuous fill IS the level. -->
            <Style x:Key="PopupSliderRepeatFilled" TargetType="RepeatButton">
                <Setter Property="Focusable" Value="False"/>
                <Setter Property="IsTabStop" Value="False"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RepeatButton">
                            <Border Background="Transparent">
                                <Border Width="12" CornerRadius="6" HorizontalAlignment="Center"
                                        Background="{DynamicResource Popup.Blue}"/>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="PopupSliderRepeatEmpty" TargetType="RepeatButton">
                <Setter Property="Focusable" Value="False"/>
                <Setter Property="IsTabStop" Value="False"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RepeatButton">
                            <Border Background="Transparent"/>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <!-- Flush rounded cap, SAME width as the fill, so the thumb reads as the rounded END of
                 the seamless accent fill (not a separate dot). 44-wide hit pad keeps it grabbable. -->
            <Style x:Key="PopupSliderThumb" TargetType="Thumb">
                <Setter Property="Focusable" Value="False"/>
                <Setter Property="Width" Value="44"/>
                <Setter Property="Height" Value="14"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Thumb">
                            <Border Background="Transparent"> <!-- 44-wide hit pad -->
                                <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <!-- R3 #1: a soft accent glow behind the handle so the slider fill
                                         reads as 'lit' at the level (crisp accent, no DropShadow). -->
                                    <Border Width="18" Height="20" CornerRadius="9"
                                            Background="{DynamicResource Popup.Blue}"
                                            Opacity="0.28" IsHitTestVisible="False"/>
                                    <Border x:Name="knob" Width="12" Height="14" CornerRadius="6"
                                            Background="{DynamicResource Popup.Blue}"/>
                                </Grid>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="knob" Property="Background" Value="{DynamicResource Popup.BlueHover}"/>
                                </Trigger>
                                <Trigger Property="IsDragging" Value="True">
                                    <Setter TargetName="knob" Property="Background" Value="{DynamicResource Popup.BlueHover}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="PopupIntensitySlider" TargetType="Slider">
                <Setter Property="Orientation" Value="Vertical"/>
                <Setter Property="Minimum" Value="1"/>
                <Setter Property="Maximum" Value="12"/>
                <Setter Property="IsSnapToTickEnabled" Value="True"/>
                <Setter Property="TickFrequency" Value="1"/>
                <Setter Property="SmallChange" Value="1"/>
                <Setter Property="LargeChange" Value="2"/>
                <Setter Property="IsMoveToPointEnabled" Value="True"/>
                <Setter Property="Width" Value="44"/>
                <Setter Property="FocusVisualStyle" Value="{DynamicResource FocusVisible}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Slider">
                            <Grid>
                                <!-- thick rounded rail (the unfilled track) — seamless, no segments -->
                                <Border Width="12" CornerRadius="6" HorizontalAlignment="Center"
                                        Background="{DynamicResource Popup.SegOff}"/>
                                <Track x:Name="PART_Track">
                                    <Track.DecreaseRepeatButton>
                                        <RepeatButton Style="{StaticResource PopupSliderRepeatFilled}" Command="Slider.DecreaseLarge"/>
                                    </Track.DecreaseRepeatButton>
                                    <Track.IncreaseRepeatButton>
                                        <RepeatButton Style="{StaticResource PopupSliderRepeatEmpty}" Command="Slider.IncreaseLarge"/>
                                    </Track.IncreaseRepeatButton>
                                    <Track.Thumb>
                                        <Thumb Style="{StaticResource PopupSliderThumb}"/>
                                    </Track.Thumb>
                                </Track>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- (item 3) Quick-settings help affordance: a small "?" glyph + a dark, opaque hover
                 bubble describing each toggle. A styled ToolTip (NOT a Popup — :565 rationale) so it
                 renders in its own layered window, unclipped by the fixed 360×496 frame; flat brushes
                 only, no DropShadow/effect (software-render — see R3-6 notes above). -->
            <Style x:Key="HelpTip" TargetType="ToolTip">
                <Setter Property="MaxWidth" Value="224"/>
                <Setter Property="HasDropShadow" Value="False"/>
                <Setter Property="Placement" Value="Bottom"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ToolTip">
                            <Border Background="{DynamicResource Popup.PanelBg}"
                                    BorderBrush="{DynamicResource Popup.Bdr}" BorderThickness="1"
                                    CornerRadius="{StaticResource Radius.sm}" Padding="10,8"
                                    SnapsToDevicePixels="True">
                                <TextBlock Text="{TemplateBinding Content}" TextWrapping="Wrap"
                                           FontSize="12" Foreground="{DynamicResource Popup.Ink1}"/>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <!-- The 18px "?" chip. Non-interactive (no command, not a tab stop) — a pure hover/AT
                 affordance; the description is its ToolTip + the toggle's AutomationProperties.HelpText. -->
            <Style x:Key="HelpGlyph" TargetType="Button">
                <Setter Property="Width" Value="18"/>
                <Setter Property="Height" Value="18"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Focusable" Value="False"/>
                <Setter Property="IsTabStop" Value="False"/>
                <Setter Property="ToolTipService.InitialShowDelay" Value="150"/>
                <Setter Property="ToolTipService.ShowDuration" Value="30000"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="g" Width="18" Height="18" CornerRadius="9"
                                    Background="{DynamicResource Popup.ChipRest}">
                                <TextBlock Text="?" FontSize="11" FontWeight="SemiBold"
                                           Foreground="{DynamicResource Popup.Ink2}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="g" Property="Background" Value="{DynamicResource Popup.BtnHover}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <!-- R3-7 (FLASH FIX): the WINDOW is a FIXED 360x496 (SizeToContent=Manual) and NEVER resizes —
         resizing a layered (AllowsTransparency) window re-allocates its surface = the flash on every
         reveal/expand/chat/settings (confirmed: flash ⇔ window SizeChanged). Instead RootGrid hugs its
         content and floats RIGHT + vertically CENTRED inside the fixed window, so the bar stays flush to
         the edge and the panels open into already-allocated (transparent, click-through) space. The grid
         resizing internally is just content layout — same-size surface update, no flash. ShellController
         positions the window so the grid's centre sits at the saved bar-centre; the empty grid area has no
         Background (null) so clicks pass through it. -->
    <Grid x:Name="RootGrid" HorizontalAlignment="Right" VerticalAlignment="Center">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <!-- ═══ Col 0 — AI chat card (toggled, floats left of the bar). FIXED HEIGHT (#4): the card
             is a constant height so typing / new messages never reflow the window (the "flash on
             every keystroke" was SizeToContent re-measuring as the input + message list grew). The
             messages row is star-sized and absorbs the input box's growth — total height stays put. -->
        <Border x:Name="ChatPanel" Grid.Column="0" Width="300" Height="480" Margin="0,0,8,0"
                VerticalAlignment="Center"
                Visibility="Collapsed" Opacity="0" RenderTransformOrigin="1,0.5"
                Background="{DynamicResource Popup.PanelBg}"
                BorderBrush="{DynamicResource Popup.Bdr}" BorderThickness="1"
                CornerRadius="{StaticResource Radius.md}">
            <!-- R3-6: no DropShadowEffect. In software-render mode (AllowsTransparency) an Effect
                 allocates an offscreen buffer that DISABLES ClearType for the subtree, so the card's
                 text re-rastered crisp↔grey on every open/close = the "flash". The 1px Popup.Bdr rim +
                 the near-opaque glass fill carry the card's definition without a render target. -->
            <Border.RenderTransform><ScaleTransform x:Name="ChatScale" ScaleX="1" ScaleY="1"/></Border.RenderTransform>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- R3 chatbox #1: always-on accent rim so the chat card reads as one lit object of the
                     same neon family as the bar (mirrors barNeonRim verbatim). Static (rides the existing
                     AnimateCard entrance), behind content, never hit-tested. -->
                <Border x:Name="chatNeonRim" Grid.RowSpan="3" Margin="-1" IsHitTestVisible="False"
                        CornerRadius="{StaticResource Radius.md}"
                        BorderBrush="{DynamicResource Popup.Blue}" BorderThickness="1" Opacity="0.18"/>

                <!-- header: identity + clear-chat. -->
                <Grid Margin="16,11,8,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="SenseEase AI" VerticalAlignment="Center"
                               FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource Popup.Ink1}"/>
                    <Button Grid.Column="1" Style="{StaticResource BarIconBtn}" Command="{Binding Chat.ClearCommand}"
                            VerticalAlignment="Center"
                            ToolTip="{loc:T Zh='清除對話', En='Clear chat'}"
                            AutomationProperties.Name="{loc:T Zh='清除對話', En='Clear chat'}">
                        <Path Data="{StaticResource Icon.Trash}" Fill="{DynamicResource Popup.Ink2}" Width="14" Height="14" Stretch="Uniform"/>
                    </Button>
                </Grid>

                <!-- messages — fill the fixed-height card's middle row; scroll when overflowing -->
                <ScrollViewer x:Name="ChatScroll" Grid.Row="1" Margin="10,0" VerticalScrollBarVisibility="Auto"
                              PanningMode="VerticalOnly" ScrollChanged="OnChatScrollChanged"
                              Style="{DynamicResource AutoHideScroll}">
                    <ItemsControl ItemsSource="{Binding Chat.Messages}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="6,4">
                                    <Border CornerRadius="12" Padding="10,8" MaxWidth="246">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="HorizontalAlignment" Value="Left"/>
                                                <Setter Property="Background" Value="{DynamicResource Popup.BotBubbleBg}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsUser}" Value="True">
                                                        <Setter Property="HorizontalAlignment" Value="Right"/>
                                                        <Setter Property="Background" Value="{DynamicResource Popup.Blue}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Grid>
                                            <!-- Selectable, marker-stripped content (reuses the proven
                                                 MarkdownInlines source the console chat uses). Hidden while typing. -->
                                            <TextBox Visibility="{Binding ContentVisibility}"
                                                     views:MarkdownInlines.Source="{Binding Content}"
                                                     IsReadOnly="True" IsReadOnlyCaretVisible="False" IsTabStop="False"
                                                     BorderThickness="0" Background="Transparent" Padding="0"
                                                     TextWrapping="Wrap" FontSize="13">
                                                <TextBox.Style>
                                                    <Style TargetType="TextBox">
                                                        <Setter Property="Foreground" Value="{DynamicResource Popup.Ink1}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsUser}" Value="True">
                                                                <Setter Property="Foreground" Value="White"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBox.Style>
                                            </TextBox>
                                            <!-- Animated typing dots — opacity-only staggered pulse (WCAG-2.3.3
                                                 RM-exempt), mirroring the proven MainWindow DotsStoryboard. Same
                                                 per-message TypingVisibility gate (unchanged); self-halts when hidden. -->
                                            <StackPanel Orientation="Horizontal" Visibility="{Binding TypingVisibility}"
                                                        VerticalAlignment="Center">
                                                <StackPanel.Resources>
                                                    <Storyboard x:Key="PopupDots" RepeatBehavior="Forever">
                                                        <DoubleAnimation Storyboard.TargetName="D1" Storyboard.TargetProperty="Opacity"
                                                                         From="0.2" To="1.0" Duration="0:0:0.25" AutoReverse="True"/>
                                                        <DoubleAnimation Storyboard.TargetName="D2" Storyboard.TargetProperty="Opacity"
                                                                         From="0.2" To="1.0" Duration="0:0:0.25" BeginTime="0:0:0.1" AutoReverse="True"/>
                                                        <DoubleAnimation Storyboard.TargetName="D3" Storyboard.TargetProperty="Opacity"
                                                                         From="0.2" To="1.0" Duration="0:0:0.25" BeginTime="0:0:0.2" AutoReverse="True"/>
                                                    </Storyboard>
                                                </StackPanel.Resources>
                                                <StackPanel.Triggers>
                                                    <EventTrigger RoutedEvent="StackPanel.Loaded">
                                                        <BeginStoryboard Storyboard="{StaticResource PopupDots}"/>
                                                    </EventTrigger>
                                                </StackPanel.Triggers>
                                                <Ellipse x:Name="D1" Width="6" Height="6" Fill="{DynamicResource Popup.Ink2}" Opacity="0.35" Margin="0,0,3,0"/>
                                                <Ellipse x:Name="D2" Width="6" Height="6" Fill="{DynamicResource Popup.Ink2}" Opacity="0.35" Margin="0,0,3,0"/>
                                                <Ellipse x:Name="D3" Width="6" Height="6" Fill="{DynamicResource Popup.Ink2}" Opacity="0.35"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <!-- Gated followup options: the FMS check-in / habituation-proposal
                                         answers + B5 adaptation notices flow through the real
                                         ChatbotViewModel into Messages, so they surface here automatically. -->
                                    <!-- R3 #3b: smaller, left-aligned option chips (the big centred pills
                                         read 'cheap'). Compact padding / font / min-height; flush left. -->
                                    <ItemsControl ItemsSource="{Binding FollowupOptions}" Margin="2,6,0,0"
                                                  HorizontalAlignment="Left"
                                                  Visibility="{Binding FollowupVisibility}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate><WrapPanel HorizontalAlignment="Left"/></ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Content="{Binding}"
                                                        Command="{Binding DataContext.SelectFollowupCommand,
                                                                          RelativeSource={RelativeSource AncestorType=ItemsControl, AncestorLevel=1}}"
                                                        CommandParameter="{Binding}"
                                                        Style="{StaticResource GhostPanelBtn}"
                                                        HorizontalAlignment="Left"
                                                        Padding="9,4" FontSize="12" MinHeight="24" Margin="0,0,5,5"/>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <!-- FMS 0–20 quick-rate row (UVHS 2026-06-20): card-LESS, narrow, mouse-sized.
                                         Lives directly under the proactive question — no separate card. Software-render
                                         safe (flat brushes only, no effects/cache; state via brush only). -->
                                    <StackPanel Visibility="{Binding FmsVisibility}" Margin="2,5,2,2" HorizontalAlignment="Left">
                                        <!-- header: hint on the left, ‹ › window arrows pinned to the very top-right of the box -->
                                        <Grid Margin="1,0,0,4">
                                            <TextBlock Text="{Binding FmsHint}" Foreground="{DynamicResource Popup.Ink2}"
                                                       FontSize="10.5" TextWrapping="Wrap" VerticalAlignment="Center"
                                                       Margin="0,0,52,0"/>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                                                <Button Style="{StaticResource FmsNavArrowBtn}"
                                                        Command="{Binding FmsBackCommand}" IsEnabled="{Binding FmsCanGoBack}"
                                                        ToolTip="{loc:T Zh='回到較舒適的數字', En='Back to lower numbers'}"
                                                        AutomationProperties.Name="{loc:T Zh='上一組數字', En='Back to lower numbers'}">
                                                    <Path Data="M 6,0 L 0,6 L 6,12" Stroke="{DynamicResource Popup.Ink1}"
                                                          StrokeThickness="1.6" StrokeStartLineCap="Round"
                                                          StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                                                </Button>
                                                <Button Style="{StaticResource FmsNavArrowBtn}" Margin="4,0,0,0"
                                                        Command="{Binding FmsWorseCommand}" IsEnabled="{Binding FmsCanGoWorse}"
                                                        ToolTip="{loc:T Zh='更嚴重的數字', En='Higher numbers (worse)'}"
                                                        AutomationProperties.Name="{loc:T Zh='更嚴重數字', En='Worse — higher numbers'}">
                                                    <Path Data="M 0,0 L 6,6 L 0,12" Stroke="{DynamicResource Popup.Ink1}"
                                                          StrokeThickness="1.6" StrokeStartLineCap="Round"
                                                          StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                        <ItemsControl ItemsSource="{Binding FmsButtons}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button Width="26" Height="26" Margin="0,0,4,0" Cursor="Hand"
                                                            FocusVisualStyle="{DynamicResource FocusVisible}"
                                                            Command="{Binding DataContext.SelectFmsCommand,
                                                                              RelativeSource={RelativeSource AncestorType=ItemsControl, AncestorLevel=1}}"
                                                            CommandParameter="{Binding Value}"
                                                            AutomationProperties.Name="{Binding AccessibleName}">
                                                        <Button.Template>
                                                            <ControlTemplate TargetType="Button">
                                                                <Border x:Name="sq" CornerRadius="6" BorderThickness="1"
                                                                        Background="{Binding IdleTint}"
                                                                        BorderBrush="{DynamicResource Popup.Bdr}">
                                                                    <TextBlock Text="{Binding Value}" FontSize="12"
                                                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                               Foreground="{DynamicResource Popup.Ink1}"/>
                                                                </Border>
                                                                <ControlTemplate.Triggers>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter TargetName="sq" Property="BorderBrush"
                                                                                Value="{DynamicResource Popup.Ink2}"/>
                                                                    </Trigger>
                                                                    <Trigger Property="IsPressed" Value="True">
                                                                        <Setter TargetName="sq" Property="Opacity" Value="0.6"/>
                                                                    </Trigger>
                                                                </ControlTemplate.Triggers>
                                                            </ControlTemplate>
                                                        </Button.Template>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <!-- thin comfort-spectrum track: calm → warm, never alarming -->
                                        <Rectangle Height="2" RadiusX="1" RadiusY="1" Margin="1,5,1,0"
                                                   Fill="{Binding FmsTrackBrush}"/>
                                    </StackPanel>
                                    <!-- calm confirmation shown in place of the row after the user rates -->
                                    <TextBlock Visibility="{Binding FmsConfirmVisibility}" Text="{Binding FmsConfirmText}"
                                               Foreground="{DynamicResource Popup.Ink2}" FontSize="12"
                                               Margin="4,7,2,2" TextWrapping="Wrap"/>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- input area (R3 chatbox): quick-start chips · recessed input + neon focus halo ·
                     send w/ accent glow · keymap footer. Stacked inside the SAME bottom Auto row — no new
                     RowDefinition, so the fixed-480 layout is preserved (messages row absorbs the delta). -->
                <StackPanel Grid.Row="2" Margin="12,8,12,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- recessed auto-expanding input. Its OWN border turns accent on keyboard focus —
                             correctly sized to the field. (A stretch overlay rim, like the bar's fixed-size
                             chip ring, over-sized the box to the row height, so the focus lives on the field
                             border itself here.) -->
                        <Border Grid.Column="0" Background="#33000000" BorderThickness="1" CornerRadius="9"
                                VerticalAlignment="Bottom">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="BorderBrush" Value="{DynamicResource Popup.Bdr}"/>
                                    <Style.Triggers>
                                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                            <Setter Property="BorderBrush" Value="{DynamicResource Popup.Blue}"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Grid>
                                <TextBox x:Name="ChatInput" Background="Transparent" BorderThickness="0"
                                         Padding="9,6" FontSize="13" MinHeight="20" MaxHeight="84"
                                         TextWrapping="Wrap" AcceptsReturn="True" VerticalContentAlignment="Center"
                                         VerticalScrollBarVisibility="Auto"
                                         Foreground="{DynamicResource Popup.Ink1}" CaretBrush="{DynamicResource Popup.Ink1}"
                                         Text="{Binding Chat.InputText, UpdateSourceTrigger=PropertyChanged}"
                                         IsVisibleChanged="OnChatInputVisibleChanged" PreviewKeyDown="OnChatInputKeyDown"
                                         AutomationProperties.Name="{loc:T Zh='輸入訊息給 SenseEase AI', En='Message SenseEase AI'}"/>
                                <!-- Placeholder watermark — shown only while the field is empty (driven by
                                     the TextBox's own Text); non-interactive so clicks fall through to the input. -->
                                <TextBlock IsHitTestVisible="False" Padding="9,6" FontSize="13"
                                           VerticalAlignment="Center" Foreground="{DynamicResource Popup.Ink2}"
                                           Text="{loc:T Zh='有不適都可以告訴我', En='Tell me how you feel…'}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Text, ElementName=ChatInput}" Value="">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </Border>

                        <!-- send / stop, with a soft accent glow behind the chip (brightens while a reply
                             is generating). The Button (Send↔Stop command + icon morph) is verbatim. -->
                        <Grid Grid.Column="1" Margin="6,0,0,0" VerticalAlignment="Bottom">
                            <Border Width="32" Height="32" CornerRadius="{StaticResource Radius.md}" Background="{DynamicResource Popup.Blue}"
                                    IsHitTestVisible="False" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Opacity" Value="0.30"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Chat.IsGenerating}" Value="True">
                                                <Setter Property="Opacity" Value="0.50"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                            </Border>
                            <Button AutomationProperties.Name="{loc:T Zh='傳送或停止', En='Send or stop'}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource BarPrimaryBtn}">
                                        <Setter Property="Command" Value="{Binding Chat.SendCommand}"/>
                                        <Setter Property="ToolTip" Value="{loc:T Zh='傳送', En='Send'}"/>
                                        <Style.Triggers>
                                            <!-- While generating, the same button STOPS the reply. -->
                                            <DataTrigger Binding="{Binding Chat.IsGenerating}" Value="True">
                                                <Setter Property="Command" Value="{Binding Chat.CancelGenerationCommand}"/>
                                                <Setter Property="ToolTip" Value="{loc:T Zh='停止生成', En='Stop'}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <Path Width="13" Height="13" Stretch="Uniform" Fill="White">
                                    <Path.Style>
                                        <Style TargetType="Path">
                                            <Setter Property="Data" Value="{StaticResource Icon.Send}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Chat.IsGenerating}" Value="True">
                                                    <Setter Property="Data" Value="{StaticResource Icon.Stop}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Path.Style>
                                </Path>
                            </Button>
                        </Grid>
                    </Grid>

                </StackPanel>
            </Grid>
        </Border>

        <!-- quick-settings card — a small individual card (NOT the chat's template), floats at the
             lower-left near the gear. In-window overlay, NOT a WPF Popup (a Popup hooks
             Application.Exit + mis-places over a topmost no-activate transparent window). -->
        <!-- Distinct from the chat card: uses the BAR's glass (not the chat's PanelBg), is
             narrower, a smaller pill radius, and a compact toggle list — a different "template". -->
        <Border x:Name="SettingsFlyout" Grid.Column="0" Width="214" Margin="0,0,8,12"
                VerticalAlignment="Bottom" HorizontalAlignment="Right" Panel.ZIndex="10"
                Visibility="Collapsed" Opacity="0" RenderTransformOrigin="1,1"
                Background="{DynamicResource Popup.BarBg}" BorderBrush="{DynamicResource Popup.Bdr}"
                BorderThickness="1" CornerRadius="{StaticResource Radius.sm}" Padding="11,11,11,11">
            <!-- R3-6: no DropShadowEffect (see ChatPanel note) — kills the ClearType re-raster flash. -->
            <Border.RenderTransform><ScaleTransform x:Name="SettingsScale" ScaleX="1" ScaleY="1"/></Border.RenderTransform>
            <StackPanel>
                <!-- (item 3) Each toggle carries a ? help glyph whose dark hover bubble describes the
                     control + its effect. Copy is transplanted from the app's established descriptions
                     where they exist (Graded exposure = full-settings subtitle; Auto Protect = its prior
                     tooltip); 格線 / 常駐遮罩 get calm bilingual copy in the same voice. The toggle also
                     carries AutomationProperties.HelpText so screen readers announce the same text. -->
                <StackPanel Orientation="Horizontal" Margin="0,2">
                    <CheckBox Style="{StaticResource SettingSwitch}" IsChecked="{Binding AnchorGridOn}"
                              Foreground="{DynamicResource Popup.Ink1}"
                              Content="{loc:T Zh='格線', En='Grid'}"
                              AutomationProperties.HelpText="{loc:T Zh='在畫面上疊加淡淡的錨點格線，給眼睛一個固定的定位點：畫面晃動時，目光可以抓住格線並穩定下來，減輕視覺上的搖晃。關閉則隱藏。', En='Overlays faint anchor lines that give your eyes a fixed point to settle on — when the view sways, your gaze can latch onto the grid and steady, easing the visual motion. Off hides them.'}"/>
                    <Button Style="{StaticResource HelpGlyph}" Margin="6,0,0,0" VerticalAlignment="Center"
                            AutomationProperties.Name="{loc:T Zh='格線說明', En='Grid help'}">
                        <Button.ToolTip><ToolTip Style="{StaticResource HelpTip}"
                            Content="{loc:T Zh='在畫面上疊加淡淡的錨點格線，給眼睛一個固定的定位點：畫面晃動時，目光可以抓住格線並穩定下來，減輕視覺上的搖晃。關閉則隱藏。', En='Overlays faint anchor lines that give your eyes a fixed point to settle on — when the view sways, your gaze can latch onto the grid and steady, easing the visual motion. Off hides them.'}"/></Button.ToolTip>
                    </Button>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,2">
                    <CheckBox Style="{StaticResource SettingSwitch}" IsChecked="{Binding GradedExposureOn}"
                              Foreground="{DynamicResource Popup.Ink1}"
                              Content="{loc:T Zh='漸進適應', En='Adaptive Training'}"
                              AutomationProperties.HelpText="{loc:T Zh='開啟後，SenseEase 會在您舒適時逐步、緩慢地放寬防護，幫助您按自己的步調適應。隨時可暫停。', En='When on, SenseEase gradually relaxes protection while you are comfortable, helping you adjust at your own pace. Pause anytime.'}"/>
                    <Button Style="{StaticResource HelpGlyph}" Margin="6,0,0,0" VerticalAlignment="Center"
                            AutomationProperties.Name="{loc:T Zh='漸進適應說明', En='Adaptive Training help'}">
                        <Button.ToolTip><ToolTip Style="{StaticResource HelpTip}"
                            Content="{loc:T Zh='開啟後，SenseEase 會在您舒適時逐步、緩慢地放寬防護，幫助您按自己的步調適應。隨時可暫停。', En='When on, SenseEase gradually relaxes protection while you are comfortable, helping you adjust at your own pace. Pause anytime.'}"/></Button.ToolTip>
                    </Button>
                </StackPanel>
                <!-- Persistent-mask switch temporarily HIDDEN (Kirby 2026-06-23): its backing flag
                     (PersistentOverlayEnabled) is overloaded with the strength-baseline floor, so it self-lit
                     whenever the user dragged the level bar / hit +-. Always-on is already reachable that way
                     (any level > 1 floors the baseline). Reinstate once the read state is split out
                     (PersistentMaskUserChosen) — see the 2026-06-23 audit. -->
                <StackPanel Orientation="Horizontal" Margin="0,2" Visibility="Collapsed">
                    <CheckBox Style="{StaticResource SettingSwitch}" IsChecked="{Binding PersistentMaskOn}"
                              Foreground="{DynamicResource Popup.Ink1}"
                              Content="{loc:T Zh='常駐遮罩', En='Persistent mask'}"
                              AutomationProperties.HelpText="{loc:T Zh='讓舒適防護遮罩持續顯示，即使目前未偵測到晃動。', En='Keeps a gentle comfort overlay on at all times, even when no motion is detected.'}"/>
                    <Button Style="{StaticResource HelpGlyph}" Margin="6,0,0,0" VerticalAlignment="Center"
                            AutomationProperties.Name="{loc:T Zh='常駐遮罩說明', En='Persistent mask help'}">
                        <Button.ToolTip><ToolTip Style="{StaticResource HelpTip}"
                            Content="{loc:T Zh='讓舒適防護遮罩持續顯示，即使目前未偵測到晃動。', En='Keeps a gentle comfort overlay on at all times, even when no motion is detected.'}"/></Button.ToolTip>
                    </Button>
                </StackPanel>
                <!-- 自動防護 / Auto Protect (backing flag: AlwaysAllowOverlay) — overlay-consent mode:
                     ON = auto-engage on motion (no bubble), OFF = ask each time. -->
                <StackPanel Orientation="Horizontal" Margin="0,2">
                    <CheckBox Style="{StaticResource SettingSwitch}" IsChecked="{Binding AlwaysAllowOverlayOn}"
                              Foreground="{DynamicResource Popup.Ink1}"
                              Content="{loc:T Zh='自動防護', En='Auto Protect'}"
                              AutomationProperties.HelpText="{loc:T Zh='開啟後，偵測到晃動會自動開啟舒適防護，不再先詢問。', En='When on, the comfort overlay auto-engages on motion without asking first.'}"/>
                    <Button Style="{StaticResource HelpGlyph}" Margin="6,0,0,0" VerticalAlignment="Center"
                            AutomationProperties.Name="{loc:T Zh='自動防護說明', En='Auto Protect help'}">
                        <Button.ToolTip><ToolTip Style="{StaticResource HelpTip}"
                            Content="{loc:T Zh='開啟後，偵測到晃動會自動開啟舒適防護，不再先詢問。', En='When on, the comfort overlay auto-engages on motion without asking first.'}"/></Button.ToolTip>
                    </Button>
                </StackPanel>
                <Border Height="1" Background="{DynamicResource Popup.Ink3}" Margin="0,9,0,7" Opacity="0.4"/>
                <Button Content="{loc:T Zh='更多設定', En='More settings'}" Style="{StaticResource PanelBtn}"
                        HorizontalAlignment="Stretch" Command="{Binding OpenFullSettingsCommand}"
                        AutomationProperties.Name="{loc:T Zh='開啟更多設定', En='Open more settings'}"/>
            </StackPanel>
        </Border>

        <!-- ═══ Col 1 — the bar ═══ -->
        <!-- Two-stage reveal: the bar reveals CONDENSED — status · power · chat · expand-chevron.
             The chevron grows it to FULL, adding the ±strength meter, the quick-settings gear, and
             the pin. IsExpanded-bound blocks carry their OWN leading divider so no orphan dividers
             appear when collapsed. -->
        <Border x:Name="BarRoot" Grid.Column="1" Width="48" Padding="0,8"
                VerticalAlignment="Center"
                Background="{DynamicResource Popup.BarBg}"
                BorderBrush="{DynamicResource Popup.Bdr}" BorderThickness="1"
                CornerRadius="{StaticResource Radius.md}"
                RenderTransformOrigin="1,0.5"
                MouseLeftButtonDown="OnBarMouseDown"><!-- R3-6: no DropShadowEffect (ClearType re-raster flash) -->
            <!-- The whole bar background is still a drag surface (OnBarMouseDown), but it no longer
                 wears a SizeNS cursor — that over-implied EVERY control was drag-adjustable and
                 confused the user. The vertical drag is now advertised by ONE explicit grip handle at
                 the bottom (DragHandle, shown when expanded). BarScale drives the unified fade+scale
                 reveal (code-behind, deferred to settle). -->
            <Border.RenderTransform><ScaleTransform x:Name="BarScale" ScaleX="1" ScaleY="1"/></Border.RenderTransform>
            <Grid>
                <!-- NEON edge-glow (R3 #1): a faint always-on accent rim tracing the bar (negative
                     margin cancels BarRoot's 0,8 padding so it reaches the rounded edge). Crisp accent
                     stroke (no DropShadow — Effects don't render on the transparent glass window). -->
                <Border x:Name="barNeonRim" Margin="0,-8" CornerRadius="{StaticResource Radius.md}"
                        BorderBrush="{DynamicResource Popup.Blue}" BorderThickness="1"
                        IsHitTestVisible="False" Opacity="0.18"/>
                <StackPanel HorizontalAlignment="Center">

                <!-- (item 2) status dot + 低/中/高 word removed — the bar now opens straight to the
                     action button; on-screen motion is conveyed by the overlay itself, not a bar readout. -->

                <!-- on/off switch — the SenseEase mark on a GLASS chip that matches the bar (R3 #2: no
                     blue tone behind it). ON = raised glass chip + full-strength mark (+ the neon ring,
                     Group 5); OFF/paused = flat (transparent) chip + dimmed mark. CONDENSED + FULL -->
                <Button x:Name="PlayPauseButton" Command="{Binding PlayPauseCommand}"
                        ToolTip="{loc:T Zh='開啟／暫停保護', En='Toggle protection on / off'}"
                        AutomationProperties.Name="{loc:T Zh='開啟或暫停保護', En='Toggle protection on/off'}">
                    <Button.Style>
                        <!-- BarIconBtn (glass hover = Popup.BtnHover), NOT BarPrimaryBtn — so neither the
                             rest fill nor the hover is blue. ON = glass chip; paused = flat/transparent. -->
                        <Style TargetType="Button" BasedOn="{StaticResource BarIconBtn}">
                            <Setter Property="Background" Value="{DynamicResource Popup.ChipRest}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsPaused}" Value="True">
                                    <Setter Property="Background" Value="Transparent"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <!-- (item 3) the SenseEase app mark as the action glyph. Raster .ico (≤24px source)
                         → mildly soft at this size; HighQuality scaling softens the upscale. Dims when
                         paused so ON/OFF reads from the mark itself (no blue chip). -->
                    <Grid Width="28" Height="28">
                        <!-- ACTIVE state = a soft blue GLOW around the SenseEase mark while protection is
                             ON. R3-6: the glow is a STATIC radial-gradient halo (an Ellipse), NOT a
                             DropShadowEffect. In software-render mode an Effect allocates an offscreen
                             buffer that DISABLES ClearType + re-rasters on every toggle — so the old
                             DropShadow flashed the bar each time PlayPause flipped IsPaused. The halo's
                             Opacity (not an Effect) toggles with IsPaused — cheap, no render target, no
                             flash — mirroring the slider-thumb glow pattern already used in this file. -->
                        <Ellipse Width="32" Height="32" IsHitTestVisible="False"
                                 HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Ellipse.Fill>
                                <RadialGradientBrush>
                                    <GradientStop Color="{DynamicResource Popup.NeonGlowColor}"     Offset="0.0"/>
                                    <GradientStop Color="{DynamicResource Popup.NeonGlowColor}"     Offset="0.45"/>
                                    <GradientStop Color="{DynamicResource Popup.NeonGlowColorEdge}" Offset="1.0"/>
                                </RadialGradientBrush>
                            </Ellipse.Fill>
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Opacity" Value="0.85"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsPaused}" Value="True">
                                            <Setter Property="Opacity" Value="0"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <Image Source="pack://application:,,,/SenseEase.App;component/Resources/AppIcon.ico"
                               Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center"
                               RenderOptions.BitmapScalingMode="HighQuality">
                            <Image.Style>
                                <Style TargetType="Image">
                                    <Setter Property="Opacity" Value="1"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsPaused}" Value="True">
                                            <Setter Property="Opacity" Value="0.4"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Image.Style>
                        </Image>
                    </Grid>
                </Button>

                <!-- FULL only: intensity drag slider + Lv.NN readout (with its own leading divider so
                     nothing is orphaned when condensed). The engine owns the level; dragging the
                     handle routes a TwoWay IntensityLevel to the absolute setter. Top = stronger. -->
                <StackPanel x:Name="MeterSection" HorizontalAlignment="Center"
                            Visibility="Collapsed" ClipToBounds="True">
                    <!-- R3-5: a TranslateTransform the expand/collapse animates (Y rise/sink) instead of
                         Height — transforms composite fine in software-render mode, Height re-ran layout
                         + a native window resize every frame (the old "jerky" growth). -->
                    <StackPanel.RenderTransform><TranslateTransform x:Name="MeterShift"/></StackPanel.RenderTransform>
                    <Border Height="1" Width="22" Margin="0,5" Background="{DynamicResource Popup.OnBarDim}" Opacity="0.30"/>
                    <Slider x:Name="IntensitySlider" Style="{StaticResource PopupIntensitySlider}"
                            Height="128" HorizontalAlignment="Center" Margin="0,2"
                            Value="{Binding IntensityLevel, Mode=TwoWay}"
                            ToolTip="{loc:T Zh='拖曳調整保護強度', En='Drag to set protection strength'}"
                            AutomationProperties.Name="{loc:T Zh='保護強度（1 至 12，往上更強）', En='Protection strength (1 to 12, up is stronger)'}"/>
                    <TextBlock Text="{Binding LevelText}" HorizontalAlignment="Center" FontSize="12" FontWeight="SemiBold"
                               Margin="0,4,0,0" Foreground="{DynamicResource Popup.OnBar}"/>
                </StackPanel>

                <Border Height="1" Width="22" Margin="0,5" Background="{DynamicResource Popup.OnBarDim}" Opacity="0.30"/>

                <!-- chat — CONDENSED + FULL -->
                <Button Style="{StaticResource BarIconBtn}" Command="{Binding ToggleChatCommand}"
                        ToolTip="{loc:T Zh='與 SenseEase AI 對話', En='Chat with SenseEase AI'}"
                        AutomationProperties.Name="{loc:T Zh='開啟對話', En='Open chat'}">
                    <Path Data="{StaticResource Icon.Chat}" Fill="{DynamicResource Popup.OnBar}" Width="15" Height="15" Stretch="Uniform"/>
                </Button>

                <!-- FULL only: quick-settings gear. The gear's dropdown is the in-window
                     SettingsFlyout card. (Pin removed — item 7: the bar appears reactively when
                     needed, so a keep-open pin is unnecessary; the bar is always dismissible.) -->
                <StackPanel x:Name="ToolsSection" HorizontalAlignment="Center"
                            Visibility="Collapsed" ClipToBounds="True">
                    <StackPanel.RenderTransform><TranslateTransform x:Name="ToolsShift"/></StackPanel.RenderTransform>
                    <Button x:Name="SettingsBtn" Style="{StaticResource BarIconBtn}" Command="{Binding ToggleSettingsCommand}"
                            ToolTip="{loc:T Zh='快速設定', En='Quick settings'}"
                            AutomationProperties.Name="{loc:T Zh='設定', En='Settings'}">
                        <Path Data="{StaticResource Icon.Settings}" Fill="{DynamicResource Popup.OnBar}" Width="15" Height="15" Stretch="Uniform"/>
                    </Button>
                </StackPanel>

                <Border Height="1" Width="22" Margin="0,5" Background="{DynamicResource Popup.OnBarDim}" Opacity="0.30"/>

                <!-- expand / collapse chevron — always shown (pin removed, item 7) -->
                <Button Command="{Binding ToggleExpandCommand}"
                        Style="{StaticResource BarIconBtn}"
                        ToolTip="{loc:T Zh='展開／收合工具列', En='Expand / collapse'}"
                        AutomationProperties.Name="{loc:T Zh='展開或收合工具列', En='Expand or collapse the bar'}">
                    <Path Width="14" Height="14" Stretch="Uniform" Stroke="{DynamicResource Popup.OnBar}" StrokeThickness="2"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round">
                        <Path.Style>
                            <Style TargetType="Path">
                                <Setter Property="Data" Value="{StaticResource Icon.ChevronDown}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                        <Setter Property="Data" Value="{StaticResource Icon.ChevronUp}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Path.Style>
                    </Path>
                </Button>

                <!-- Drag handle — the explicit grip for moving the bar up / down. Shown ONLY in the
                     EXPANDED stage (item 6 — tucked away in the condensed bar to keep it minimal). A
                     press here is non-interactive, so it bubbles up to BarRoot.OnBarMouseDown and runs
                     the vertical-only DragMove (mouse) / the window touch path (touch); the condensed
                     bar is still draggable from its background via the same handler. -->
                <Border x:Name="DragHandle" Cursor="SizeNS" Background="Transparent"
                        Visibility="Collapsed" ClipToBounds="True"
                        HorizontalAlignment="Center" Margin="0,-2,0,0" Padding="8,3"
                        ToolTip="{loc:T Zh='拖曳調整上下位置', En='Drag to move up / down'}"
                        AutomationProperties.Name="{loc:T Zh='拖曳調整工具列上下位置', En='Drag the bar up or down'}">
                    <Border.RenderTransform><TranslateTransform x:Name="DragShift"/></Border.RenderTransform>
                    <Border.Style>
                        <Style TargetType="Border">
                            <!-- R3 #4: TWO short rules (a single line confused as a 'minus'); small +
                                 faint at rest, pulled tight under the chevron (negative top margin). -->
                            <Setter Property="Opacity" Value="0.3"/>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Opacity" Value="0.6"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel VerticalAlignment="Center">
                        <Border Width="10" Height="1.5" CornerRadius="0.75"
                                Background="{DynamicResource Popup.OnBarDim}"/>
                        <Border Width="10" Height="1.5" CornerRadius="0.75" Margin="0,2,0,0"
                                Background="{DynamicResource Popup.OnBarDim}"/>
                    </StackPanel>
                </Border>
            </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
