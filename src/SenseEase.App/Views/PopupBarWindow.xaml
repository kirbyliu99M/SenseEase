<Window x:Class="SenseEase.App.Views.PopupBarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:SenseEase.App.Localization"
        xmlns:conv="clr-namespace:SenseEase.App.Converters"
        xmlns:views="clr-namespace:SenseEase.App.Views"
        Title="SenseEase"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="Manual"
        AutomationProperties.Name="{loc:T Zh='SenseEase 控制列', En='SenseEase control bar'}"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType"
        RenderOptions.BitmapScalingMode="HighQuality">
    <!-- UI-RESHAPE prep: the glass vertical function bar (col 1) with a slide-out AI
         chat panel (col 0). Native WPF translation of senseease-vertical-v1.html using
         the reference palette (PopupGlassTokens) over a Win11 acrylic window. NO XAML
         storyboards in this skeleton (pulse + reveal are static) so it is smoke-clean
         and free of un-gated motion; ReducedMotion-gated polish animations land in
         code-behind later. DataContext = PopupBarViewModel. -->
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/SenseEase.App;component/Theme/SenseEaseTheme.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/SenseEase.App;component/Theme/PopupGlassTokens.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/SenseEase.App;component/Theme/Icons.PopupBar.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <conv:TierToPopupStatusBrushConverter x:Key="StatusBrush"/>
            <conv:TierToPopupStatusWordConverter  x:Key="StatusWord"/>
            <conv:TierToPopupStatusGlyphConverter x:Key="StatusGlyph"/>
            <conv:SegmentFillConverter            x:Key="SegFill"/>
            <BooleanToVisibilityConverter         x:Key="BoolToVis"/>

            <!-- Round transparent glyph button on the bar -->
            <Style x:Key="BarIconBtn" TargetType="Button">
                <Setter Property="Width" Value="34"/>
                <Setter Property="Height" Value="34"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="FocusVisualStyle" Value="{DynamicResource FocusVisible}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="17">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="{StaticResource Popup.BtnHover}"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="{StaticResource Popup.BtnPress}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Filled blue primary (play/pause) -->
            <Style x:Key="BarPrimaryBtn" TargetType="Button">
                <Setter Property="Width" Value="38"/>
                <Setter Property="Height" Value="38"/>
                <Setter Property="Background" Value="{StaticResource Popup.Blue}"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="FocusVisualStyle" Value="{DynamicResource FocusVisible}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="19">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="{StaticResource Popup.BlueHover}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Calm pill button used on the light panels (chat options, undo, full-settings, send) -->
            <Style x:Key="PanelBtn" TargetType="Button">
                <Setter Property="Background" Value="{StaticResource Popup.Blue}"/>
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Padding" Value="12,6"/>
                <Setter Property="MinHeight" Value="32"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="FocusVisualStyle" Value="{DynamicResource FocusVisible}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="16"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="{StaticResource Popup.BlueHover}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Ghost pill for secondary panel actions (undo / followup options) -->
            <Style x:Key="GhostPanelBtn" TargetType="Button" BasedOn="{StaticResource PanelBtn}">
                <Setter Property="Background" Value="#1A024AD8"/>
                <Setter Property="Foreground" Value="{StaticResource Popup.Ink1}"/>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid x:Name="RootGrid" SizeChanged="OnRootSizeChanged">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <!-- ═══ Col 0 — AI chat panel (toggled) ═══ -->
        <Border x:Name="ChatPanel" Grid.Column="0" Width="300" Margin="0,0,6,0"
                Visibility="Collapsed" Opacity="0" RenderTransformOrigin="1,0.5"
                Background="{StaticResource Popup.PanelBg}"
                BorderBrush="{StaticResource Popup.Bdr}" BorderThickness="1"
                CornerRadius="{StaticResource Radius.md}"
                Effect="{StaticResource Elev.3}">
            <Border.RenderTransform><TranslateTransform x:Name="ChatXform" X="28"/></Border.RenderTransform>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="320"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- header -->
                <StackPanel Orientation="Horizontal" Margin="14,12,14,8">
                    <!-- This dot = LLM ONLINE status (green = chat model loaded, grey = offline) —
                         NOT screen motion. Binds Chat.IsLlmOnline (raised when the model finishes loading). -->
                    <Ellipse Width="10" Height="10" VerticalAlignment="Center"
                             AutomationProperties.Name="{loc:T Zh='AI 連線狀態', En='AI connection status'}">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="{StaticResource Popup.Ink3}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Chat.IsLlmOnline}" Value="True">
                                        <Setter Property="Fill" Value="{StaticResource Popup.Low}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <TextBlock Text="SenseEase AI" Margin="8,0,0,0" VerticalAlignment="Center"
                               FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource Popup.Ink1}"/>
                </StackPanel>

                <!-- messages -->
                <ScrollViewer Grid.Row="1" Margin="8,0" VerticalScrollBarVisibility="Auto"
                              Style="{DynamicResource AutoHideScroll}">
                    <ItemsControl ItemsSource="{Binding Chat.Messages}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="6,4">
                                    <Border CornerRadius="12" Padding="9,7" MaxWidth="244">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="HorizontalAlignment" Value="Left"/>
                                                <Setter Property="Background" Value="#33FFFFFF"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsUser}" Value="True">
                                                        <Setter Property="HorizontalAlignment" Value="Right"/>
                                                        <Setter Property="Background" Value="{StaticResource Popup.Blue}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Grid>
                                            <!-- Selectable, marker-stripped content (reuses the proven
                                                 MarkdownInlines source the console chat uses). Hidden while typing. -->
                                            <TextBox Visibility="{Binding ContentVisibility}"
                                                     views:MarkdownInlines.Source="{Binding Content}"
                                                     IsReadOnly="True" IsReadOnlyCaretVisible="False" IsTabStop="False"
                                                     BorderThickness="0" Background="Transparent" Padding="0"
                                                     TextWrapping="Wrap" FontSize="13">
                                                <TextBox.Style>
                                                    <Style TargetType="TextBox">
                                                        <Setter Property="Foreground" Value="{StaticResource Popup.Ink1}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsUser}" Value="True">
                                                                <Setter Property="Foreground" Value="White"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBox.Style>
                                            </TextBox>
                                            <!-- Static "thinking" indicator while generating — no animation
                                                 (reduced-motion-safe by default for a motion-sickness app). -->
                                            <TextBlock Visibility="{Binding TypingVisibility}"
                                                       Text="• • •" FontSize="15" Foreground="{StaticResource Popup.Ink2}"/>
                                        </Grid>
                                    </Border>

                                    <!-- Gated followup options: the FMS check-in / habituation-proposal
                                         answers + B5 adaptation notices flow through the real
                                         ChatbotViewModel into Messages, so they surface here automatically. -->
                                    <ItemsControl ItemsSource="{Binding FollowupOptions}" Margin="2,6,0,0"
                                                  Visibility="{Binding FollowupVisibility}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Content="{Binding}"
                                                        Command="{Binding DataContext.SelectFollowupCommand,
                                                                          RelativeSource={RelativeSource AncestorType=ItemsControl, AncestorLevel=1}}"
                                                        CommandParameter="{Binding}"
                                                        Style="{StaticResource GhostPanelBtn}" Margin="0,0,6,6" MinHeight="36"/>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- input row -->
                <Grid Grid.Row="2" Margin="12,8,12,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" x:Name="ChatInput" VerticalContentAlignment="Center" Padding="8,6" FontSize="13"
                             Text="{Binding Chat.InputText, UpdateSourceTrigger=PropertyChanged}"
                             Foreground="{StaticResource Popup.Ink1}"
                             IsVisibleChanged="OnChatInputVisibleChanged" KeyDown="OnChatInputKeyDown"
                             AutomationProperties.Name="{loc:T Zh='輸入訊息給 SenseEase AI', En='Message SenseEase AI'}"/>
                    <Button Grid.Column="1" Margin="6,0,0,0" Width="34" Height="34"
                            Command="{Binding Chat.SendCommand}"
                            Style="{StaticResource BarPrimaryBtn}"
                            AutomationProperties.Name="{loc:T Zh='傳送', En='Send'}">
                        <Path Data="{StaticResource Icon.Send}" Fill="White" Width="15" Height="15" Stretch="Uniform"/>
                    </Button>
                </Grid>
            </Grid>
        </Border>

        <!-- settings flyout — in-window overlay (NOT a WPF Popup: a Popup hooks Application.Exit
             and mis-places over a topmost no-activate transparent window). Sits in col 0, left of the bar. -->
        <Border x:Name="SettingsFlyout" Grid.Column="0" Width="218" Margin="0,0,6,14"
                VerticalAlignment="Bottom" HorizontalAlignment="Right" Panel.ZIndex="10"
                Visibility="Collapsed" Opacity="0" RenderTransformOrigin="1,1"
                Background="{StaticResource Popup.PanelBg}" BorderBrush="{StaticResource Popup.Bdr}"
                BorderThickness="1" CornerRadius="{StaticResource Radius.md}" Padding="12"
                Effect="{StaticResource Elev.3}">
            <Border.RenderTransform><TranslateTransform x:Name="SettingsXform" Y="28"/></Border.RenderTransform>
            <StackPanel>
                <CheckBox Style="{StaticResource SettingSwitch}" IsChecked="{Binding AnchorGridOn}"
                          Foreground="{StaticResource Popup.Ink1}" Margin="0,2"
                          Content="{loc:T Zh='錨點格線', En='Anchor grid'}"/>
                <CheckBox Style="{StaticResource SettingSwitch}" IsChecked="{Binding GradedExposureOn}"
                          Foreground="{StaticResource Popup.Ink1}" Margin="0,2"
                          Content="{loc:T Zh='漸進適應', En='Graded exposure'}"/>
                <CheckBox Style="{StaticResource SettingSwitch}" IsChecked="{Binding PersistentMaskOn}"
                          Foreground="{StaticResource Popup.Ink1}" Margin="0,2"
                          Content="{loc:T Zh='常駐遮罩', En='Persistent mask'}"/>
                <Border Height="1" Background="{StaticResource Popup.Ink3}" Margin="0,8" Opacity="0.4"/>
                <TextBlock Text="{Binding ProfileName}" FontSize="12" Foreground="{StaticResource Popup.Ink2}" Margin="2,0,0,8"/>
                <Button Content="{loc:T Zh='完整設定頁面', En='Full settings'}" Style="{StaticResource PanelBtn}"
                        HorizontalAlignment="Stretch" Command="{Binding OpenFullSettingsCommand}"
                        AutomationProperties.Name="{loc:T Zh='開啟完整設定頁面', En='Open full settings'}"/>
            </StackPanel>
        </Border>

        <!-- ═══ Col 1 — the bar ═══ -->
        <Border x:Name="BarRoot" Grid.Column="1" Width="56" Padding="0,12"
                Background="{StaticResource Popup.BarBg}"
                BorderBrush="{StaticResource Popup.Bdr}" BorderThickness="1"
                CornerRadius="{StaticResource Radius.md}"
                Effect="{StaticResource Elev.3}"
                MouseLeftButtonDown="OnBarMouseDown">
            <StackPanel HorizontalAlignment="Center">

                <!-- pulse status (colour + glyph + word) -->
                <StackPanel HorizontalAlignment="Center"
                            AutomationProperties.Name="{Binding VimsTier, Converter={StaticResource StatusWord}}">
                    <!-- Screen-motion status — a clean solid dot (no checkmark/glyph, no halo).
                         The 低/中/高 word below keeps it dual-coded for accessibility. -->
                    <Grid Width="26" Height="26" HorizontalAlignment="Center">
                        <Ellipse Width="16" Height="16"
                                 Fill="{Binding VimsTier, Converter={StaticResource StatusBrush}}"/>
                    </Grid>
                    <TextBlock Margin="0,3,0,0" HorizontalAlignment="Center" FontSize="12" FontWeight="SemiBold"
                               Foreground="{StaticResource Popup.OnBar}"
                               Text="{Binding VimsTier, Converter={StaticResource StatusWord}}"/>
                </StackPanel>

                <Border Height="1" Width="28" Margin="0,10" Background="{StaticResource Popup.OnBarDim}" Opacity="0.30"/>

                <!-- on/off switch — a power symbol; BRIGHT when running, DIM when paused -->
                <Button Command="{Binding PlayPauseCommand}"
                        AutomationProperties.Name="{loc:T Zh='開啟或暫停保護', En='Toggle protection on/off'}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource BarPrimaryBtn}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsPaused}" Value="True">
                                    <Setter Property="Opacity" Value="0.42"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <Path Data="{StaticResource Icon.Power}" Width="16" Height="16" Stretch="Uniform"
                          Stroke="White" StrokeThickness="2"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                </Button>

                <Border Height="1" Width="28" Margin="0,10" Background="{StaticResource Popup.OnBarDim}" Opacity="0.30"/>

                <!-- strength: read-only 12-seg meter + nudge buttons -->
                <StackPanel HorizontalAlignment="Center">
                    <Button Style="{StaticResource BarIconBtn}" Command="{Binding StrongerCommand}"
                            AutomationProperties.Name="{loc:T Zh='加強保護', En='Stronger protection'}">
                        <Path Data="{StaticResource Icon.Plus}" Fill="{StaticResource Popup.OnBar}" Width="14" Height="14" Stretch="Uniform"/>
                    </Button>
                    <ItemsControl ItemsSource="{Binding Segments}" Margin="0,5" HorizontalAlignment="Center"
                                  AutomationProperties.Name="{Binding LevelText}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Width="24" Height="5" Margin="0,1" CornerRadius="2.5"
                                        Background="{Binding Converter={StaticResource SegFill}}"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="{Binding LevelText}" HorizontalAlignment="Center" FontSize="12" FontWeight="SemiBold"
                               Foreground="{StaticResource Popup.OnBar}"/>
                    <Button Style="{StaticResource BarIconBtn}" Command="{Binding GentlerCommand}"
                            AutomationProperties.Name="{loc:T Zh='減弱保護', En='Gentler protection'}">
                        <Path Data="{StaticResource Icon.Minus}" Fill="{StaticResource Popup.OnBar}" Width="14" Height="14" Stretch="Uniform"/>
                    </Button>
                </StackPanel>

                <Border Height="1" Width="28" Margin="0,10" Background="{StaticResource Popup.OnBarDim}" Opacity="0.30"/>

                <!-- chat -->
                <Button Style="{StaticResource BarIconBtn}" Command="{Binding ToggleChatCommand}"
                        AutomationProperties.Name="{loc:T Zh='開啟對話', En='Open chat'}">
                    <Path Data="{StaticResource Icon.Chat}" Fill="{StaticResource Popup.OnBar}" Width="16" Height="16" Stretch="Uniform"/>
                </Button>

                <!-- settings (the dropdown is the in-window SettingsFlyout below, NOT a WPF Popup) -->
                <Button x:Name="SettingsBtn" Style="{StaticResource BarIconBtn}" Command="{Binding ToggleSettingsCommand}"
                        AutomationProperties.Name="{loc:T Zh='設定', En='Settings'}">
                    <Path Data="{StaticResource Icon.Settings}" Fill="{StaticResource Popup.OnBar}" Width="16" Height="16" Stretch="Uniform"/>
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</Window>
