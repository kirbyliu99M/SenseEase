<Window x:Class="SenseEase.App.Views.DemoSummaryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SenseEase Demo Summary"
        Width="560" Height="560"
        WindowStyle="SingleBorderWindow"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False"
        Background="#0E1320"
        Icon="pack://application:,,,/SenseEase.App;component/Resources/AppIcon.ico">
    <Grid Margin="28,24,28,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header — text changes between summary mode and calibration mode -->
        <TextBlock Grid.Row="0"
                   x:Name="HeaderText"
                   Text="Demo 完成 / Demo complete"
                   Foreground="#F0F4FA"
                   FontSize="20" FontWeight="Bold"/>

        <TextBlock Grid.Row="1"
                   Text="Results"
                   Foreground="#9AB6E0"
                   FontSize="11" FontWeight="Bold"
                   Margin="0,14,0,8"/>

        <!-- Results panel: 2-column stat table -->
        <Border Grid.Row="2"
                Background="#1A2235"
                BorderBrush="#2C3A55"
                BorderThickness="1"
                CornerRadius="8"
                Padding="20,16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0"
                           Text="時長 / Duration"
                           Foreground="#C0CEE5"
                           FontSize="13"
                           Margin="0,0,0,12"/>
                <TextBlock Grid.Row="0" Grid.Column="1"
                           x:Name="DurationText"
                           Foreground="#F0F4FA"
                           FontSize="14" FontWeight="SemiBold"
                           Margin="0,0,0,12"/>

                <TextBlock Grid.Row="1" Grid.Column="0"
                           Text="遮罩啟動次數 / Mask activations"
                           Foreground="#C0CEE5"
                           FontSize="13"
                           Margin="0,0,0,12"/>
                <TextBlock Grid.Row="1" Grid.Column="1"
                           x:Name="MaskActivationsText"
                           Foreground="#F0F4FA"
                           FontSize="14" FontWeight="SemiBold"
                           Margin="0,0,0,12"/>

                <TextBlock Grid.Row="2" Grid.Column="0"
                           Text="峰值壓力 / Peak pressure"
                           Foreground="#C0CEE5"
                           FontSize="13"/>
                <TextBlock Grid.Row="2" Grid.Column="1"
                           x:Name="PeakPressureText"
                           Foreground="#F0F4FA"
                           FontSize="14" FontWeight="SemiBold"/>
            </Grid>
        </Border>

        <!-- Calibration suggestion panel — hidden in plain summary mode -->
        <StackPanel Grid.Row="3" x:Name="CalibrationPanel" Visibility="Collapsed">
            <TextBlock Text="Suggested preset"
                       Foreground="#9AB6E0"
                       FontSize="11" FontWeight="Bold"
                       Margin="0,18,0,8"/>
            <Border Background="#1A2235"
                    BorderBrush="#3D5AFE"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="20,14">
                <StackPanel>
                    <TextBlock x:Name="TierText"
                               Foreground="#FF9B6B"
                               FontSize="13" FontWeight="Bold"
                               Margin="0,0,0,10"/>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="FOV"
                                   Foreground="#C0CEE5" FontSize="12" Margin="0,0,0,6"/>
                        <TextBlock Grid.Row="0" Grid.Column="1" x:Name="PresetFovText"
                                   Foreground="#F0F4FA" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,6"/>
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Mask depth"
                                   Foreground="#C0CEE5" FontSize="12" Margin="0,0,0,6"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" x:Name="PresetMaskText"
                                   Foreground="#F0F4FA" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,6"/>
                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Grid visibility"
                                   Foreground="#C0CEE5" FontSize="12" Margin="0,0,0,6"/>
                        <TextBlock Grid.Row="2" Grid.Column="1" x:Name="PresetGridText"
                                   Foreground="#F0F4FA" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,6"/>
                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Feather"
                                   Foreground="#C0CEE5" FontSize="12"/>
                        <TextBlock Grid.Row="3" Grid.Column="1" x:Name="PresetFeatherText"
                                   Foreground="#F0F4FA" FontSize="13" FontWeight="SemiBold"/>
                    </Grid>
                </StackPanel>
            </Border>
            <TextBlock Text="存檔將疊加在現有偏好之上 / Save adds these on top of your existing preferences."
                       Foreground="#9AB6E0"
                       FontSize="10"
                       TextWrapping="Wrap"
                       Margin="0,8,0,0"/>
        </StackPanel>

        <!-- Explanatory line — visible in summary mode only -->
        <TextBlock Grid.Row="4"
                   x:Name="ExplanatoryText"
                   Text="這份 demo 啟動了完整 SenseEase pipeline，包含 WGC 螢幕擷取、推論與遮罩 / This demo exercised the full SenseEase pipeline (WGC capture → inference → mask)."
                   Foreground="#9AB6E0"
                   FontSize="11"
                   TextWrapping="Wrap"
                   Margin="0,16,0,16"/>

        <!-- Buttons row — content swapped between modes -->
        <StackPanel Grid.Row="6"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button x:Name="SkipButton"
                    Content="Skip"
                    Visibility="Collapsed"
                    Padding="22,8"
                    Background="Transparent"
                    Foreground="#9AB6E0"
                    BorderBrush="#2C3A55"
                    BorderThickness="1"
                    FontSize="12"
                    Cursor="Hand"
                    Margin="0,0,10,0"
                    Click="OnSkipClicked"/>
            <Button x:Name="PrimaryButton"
                    Content="Close"
                    Padding="22,8"
                    Background="#3D5AFE"
                    Foreground="White"
                    BorderThickness="0"
                    FontSize="12" FontWeight="SemiBold"
                    Cursor="Hand"
                    IsDefault="True"
                    Click="OnPrimaryClicked"/>
        </StackPanel>
    </Grid>
</Window>
