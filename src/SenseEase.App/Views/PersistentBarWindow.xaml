<Window x:Class="SenseEase.App.Views.PersistentBarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:SenseEase.App.Localization"
        Title="SenseEase"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        SizeToContent="Manual"
        Width="80" Height="4"
        WindowStartupLocation="Manual"
        Focusable="False"
        AutomationProperties.Name="{loc:T Zh='舒適度指示器', En='Comfort level indicator'}">
    <!-- Pop-up sprint Task 2: persistent ambient bar.
         4 dip × 80 dip top-centre, rounded corners. NO animation. NO interaction
         in Task 2 (IsHitTestVisible=false makes it pass-through for clicks; hover
         + click-to-expand land in Task 4). Background brush is set imperatively
         from PersistentBarWindow.xaml.cs SetTier so the 3-tier mapping has one
         source of truth in code, not XAML.

         overlay-bar-redesign D3: SleepOverlay sibling Rectangle for the
         power-save dashed outline. Collapsed by default so the production
         bar is visually identical to before; EnterSleepMode toggles it
         Visible and ExitSleepMode collapses it again. WPF Border doesn't
         support StrokeDashArray natively — using a Rectangle stacked over
         BarFill is the canonical workaround. -->
    <Grid>
        <Border x:Name="BarFill"
                Background="#26666666"
                CornerRadius="2"/>
        <Rectangle x:Name="SleepOverlay"
                   Visibility="Collapsed"
                   Stroke="#9AA0A8"
                   StrokeThickness="1"
                   StrokeDashArray="4 2"
                   RadiusX="2" RadiusY="2"
                   IsHitTestVisible="False"/>
        <!-- D3 liveness contract: FaultOutline is the "sensing faulted" token.
             SOLID 1px clay (not dashed — dashed is Paused's identity, and the
             two must never be confusable). Collapsed by default so the healthy
             bar is byte-identical to before; EnterFaultedMode shows it + swaps
             BarFill to the low-alpha clay FaultedBarBrush. No animation. -->
        <Rectangle x:Name="FaultOutline"
                   Visibility="Collapsed"
                   Stroke="#80B65C4E"
                   StrokeThickness="1"
                   RadiusX="2" RadiusY="2"
                   IsHitTestVisible="False"/>
    </Grid>
</Window>
