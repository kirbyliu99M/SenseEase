<Window x:Class="SenseEase.App.Views.NpsSurveyWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:SenseEase.App.Localization"
        xmlns:conv="clr-namespace:SenseEase.App.Converters"
        Title="SenseEase"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="Manual"
        AutomationProperties.Name="{loc:T Zh='SenseEase 意見回饋', En='SenseEase feedback'}">
    <!-- UI-RESHAPE prep: subtle Teams-style NPS survey, bottom-right, dark-glass.
         Custom window (NOT a native toast) per the locked decision. DataContext =
         NpsSurveyViewModel. No animation (no un-gated motion); a ReducedMotion-gated
         fade is a later polish step. -->
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/SenseEase.App;component/Theme/SenseEaseTheme.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/SenseEase.App;component/Theme/PopupGlassTokens.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <conv:ScoreIsSelectedConverter x:Key="ScoreSelected"/>
            <conv:ScoreToAccessibleNameConverter x:Key="ScoreA11yName"/>
            <BooleanToVisibilityConverter x:Key="BoolToVis"/>

            <!-- 5-point QA tile: a faint glass chip at rest; the accent fill (+ white ink)
                 on hover AND while selected, so the chosen score stays lit after the click. -->
            <Style x:Key="ScoreBtn" TargetType="Button">
                <Setter Property="Width" Value="44"/>
                <Setter Property="Height" Value="44"/>
                <Setter Property="Margin" Value="4,0"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="FontSize" Value="16"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Foreground" Value="{DynamicResource Popup.Ink1}"/>
                <Setter Property="FocusVisualStyle" Value="{DynamicResource FocusVisible}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bd" Background="{DynamicResource Popup.ChipRest}" CornerRadius="10">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="{DynamicResource Popup.Blue}"/>
                                    <Setter Property="Foreground" Value="White"/>
                                </Trigger>
                                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="{DynamicResource Popup.Blue}"/>
                                    <Setter Property="Foreground" Value="White"/>
                                </DataTrigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter Property="Opacity" Value="0.6"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="NpsPrimaryBtn" TargetType="Button">
                <Setter Property="Background" Value="{DynamicResource Popup.Blue}"/>
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Padding" Value="14,7"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="MinHeight" Value="32"/>
                <Setter Property="FocusVisualStyle" Value="{DynamicResource FocusVisible}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="16" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="{DynamicResource Popup.BlueHover}"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter Property="Opacity" Value="0.6"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.4"/>
                                    <Setter Property="Cursor" Value="Arrow"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Secondary "Not now" pill — own template so hover does NOT flip to a blue fill
                 (the old BasedOn inherited the primary's blue-hover, leaving dark ink on dark
                 blue = unreadable). Stays a glass chip; hover just deepens the film, ink keeps
                 its contrast in both themes. -->
            <Style x:Key="NpsGhostBtn" TargetType="Button">
                <Setter Property="Background" Value="{DynamicResource Popup.ChipRest}"/>
                <Setter Property="Foreground" Value="{DynamicResource Popup.Ink1}"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Padding" Value="14,7"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="MinHeight" Value="32"/>
                <Setter Property="FocusVisualStyle" Value="{DynamicResource FocusVisible}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="16" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="{DynamicResource Popup.ChipHover}"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter Property="Opacity" Value="0.6"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Compact card close (X) — a Teams-style feedback card has a dismiss in the header. -->
            <Style x:Key="CardCloseBtn" TargetType="Button">
                <Setter Property="Width" Value="28"/>
                <Setter Property="Height" Value="28"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="FocusVisualStyle" Value="{DynamicResource FocusVisible}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="8">
                                <Path Data="M6,6 L16,16 M16,6 L6,16" Width="13" Height="13" Stretch="Uniform"
                                      Stroke="{DynamicResource Popup.Ink2}" StrokeThickness="1.6"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="{DynamicResource Popup.ChipHover}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Border x:Name="Card" Width="332" TextElement.FontFamily="{DynamicResource Font.UI}"
            Background="{DynamicResource Popup.PanelBg}"
            BorderBrush="{DynamicResource Popup.Bdr}" BorderThickness="1"
            CornerRadius="{StaticResource Radius.md}" Padding="16,13,16,16"
            RenderTransformOrigin="1,1">
        <Border.RenderTransform><TranslateTransform x:Name="CardRise"/></Border.RenderTransform>
        <Grid>
        <!-- The feedback form and the post-submit thank-you state share one cell; the VM's IsSubmitted
             latch swaps them. Visibility lives in a Style (NOT a local attribute, which would out-rank
             the DataTrigger). -->
        <StackPanel x:Name="FormPanel">
            <StackPanel.Style>
                <Style TargetType="StackPanel">
                    <Setter Property="Visibility" Value="Visible"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsSubmitted}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </StackPanel.Style>
            <!-- Header: app identity (left) + dismiss (right) — Teams-style feedback card chrome. -->
            <Grid Margin="0,0,0,10">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="8" Height="8" VerticalAlignment="Center" Fill="{DynamicResource Popup.Blue}"/>
                    <TextBlock Text="SenseEase" Margin="8,0,0,0" VerticalAlignment="Center"
                               FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Popup.Ink2}"/>
                </StackPanel>
                <Button HorizontalAlignment="Right" VerticalAlignment="Top" Style="{StaticResource CardCloseBtn}"
                        Command="{Binding DismissCommand}"
                        ToolTip="{loc:T Zh='關閉', En='Close'}"
                        AutomationProperties.Name="{loc:T Zh='關閉意見回饋', En='Close feedback'}"/>
            </Grid>

            <!-- The question -->
            <TextBlock Text="{Binding Prompt}" TextWrapping="Wrap" FontSize="15" FontWeight="SemiBold"
                       Foreground="{DynamicResource Popup.Ink1}"/>

            <!-- Small, subtle meaning anchors sitting ON TOP of the number row (poor over 1, great over 5).
                 Width-matched to the 5×52px button block so the ends align; no "1 ="/"5 =" prefix — the
                 numbers are right below. -->
            <Grid Width="260" HorizontalAlignment="Center" Margin="0,14,0,2">
                <TextBlock Text="{Binding ScaleLowLabel}"  HorizontalAlignment="Left"  Margin="6,0,0,0"
                           FontSize="11" Foreground="{DynamicResource Popup.Ink2}"/>
                <TextBlock Text="{Binding ScaleHighLabel}" HorizontalAlignment="Right" Margin="0,0,6,0"
                           FontSize="11" Foreground="{DynamicResource Popup.Ink2}"/>
            </Grid>

            <ItemsControl ItemsSource="{Binding Scores}" Margin="0,0,0,0" HorizontalAlignment="Center"
                          AutomationProperties.Name="{loc:T Zh='1 到 5 分', En='Score from 1 to 5'}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Style="{StaticResource ScoreBtn}" Content="{Binding}"
                                CommandParameter="{Binding}"
                                Command="{Binding DataContext.SelectScoreCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                AutomationProperties.Name="{Binding Converter={StaticResource ScoreA11yName}}">
                            <Button.Tag>
                                <MultiBinding Converter="{StaticResource ScoreSelected}">
                                    <Binding/>
                                    <Binding Path="DataContext.SelectedScore" RelativeSource="{RelativeSource AncestorType=Window}"/>
                                </MultiBinding>
                            </Button.Tag>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Text="{Binding CommentLabel}" Margin="2,16,0,5" FontSize="12"
                       Foreground="{DynamicResource Popup.Ink2}"/>
            <!-- Recessed dark field (was a default WHITE box → invisible light text in dark glass,
                 same bug the chat input had). Multi-line so users can write longer feedback. -->
            <Border Background="#33000000" BorderBrush="{DynamicResource Popup.Bdr}"
                    BorderThickness="1" CornerRadius="9">
                <TextBox Background="Transparent" BorderThickness="0" Padding="9,7" FontSize="13"
                         MinHeight="22" MaxHeight="76" TextWrapping="Wrap" AcceptsReturn="True"
                         VerticalScrollBarVisibility="Auto" GotFocus="OnCommentFocus"
                         Foreground="{DynamicResource Popup.Ink1}" CaretBrush="{DynamicResource Popup.Ink1}"
                         Text="{Binding Comment, UpdateSourceTrigger=PropertyChanged}"
                         AutomationProperties.Name="{Binding CommentLabel}"/>
            </Border>

            <!-- Hint: explain why Submit stays disabled until a score is picked (hidden once chosen). -->
            <TextBlock Text="{loc:T Zh='請先選擇分數', En='Select a score to submit'}"
                       Visibility="{Binding NeedsScore, Converter={StaticResource BoolToVis}}"
                       HorizontalAlignment="Right" Margin="0,12,2,0" FontSize="11"
                       Foreground="{DynamicResource Popup.Ink2}"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                <Button Content="{loc:T Zh='暫時不要', En='Not now'}" Style="{StaticResource NpsGhostBtn}"
                        Command="{Binding DismissCommand}" Margin="0,0,8,0"
                        AutomationProperties.Name="{loc:T Zh='暫時不要回饋', En='Dismiss feedback'}"/>
                <Button Content="{loc:T Zh='送出', En='Submit'}" Style="{StaticResource NpsPrimaryBtn}"
                        Command="{Binding SubmitCommand}"
                        AutomationProperties.Name="{loc:T Zh='送出評分', En='Submit score'}"/>
            </StackPanel>
        </StackPanel>

        <!-- Thank-you state (audit 2026-06-20): shown after submit so the response is acknowledged
             instead of the card vanishing instantly; the window dwells briefly then self-closes. -->
        <StackPanel x:Name="ThanksPanel" VerticalAlignment="Center" Margin="0,22"
                    AutomationProperties.LiveSetting="Polite">
            <StackPanel.Style>
                <Style TargetType="StackPanel">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsSubmitted}" Value="True">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </StackPanel.Style>
            <Border Width="44" Height="44" CornerRadius="22" HorizontalAlignment="Center"
                    Background="{DynamicResource Popup.Blue}">
                <Path Data="M5,12 L10,17 L19,7" Stretch="Uniform" Width="22" Height="22"
                      Stroke="White" StrokeThickness="2.4"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <TextBlock Text="{Binding ThankYouText}" HorizontalAlignment="Center" Margin="0,12,0,0"
                       FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource Popup.Ink1}"/>
            <TextBlock Text="{Binding ThankYouSubText}" HorizontalAlignment="Center" Margin="0,3,0,0"
                       FontSize="12" Foreground="{DynamicResource Popup.Ink2}"/>
        </StackPanel>
        </Grid>
    </Border>
</Window>
