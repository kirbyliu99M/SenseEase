<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <RootNamespace>SenseEase.App</RootNamespace>
    <AssemblyName>SenseEase.App</AssemblyName>
    <!-- Patch 8 (sub-bug #2): explicit assembly metadata. Windows shell uses
         AssemblyTitle / Product as a secondary fallback for tray icon
         display name when AUMID resolution is ambiguous. Without these,
         the Settings → Other system tray icons list was showing "testhost"
         (the dev-launcher process name) even after AUMID was set, because
         the assembly itself had no display name set. Paired with the
         SetCurrentProcessExplicitAppUserModelID call in App.OnStartup. -->
    <AssemblyTitle>SenseEase</AssemblyTitle>
    <Product>SenseEase</Product>
    <!-- ApplicationIcon embeds the icon into the EXE itself, so Windows
         Explorer / taskbar / Alt-Tab pick it up even before any window
         opens. The Resource entry below makes the same file available as
         a pack URI for runtime Window.Icon binding. -->
    <ApplicationIcon>Resources\AppIcon.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\SenseEase.Core\SenseEase.Core.csproj" />
    <ProjectReference Include="..\SenseEase.Infrastructure\SenseEase.Infrastructure.csproj" />
  </ItemGroup>

  <!-- Pop-up sprint tray library (current, Patch 5 2026-05-26):
       Hardcodet.NotifyIcon.Wpf 2.0.1. The de facto standard for WPF tray
       icons (used by Microsoft tooling, Files, parts of PowerToys, etc.),
       widely validated for Win11 shell integration.

       Previously H.NotifyIcon.Wpf 2.3.0 was used (originally picked for
       its active-fork status and .NET 8 targets) — swapped after diag-4
       caught a silent Shell_NotifyIcon registration failure: library
       reported success internally (Visibility=Visible + valid HICON for
       100+ seconds) but the OS shell never received registration. The
       failure reproduced under both `dotnet run` and direct .exe
       execution (Amendment 3 verification), eliminating dev-build /
       manifest hypotheses. See docs/POPUP-OVERLAY.md §11 + the
       overlay-bar-redesign branch's Patch 5 commit for the full
       diagnostic trail.

       WinForms NotifyIcon was rejected (still) to avoid dragging the
       WinForms runtime into a pure-WPF app. -->
  <ItemGroup>
    <PackageReference Include="Hardcodet.NotifyIcon.Wpf" Version="2.0.1" />
  </ItemGroup>

  <!-- Pop-up sprint Task 5: expose `internal` test hooks (currently
       UserPreferences.ResetCacheForTesting) to the test project. -->
  <ItemGroup>
    <InternalsVisibleTo Include="SenseEase.Tests" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Resources\AppIcon.ico" />
  </ItemGroup>

  <!-- Dark palette override layer. The WPF SDK auto-includes every .xaml
       under the project as <Page>, which would run the XAML through the
       markup compiler expecting a Page/code-behind pairing. Palette.Dark.xaml
       is a pure brush-only ResourceDictionary with NO x:Class, so we drop the
       implicit Page item and re-add it as a <Resource>. That bakes the raw
       XAML into the assembly as a loose resource, pack-URI-loadable at runtime
       via pack://application:,,,/SenseEase.App;component/Theme/Palette.Dark.xaml
       and mergeable ABOVE Theme/SenseEaseTheme.xaml to override the light
       colour-brush keys. -->
  <ItemGroup>
    <Page Remove="Theme\Palette.Dark.xaml" />
    <Resource Include="Theme\Palette.Dark.xaml" />
  </ItemGroup>

  <!-- Side-load b9294 llama.cpp binaries (Vulkan backend) over the
       LLamaSharp 0.27 NuGet defaults. The NuGet ships pre-b9294 binaries
       that (a) lack llama-server.exe, the subprocess our chatbot drives,
       and (b) crash on the gemma4 / mistral3 GDN architecture in Ministral 3B.
       Without this rule the binaries only land in bin\ when somebody manually
       extracts them — easy to lose on `dotnet clean` or a fresh checkout.
       Pinned here so every build stages them deterministically.

       Pre-Alpha v0.11.1 (packaging): swapped from cuda12 (NVIDIA-only,
       702 MB) to vulkan (cross-vendor: NVIDIA, AMD, Intel iGPU, ~100 MB).
       Vulkan auto-falls-back to bundled ggml-cpu-*.dll variants on
       machines with no GPU at all. Net effect: chatbot runs on any
       Windows 10 19041+ machine with a working GPU driver, with 10-30%
       NVIDIA dGPU slowdown vs CUDA-native (acceptable for 256-token
       chatbot replies).

       Files live at <repo>\runtimes\ — gitignored because the binary set
       totals ~100 MB and is hostile to git. Restore source for fresh
       checkouts: extract llama-b9294-bin-win-vulkan-x64.zip from
       https://github.com/ggml-org/llama.cpp/releases/tag/b9294 into
       runtimes\win-x64\native\vulkan\. -->
  <ItemGroup>
    <Content Include="..\..\runtimes\win-x64\native\vulkan\*.*">
      <Link>runtimes\win-x64\native\vulkan\%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      <Visible>false</Visible>
    </Content>
  </ItemGroup>

</Project>
