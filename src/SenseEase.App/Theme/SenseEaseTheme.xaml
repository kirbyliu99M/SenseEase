<!--
  D0 — SenseEase Calm design tokens (M5 design adoption).
  TOKEN NAMES ARE FROZEN once committed (no mid-wave renames).

  CARDINAL RULE: this dictionary is merged VIEW-LOCALLY into each
  Window.Resources / UserControl.Resources via:
    <ResourceDictionary Source="pack://application:,,,/SenseEase.App;component/Theme/SenseEaseTheme.xaml"/>
  It must NEVER be merged into App.Resources — MainWindowSmokeTests boots a bare
  new Application() with no Application.Resources, so an App-level token fails it.

  Calm palette only: NO #E54747 (alarm red), NO #024AD8 (royal blue), NO #7B8DB0.
  High strain uses muted clay #B65C4E, never loud red.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- ═══ Colors ═══════════════════════════════════════════════════════════
         "myHP / HP Smart" refresh (user-picked 2026-06-07). Clean light, airy
         canvas + white rounded cards + an INDIGO accent (#4B6EF5, S~89%)
         RATIONED to the hero card, primary CTA pills, the active-tab underline,
         the logo mark, and the focus ring — NEVER the header bar, the canvas,
         card borders, or data numerals (those are TextPrimary). Cards sit on a
         soft near-borderless surface with a CardBorder hairline for definition.
         All text pairs clear WCAG AA 4.5:1. -->
    <SolidColorBrush x:Key="Canvas"        Color="#F3F4F7"/>
    <SolidColorBrush x:Key="Surface"       Color="#FFFFFF"/>
    <SolidColorBrush x:Key="SurfaceMuted"  Color="#EDEFF3"/>
    <SolidColorBrush x:Key="Separator"     Color="#E3E6EC"/>
    <!-- Hairline card outline for soft, near-borderless surface definition. -->
    <SolidColorBrush x:Key="CardBorder"    Color="#ECEEF2"/>
    <SolidColorBrush x:Key="TextPrimary"   Color="#1B2333"/>
    <SolidColorBrush x:Key="TextSecondary" Color="#5A6475"/>
    <SolidColorBrush x:Key="TextTertiary"  Color="#8A93A3"/>
    <SolidColorBrush x:Key="Accent"        Color="#4B6EF5"/>
    <SolidColorBrush x:Key="AccentHover"   Color="#3552D9"/>
    <!-- Light top-chrome surface — the header is a hairline-divided white bar,
         never a painted indigo band. -->
    <SolidColorBrush x:Key="HeaderSurface" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="TextOnComfort" Color="#FFFFFF"/>

    <!-- Three comfort bands (base / weak fill / readable text-on-weak).
         These mirror TierColorPalette's three tier bands; TierColorPalette stays
         the single source for the BAND→colour mapping (converters read it). -->
    <SolidColorBrush x:Key="ComfortSteady"     Color="#2F7D6E"/>
    <SolidColorBrush x:Key="ComfortSteadyWeak" Color="#E2F0EC"/>
    <SolidColorBrush x:Key="ComfortSteadyText" Color="#1F5249"/>
    <SolidColorBrush x:Key="ComfortRising"     Color="#9A6B22"/>
    <SolidColorBrush x:Key="ComfortRisingWeak" Color="#F6ECD8"/>
    <SolidColorBrush x:Key="ComfortRisingText" Color="#7A4E16"/>
    <SolidColorBrush x:Key="ComfortHigh"       Color="#B65C4E"/>
    <SolidColorBrush x:Key="ComfortHighWeak"   Color="#F6E2DE"/>
    <SolidColorBrush x:Key="ComfortHighText"   Color="#8A3A2E"/>

    <!-- ═══ Spacing / radius ═════════════════════════════════════════════════ -->
    <sys:Double x:Key="Pad.Card">24</sys:Double>
    <sys:Double x:Key="Gap.Stack">16</sys:Double>
    <sys:Double x:Key="Gap.Tight">8</sys:Double>
    <Thickness  x:Key="Pad.CardAll">24</Thickness>
    <Thickness  x:Key="Gap.StackBottom">0,0,0,16</Thickness>
    <CornerRadius x:Key="Radius.md">16</CornerRadius>
    <CornerRadius x:Key="Radius.sm">10</CornerRadius>
    <CornerRadius x:Key="Radius.pill">999</CornerRadius>

    <!-- ═══ Elevation ════════════════════════════════════════════════════════ -->
    <!-- Soft black shadow (NOT an indigo glow), softened for the airy look. -->
    <DropShadowEffect x:Key="Elev.2" Color="#000000" Direction="270"
                      ShadowDepth="2" BlurRadius="10" Opacity="0.06"/>
    <DropShadowEffect x:Key="Elev.3" Color="#000000" Direction="270"
                      ShadowDepth="4" BlurRadius="18" Opacity="0.09"/>

    <!-- ═══ Typography ═══════════════════════════════════════════════════════
         Font props only here; Foreground via DynamicResource so it resolves
         across the merged scope regardless of dictionary order. Floor: 14 body,
         12 caption — no 10/11px text anywhere. -->
    <FontFamily x:Key="Font.UI">Segoe UI Variable Text, Segoe UI, Microsoft JhengHei UI, Microsoft JhengHei, Noto Sans CJK TC, sans-serif</FontFamily>
    <FontFamily x:Key="Font.Mono">Cascadia Mono, Cascadia Code, Consolas, monospace</FontFamily>
    <Style x:Key="Type.Display" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource Font.UI}"/>
        <Setter Property="FontSize" Value="28"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="LineHeight" Value="34"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
    </Style>
    <Style x:Key="Type.Title" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource Font.UI}"/>
        <Setter Property="FontSize" Value="20"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="LineHeight" Value="28"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
    </Style>
    <Style x:Key="Type.Heading" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource Font.UI}"/>
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="LineHeight" Value="22"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
    </Style>
    <Style x:Key="Type.Body" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource Font.UI}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="LineHeight" Value="20"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
    </Style>
    <Style x:Key="Type.Caption" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource Font.UI}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="LineHeight" Value="16"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
    </Style>
    <Style x:Key="Type.Mono" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Consolas, 'Cascadia Mono', monospace"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="LineHeight" Value="18"/>
        <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
    </Style>

    <!-- ═══ Focus ring (C2 a11y) ═════════════════════════════════════════════
         Shared keyboard-focus visual. WPF renders FocusVisualStyle ONLY after
         keyboard navigation (Tab/arrow) and never on a mouse click — exactly
         the calm, Apple-grade behaviour we want: no ring while clicking, a
         clear ring while tabbing. A 2px Accent ring, rounded, offset slightly
         outward so it never overlaps the control's own fill. Applied via
         per-window implicit Button/CheckBox/TextBox styles plus the explicit
         button styles' own FocusVisualStyle setter (implicit styles don't reach
         a control that already has an explicit Style). -->
    <Style x:Key="FocusVisible">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Rectangle Margin="-3"
                               StrokeThickness="2"
                               Stroke="{DynamicResource Accent}"
                               RadiusX="6" RadiusY="6"
                               SnapsToDevicePixels="True"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Calm iOS-style toggle-switch (shared). A rounded pill TRACK that fills
         {DynamicResource Accent} when checked, a sliding THUMB, ≥44px-wide hit
         area, hover / keyboard-focus / disabled (0.4 opacity) states. The
         content label sits to the right of the switch; the whole row keeps the
         original click-to-toggle behaviour. Only the visual chrome changes —
         every x:Name, Checked/Unchecked handler and IsChecked binding on the
         consumers is untouched.
         Moved here from SettingsContent.xaml (UI/UX fine-tune 2026-06-07) so the
         Settings page AND the dashboard's Overlay Adjustment toggle share ONE
         source and can't drift. Both views merge this theme dictionary. -->
    <Style x:Key="SettingSwitch" TargetType="CheckBox">
        <Setter Property="FocusVisualStyle" Value="{DynamicResource FocusVisible}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Border Background="Transparent" Padding="0">
                        <StackPanel Orientation="Horizontal">
                            <!-- ≥44px-wide hit area: 44-wide cell wraps the 40px track -->
                            <Grid x:Name="SwitchHit" Width="44" Height="26" VerticalAlignment="Center">
                                <Border x:Name="Track"
                                        Width="40" Height="24"
                                        CornerRadius="12"
                                        Background="{DynamicResource SurfaceMuted}"
                                        BorderBrush="{DynamicResource Separator}"
                                        BorderThickness="1"/>
                                <Border x:Name="Thumb"
                                        Width="18" Height="18"
                                        CornerRadius="9"
                                        HorizontalAlignment="Left"
                                        Margin="3,0,0,0"
                                        Background="{DynamicResource TextOnComfort}"/>
                            </Grid>
                            <ContentPresenter x:Name="Label"
                                              Margin="10,0,0,0"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True"
                                              SnapsToDevicePixels="True"/>
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <!-- Checked: track fills Accent, thumb slides right -->
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Track" Property="Background" Value="{DynamicResource Accent}"/>
                            <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                            <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/>
                            <Setter TargetName="Thumb" Property="Margin" Value="0,0,3,0"/>
                        </Trigger>
                        <!-- Hover: gentle track lift -->
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True"/>
                                <Condition Property="IsChecked" Value="False"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Track" Property="Background" Value="{DynamicResource Separator}"/>
                        </MultiTrigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True"/>
                                <Condition Property="IsChecked" Value="True"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Track" Property="Background" Value="{DynamicResource AccentHover}"/>
                            <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource AccentHover}"/>
                        </MultiTrigger>
                        <!-- Keyboard focus: Accent ring around the track (in addition to FocusVisualStyle) -->
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                            <Setter TargetName="Track" Property="BorderThickness" Value="2"/>
                        </Trigger>
                        <!-- Disabled: dim whole control to 0.4 opacity -->
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4"/>
                            <Setter Property="Cursor" Value="Arrow"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ═══ Tray context-menu (UI/UX 2026-06-09) ════════════════════════════════
         The system-tray menu is a WPF ContextMenu; with no style it falls back to the
         default NATIVE-looking Windows menu. These KEYED styles (opt-in — no app-wide
         menu is touched) re-skin it to match the app: a rounded Surface card + CardBorder
         hairline, token-coloured items, and a calm SurfaceMuted highlight (no system blue).
         Wired in TrayIconService, which merges THIS dictionary into the menu's OWN
         resources (a popup isn't parented to a themed window) so the tokens resolve, and
         ThemeManager.TrackElement keeps it light/dark-correct incl. a live OS flip. -->
    <Style x:Key="SenseEaseMenuItem" TargetType="MenuItem">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Padding" Value="12,7"/>
        <Setter Property="FontFamily" Value="{DynamicResource Font.UI}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}"
                            CornerRadius="6" Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter ContentSource="Header" VerticalAlignment="Center"
                                          RecognizesAccessKey="True"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SurfaceMuted}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <!-- display-only status row reads as a muted header -->
                            <Setter Property="Foreground" Value="{DynamicResource TextTertiary}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="SenseEaseMenuSeparator" TargetType="Separator">
        <Setter Property="Margin" Value="8,4"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Separator">
                    <Border Height="1" Background="{DynamicResource Separator}"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="SenseEaseContextMenu" TargetType="ContextMenu">
        <Setter Property="Background" Value="{DynamicResource Surface}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource CardBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContextMenu">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="10" Padding="4"
                            SnapsToDevicePixels="True">
                        <ItemsPresenter/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ═══ Slim auto-hide scrollbars (UI/UX 2026-06-09) ═════════════════════════
         The app's ScrollViewers used the default chunky, always-reserved native
         scrollbar. These KEYED styles (opt-in — NOT app-wide implicit, so embedded
         ListView/ComboBox/native scrollbars are untouched) give a thin, right-aligned,
         OVERLAY scrollbar that fades in on hover and out when idle. Applied to the main
         VERTICAL scrolls (Settings, dashboard panels, chat) via Style="{DynamicResource
         AutoHideScroll}". Vertical-only by design — every target disables horizontal scroll. -->
    <Style x:Key="SlimScrollBar" TargetType="ScrollBar">
        <Setter Property="Width" Value="10"/>
        <Setter Property="MinWidth" Value="10"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid Background="Transparent" Width="10">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageUpCommand" Focusable="False" IsTabStop="False">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageDownCommand" Focusable="False" IsTabStop="False">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb MinHeight="28">
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border x:Name="ThumbBd" CornerRadius="4" Margin="2,0"
                                                    Background="{DynamicResource TextTertiary}" Opacity="0.5"/>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="ThumbBd" Property="Opacity" Value="0.8"/>
                                                </Trigger>
                                                <Trigger Property="IsDragging" Value="True">
                                                    <Setter TargetName="ThumbBd" Property="Opacity" Value="0.9"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="AutoHideScroll" TargetType="ScrollViewer">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollViewer">
                    <Grid>
                        <ScrollContentPresenter x:Name="PART_ScrollContentPresenter"
                                                Margin="{TemplateBinding Padding}"
                                                Content="{TemplateBinding Content}"
                                                ContentTemplate="{TemplateBinding ContentTemplate}"
                                                CanContentScroll="{TemplateBinding CanContentScroll}"/>
                        <ScrollBar x:Name="PART_VerticalScrollBar" Orientation="Vertical"
                                   HorizontalAlignment="Right"
                                   Style="{StaticResource SlimScrollBar}"
                                   Minimum="0"
                                   Maximum="{TemplateBinding ScrollableHeight}"
                                   Value="{TemplateBinding VerticalOffset}"
                                   ViewportSize="{TemplateBinding ViewportHeight}"
                                   Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"
                                   Opacity="0"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <!-- Auto-hide: fade the overlay bar in on hover, out after a short idle. -->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="PART_VerticalScrollBar"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="1" Duration="0:0:0.15"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="PART_VerticalScrollBar"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="0" BeginTime="0:0:0.8" Duration="0:0:0.4"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
