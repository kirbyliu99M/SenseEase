<!--
  SettingsGlassPalette — the GLASS bridge that makes the Settings surface match the new popup panel.

  Redefines the SAME SenseEaseTheme colour-brush keys (see Palette.Dark.xaml for the authoritative
  list) with the popup's Popup.* GLASS values, so SettingsContent + SettingsWindow re-skin to the
  brand glass WITHOUT rewriting every control (the theme styles resolve colours via DynamicResource,
  so redefining the keys re-skins them). Merged ABOVE SenseEaseTheme.xaml view-locally and, unlike
  Palette.Dark, it is ALWAYS on (the settings is glass regardless of the OS light/dark, matching the
  popup which is slate-by-default). SettingsGlassPalette.Dark.xaml flips it to the Game-Bar variant
  exactly as PopupGlassTokens.Dark flips the popup. SenseEaseTheme.xaml + Palette.Dark.xaml are
  UNCHANGED (TokenContrastTests untouched).

  This file = the SLATE (default) glass, mirroring PopupGlassTokens.xaml. Pure ResourceDictionary
  (no x:Class), pack-URI-mergeable. Contrast on the slate card #1D232E (L≈0.0164):
    TextPrimary  #F0EAF0F8 ≈ 12.3:1 (AAA)
    TextSecondary#B8EAF0F8 ≈  9.0:1 (AAA)
    TextTertiary #99EAF0F8 ≈  6.0:1 (AA+)
    ComfortHighText #FCA5A5 ≈ 8.4:1 (AAA), SteadyText #A6E9C0 ≈ 11:1, RisingText #FBD89A ≈ 10:1.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Page / header backdrops → transparent so the window's acrylic glass shows between cards. -->
    <SolidColorBrush x:Key="Canvas"        Color="#00000000"/>
    <SolidColorBrush x:Key="HeaderSurface" Color="#00000000"/>

    <!-- Card fills = the popup glass. Surface = PanelBg; SurfaceMuted = the slightly-lighter BarBg
         so muted insets read as a distinct glass layer. -->
    <SolidColorBrush x:Key="Surface"       Color="#F21D232E"/>
    <SolidColorBrush x:Key="SurfaceMuted"  Color="#E6232A36"/>

    <!-- Soft light rim + hairline divider on the dark glass (Popup.Bdr). -->
    <SolidColorBrush x:Key="CardBorder"    Color="#26FFFFFF"/>
    <SolidColorBrush x:Key="Separator"     Color="#22FFFFFF"/>

    <!-- Ink ramp = the popup's near-white ramp (Popup.Ink1/2 + a 60% tertiary for dense captions). -->
    <SolidColorBrush x:Key="TextPrimary"   Color="#F0EAF0F8"/>
    <SolidColorBrush x:Key="TextSecondary" Color="#B8EAF0F8"/>
    <SolidColorBrush x:Key="TextTertiary"  Color="#99EAF0F8"/>
    <SolidColorBrush x:Key="TextOnComfort" Color="#FFFFFFFF"/>

    <!-- Accent = the popup royal blue. -->
    <SolidColorBrush x:Key="Accent"        Color="#FF5B8CFF"/>
    <SolidColorBrush x:Key="AccentHover"   Color="#FF7AA2FF"/>

    <!-- Comfort bands = the popup status hues, with light readable text + faint fills on the glass. -->
    <SolidColorBrush x:Key="ComfortSteady"     Color="#FF4ADE80"/>
    <SolidColorBrush x:Key="ComfortSteadyWeak" Color="#264ADE80"/>
    <SolidColorBrush x:Key="ComfortSteadyText" Color="#FFA6E9C0"/>
    <SolidColorBrush x:Key="ComfortRising"     Color="#FFFBBF24"/>
    <SolidColorBrush x:Key="ComfortRisingWeak" Color="#26FBBF24"/>
    <SolidColorBrush x:Key="ComfortRisingText" Color="#FFFBD89A"/>
    <SolidColorBrush x:Key="ComfortHigh"       Color="#FFF87171"/>
    <SolidColorBrush x:Key="ComfortHighWeak"   Color="#26F87171"/>
    <SolidColorBrush x:Key="ComfortHighText"   Color="#FFFCA5A5"/>

</ResourceDictionary>
