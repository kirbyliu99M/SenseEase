<!--
  PopupGlassTokens.Dark — the DARK theme for the discreet popup surfaces
  (EdgeSidebarWindow / PopupBarWindow / NpsSurveyWindow / ConsentBubbleWindow only).

  THEME REMAP (kirby, 2026-06-18 round 2): DARK is now the SLATE glass (the look kirby confirmed he
  wants as the dark mode); the frosted white/light-blue glass moved to the LIGHT default
  (PopupGlassTokens.xaml). Redefines the SAME Popup.* keys with the slate values and is merged ABOVE
  PopupGlassTokens.xaml view-locally (per-window) when the effective theme is dark — exactly the way
  Theme/Palette.Dark.xaml overrides SenseEaseTheme.xaml. Brushes only; no x:Class so it stays a pure
  pack-URI-mergeable ResourceDictionary.

  Slate glass reads DARK over the desktop → near-WHITE ink/glyph ramps.
  Contrast (over the near-opaque panel each brush paints):
    PanelBg #F21D232E ≈ rgb(29,35,46) → Ink1 ≈ 13.6:1 (AAA), Ink2 ≈ 9:1 (AAA), Ink3 ≈ 5:1 (AA).
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Accent (royal blue). Deepened 2026-06-18 from #5B8CFF → #3366E0 so WHITE button/bubble labels
         clear AA 4.5:1 (white-on-#5B8CFF was only 3.16:1; on #3366E0 it is 5.1:1) while the fill still
         reads ~3.1:1 on the slate panel. Hover deepens (not lightens) to keep white readable. The
         brighter #5B8CFF stays as the non-text slider run (Popup.SegOn) below. -->
    <SolidColorBrush x:Key="Popup.Blue"      Color="#FF3366E0"/>
    <SolidColorBrush x:Key="Popup.BlueHover" Color="#FF2856C8"/>
    <!-- Neon GLOW colour for the active on/off mark's DropShadow halo — a brighter cyan-blue so it
         reads as a luminous glow on the dark slate glass. -->
    <Color x:Key="Popup.NeonGlowColor">#FF5AA0FF</Color>
    <!-- R3-6: same hue at 0 alpha — the OUTER stop of the on/off mark's radial-gradient halo, so the
         glow fades to nothing with no dark fringe (replaces the DropShadowEffect that caused flashing). -->
    <Color x:Key="Popup.NeonGlowColorEdge">#005AA0FF</Color>

    <!-- (Popup.Low/Mid/High removed 2026-06-18 — zero consumers after the status-dot removal.) -->

    <!-- Card fills — slate glass (no window acrylic → alpha bumped): BarBg ~90%, PanelBg ~95%. -->
    <SolidColorBrush x:Key="Popup.BarBg"   Color="#E6232A36"/>
    <SolidColorBrush x:Key="Popup.PanelBg" Color="#F21D232E"/>
    <!-- Soft light rim on the dark glass. -->
    <SolidColorBrush x:Key="Popup.Bdr"     Color="#26FFFFFF"/>
    <!-- Assistant chat bubble — a soft white wash on the slate glass. -->
    <SolidColorBrush x:Key="Popup.BotBubbleBg" Color="#33FFFFFF"/>
    <!-- Notice/alert dot (consent-bubble red notice) — brighter on the dark slate so the badge reads. -->
    <SolidColorBrush x:Key="Popup.Notice" Color="#FFFF6168"/>

    <!-- Ink ramp on PANELS — near-WHITE at descending alpha (dark text would vanish on the slate). -->
    <SolidColorBrush x:Key="Popup.Ink1" Color="#F0EAF0F8"/>
    <SolidColorBrush x:Key="Popup.Ink2" Color="#B8EAF0F8"/>
    <SolidColorBrush x:Key="Popup.Ink3" Color="#80EAF0F8"/>

    <!-- Text/glyph ON the bar — white ramp (the slate bar reads dark over the desktop). -->
    <SolidColorBrush x:Key="Popup.OnBar"    Color="#F2FFFFFF"/>
    <SolidColorBrush x:Key="Popup.OnBarDim" Color="#C2FFFFFF"/>

    <!-- 12-segment meter / intensity slider — off = low-alpha light, on = the accent. -->
    <SolidColorBrush x:Key="Popup.SegOff" Color="#33FFFFFF"/>
    <SolidColorBrush x:Key="Popup.SegOn"  Color="#FF5B8CFF"/>

    <!-- Hover/press wash for bar icon buttons (white film = a highlight over the dark glass). -->
    <SolidColorBrush x:Key="Popup.BtnHover" Color="#2EFFFFFF"/>
    <SolidColorBrush x:Key="Popup.BtnPress" Color="#21FFFFFF"/>

    <!-- Glass chip rest/hover fills (NPS score tiles, ghost pills) — white film on the slate glass. -->
    <SolidColorBrush x:Key="Popup.ChipRest"  Color="#1FFFFFFF"/>
    <SolidColorBrush x:Key="Popup.ChipHover" Color="#33FFFFFF"/>

</ResourceDictionary>
