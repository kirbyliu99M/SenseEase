<!--
  PopupGlassTokens.Dark — the ACTUAL dark theme for the discreet popup surfaces
  (EdgeSidebarWindow / PopupBarWindow / NpsSurveyWindow only).

  PALETTE SWAP (kirby, 2026-06-17 iter 3): the slate look moved to the DEFAULT
  (PopupGlassTokens.xaml). This dark override is now a genuine NEUTRAL black/grey theme
  modelled on the Windows 11 Game Bar — near-black translucent glass, soft white rims,
  a bright accent, pure-white ink. Redefines the SAME Popup.* keys with the dark values
  and is merged ABOVE PopupGlassTokens.xaml view-locally (per-window) when the effective
  theme is dark — exactly the way Theme/Palette.Dark.xaml overrides SenseEaseTheme.xaml.
  Brushes only; every non-colour token resolves from the structural dictionaries
  underneath. NO x:Class so it stays a pure pack-URI-mergeable ResourceDictionary.

  Neutral (NOT blue-slate): #1B1B1D / #1F1F22 carry almost no hue, the Game Bar signature.

  Contrast (over the near-opaque panel each brush paints):
    PanelBg #E61F1F22 ≈ rgb(31,31,34) →
      Ink1 #F2FFFFFF ≈ 17:1  (AAA)
      Ink2 #B8FFFFFF ≈ 11:1  (AAA, at 72% alpha)
      Ink3 #80FFFFFF ≈ 6.5:1 (AA,  at 50% alpha)
    BarBg #CC1B1B1D over the dark desktop blur reads near-black → white OnBar ramp.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Accent (bright blue — pops on near-black, Game-Bar style) -->
    <SolidColorBrush x:Key="Popup.Blue"      Color="#FF4DA6FF"/>
    <SolidColorBrush x:Key="Popup.BlueHover" Color="#FF6FB6FF"/>

    <!-- 3-state pulse status — same hues, brightened a touch to read on near-black -->
    <SolidColorBrush x:Key="Popup.Low"  Color="#FF4ADE80"/>
    <SolidColorBrush x:Key="Popup.Mid"  Color="#FFFBBF24"/>
    <SolidColorBrush x:Key="Popup.High" Color="#FFFF6B6B"/>

    <!-- Glass fills. Neutral near-black grey: BarBg ~80%, PanelBg ~90% (near-opaque so the
         chat/dropdown text sits on solid Game-Bar grey). -->
    <SolidColorBrush x:Key="Popup.BarBg"   Color="#CC1B1B1D"/>
    <SolidColorBrush x:Key="Popup.PanelBg" Color="#E61F1F22"/>
    <!-- Soft light hairline rim (Game Bar's faint grey edge). -->
    <SolidColorBrush x:Key="Popup.Bdr"     Color="#33FFFFFF"/>

    <!-- Ink ramp on PANELS — pure-white ramp at descending alpha (neutral, no hue). -->
    <SolidColorBrush x:Key="Popup.Ink1" Color="#F2FFFFFF"/>
    <SolidColorBrush x:Key="Popup.Ink2" Color="#B8FFFFFF"/>
    <SolidColorBrush x:Key="Popup.Ink3" Color="#80FFFFFF"/>

    <!-- Text/glyph ON the bar — white ramp (the bar reads near-black). -->
    <SolidColorBrush x:Key="Popup.OnBar"    Color="#F2FFFFFF"/>
    <SolidColorBrush x:Key="Popup.OnBarDim" Color="#C2FFFFFF"/>

    <!-- 12-segment strength meter — off-segments low-alpha white, on-segments the accent. -->
    <SolidColorBrush x:Key="Popup.SegOff" Color="#2EFFFFFF"/>
    <SolidColorBrush x:Key="Popup.SegOn"  Color="#FF4DA6FF"/>

    <!-- Hover/press wash for bar icon buttons (white film = a highlight over near-black). -->
    <SolidColorBrush x:Key="Popup.BtnHover" Color="#29FFFFFF"/>
    <SolidColorBrush x:Key="Popup.BtnPress" Color="#1FFFFFFF"/>

</ResourceDictionary>
