<!--
  UI-RESHAPE — DEFAULT (LIGHT-mode) palette for the NEW discreet surfaces only
  (EdgeSidebarWindow / PopupBarWindow / NpsSurveyWindow / ConsentBubbleWindow). USER-APPROVED to
  override the locked "Calm palette only" rule FOR THESE NEW SURFACES (kirby, 2026-06-17).

  THEME REMAP (kirby, 2026-06-18 round 2): the original frosted WHITE / light-blue glass is the
  LIGHT mode (restored here from the reference senseease-vertical-v1.html), and the SLATE look the
  earlier iterations defaulted to is now the DARK mode (PopupGlassTokens.Dark.xaml). So: LIGHT =
  light-blue frosted glass with DARK navy ink; DARK = slate glass with near-white ink. The locked
  Theme/SenseEaseTheme.xaml is UNCHANGED — existing windows + TokenContrastTests are untouched.

  Pure ResourceDictionary (no x:Class) merged VIEW-LOCALLY via pack URI exactly like
  SenseEaseTheme.xaml — NEVER App.Resources (MainWindowSmokeTests boots a bare Application).

  Light glass reads LIGHT over the desktop, so BAR text/glyphs use the DARK navy Popup.OnBar ramp
  and panels use the DARK navy Popup.Ink ramp (reference rgba(6,16,48,…)). No window-wide acrylic
  on the bar (iter-4), so the fill alpha is bumped (~90% bar / ~95% panel) for readability.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Accent (reference royal blue — reads on the light glass) -->
    <SolidColorBrush x:Key="Popup.Blue"      Color="#FF024AD8"/>
    <SolidColorBrush x:Key="Popup.BlueHover" Color="#FF0340C0"/>

    <!-- 3-state pulse status (reference saturated green / amber / red — read on light glass) -->
    <SolidColorBrush x:Key="Popup.Low"  Color="#FF22C55E"/>
    <SolidColorBrush x:Key="Popup.Mid"  Color="#FFF59E0B"/>
    <SolidColorBrush x:Key="Popup.High" Color="#FFEF4444"/>

    <!-- Card fills — frosted light-blue glass (reference rgba(210,224,255)/(215,228,252), alpha
         bumped since there is no window-wide acrylic blur): BarBg ~90%, PanelBg ~95%. -->
    <SolidColorBrush x:Key="Popup.BarBg"   Color="#E6D2E0FF"/>
    <SolidColorBrush x:Key="Popup.PanelBg" Color="#F2D7E4FC"/>
    <!-- Frosted-glass highlight rim. -->
    <SolidColorBrush x:Key="Popup.Bdr"     Color="#59FFFFFF"/>
    <!-- Assistant chat bubble — a soft navy wash on the light glass (Claude-style light-grey bubble). -->
    <SolidColorBrush x:Key="Popup.BotBubbleBg" Color="#1F061030"/>

    <!-- Ink ramp on PANELS — DARK navy (reference rgba(6,16,48, .88/.52/.30)) on the light glass. -->
    <SolidColorBrush x:Key="Popup.Ink1" Color="#E0061030"/>
    <SolidColorBrush x:Key="Popup.Ink2" Color="#85061030"/>
    <SolidColorBrush x:Key="Popup.Ink3" Color="#4D061030"/>

    <!-- Text/glyph ON the bar — DARK navy (the light-blue bar reads LIGHT over the desktop). -->
    <SolidColorBrush x:Key="Popup.OnBar"    Color="#F0061030"/>
    <SolidColorBrush x:Key="Popup.OnBarDim" Color="#99061030"/>

    <!-- 12-segment meter / intensity slider — off = faint navy, on = the accent. -->
    <SolidColorBrush x:Key="Popup.SegOff" Color="#26061030"/>
    <SolidColorBrush x:Key="Popup.SegOn"  Color="#FF024AD8"/>

    <!-- Hover/press wash for bar icon buttons (a faint DARK film = a press highlight on light glass). -->
    <SolidColorBrush x:Key="Popup.BtnHover" Color="#14061030"/>
    <SolidColorBrush x:Key="Popup.BtnPress" Color="#1F061030"/>

</ResourceDictionary>
