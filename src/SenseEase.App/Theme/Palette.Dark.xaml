<!--
  Palette.Dark — Windows-11-dark override layer.

  Redefines the SAME colour-brush keys as Theme/SenseEaseTheme.xaml with
  dark values. Merged ABOVE SenseEaseTheme.xaml at runtime so these keys
  win over the light defaults; all non-colour tokens (spacing, radius,
  elevation, typography, focus ring) continue to resolve from the light
  dictionary underneath. Brushes only — nothing else lives here.

  Loaded via pack URI, e.g.:
    <ResourceDictionary Source="pack://application:,,,/SenseEase.App;component/Theme/Palette.Dark.xaml"/>
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <SolidColorBrush x:Key="Canvas"        Color="#16181D"/>
    <SolidColorBrush x:Key="Surface"       Color="#20242B"/>
    <SolidColorBrush x:Key="SurfaceMuted"  Color="#282D35"/>
    <SolidColorBrush x:Key="Separator"     Color="#343A44"/>
    <!-- Hairline card outline — esp. important in dark for surface definition. -->
    <SolidColorBrush x:Key="CardBorder"    Color="#2E343D"/>
    <SolidColorBrush x:Key="HeaderSurface" Color="#1B1E24"/>
    <SolidColorBrush x:Key="TextPrimary"   Color="#EAEDF2"/>
    <SolidColorBrush x:Key="TextSecondary" Color="#AEB6C2"/>
    <SolidColorBrush x:Key="TextTertiary"  Color="#828B98"/>
    <SolidColorBrush x:Key="TextOnComfort" Color="#FFFFFF"/>
    <!-- Brighter indigo for dark-mode contrast on the deep canvas/surfaces. -->
    <SolidColorBrush x:Key="Accent"        Color="#7C8CF8"/>
    <SolidColorBrush x:Key="AccentHover"   Color="#98A6FF"/>

    <!-- Comfort bands re-tuned for dark legibility: text-on-weak stays ≥4.5:1
         against its weak fill; weak fills sit just above the dark surface. -->
    <SolidColorBrush x:Key="ComfortSteady"     Color="#3FA68F"/>
    <SolidColorBrush x:Key="ComfortSteadyWeak" Color="#1C3D37"/>
    <SolidColorBrush x:Key="ComfortSteadyText" Color="#A4E4D3"/>
    <SolidColorBrush x:Key="ComfortRising"     Color="#C79A4E"/>
    <SolidColorBrush x:Key="ComfortRisingWeak" Color="#3D311B"/>
    <SolidColorBrush x:Key="ComfortRisingText" Color="#ECCD8F"/>
    <SolidColorBrush x:Key="ComfortHigh"       Color="#D07A6B"/>
    <SolidColorBrush x:Key="ComfortHighWeak"   Color="#3D2724"/>
    <SolidColorBrush x:Key="ComfortHighText"   Color="#F4BAAF"/>

</ResourceDictionary>
