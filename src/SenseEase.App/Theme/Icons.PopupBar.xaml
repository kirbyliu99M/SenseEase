<!--
  UI-RESHAPE prep — vector glyphs for the new popup bar (no emoji; SVG-style Path
  geometry per the design-system iconography rule). Pure ResourceDictionary (no
  x:Class), merged VIEW-LOCALLY via pack URI. Each entry is a fillable Geometry
  (24x24 coordinate space) referenced as <Path Data="{StaticResource Icon.X}"/>.
  Default StreamGeometry fill rule is EvenOdd, which punches the inner holes
  (gear centre / alert bar) correctly.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Geometry x:Key="Icon.Play">M8,5 L19,12 L8,19 Z</Geometry>
    <Geometry x:Key="Icon.Pause">M6,5 L10,5 L10,19 L6,19 Z M14,5 L18,5 L18,19 L14,19 Z</Geometry>
    <Geometry x:Key="Icon.Plus">M11,5 L13,5 L13,11 L19,11 L19,13 L13,13 L13,19 L11,19 L11,13 L5,13 L5,11 L11,11 Z</Geometry>
    <Geometry x:Key="Icon.Minus">M5,11 L19,11 L19,13 L5,13 Z</Geometry>
    <Geometry x:Key="Icon.Send">M2,21 L23,12 L2,3 L2,10 L17,12 L2,14 Z</Geometry>
    <Geometry x:Key="Icon.Stop">M6,6 L18,6 L18,18 L6,18 Z</Geometry>
    <Geometry x:Key="Icon.Chat">M9,22 A1,1 0 0,1 8,21 V18 H4 A2,2 0 0,1 2,16 V4 C2,2.9 2.9,2 4,2 H20 A2,2 0 0,1 22,4 V16 A2,2 0 0,1 20,18 H13.9 L10.2,21.71 C10,21.9 9.75,22 9.5,22 Z</Geometry>
    <Geometry x:Key="Icon.Settings">M12,15.5 A3.5,3.5 0 0,1 8.5,12 A3.5,3.5 0 0,1 12,8.5 A3.5,3.5 0 0,1 15.5,12 A3.5,3.5 0 0,1 12,15.5 M19.43,12.97 C19.47,12.65 19.5,12.33 19.5,12 C19.5,11.67 19.47,11.34 19.43,11 L21.54,9.37 C21.73,9.22 21.78,8.95 21.66,8.73 L19.66,5.27 C19.54,5.05 19.27,4.96 19.05,5.05 L16.56,6.05 C16.04,5.66 15.5,5.32 14.87,5.07 L14.5,2.42 C14.46,2.18 14.25,2 14,2 H10 C9.75,2 9.54,2.18 9.5,2.42 L9.13,5.07 C8.5,5.32 7.96,5.66 7.44,6.05 L4.95,5.05 C4.73,4.96 4.46,5.05 4.34,5.27 L2.34,8.73 C2.21,8.95 2.27,9.22 2.46,9.37 L4.57,11 C4.53,11.34 4.5,11.67 4.5,12 C4.5,12.33 4.53,12.65 4.57,12.97 L2.46,14.63 C2.27,14.78 2.21,15.05 2.34,15.27 L4.34,18.73 C4.46,18.95 4.73,19.03 4.95,18.95 L7.44,17.94 C7.96,18.34 8.5,18.68 9.13,18.93 L9.5,21.58 C9.54,21.82 9.75,22 10,22 H14 C14.25,22 14.46,21.82 14.5,21.58 L14.87,18.93 C15.5,18.67 16.04,18.34 16.56,17.94 L19.05,18.95 C19.27,19.03 19.54,18.95 19.66,18.73 L21.66,15.27 C21.78,15.05 21.73,14.78 21.54,14.63 Z</Geometry>

    <!-- Power / on-off switch glyph (stroked, not filled). Bar pierces DOWN through the
         gap at the TOP of a ring centred at (12,13); large-arc + sweep=0 wrap the bottom,
         leaving the gap up top. (The prior glyph resolved its arc centre ABOVE the gap, so
         the ring sat on top of the bar — i.e. upside-down. Verified centre = (12,13) now.) -->
    <Geometry x:Key="Icon.Power">M12,4 L12,11 M7.5,7.64 A7,7 0 1 0 16.5,7.64</Geometry>

    <!-- Pin / keep-open (filled thumbtack, points down) for the two-stage bar's pin toggle -->
    <Geometry x:Key="Icon.Pin">M16,12 V4 H17 V2 H7 V4 H8 V12 L6,14 V16 H11.2 V22 H12.8 V16 H18 V14 L16,12 Z</Geometry>

    <!-- Expand / collapse chevrons (stroked) for the condensed↔full reveal -->
    <Geometry x:Key="Icon.ChevronDown">M6,9 L12,15 L18,9</Geometry>
    <Geometry x:Key="Icon.ChevronUp">M6,15 L12,9 L18,15</Geometry>

    <!-- Trash / clear-chat (filled): lid + handle notch, then the bin body -->
    <Geometry x:Key="Icon.Trash">M10,2 L14,2 L15,4 L20,4 L20,6 L4,6 L4,4 L9,4 Z M6,8 L18,8 L16.8,22 L7.2,22 Z</Geometry>

    <!-- Pulse status glyphs (triple-coding so status is never colour-only) -->
