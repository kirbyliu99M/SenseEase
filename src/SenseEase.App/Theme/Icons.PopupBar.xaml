    <Geometry x:Key="Icon.StatusMid">M12,7 A5,5 0 1,0 12,17 A5,5 0 1,0 12,7 Z</Geometry>
    <Geometry x:Key="Icon.StatusHigh">M12,2 L1,21 L23,21 Z M12,6 L19.53,19 L4.47,19 Z M11,10 L13,10 L13,14 L11,14 Z M11,16 L13,16 L13,18 L11,18 Z</Geometry>

</ResourceDictionary>
