<!--
  SettingsGlassPalette.Dark — the Game-Bar dark variant of the Settings glass bridge.

  Redefines the SAME keys as SettingsGlassPalette.xaml with the neutral black/grey Game-Bar values
  (mirroring PopupGlassTokens.Dark.xaml), merged ABOVE the slate glass when the effective theme is
  dark — so the Settings flips slate↔Game-Bar EXACTLY like the popup. Pure ResourceDictionary.
  Contrast on the near-black card #1F1F22 (L≈0.014):
    TextPrimary #F2FFFFFF ≈ 17:1 (AAA), TextSecondary #B8FFFFFF ≈ 11:1, TextTertiary #99FFFFFF ≈ 7:1.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <SolidColorBrush x:Key="Canvas"        Color="#00000000"/>
    <SolidColorBrush x:Key="HeaderSurface" Color="#00000000"/>

    <SolidColorBrush x:Key="Surface"       Color="#F51F1F22"/>
    <SolidColorBrush x:Key="SurfaceMuted"  Color="#ED1B1B1D"/>

    <SolidColorBrush x:Key="CardBorder"    Color="#33FFFFFF"/>
    <SolidColorBrush x:Key="Separator"     Color="#26FFFFFF"/>

    <SolidColorBrush x:Key="TextPrimary"   Color="#F2FFFFFF"/>
    <SolidColorBrush x:Key="TextSecondary" Color="#B8FFFFFF"/>
    <SolidColorBrush x:Key="TextTertiary"  Color="#99FFFFFF"/>
    <SolidColorBrush x:Key="TextOnComfort" Color="#FFFFFFFF"/>

    <SolidColorBrush x:Key="Accent"        Color="#FF4DA6FF"/>
    <SolidColorBrush x:Key="AccentHover"   Color="#FF6FB6FF"/>

    <SolidColorBrush x:Key="ComfortSteady"     Color="#FF4ADE80"/>
    <SolidColorBrush x:Key="ComfortSteadyWeak" Color="#264ADE80"/>
    <SolidColorBrush x:Key="ComfortSteadyText" Color="#FFA6E9C0"/>
    <SolidColorBrush x:Key="ComfortRising"     Color="#FFFBBF24"/>
    <SolidColorBrush x:Key="ComfortRisingWeak" Color="#26FBBF24"/>
    <SolidColorBrush x:Key="ComfortRisingText" Color="#FFFBD89A"/>
    <SolidColorBrush x:Key="ComfortHigh"       Color="#FFFF6B6B"/>
    <SolidColorBrush x:Key="ComfortHighWeak"   Color="#26FF6B6B"/>
    <SolidColorBrush x:Key="ComfortHighText"   Color="#FFFCA5A5"/>

</ResourceDictionary>
